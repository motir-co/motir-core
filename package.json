{
  "name": "motir-core",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source PM substrate for Motir — an AI-native project management tool. GPL-3.0.",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/migrate-deploy.mjs && NODE_OPTIONS=--max-old-space-size=6144 next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b tsconfig.solution.json",
    "assert:nft-trace": "node scripts/assert-nft-trace-scope.mjs",
    "generate:cli-api": "tsx --tsconfig tsconfig.node.json scripts/generate-cli-api.ts",
    "generate:mcp-tool-schemas": "tsx --tsconfig tsconfig.node.json scripts/generate-mcp-tool-schemas.ts",
    "staging:two-machine-check": "tsx --tsconfig tsconfig.node.json scripts/staging/two-machine-check.ts",
    "loadtest:preflight": "tsx --tsconfig tsconfig.node.json loadtest/preflight/sideEffects.ts",
    "loadtest:secrets-template": "tsx --tsconfig tsconfig.node.json loadtest/staging/sideEffectSwitches.ts --write",
    "loadtest:seed": "tsx --tsconfig tsconfig.node.json loadtest/seed/seed.ts",
    "loadtest:seed:reset": "tsx --tsconfig tsconfig.node.json loadtest/seed/reset.ts",
    "loadtest:run": "tsx --tsconfig tsconfig.node.json loadtest/run/run.ts",
    "loadtest:report": "tsx --tsconfig tsconfig.node.json loadtest/report/report.ts",
    "db:seed": "tsx --tsconfig tsconfig.node.json scripts/plan-seed/seed.ts",
    "db:seed:large": "tsx --tsconfig tsconfig.node.json scripts/seed-large.ts",
    "db:seed:collab": "tsx --tsconfig tsconfig.node.json scripts/seed-collab.ts",
    "db:seed:reporting": "tsx --tsconfig tsconfig.node.json scripts/seed-reporting.ts",
    "bench:bound-read-shape": "tsx --tsconfig tsconfig.node.json scripts/bench/boundReadTransactionShape.ts",
    "db:backfill:boards": "tsx --tsconfig tsconfig.node.json scripts/backfill-default-boards.ts",
    "db:backfill:provenance": "tsx --tsconfig tsconfig.node.json scripts/backfill-work-item-provenance.ts",
    "db:backfill:code-graph-index": "tsx --tsconfig tsconfig.node.json scripts/backfill-code-graph-index.ts",
    "db:backfill:pull-requests": "tsx --tsconfig tsconfig.node.json scripts/backfill-historical-pull-requests.ts",
    "db:backfill:pr-base-ref": "tsx --tsconfig tsconfig.node.json scripts/backfill-pull-request-base-ref.ts",
    "db:backfill:ci-state": "tsx --tsconfig tsconfig.node.json scripts/backfill-work-item-ci-state.ts",
    "db:backfill:fix-reason": "tsx --tsconfig tsconfig.node.json scripts/backfill-fix-reason.ts",
    "db:backfill:resume-state": "tsx --tsconfig tsconfig.node.json scripts/backfill-resume-state.ts",
    "db:backfill:plan-gates": "tsx --tsconfig tsconfig.node.json scripts/backfill-plan-approval-gates.ts",
    "db:converge:unlanded-cards": "tsx --tsconfig tsconfig.node.json scripts/converge-ejected-cards.ts",
    "db:converge:ejected-cards": "tsx --tsconfig tsconfig.node.json scripts/converge-ejected-cards.ts",
    "db:reevaluate:repo-set": "tsx --tsconfig tsconfig.node.json scripts/reevaluate-repo-set-completion.ts",
    "ops:fleet-cost": "tsx --tsconfig tsconfig.node.json scripts/fleet-cost-readout.ts",
    "ops:pg-top-statements": "tsx --tsconfig tsconfig.node.json scripts/pg-top-statements.ts",
    "ops:agent-meter-rehearsal": "tsx --tsconfig tsconfig.node.json scripts/rehearse-hosted-agent-meter.ts",
    "ops:platform-meter-backfill": "tsx --tsconfig tsconfig.node.json scripts/platform-meter-backfill.ts",
    "db:backfill:embeddings": "tsx --tsconfig tsconfig.node.json scripts/backfill-work-item-embeddings.ts",
    "db:stamp:onboarding": "tsx --tsconfig tsconfig.node.json scripts/stamp-onboarding-ran.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage:auto-translate": "vitest run --config vitest.coverage.auto-translate.config.ts --coverage",
    "coverage:onboarding-routing": "vitest run --config vitest.coverage.onboarding-routing.config.ts --coverage",
    "coverage:approved-status": "vitest run --config vitest.coverage.approved-status.config.ts --coverage",
    "coverage:in-flight-code": "vitest run --config vitest.coverage.in-flight-code.config.ts --coverage",
    "coverage:code-unreadable": "vitest run --config vitest.coverage.code-unreadable.config.ts --coverage",
    "coverage:code-read": "vitest run --config vitest.coverage.code-read.config.ts --coverage",
    "coverage:hosted-agent-run": "vitest run --config vitest.coverage.hosted-agent-run.config.ts --coverage",
    "coverage:review-agent": "vitest run --config vitest.coverage.review-agent.config.ts --coverage",
    "coverage:agent-instances": "vitest run --config vitest.coverage.agent-instances.config.ts --coverage",
    "coverage:platform-admin": "vitest run --config vitest.coverage.platform-admin.config.ts --coverage",
    "coverage:agent-instance-run": "vitest run --config vitest.coverage.agent-instance-run.config.ts --coverage",
    "coverage:fix-in-my-agent": "vitest run --config vitest.coverage.fix-in-my-agent.config.ts --coverage",
    "coverage:pages": "vitest run --config vitest.coverage.pages.config.ts --coverage",
    "coverage:planning-session-needs-you": "vitest run --config vitest.coverage.planning-session-needs-you.config.ts --coverage",
    "coverage:lost-machine-auto-resume": "vitest run --config vitest.coverage.lost-machine-auto-resume.config.ts --coverage",
    "coverage:session-lifecycle": "vitest run --config vitest.coverage.session-lifecycle.config.ts --coverage",
    "coverage:plan-something-new": "vitest run --config vitest.coverage.plan-something-new.config.ts --coverage",
    "coverage:mid-run-turns": "vitest run --config vitest.coverage.mid-run-turns.config.ts --coverage",
    "coverage:guide-replan-offer": "vitest run --config vitest.coverage.guide-replan-offer.config.ts --coverage",
    "coverage:to-resume": "vitest run --config vitest.coverage.to-resume.config.ts --coverage",
    "coverage:live-push": "vitest run --config vitest.coverage.live-push.config.ts --coverage",
    "coverage:bug-filing": "vitest run --config vitest.coverage.bug-filing.config.ts --coverage",
    "coverage:font-picks": "vitest run --config vitest.coverage.font-picks.config.ts --coverage",
    "coverage:runs-overlay-parity": "vitest run --config vitest.coverage.runs-overlay-parity.config.ts --coverage",
    "coverage:plan-overlay-only": "vitest run --config vitest.coverage.plan-overlay-only.config.ts --coverage",
    "coverage:waiting-plan-carry": "vitest run --config vitest.coverage.waiting-plan-carry.config.ts --coverage",
    "test:coverage:plan-progress": "vitest run --config vitest.coverage.plan-progress.config.ts --coverage",
    "test:coverage:plan-at-work": "vitest run --config vitest.coverage.plan-at-work.config.ts --coverage",
    "test:coverage:plan-narration": "vitest run --config vitest.coverage.plan-narration.config.ts --coverage",
    "test:coverage:tool-call-narration": "vitest run --config vitest.coverage.tool-call-narration.config.ts --coverage",
    "test:guards": "vitest run --config vitest.guards.config.ts",
    "test:two-instance": "vitest run --config vitest.two-instance.config.ts",
    "test:loadtest-e2e": "vitest run --config vitest.loadtest-e2e.config.ts",
    "test:docs-guards": "vitest run --config vitest.docs.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:cloud": "playwright test --config playwright.cloud.config.ts",
    "test:e2e:regression": "playwright test --config playwright.regression.config.ts",
    "test:e2e:observability": "playwright test -c playwright.observability.config.ts",
    "prepare": "husky",
    "postinstall": "prisma generate && pnpm --filter @motir/design-system build && pnpm --filter @motir/brand build && pnpm --filter @motir/orchestrator build && pnpm --filter @motir/pages build",
    "build:worker": "node scripts/build-worker.mjs",
    "build:relay": "node scripts/build-relay.mjs",
    "build:fleet-admin": "node scripts/build-fleet-admin.mjs",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "i18n:extract": "tsx --tsconfig tsconfig.node.json scripts/i18n/catalogue.ts extract",
    "i18n:merge": "tsx --tsconfig tsconfig.node.json scripts/i18n/catalogue.ts merge",
    "i18n:status": "tsx --tsconfig tsconfig.node.json scripts/i18n/catalogue.ts status",
    "i18n:baseline": "tsx --tsconfig tsconfig.node.json scripts/i18n/catalogue.ts baseline"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1104.0",
    "@aws-sdk/s3-request-presigner": "^3.1104.0",
    "@better-auth/cimd": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "@better-auth/passkey": "1.7.7",
    "@better-auth/prisma-adapter": "1.7.7",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@motir/brand": "workspace:*",
    "@motir/design-system": "workspace:*",
    "@motir/orchestrator": "workspace:*",
    "@motir/pages": "workspace:*",
    "@prisma/adapter-pg": "~7.9.0",
    "@prisma/client": "~7.9.0",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "@sentry/nextjs": "^10.71.0",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-code-block": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-mention": "^3.31.4",
    "@tiptap/extension-task-item": "^3.31.4",
    "@tiptap/extension-task-list": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "argon2": "^0.44.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "fractional-indexing": "^3.2.0",
    "franc-min": "6.2.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.16.0",
    "mcp-handler": "^1.1.0",
    "next": "16.3.6",
    "next-intl": "^4.13.0",
    "pg": "^8.21.0",
    "prom-client": "15.1.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^3.6.0",
    "tiptap-markdown": "^0.9.0",
    "tldts": "^7.4.11",
    "unified": "^11.0.5",
    "ws": "8.21.0",
    "yaml": "2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@changesets/cli": "^3.0.1",
    "@formatjs/icu-messageformat-parser": "3.5.11",
    "@playwright/test": "^1.60.0",
    "@seriousme/openapi-schema-validator": "^2.9.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.19",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^8.20.0",
    "axe-core": "4.11.4",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.3",
    "prisma": "~7.9.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "undici": "^6.25.0",
    "vitest": "^4.1.11"
  }
}
