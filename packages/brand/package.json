{
  "name": "@motir/brand",
  "version": "0.4.10",
  "description": "Motir's own brand chrome — the wave-band glyph, the wordmark lockup, and their presentation CSS. Consumed by motir-core and motir-marketing; deliberately NOT part of @motir/design-system, which scaffolded third-party products install.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/motir-co/motir-core.git",
    "directory": "packages/brand"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./brand.css": "./brand.css",
    "./fonts/*": "./fonts/*"
  },
  "files": [
    "dist",
    "brand.css",
    "fonts",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@motir/design-system": "^0.18.0",
    "react": "^19"
  },
  "devDependencies": {
    "@motir/design-system": "workspace:*",
    "@types/node": "^22.19.19",
    "@types/react": "^19",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
