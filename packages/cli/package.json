{
  "name": "@motir/cli",
  "version": "0.16.0",
  "description": "Motir CLI — terminal dispatch of the work loop, over Motir's public REST API.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/motir-co/motir-core.git",
    "directory": "packages/cli"
  },
  "homepage": "https://motir.co",
  "bugs": {
    "url": "https://github.com/motir-co/motir-core/issues"
  },
  "type": "module",
  "bin": {
    "motir": "./dist/index.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "generate:api": "pnpm -w run generate:cli-api",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "^14.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@vitest/coverage-v8": "^4.1.11",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
