{
  "schemaVersion": 1,
  "targets": ["fly"],
  "port": 8080,
  "healthCheck": {
    "path": "/health"
  },
  "startCommand": "node -e require('node:http').createServer((q,s)=>{if(q.url==='/health'){s.end('ok');return}s.setHeader('content-type','text/plain');s.end('GREETING='+(process.env.GREETING??'')+'\\nAPI_KEY:\\x20'+(process.env.API_KEY?'present':'absent')+'\\n')}).listen(process.env.PORT||8080)",
  "buildCommand": "echo prebuilt",
  "requires": {
    "websockets": false,
    "backgroundWork": false
  },
  "database": {
    "kind": "none"
  }
}
