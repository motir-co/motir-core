{
  // ── The SOLUTION file (MOTIR-4293) ──────────────────────────────────────────
  //
  // `pnpm typecheck` is `tsc -b tsconfig.solution.json`. It owns no files of its
  // own; it names the projects and lets `tsc -b` order them by their references.
  //
  // ⚠️ EVERY `composite` project in the repository belongs on this list, and
  // `tests/typecheck-program.test.ts` asserts exactly that — a project added later
  // and left off would simply stop being type-checked, silently and greenly. That
  // includes a `packages/*` project: `@motir/orchestrator` is here (MOTIR-4299), `@motir/pages` too (MOTIR-5757),
  // and `docs/decisions/app-shell-over-packages.md` §1 makes the reference part of
  // what a package IS.
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.tests.json" },
    { "path": "./tsconfig.tests-platform.json" },
    { "path": "./tsconfig.components.json" },
    { "path": "./tsconfig.integration.json" },
    { "path": "./tsconfig.e2e.json" },
    { "path": "./tsconfig.scripts.json" },
    { "path": "./packages/orchestrator" },
    { "path": "./packages/hosting-guard" },
    { "path": "./packages/pages" }
  ]
}
