# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# Playwright — the runner writes traces/screenshots/videos under
# /out/playwright-output and the HTML report under /out/playwright-report.
# `/out/` is already ignored below for Next.js's static export; calling
# it out here so a future Subtask doesn't accidentally git-add a trace
# zip if the out/ ignore moves.
/test-results/
/playwright-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# Amazon's PUBLIC RDS CA bundle, baked into the image so the pg driver can
# verify the AWS database's certificate (MOTIR-10056). Not a key.
!/certs/rds-global-bundle.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# The project-references declaration output (MOTIR-4293). `tsc -b
# tsconfig.solution.json` writes one `.d.ts` tree per project here, plus each
# project's own `.tsbuildinfo`, so no build state lands beside the sources and
# the incremental state is per project rather than one file for the whole tree.
/.tsout/

# Prisma's generated client (provider = "prisma-client"). Regenerated by the
# postinstall hook — never committed, so it cannot drift from schema.prisma.
# It lives at the repo ROOT, deliberately outside `lib/`, `app/` and
# `components/`: those are source roots the 4-layer rule and the structural
# guards walk, and a generated tree inside one is read as source by every
# sweep that does not know to skip it.
/generated/
.worker/
.relay/
.fleet-admin/
.deploy-check/

# Throwaway tsc probe dirs (tests/approval-gate-registry.test.ts) — removed in its own `finally`;
# ignored so a hard-killed run cannot leave one in `git status`.
.tsprobe-*/

# MOTIR-7745 — translation batch files written by `pnpm i18n:extract`
/.i18n-work/

# MOTIR-8673 — the load-test seed manifest holds tokens and session cookies
loadtest/.out/
