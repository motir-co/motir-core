{
  // ── The TESTS project (MOTIR-4293, narrowed by MOTIR-4363) ──────────────────
  //
  // Files that import almost all of `lib/`. Checked on its own it would be
  // nearly the whole tree again — which is why it REFERENCES the app project
  // instead of including it: `@/lib/x` redirects to `.tsout/app/lib/x.d.ts`, so
  // this program pays for its own bodies plus the app's declarations.
  //
  // The four VITEST configs live here because they are that runner's own entry
  // points, and each file belongs to EXACTLY ONE project — a file in two
  // composite projects is emitted twice and checked twice.
  //
  // ⚠️ THE PLAYWRIGHT HALF LEFT (MOTIR-4363), AND THE LINE IS THE RUNNER: the
  // 182 `tests/e2e/**/*.spec.ts` and the three `playwright.*.config.ts` are
  // `tsconfig.e2e.json` now, which REFERENCES this project. Everything a spec
  // imports stayed HERE — `tests/e2e/_helpers/`, `_reporters/`,
  // `global-setup.ts`, `global-teardown.ts`, `shard-plan.ts` — because nine
  // vitest suites import those same modules, and a module both runners load has
  // to sit in the project the other one references or the graph is a cycle.
  // `tsconfig.e2e.json`'s header carries the rule in full; the short form is
  // *Playwright ENTERS THROUGH it ⇒ e2e project; something Playwright runs
  // IMPORTS it ⇒ here*.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": ".",
    "outDir": ".tsout/tests",
    "tsBuildInfoFile": ".tsout/tests/tsconfig.tsbuildinfo"
  },
  "include": [
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "tests/**/*.mts",
    // The import-sample fixture's data (MOTIR-8240): `index.ts` imports each
    // file and checks it against its type with `satisfies`, and a composite
    // project must list every file it reads (TS6307). Named narrowly so no other
    // JSON under `tests/` is pulled into the program.
    "tests/fixtures/importSample/**/*.json",
    // The hoster host agent (MOTIR-9480) is a standalone, dependency-free service
    // with no project of its own; its source is type-checked here, beside its
    // tests in `tests/hosterHostAgent/`.
    "infra/hoster-host-agent/src/**/*.ts",
    "vitest.config.ts",
    "vitest.collect.config.ts",
    "vitest.design.config.ts",
    "vitest.docs.config.ts",
    "vitest.guards.config.ts"
  ],
  // The e2e project owns the Playwright specs (above). Excluded rather than
  // narrowed out of the glob so `tests/**` keeps meaning "every test source",
  // and so the one line that moves the boundary is legible in a diff.
  // `tests/components/**` is `tsconfig.components.json` (MOTIR-5433), which
  // references this project — the render suites import `tests/helpers/**`.
  "exclude": [
    "node_modules",
    "packages",
    ".tsout",
    "tests/e2e/**/*.spec.ts",
    "tests/components/**",
    "tests/integration/**/*.test.ts",
    "tests/integration/**/*.test.tsx",
    // `tsconfig.tests-platform.json` (MOTIR-8353) — keep this list and its
    // `include` the same set of directories; `tests/typecheck-program.test.ts`
    // fails when they drift.
    "tests/agentChat/**",
    "tests/agentReview/**",
    "tests/agentTerminal/**",
    "tests/ai/**",
    "tests/async/**",
    "tests/automation/**",
    "tests/ciFleet/**",
    "tests/ciMetering/**",
    "tests/codeGraph/**",
    "tests/codeHealth/**",
    "tests/dispatch/**",
    "tests/dispatchRuns/**",
    "tests/embeddings/**",
    "tests/gateway/**",
    "tests/git/**",
    "tests/github/**",
    "tests/gitlab/**",
    "tests/hosted/**",
    "tests/hostedRuns/**",
    "tests/hosting/**",
    "tests/ideaDraft/**",
    "tests/jobs/**",
    "tests/lessons/**",
    "tests/mcp/**",
    "tests/planChange/**",
    "tests/planning/**",
    "tests/plans/**",
    "tests/projectRepos/**",
    "tests/runs/**"
  ],
  // BOTH, because a test importing `@/scripts/plan-seed/…` (the seed fixtures) or
  // `../../scripts/deployFreshness.mjs` must redirect into the scripts project
  // rather than pull those files into this program as sources of its own — a file
  // belongs to exactly one project.
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.scripts.json" }]
}
