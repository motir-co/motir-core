  /// `primaryAddress` is the ADR §7 canonical rule expressed as a CONSTRAINT
  /// rather than a convention: one nullable FK cannot point at two rows, so
  /// "exactly one primary" is unrepresentable-otherwise instead of enforced by a
  /// check somebody has to remember to write. NULL means the default rule
  /// applies — the workspace subdomain path when one is claimed, else
  /// `motir.co/p/<identifier>`.
  ///
  /// `SetNull` on the primary, `Cascade` on the list: removing the address a
  /// project is canonical at must NOT delete the project, it must fall back to
  /// the default; deleting the project takes its addresses with it.
  primaryAddressId              String?                      @map("primary_address_id")
  primaryAddress                PublicAddress?               @relation("ProjectPrimaryAddress", fields: [primaryAddressId], references: [id], onDelete: SetNull)
  publicAddresses               PublicAddress[]              @relation("ProjectPublicAddresses")
  /// Approval gates scoped to this project (a gate is `workspaceId` + `projectId`,
  /// per the ADR §7 tier — `prMergeMode` lives at the project, not the workspace).
  approvalGates                 ApprovalGate[]
  /// The project's folders (Story MOTIR-5308) — named, nestable places in its
  /// tree that carry no workflow. Cascade.
  folders                       Folder[]
  pages                         Page[]
  pageVersions                  PageVersion[]
  autoTranslateChanges          ProjectAutoTranslateChange[]
  decisionPagePublications      DecisionPagePublication[]
  pageWorkItemLinks             PageWorkItemLink[]
  /// The folder this project's filed bugs land in (Story MOTIR-4927 · MOTIR-4934).
  /// NULL MEANS THE PROJECT ROOT, CHOSEN — nullable with no default, and never to
  /// be made required. `NoAction`, the `Folder.parentFolder` idiom: a folder this
  /// names is deleted only through `foldersService.deleteFolder`, which carries
  /// the destination to the folder's parent first (MOTIR-5537); `SetNull` would
  /// turn a deleted nested folder into a root nobody chose. Same-project is
  /// enforced by `trg_project_bug_destination_folder_tenancy`.
  bugDestinationFolderId        String?                      @map("bug_destination_folder_id")
  bugDestinationFolder          Folder?                      @relation("ProjectBugDestinationFolder", fields: [bugDestinationFolderId], references: [id], onDelete: NoAction)
  /// The folder this project's PLANNER bugs are filed into (Story MOTIR-5818 ·
  /// MOTIR-5820) — the `@planner-bug-home` marker's destination. A SECOND
  /// pointer, mirroring `bugDestinationFolderId` field for field, because the two
  /// destinations are distinct. NULL MEANS *FALL BACK*: a planner bug then goes
  /// wherever the product bugs go (`bugDestinationFolderId`), and thence to the
  /// project root. Nothing seeds it — it stays null in every project that does not
  /// deliberately set it. `NoAction` for the same reason as the product pointer:
  /// `foldersService.deleteFolder` carries it up first (MOTIR-5821). Same-project
  /// is enforced by `trg_project_planner_bug_destination_folder_tenancy`.
  plannerBugDestinationFolderId String?                      @map("planner_bug_destination_folder_id")
  plannerBugDestinationFolder   Folder?                      @relation("ProjectPlannerBugDestinationFolder", fields: [plannerBugDestinationFolderId], references: [id], onDelete: NoAction)

  @@unique([workspaceId, slug])
  @@unique([workspaceId, identifier])
  @@index([workspaceId])
  /// `public_address.id` is SET NULL when the address is removed, so the delete
  /// scans `project` for referencing rows. Declared here as well as in the
  /// migration because a database index the datamodel does not carry is exactly
  /// the drift `CLAUDE.md`'s migration rules describe — the `build` job's
  /// `prisma migrate diff` assertion caught this one before it shipped.
  @@index([primaryAddressId])
  /// A folder delete checks `project` for rows naming it (the NoAction FK above).
  @@index([bugDestinationFolderId])
  /// …and for rows naming it as the PLANNER-bug destination (MOTIR-5820).
  @@index([plannerBugDestinationFolderId])
  // pg_trgm GIN over the public-project DIRECTORY's free-text contains-match
  // columns (Story 6.13 · Subtask 6.13.3, finding #57): the project-square
  // search compiles to ILIKE '%…%' over the project `name` + the public
  // `public_overview_md` overview, and the square is a cross-org directory that
  // can hold thousands of public projects — so the search must not table-scan. A
  // multicolumn GIN serves predicates on either column. Mirrors the 6.1.1
  // work-item trgm index; the pg_trgm EXTENSION it needs already exists (created
  // by that migration — Prisma doesn't model extensions here).
  @@index([name(ops: raw("gin_trgm_ops")), publicOverviewMd(ops: raw("gin_trgm_ops"))], type: Gin, map: "project_name_public_overview_md_idx")
  @@map("project")
}

/// Join table — a user belongs to one-or-more workspaces. Cascades on both
/// FKs: deleting a Workspace or a User removes the membership row. The
/// (userId, workspaceId) uniqueness prevents accidental double-inserts.
/// The member's role is `workspaceRole` (+ `roleDefinitionId` for a custom role,
/// Story MOTIR-6168). The legacy `role` column (`member_role`, Story 6.4) was
/// retired by Release A and dropped by MOTIR-6569.
model WorkspaceMembership {
  id               String               @id @default(cuid())
  userId           String
  workspaceId      String
  /// The member's currently-active project within this workspace. Clears
  /// to NULL (onDelete: SetNull) — not cascades — when that project is
  /// archived/deleted, so losing a project never removes the membership.
  /// Resolution (getActiveProject) + RLS land in Subtask 1.3.2.
  activeProjectId  String?
  /// The person's ONE workspace role (Story MOTIR-6168 · MOTIR-6457) — Manager,
  /// Member or Viewer, the same in every project of the workspace
  /// (`docs/decisions/role-model.md` §2). NOT NULL since MOTIR-6561, which
  /// backfilled the deploy window's stragglers and deleted the fallback that read
  /// the legacy `role` — this column is now the ONLY place a role is read from.
  /// It has NO default on purpose: every writer names the role, and a default
  /// would hide one that forgot to.
  ///
  /// ⚠️ This column and `roleDefinitionId` MOVE TOGETHER, and
  /// `workspaceMembershipRepository.setWorkspaceRole` is their only writer. A
  /// membership on a workspace custom role carries `workspaceRole =
  /// CUSTOM_WORKSPACE_ROLE_TIER` (`member`, `lib/workspaces/roles.ts`).
  workspaceRole    WorkspaceRole        @map("workspace_role")
  /// The workspace CUSTOM role this membership holds, or NULL for a built-in.
  /// `onDelete: Restrict` for the reason `ProjectMembership.roleDefinitionId`
  /// gives: Cascade would drop the member, SetNull would silently re-grant, so
  /// the DATABASE refuses and the only route to deleting a held role is the
  /// service's reassign-then-delete path.
  roleDefinitionId String?              @map("role_definition_id")
  /// The member's ACCESS SCOPE (Story MOTIR-6169 · MOTIR-6541) — `full` enters
  /// every project open to the workspace plus any Members-only project they
  /// were added to; `limited` enters ONLY the projects they were added to
  /// (`docs/decisions/role-model.md` Q1). Never read for a Manager, who enters
  /// every project. It DOES default, unlike `workspaceRole`: nobody before this
  /// story was restricted, so `full` is the correct value for every row the
  /// still-serving old build inserts, and a default loses nothing.
  /// `workspaceMembershipRepository.setAccessScope` is its writer.
  accessScope      WorkspaceAccessScope @default(full) @map("access_scope")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace      Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  activeProject  Project?                 @relation("ActiveProject", fields: [activeProjectId], references: [id], onDelete: SetNull)
  roleDefinition WorkspaceRoleDefinition? @relation(fields: [roleDefinitionId], references: [id], onDelete: Restrict)

  @@unique([userId, workspaceId])
  @@index([userId])
  @@index([workspaceId])
  @@index([activeProjectId])
  @@index([roleDefinitionId])
  @@map("workspace_membership")
}

/// A workspace's OWN role — a custom role a Manager authored (Story MOTIR-6168 ·
/// MOTIR-6457). The workspace-tier successor of the project custom role (the
/// `project_role_definition` table, dropped by MOTIR-6569): the three
/// BUILT-IN roles (Manager · Member · Viewer) are not rows, they live in code; a
/// custom role is a NAME + a chosen SET over the code-owned catalog, and it
/// applies in every project of its workspace (`role-model.md` Q2).
///
/// `permissions` is a `String[]` rather than a join table: the catalog is
/// code-owned and bounded, a role's set is read whole, and no query asks which
/// roles hold a key. There is no `based_on` column: provenance that never
/// re-flowed. The editor's "Start from" seeds the grid and is not
/// stored.
///
/// RLS: its own `workspace_id` column and ONE `FOR ALL` policy on
/// `app.workspace_id`, the shape every workspace-bearing table takes.
model WorkspaceRoleDefinition {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  permissions String[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace       Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberships     WorkspaceMembership[]
  migrationReport RoleMigrationReport[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("workspace_role_definition")
}

/// One row per person per reason the move to workspace roles chose their role by
/// anything other than the plain mapping (Story MOTIR-6168 · MOTIR-6457). Written
/// by the role migration (MOTIR-6458) and its never-wider check (MOTIR-6461),
/// read by the workspace Members page's migration notice (MOTIR-6465), and read
/// by the project access story's migration (MOTIR-6169) to turn a narrowing
/// project role into a Limited scope.
///
/// A RECORD, not a live pointer: `beforeJson` is the legacy workspace role and
/// every project role / custom role the person held, as it stood at the move.
/// `afterRoleDefinitionId` is `SetNull` because a report row outliving the custom
/// role it names is correct — the report says what happened, and the role's later
/// deletion does not un-happen it.
model RoleMigrationReport {
  id                    String              @id @default(cuid())
  workspaceId           String              @map("workspace_id")
  userId                String              @map("user_id")
  beforeJson            Json                @map("before_json")
  afterRole             WorkspaceRole       @map("after_role")
  afterRoleDefinitionId String?             @map("after_role_definition_id")
  reason                RoleMigrationReason
  createdAt             DateTime            @default(now()) @map("created_at")
  dismissedAt           DateTime?           @map("dismissed_at")

  workspace           Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  afterRoleDefinition WorkspaceRoleDefinition? @relation(fields: [afterRoleDefinitionId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([userId])
  @@index([afterRoleDefinitionId])
  @@map("role_migration_report")
}

/// Per-project membership (Story 6.4) — the project-scoped sibling of
/// `WorkspaceMembership`: who is in a project. It carries no role since Story
/// MOTIR-6168 put the role on the workspace; the legacy `role` /
/// `role_definition_id` columns and the `project_role_definition` table they
/// pointed at were dropped by MOTIR-6569. The `[userId, projectId]` uniqueness
/// prevents double-adds.
///
/// `workspaceId` is denormalized from the project — the SAME pattern
/// `work_item` / `work_item_link` / `workflow_status` use — so the RLS gate is a
/// direct `workspace_id = app.workspace_id` comparison with no join (every
/// membership read/write happens inside an active workspace context). It is kept
/// honest by the FK chain: the project and its memberships share one workspace.
/// All three FKs cascade — deleting the user, project, or workspace removes the
/// row (a membership is meaningless without all three).
/// A VISITOR RECORD (Story MOTIR-6170 · MOTIR-6665; `docs/decisions/visitor-sign-in-and-records.md`)
/// — one per (person, public project), written when a signed-in person who cannot
/// enter the project presses Continue on its consent screen. The project's Managers
/// read it (name + email); the person reads their own in their data export. It
/// belongs to both, so it cascades with either. The workspace is reached THROUGH
/// the project; nothing reads visitor records by workspace.
model ProjectVisitor {
  id           String   @id @default(cuid())
  projectId    String   @map("project_id")
  userId       String   @map("user_id")
  /// When the person pressed Continue — the consent the record exists under.
  consentedAt  DateTime @map("consented_at") @db.Timestamptz(3)
  /// Their first read as a Visitor; set to `consentedAt` on create and never moved.
  firstVisitAt DateTime @map("first_visit_at") @db.Timestamptz(3)
  /// Touched by each Visitor read; only ever moves forward.
  lastVisitAt  DateTime @map("last_visit_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId, lastVisitAt])
  @@index([userId])
  @@map("project_visitor")
}

model ProjectMembership {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  projectId   String   @map("project_id")
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([workspaceId])
  @@index([projectId])
  @@index([userId])
  @@map("project_membership")
}

/// Where a user dragged each node on a project's planning canvas (Subtask 7.3.77
/// / MOTIR-1237). One row per (user × project × node); the canvas restores the
/// user's arrangement on load and upserts on drag. PRIVATE per-user data (like
/// the appearance / notification preferences — no RLS): the project is resolved
/// server-side via getActiveProject (the user's own workspace) and every query is
/// scoped `where userId AND projectId`. `nodeKey` is the consumer's stable id for
/// a node (a work-item id or a pre-plan station key) — opaque to this layer.
model CanvasNodePosition {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  projectId String   @map("project_id")
  nodeKey   String   @map("node_key")
  x         Float
  y         Float
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId, nodeKey])
  @@index([userId, projectId])
  @@index([projectId])
  @@map("canvas_node_position")
}

/// A retired project key (Story 6.8) — when a project's `identifier` changes
/// (PROD → NIF), the OLD key is recorded here so it keeps resolving forever
/// (old issue links 308-redirect, REST calls on the old key still serve) and
/// stays RESERVED against other projects in the workspace (the verified Jira
/// "Editing a project key" + "Previous project keys" behaviour). The
/// `@@unique([workspaceId, identifier])` reserves the key workspace-wide — the
/// SAME uniqueness shape `project.identifier` carries — so a rename's collision
/// guard checks live identifiers AND aliases against one namespace. Reclaiming
/// a project's OWN previous key DELETEs its alias row (the verified revert
/// path); releasing an alias (the "Previous project keys" remove) deletes it
/// too, un-reserving the key and breaking its old links.
///
/// `workspaceId` is denormalized from the project — the SAME pattern
/// `project_membership` / `work_item` use — so the RLS gate is a direct
/// `workspace_id = app.workspace_id` comparison with no join. Both FKs cascade:
/// deleting the project FREES its keys (the verified mirror rule — only
/// deletion un-reserves), and deleting the workspace takes the rows with it.
model ProjectKeyAlias {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  projectId   String   @map("project_id")
  identifier  String
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, identifier])
  @@index([projectId])
  @@map("project_key_alias")
}

/// The org-scoped role a user holds in an `Organization` (Story 6.10), DISTINCT
/// from the workspace role (`WorkspaceRole`) and sitting ABOVE it:
///   - `owner`  — the org founder; administers every workspace under the org,
///                org settings + membership, and (later) billing.
///   - `admin`  — administers every workspace under the org + org settings/
///                membership; mirrors Atlassian org-admin / Linear Owner.
///   - `member` — org-tier presence only; no cross-workspace admin — falls back
///                to its per-workspace `WorkspaceRole` for in-workspace actions.
/// The role-precedence composition + the access gate that reads this land in
/// 6.10.4. Closed + stable set → a Postgres enum, the same shape as
/// `WorkspaceRole`.
enum OrganizationRole {
  owner
  admin
  member

  @@map("organization_role")
}

/// A person's ONE role in a workspace (Story MOTIR-6168 · `role-model.md` §2).
/// A workspace custom role is held at the `member` tier plus a pointer
/// (`WorkspaceMembership.roleDefinitionId`), so it needs no value of its own.
enum WorkspaceRole {
  manager
  member
  viewer

  @@map("workspace_role")
}

/// Why the move to workspace roles chose a person's role by anything other than
/// the plain mapping (MOTIR-6457). `mapped_narrower` is written by the never-wider
/// check (MOTIR-6461); every other value by the mapping (MOTIR-6458).
enum RoleMigrationReason {
  narrowest_kept
  project_role_dropped
  custom_role_recreated
  custom_role_merged
  mapped_narrower
  org_admin_granted
  /// Written by the access migration (Story MOTIR-6169 · MOTIR-6542): a person a
  /// `limited` project admitted who no longer enters it, because it became
  /// Members only and they were not added.
  project_access_lost

  @@map("role_migration_reason")
}

/// A project's ACCESS MODE (`project.accessMode`, Story MOTIR-6169 · MOTIR-6541)
/// — who may ENTER it (`docs/decisions/role-model.md` Q1, *Project access
/// modes*): `workspace` = every Full-scope workspace member plus the people
/// added; `members` = only the people added; `public` = as `workspace`, plus
/// anyone with the link (the Visitor, MOTIR-6170). Managers enter every mode.
/// What a person may DO once inside is their workspace role, never the mode.
enum ProjectAccessMode {
  workspace
  members
  public

  @@map("project_access_mode")
}

/// A workspace membership's ACCESS SCOPE (`workspaceMembership.accessScope`,
/// Story MOTIR-6169 · MOTIR-6541, `role-model.md` Q1 *Membership scopes*):
/// `full` enters every project open to the workspace, plus any Members-only
/// project the person was added to; `limited` enters ONLY the projects they were
/// added to — the contractor case.
enum WorkspaceAccessScope {
  full
  limited

  @@map("workspace_access_scope")
}

/// How a project's pull requests are merged (`docs/decisions/approval-gates.md`
/// §7). `manual` — a person approves a GREEN pull request before it merges;
/// `auto` — Motir merges a green pull request with no gate. A red pull request is
/// never a merge candidate in either mode. Renamed in place from the
/// `subtask_pr_merge_mode` type, because a pull request is no longer a subtask's.
/// The reserved `review_on_fail` value was RETIRED (MOTIR-4880, 2026-09-13): no
/// meaning survives the rule that only a green pull request is merged, and adding
/// an enum value later is a cheap `ADD VALUE` while removing one is not.
enum PrMergeMode {
  auto
  manual

  @@map("pr_merge_mode")
}

/// WHAT AUTHORISED a merge Motir performed (Story MOTIR-4882 · MOTIR-5520;
/// `approval-gates.md` §4 second amendment, decision 9, and §7a). `gate` — a person
/// approved a `pull_request_merge` gate; `auto_mode` — the project's `prMergeMode` is
/// `auto`, and NO person was in the loop. A merge somebody made on the host carries
/// neither, which is the honest answer rather than a gap.
/// A GitHub REVIEW's state, as the `pull_request_review` payload reports it
/// (Story MOTIR-4910 · MOTIR-5594; ADR §8 FOURTH AMENDMENT, decision 2).
///
/// All four are stored, including the two that never decide anything: the
/// Development block draws a review that does NOT count (an approval at an
/// earlier commit, a dismissed one), and a row it never wrote cannot be drawn.
/// Counting is a property of the (state, commit, dismissal, permission) TUPLE
/// read at evaluation time, never of this column alone.
enum GithubReviewState {
  approved
  changes_requested
  /// A comment-only review. Recorded, and it never counts (decision 2).
  commented
  /// Withdrawn on the host. A row that reaches this NEVER leaves it, so an
  /// out-of-order redelivery cannot resurrect a dismissed review.
  dismissed

  @@map("github_review_state")
}

/// A reviewer's permission ON THE REPOSITORY when their review arrived (Story
/// MOTIR-4910 · MOTIR-5594; ADR §8 FOURTH AMENDMENT, decision 2) — GitHub's own
/// `permission` vocabulary, captured rather than re-read, because the question
/// an audit asks is whether they could write AT THE TIME.
///
/// ⚠️ `unknown` MEANS IT COULD NOT BE READ, and it is not a synonym for `none`.
/// A review whose permission is unknown counts for NOTHING — the decision is
/// safe in that direction, because a person can still approve in Motir — but it
/// must stay distinguishable from a reviewer Motir positively knows has no
/// access.
enum GithubRepositoryPermission {
  admin
  maintain
  write
  triage
  read
  none
  unknown

  @@map("github_repository_permission")
}

/// What the head of a decision card's pull request carries under
/// `docs/decisions/` (MOTIR-5674; `approval-gates.md` §8's FIFTH AMENDMENT,
/// clauses 3 and 7). Anything but `one` raises a decision gate that cannot be
/// approved and holds the merge.
enum DecisionDocOutcome {
  /// Exactly one `docs/decisions/*.md` file added or modified.
  one
  /// None.
  none
  /// Two or more.
  several
  /// The host could not say — a failed read, a truncated file list, or a
  /// provider this build cannot list files on.
  unreadable

  @@map("decision_doc_outcome")
}

enum MergeAuthority {
  gate
  auto_mode

  @@map("merge_authority")
}

/// What a merge-queue removal MEANS for the cards the pull request delivers
/// (Story MOTIR-5461 · MOTIR-5632; `docs/decisions/approval-gates.md` §4 THIRD
/// AMENDMENT, decision 2). A `landed` removal is never recorded — the merge webhook
/// owns it — so it is not a member here.
enum QueueExitDisposition {
  /// The queue could not land it as it stands: every delivered card moves to
  /// `implemented`.
  failure
  /// Taken out without a verdict on the work (a manual removal, a cleared queue,
  /// an unrecognised reason): no card moves.
  neutral

  @@map("queue_exit_disposition")
}

/// Which value is THE planning estimate a project's surfaces display + the
/// roll-ups sum (`project.estimationStatistic`, Story 4.3) — the three Jira
/// estimation statistics: `story_points` (the agile `work_item.storyPoints`
/// field, the default), `time_estimate` (the existing `work_item.estimateMinutes`
/// field), `issue_count` (a plain `COUNT(*)`). All three values exist now so a
/// later story adds no enum ALTER. Closed + stable, so a Postgres enum.
enum EstimationStatistic {
  story_points
  time_estimate
  issue_count

  @@map("estimation_statistic")
}

/// The suggested-value deck a project's estimate picker offers
/// (`project.pointScale`, Story 4.3): `fibonacci` (the planning-poker default),
/// `linear`, or `custom` (the project-defined `project.customScaleValues` list).
/// The deck does not hard-constrain entry — story points stay a free numeric
/// value. Closed + stable, so a Postgres enum.
enum PointScale {
  fibonacci
  linear
  custom

  @@map("point_scale")
}

/// The unit of tracked work in Motir's PM core (Story 1.4). Every epic,
/// story, task, bug, and subtask a team plans is a row here. Self-referencing
/// tree via `parentId`, with the kind-parent matrix, the 4-level depth limit,
/// and cycle prevention all enforced at the DB layer by PL/pgSQL triggers
/// (see prisma/sql/work_item_triggers.sql, applied in the add_work_items
/// migration). Those triggers — NOT a Prisma-level check — are the source of
/// truth for structural integrity; the repository translates their SQLSTATE
/// 23514 message markers into typed errors at its edge.
///
/// Two distinct user-visible content axes, both Markdown source rendered as
/// GFM (see lib/markdown/render.tsx):
///   - descriptionMd  — "what to do" (the actionable spec).
///   - explanationMd  — "why this matters" (the context a non-technical
///                       reviewer needs). Mostly AI-drafted in steady state,
///                       but the column is just text + a provenance enum; the
///                       closed-source AI logic lives in motir-ai. The
///                       GPL boundary stays clean — this table can't tell an
///                       AI-drafted value from a hand-typed one except via
///                       `explanationSource`.
///
/// `key` is the per-project monotonic number allocated via
/// projectRepository.allocateWorkItemNumber (Story 1.3.1); `identifier`
/// ("PROD-42") is the denormalized `project.identifier + "-" + key` kept on
/// the row for index/search efficiency. `position` is a fractional index
/// (lib/workItems/positioning.ts) so reorders are O(1) writes. Soft-delete
/// only via `archivedAt` — work-item history must survive (the Project
/// pattern). RLS on this table lands in Subtask 1.4.5, not here.
model WorkItem {
  id                      String                        @id @default(cuid())
  workspaceId             String
  projectId               String
  parentId                String?
  // The FOLDER this item is filed in (Epic MOTIR-5307 · MOTIR-5312), or NULL.
  // A placement of its OWN, never a second meaning of `parentId`: a filed item
  // keeps `parentId IS NULL`, so every walk over `parentId` (readiness, status
  // derivation, the ready cascade, the roadmap root) reads it as the root it is.
  // The CHECK `work_item_parent_xor_folder` refuses both at once, and the
  // `trg_work_item_cotenancy_folder` trigger keeps the folder in this item's
  // own project. See prisma/migrations/20260913090000_folder.
  folderId                String?
  kind                    WorkItemKind
  key                     Int
  identifier              String // "PROD-42" — denormalized from project.identifier + key for search/index efficiency
  title                   String
  descriptionMd           String?                       @db.Text // "what to do" — Markdown source
  explanationMd           String?                       @db.Text // "why this matters" — distinct from description; mostly AI-drafted, user-owned
  /// The language each work content field was WRITTEN in (Story MOTIR-7731 ·
  /// MOTIR-8092) — one of the eleven codes in `lib/i18n/locales.ts`, or NULL for
  /// "no language recorded" (every row written before the story, and imports).
  /// Deliberately no default: NULL must stay distinguishable from a real `en`.
  titleLanguage           String?                       @map("title_language")
  descriptionLanguage     String?                       @map("description_language")
  explanationLanguage     String?                       @map("explanation_language")
  explanationSource       WorkItemExplanationSource     @default(user_authored)
  status                  String                        @default("open")
  priority                WorkItemPriority              @default(medium)
  assigneeId              String?
  reporterId              String
  dueDate                 DateTime?
  estimateMinutes         Int?
  // Work-item TYPE + EXECUTOR (Story 2.7 · Subtask 2.7.3) — the nature of the
  // executable work (`code` / `design` / `decision` / …) and WHO does it
  // (`coding_agent` | `human`). Both NULLABLE and DISTINCT from `kind`: only
  // executable LEAVES (task / subtask / bug) carry a type — every epic/story
  // and every pre-2.7 legacy row is `null`. Leaf-only is a SEMANTIC rule the
  // service enforces (`workItemsService` rejects a type/executor on an
  // epic/story), NOT a DB constraint a single nullable column can express.
  // `executor` is seeded from the type→executor default map
  // (`lib/issues/executorDefaults.ts`) when a type is first chosen, and stays
  // overridable. The split exists for the Epic-7 AI dispatch layer (route by
  // `type` → prompt template; by `executor` → agent-dispatch vs human-assign);
  // see docs/decisions/work-item-type-taxonomy.md (the 2.7.2 ADR).
  type                    WorkItemType?
  executor                Executor?
  // How HARD the work is to REASON about (Story MOTIR-6016 · MOTIR-6096) — the
  // ambiguity, blast radius, concurrency / security sensitivity or novelty it
  // demands, which `storyPoints` / `estimateMinutes` (SIZE) do not capture: a
  // 1-point change to a lock ordering can be `high`. Three things about it:
  //   - LEAF-ONLY, enforced by the service exactly as `type` / `executor` are
  //     (`workItemsService` refuses a difficulty on an epic/story with
  //     `DIFFICULTY_NOT_ALLOWED_ON_KIND`), keyed on the same `isTypeableKind`.
  //   - NULLABLE with NO backfill: existing leaves have none, and nothing
  //     guesses one.
  //   - A CLOSED enum, unlike `subject` below: this is a fixed scale a model
  //     router reads, not a vocabulary that grows with a rule-pack file.
  difficulty              WorkItemDifficulty?
  // Work-item PROVENANCE (Story MOTIR-1685, docs/decisions/work-item-provenance.md)
  // — how the item was PLANNED and how it was IMPLEMENTED, each a
  // `source · harness · model` triple. Denormalized latest-authoritative columns
  // on the item (mirroring `explanationSource`), NOT a run-history table (that is
  // deferred to Epic 9). ALL SIX nullable + leaf-agnostic: provenance may be
  // unknown (pre-feature rows; items never executed) and is meaningful on any kind.
  // `source` is a closed enum; `harness`/`model` are OPEN free-text (tool + LLM
  // names are fast-moving — an enum would force a migration per new tool). camelCase
  // with no `@map`, matching this table's existing columns. See the ADR for the
  // per-seam stamping contract (manual/mcp/native planning; byok/manual/hosted impl).
  planningSource          WorkItemPlanningSource?
  planningHarness         String?
  planningModel           String?
  implementationSource    WorkItemImplementationSource?
  implementationHarness   String?
  implementationModel     String?
  // WHICH SUBJECT MATTER the planner composed this card's rule packs from (Story
  // MOTIR-5062 · MOTIR-5065) — the FOURTH selector coordinate, beside the three
  // planning columns above because it is the same KIND of fact: a record of how
  // this card came to be planned, not a property of the work. Read-only wherever
  // it appears; the rail draws it as the third `Provenance` group (MOTIR-5074).
  //
  // ⚠️ OPEN free-text, NOT an enum, and that is the story's central decision
  // rather than a shortcut. The member vocabulary IS the rule-pack file set —
  // a member exists iff `prompts/plan-rules/subject-<name>.md` exists in
  // motir-meta — so adding one is a pack file plus a regenerate. An enum here
  // would put a schema change, a migration and a platform deploy in front of
  // every new rule pack, which is exactly the cost the design exists to avoid.
  // This column therefore validates SHAPE (a bounded lowercase slug) and never
  // MEMBERSHIP: an unrecognised but well-formed member persists and is refused
  // one hop later, at motir-ai's resolver, which is the system that owns the
  // vocabulary. Same posture as `planningHarness` / `planningModel` directly
  // above, for the same reason stated there (fast-moving names, no migration
  // per member).
  subject                 String?
  // The agile STORY-POINT estimate (Story 4.3) — SEPARATE from the `estimateMinutes`
  // TIME estimate above; both columns coexist and the project's `estimationStatistic`
  // config picks which one is THE planning estimate the surfaces display + roll up.
  // `Decimal`, not `Float`: story points allow 0.5 increments (Jira-faithful) AND
  // roll up via `SUM`, and `Decimal` avoids floating-point drift in the roll-up sums
  // (a real-product correctness concern) at the small fixed `(6, 2)` precision.
  // NULL = unestimated (contributes 0 to a roll-up). camelCase with NO `@map`, matching
  // this table's existing columns (the same within-table-consistency call recorded for
  // `sprintId` / `backlogRank` — decision-authority rung 2 > the card's `@map` prose).
  storyPoints             Decimal?                      @db.Decimal(6, 2)
  position                String                        @db.Text
  // Agile association + backlog rank (Story 4.1). `sprintId` is the issue's
  // sprint (NULL = in the backlog); `onDelete: SetNull` so deleting/clearing a
  // sprint never deletes its issues (they fall back to the backlog). `backlogRank`
  // is the GLOBAL fractional-index ordering (the same opaque base-62 String the
  // `position` columns use, via lib/workItems/positioning.ts) that lets the
  // backlog (Story 4.2) and a sprint both be drag-reordered off one field —
  // SEPARATE from `position`, which orders the tree under a parent. Column names
  // stay camelCase to match this table's existing columns (the `board` table is
  // snake_case-mapped, but `work_item`'s 20 existing columns are not — within-table
  // consistency wins, decision-authority rung 2 > the card's `@map` prose).
  sprintId                String?
  backlogRank             String?                       @db.Text
  archivedAt              DateTime?
  // OBSOLESCENCE (Story MOTIR-6574 · MOTIR-6579) — whether the card is still true
  // of the code: `outdated` (its text no longer describes what the code does —
  // the capability lives on in another shape) or `deprecated` (the direction or
  // feature was retired or overturned on purpose — do not build on it), plus a
  // Markdown note saying what moved and why. Four things about it:
  //   - KIND-AGNOSTIC and STATUS-AGNOSTIC — unlike `difficulty` (leaf-only), like
  //     `triagedAt`: any kind in any status, a `done` epic or an archived card
  //     alike, may carry it. Marking FINISHED work is the field's purpose, so the
  //     service applies no kind predicate and no done/archived refusal to it.
  //   - NULLABLE with NO backfill: every existing row reads NULL (not marked).
  //   - A CLOSED enum because it is a fixed scale both planners branch on.
  //   - The SUPERSEDERS are a LINK KIND (`supersedes`, the sibling card), not a
  //     column here. MADR's `deprecated` / `superseded by` status is the reference.
  obsolescence            WorkItemObsolescence?
  obsolescenceNoteMd      String?                       @db.Text
  // Triage marker (Story 6.11 · Subtask 6.11.3, per docs/decisions/triage-model.md
  // §1). NON-NULL ⇔ the item lives in the triage inbox and has NOT graduated to
  // the planned tree; NULL ⇔ a normal, graduated (or never-triage) item. Set at
  // intake (6.11.4), cleared ONLY by accept/promote (6.11.5). A DEDICATED column
  // (not a reserved `status` value) keeps the triage gate ORTHOGONAL to the
  // workflow status, so a triage item carries a real status (`todo`, or
  // `cancelled` once declined/merged) the whole time — the exclusion predicate is
  // the single, total `triagedAt IS NULL`. `DateTime?` (not a boolean) gives the
  // queue read newest-first ordering + an age display for free.
  triagedAt               DateTime?
  // Snooze (6.11.5): a triage item drops out of the ACTIVE queue until this time
  // OR new activity, whichever first. Does NOT affect the normal-read exclusion —
  // a snoozed item is still `triagedAt`-marked, so still hidden from every tree /
  // board / list / ready / search read.
  snoozedUntil            DateTime?
  // Triage submitter (Story 6.11 · Subtask 6.11.4, the 2026-06-14 signed-in-only
  // revision). The human who SUBMITTED a triage item — ALWAYS a real account: a
  // workspace member (the in-app "report a bug / request a feature" widget) OR a
  // signed-in non-member (Story 6.12's public-project "Submit a request", granted
  // by `canSubmitToTriage`). DISTINCT from `reporterId`, which stays the non-null
  // tenant reporter (a workspace member): for an in-app member submit the two are
  // EQUAL; for a 6.12 non-member submit the reporter is the project's intake
  // member while THIS records the real (non-member) submitter. The inbox derives
  // "member vs public" from this + workspace membership — the original
  // captured-external `externalSubmitter{Name,Email}` columns were retired by
  // Subtask 6.11.10 (intake is signed-in only, so attribution is always a real
  // account; there is no anonymous portal). NULL on every non-triage item (and on a
  // never-attributed legacy triage row). `SetNull` (NOT `Restrict`): deleting the
  // submitter must never delete or block the work item — the `reporter`
  // (`Restrict`) is the durable owner; a departed submitter just loses
  // attribution.
  submittedByUserId       String?
  // Epic-level privacy on public projects (Story 6.14 · Subtask 6.14.3, per
  // docs/decisions/epic-privacy.md §1). When TRUE on an EPIC-kind item, the
  // epic's DESCENDANTS (stories / tasks / subtasks) and its aggregate TELLS
  // (child count / progress / point total) are hidden from a public/non-member
  // viewer — the epic ROW itself stays visible as a "this epic is not public"
  // placeholder. Meaningful ONLY for an epic on a `public` project; a no-op
  // everywhere else (a member is the only viewer on a non-public project, and
  // 6.12's cross-org read exception is what creates the "public/non-member
  // viewer" population at all). The epic-only rule is enforced at the WRITE
  // layer (`workItemsService`, 6.14.7) — not a DB CHECK, since "true only when
  // kind = 'epic'" is awkward and brittle across the kind enum (ADR §1). The
  // server-side exclusion predicate (6.14.4) threads "descends from a private
  // epic" into the 6.12.4 public projection across EVERY read path; this column
  // is the flag that predicate reads. A boolean, not an enum: the only state
  // the locked model needs is binary (hiding the row is a named non-goal), so a
  // boolean is the complete state space — migrating to an enum later is a
  // contained change if a third visibility mode is ever added (ADR §1).
  publicChildrenHidden    Boolean                       @default(false)
  // Integration branch (Story 7.8 · Subtask 7.8.11) — the session branch this
  // item's work currently sits on after a run integrated it (status moved to
  // `in_review` via `mark_integrated`). NON-NULL ⇔ the item is integrated-
  // awaiting-review: its work is mergeable so it UNBLOCKS dependents (the
  // integrated-dep readiness rule, keyed on THIS field, not the status key —
  // custom workflows can name review states anything, but the recorded branch
  // is the ground truth a dependent can build on). CLEARED back to NULL the
  // moment the item reaches a `done`-category status (the chokepoint is
  // `applyStatusTransition`; `complete_session` is the bulk close-out after the
  // human merges the session PR). Indexed for the `complete_session` lookup
  // (every item recorded on a branch) — a plain `String?` matching this table's
  // camelCase, no-`@map` columns.
  // ⚠️ KEPT — and deliberately NOT replaced by `work_item_delivery`. This is the
  // INTEGRATION LINEAGE: a PRE-pull-request fact, written by `mark_integrated`
  // before any pull request exists. A delivery row is a POST-pull-request fact —
  // `work_item_delivery.github_pull_request_id` is NOT NULL — so no such row
  // exists in the window this column is written and read in, and on the
  // scoped-run lane that window is the entire run. Outside it, the head ref a
  // delivery joins to is the BLOCKER'S OWN feature branch, and this column's
  // null-ness is what tells the two cases apart. So the readiness reads above
  // cannot be moved onto the delivery table; `work-item-delivery-links.md` Q2
  // once scheduled this column for removal and is amended.
  // See docs/decisions/session-branch-lineage.md.
  sessionBranch           String?
  // Per-item REPO ATTRIBUTION (Story 7.9 · MOTIR-1804, the rebuilt half of the
  // cancelled 7.7.3) — WHICH repo this item's work ships in, as the bare repo
  // NAME (`motir-core`), or NULL when the planner never pinned one. A Motir
  // project spans SEVERAL repos, so "one subtask = one repo = one PR" needs a
  // per-item answer the CLI can route on: `motir link add <repo> <path>` already
  // maps a repo NAME to a checkout path (packages/cli · linkConfig), and this is
  // the column that tells it WHICH name an item belongs to. The bare name (not
  // `owner/name`) is deliberate — it is exactly the key the CLI's `repos`
  // override map and its `<root>/<repoName>` checkout convention use, so the two
  // halves fit with zero translation. VALIDATED at the write layer against the
  // PROJECT's repository set (MOTIR-4955 — a workspace-connected repo the project
  // never linked is rejected); no DB constraint, since the domain lives in
  // another table and changes as rows are linked and unlinked. The DISPATCH
  // payload's `targetRepo` is this value RESOLVED (an unpinned item falls back to
  // the project's single established repo, and stays null otherwise) — the
  // column itself only ever holds an explicit pin. A plain `String?` matching
  // this table's camelCase, no-`@map` columns; unindexed (never a lookup key).
  // See docs/decisions/target-repo-attribution.md.
  targetRepo              String?
  // The full repository SET (Story MOTIR-2725 · MOTIR-2727, ADR
  // `docs/decisions/work-item-repository-set.md` §1) — EVERY repository this
  // item's work ships in, ordered, de-duplicated, **element 0 being the PRIMARY**
  // that `targetRepo` above mirrors and that dispatch resolves (§2). The pin
  // above could only ever name ONE repo, so a card that legitimately spans two —
  // a boundary contract's producer + mirror sides — had nowhere to record the
  // second, and the completion gate had no EXPECTED side to check a merge
  // against: `countOtherOpenByWorkItem` counts pull requests that EXIST, and a
  // repository whose PR was never opened writes no row, so the item completed on
  // half its work (MOTIR-2664). This column is that expected side.
  //
  // An ARRAY column and not a join table (ADR §1.1): measured on `origin/main`
  // the pin has no FK, no index and is never a query key — only a projected
  // value — so a join table would buy referential integrity against a domain
  // that is deliberately NOT referentially bound (a pin must survive its repo
  // being briefly disconnected), at the cost of a workspace-scoped table, its own
  // RLS policies and a join on the hottest read in the product. A scalar array
  // inherits `work_item`'s policies unchanged, which is most of why this shape is
  // cheap; it is also already this schema's idiom for an ordered scalar set
  // (`project.publicTags`, `api_token.scopes`, `code_audit.changedPaths`, …).
  //
  // `targetRepo` is NOT a second fact: it IS `targetRepos[0] ?? null`, maintained
  // by the same service write and never independently writable. It survives
  // because `/api/v1` publishes it and ADR `public-api-conventions.md` §8 forbids
  // removing, renaming or retyping a published field without a new major — so the
  // set is ADDITIVE on every exposed shape (§3).
  //
  // Validated element-by-element at the WRITE layer against the same
  // project-scoped domain one pin is validated against (`lib/workItems/
  // targetRepo.ts` · `lib/workItems/dispatchRepo.ts`); no DB constraint, for the
  // same reason the scalar has none. `@default([])` so a row written by any path
  // that predates the change gets the empty set rather than a null every reader
  // would have to special-case; an empty set and the old null pin are ONE state.
  // camelCase, no `@map`, matching this table's columns; unindexed (never a
  // lookup key — the completion gate reads it off a row it already has).
  //
  // ⚠️ §1.3's deferral of a role SET resolved by DECLINING it (MOTIR-2732 ·
  // MOTIR-3037 §A3): no node ever carries two roles, so there was never a role
  // list to widen. MOTIR-2978 — the card that deferral filed — became the
  // container ROLLUP instead, and the role column below is retired outright.
  targetRepos             String[]                      @default([])
  // ⚠️ `targetRepoRole` WAS HERE AND IS RETIRED (Story MOTIR-2732 · MOTIR-3040,
  // ADR `docs/decisions/work-item-repository-set.md` "Amendment 2026-08-18" §A3).
  // It was the PORTABLE stand-in for a pin: at generation the repositories do not
  // exist, so a NAME is stale or meaningless and only a role was stable. A row
  // REFERENCE is stable across both — the row exists before the repository does,
  // its id does not move when its name is edited, and it survives the rename on
  // the host — so the role's reason to exist was discharged, and MOTIR-1913's
  // resolution pass went with it. `PlanItemProposedFields.targetRepoRole` REMAINS:
  // a plan still pins by role before any row exists; it is resolved to a reference
  // at materialize instead of being copied onto the item.
  // CI / verification signal (Story 7.10 · Subtask 7.10.6 / MOTIR-894) — the
  // result of a linked PR's CI, flowed back from the `check_suite` / `check_run`
  // webhook so "did the dispatched work actually pass?" lives in Motir, not only
  // on GitHub. `"passing"` ⇔ the latest checks succeeded (the item is VERIFIED —
  // the Story-level "N of M verified" roll-up counts these); `"failing"` ⇔ a
  // terminal check failed (the item is visibly NOT-ready — the dispatched agent
  // sees it needs another pass WITHOUT leaving Motir).
  //
  // ⚠️ IT IS THE CARD'S AGGREGATE OVER ITS WHOLE DELIVERY SET, NOT ONE PULL
  // REQUEST'S VERDICT (Story MOTIR-5469 · MOTIR-5470). Folded over every pull
  // request that delivers the card — its delivery links, its mirrored rows and
  // its session branch — with precedence `failing` > `running` > `passing`:
  //   `failing`  ⇔ at least one delivering pull request has a terminal failure;
  //   `running`  ⇔ none is failing and at least one is still waiting on a verdict
  //               (`running` IS written now — it was terminal-only under
  //               MOTIR-894, which is why a card whose fix was already building
  //               kept reading `failing`);
  //   `passing`  ⇔ every member that can report has passed — which holds exactly
  //               when `everyDeliveryIsGreen` does, so a card reading `passing`
  //               is one CI has already promoted;
  //   `null`     ⇔ NO member has a verdict (no deliveries, or none has reported
  //               and none is expected to). Absence of CI is not a state.
  //
  // RECOMPUTED, never stamped, by `deliveryVerdict.recomputeWorkItemCiState` —
  // the one writer — from the CI feedback loop (both the terminal AND the pending
  // arm) and from all four link doors, under the card's row lock. Never a user
  // edit, and DISTINCT from `status` (the workflow lifecycle): a merged item can
  // still be `failing`. A plain `String?` matching this table's camelCase,
  // no-`@map` columns; not an enum (a third provider-neutral value would be a
  // contained change, and the roll-up filters on the literal `'passing'`, which
  // `running` deliberately does not match).
  ciState                 String?
  // WHY this card is STUCK UNTIL SOMETHING IS REPAIRED (Story MOTIR-6588 ·
  // MOTIR-6600) — the Workbench's To fix tab reads it, and so will the To fix
  // tag (MOTIR-6589). `null` means there is nothing to repair.
  //
  // ⚠️ IT IS `motir fix`'s ANSWER, STORED — never a second rule. The three
  // pull-request reasons are read THROUGH `workItemRepairService`'s own
  // predicate (`evaluateRepair`), so the tab never lists a card the command
  // would refuse and never misses one it would claim; `changes_requested` is a
  // reviewer's standing refusal on the card's approve-to-merge gate at the
  // members' CURRENT heads, which moves nothing and so needs a column to be seen.
  // Several can hold at once: the enum's ORDER is the priority, and the one to
  // repair first is stored.
  //
  // RECOMPUTED, never stamped, by `fixReasonService.recomputeWorkItemFixReason`
  // under the card's row lock — the `ciState` pattern — and backfilled once.
  // `null` off the `in_progress` status CATEGORY and on an archived card.
  fixReason               WorkItemFixReason?
  // What the row NAMES for that reason (`FixDetail`, `lib/dto/fixReason.ts`):
  // the failing check or queue reason, the base branch, the reviewer and the
  // first line of their note, which repair command applies, and how many of the
  // card's open pull requests are affected. Written with `fixReason`, `null`
  // exactly when it is.
  fixDetail               Json?
  // WHETHER a card waits To resume (Story MOTIR-7701 · MOTIR-7707) — a SIBLING
  // of `fixReason`, never a sixth value of it: To fix means a repair would claim
  // the card, and a run stopped at an approval gate is not broken. Set while the
  // LATEST run covering the card closed `gated`; `waiting_on_gate` until one of
  // its held gates is approved, then `ready_to_resume`. RECOMPUTED by
  // `resumeStateService.recomputeWorkItemResumeState`, never stamped; `null` off
  // the `in_progress` category, on an archived card, and once a newer run opens.
  resumeState             WorkItemResumeState?
  // The gated run the state is about — the To resume tab's ENTRY key, as To fix
  // groups by run (MOTIR-7589). Written with `resumeState`, `null` exactly when it
  // is; `SetNull` so a pruned run can never leave a dangling pointer.
  resumeRunId             String?                       @map("resume_run_id")
  resumeRun               DispatchRun?                  @relation("WorkItemResumeRun", fields: [resumeRunId], references: [id], onDelete: SetNull)
  // The EMBEDDING SWEEP's poison-item bookkeeping (Story MOTIR-8226 · MOTIR-8227):
  // the content hash of the document the provider REJECTED, and how many runs have
  // rejected it. Both NULL until a rejection is recorded. A work item with no
  // embedding row has nowhere else to keep an attempt count (the row exists only
  // once a vector does), and a per-run result is not durable. A changed title or
  // description is a different hash, so the count restarts without any cleanup;
  // a successful embed clears both. Written by raw SQL in the workspace context,
  // so neither bumps `updatedAt` nor emits a work-item event.
  embeddingFailedHash     String?                       @map("embedding_failed_hash")
  embeddingFailedAttempts Int?                          @map("embedding_failed_attempts")
  // WHEN this item finished (Story MOTIR-4777 · MOTIR-4780) — the moment it
  // ENTERED a `done`-CATEGORY status, cleared the moment it leaves one. The
  // Workbench's "Recently finished" tab is the first reader; it is also the
  // first honest input to cycle time and throughput, which nothing in this
  // schema could express before (there is no status-history table, and
  // `WorkflowTransition` models the workflow's ALLOWED edges, not a log).
  //
  // ⚠️ `updatedAt` IS NOT A SUBSTITUTE, and that is the whole reason this
  // column exists. It moves on ANY edit — a re-title, a label, a comment-driven
  // touch — so a "finished this week" list built on it lists work finished in
  // June that somebody renamed today. The two columns answer different
  // questions and only one of them is about completion.
  //
  // CATEGORY, never a status KEY. Statuses are project-defined open vocabulary
  // (`workflow_status` rows, not an enum), so "done" is resolved per project
  // through `workflowsService.getTerminalStatusKeysByProjects` — the same
  // resolver `workItemsService.isReady` and `homeService` already ask. A
  // hardcoded `'done' | 'cancelled'` pair would be a subset carrying a totality
  // certificate: exhaustive over the literal, silent about every status a
  // customer adds.
  //
  // Written at ONE seam — `workItemsService.applyStatusTransition`, inside the
  // same `$transaction` and under the same `lockById` as the status write, so
  // the stamp cannot drift from the status it describes and two racing
  // transitions cannot produce two stamps. `tests/rls/status-write-guard.test.ts`
  // is what keeps a future write path from reaching `work_item.status` around it.
  //
  // A `done → cancelled` hop does NOT re-stamp (both are done-category: the
  // item never left, so its completion moment did not move); a
  // `done → in_progress` hop CLEARS it, because a re-opened card has not
  // finished. camelCase with NO `@map`, matching this table's other 35 columns
  // — the same within-table-consistency call already recorded for `storyPoints`
  // and `sprintId` / `backlogRank` (decision-authority rung 2 > the card's
  // `@map` prose).
  completedAt             DateTime?
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt

  workspace                Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project                  Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent                   WorkItem?                 @relation("WorkItemParent", fields: [parentId], references: [id], onDelete: NoAction)
  children                 WorkItem[]                @relation("WorkItemParent")
  // NoAction, as `parent` is: a folder still holding filed items cannot be
  // deleted; the service files them up first, in the same transaction.
  folder                   Folder?                   @relation("WorkItemFolder", fields: [folderId], references: [id], onDelete: NoAction)
  assignee                 User?                     @relation("WorkItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter                 User                      @relation("WorkItemReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  // Triage submitter (Subtask 6.11.4) — the real human who submitted a triage
  // item (member or, via 6.12, a signed-in non-member). SetNull so a departed
  // submitter never deletes the work item (the reporter is the durable owner).
  submittedBy              User?                     @relation("WorkItemTriageSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  // The sprint side of the association. Modelled on BOTH sides (Sprint.workItems
  // back-relation) with the SetNull action the migration uses, so `migrate dev`
  // reports "No difference detected" — the FK-drift rule (bug-attachment-fk-migration-drift).
  sprint                   Sprint?                   @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  // At-completion sprint-report snapshot rows (bug-sprint-report-incomplete-
  // list-zero-after-carry-over). One row per sprint this issue was a member of
  // at the moment that sprint completed; Cascade so hard-deleting an issue
  // removes its frozen report rows with it (the FK is modelled here + on
  // SprintReportEntry to keep `migrate dev` drift-free).
  sprintReportEntries      SprintReportEntry[]
  // Back-relations for WorkItemLink (Subtask 1.4.3). Two named relations
  // because there are two distinct WorkItem↔WorkItemLink edges (from/to).
  // Cascading delete on both sides: removing an issue removes its links.
  linksFrom                WorkItemLink[]            @relation("LinksFrom")
  linksTo                  WorkItemLink[]            @relation("LinksTo")
  // Audit trail (Subtask 1.4.6). A work item accrues many revision rows; the
  // FK cascades so hard-deleting an issue removes its history with it.
  revisions                WorkItemRevision[]
  // Comment thread (Subtask 5.1.1). Comments die with the issue (Cascade) —
  // the rare hard-delete path; issues are soft-archived in practice.
  comments                 Comment[]
  // Issue attachments (Subtask 5.2.1). SetNull — NOT cascade: hard-deleting an
  // issue must leave the attachment rows behind (unlinked) so the orphan-GC
  // (5.2.7) can remove their blobs too; a cascade would strand the blobs.
  attachments              Attachment[]
  // Story-acceptance videos (Story MOTIR-1627 · MOTIR-1629) — evidence rows for
  // a STORY. Cascade with the story: deleting the story removes its evidence
  // rows (the underlying video Attachment is unlinked/GC-reclaimed separately).
  acceptanceEvidences      AcceptanceEvidence[]
  // Published design results (Story MOTIR-2664 · MOTIR-2666) — evidence rows
  // for THIS work item. Unlike acceptance evidence, which rolls a subtask key
  // UP to its parent story, a design result belongs to the card that produced
  // it (docs/decisions/design-result.md §3), so this relation hangs off every
  // leaf, not only stories. Cascade with the item.
  designEvidences          DesignEvidence[]
  /// How-to-test records, one current per repository (MOTIR-5328). Cascade.
  testInstructions         TestInstructions[]
  /// Approval gates hanging off this card (the per-card read).
  approvalGates            ApprovalGate[]
  /// Decision pages this work item published (Story MOTIR-5761). Cascade.
  decisionPagePublications DecisionPagePublication[]
  // The pages that link this work item (MOTIR-7571). Cascade.
  pageWorkItemLinks        PageWorkItemLink[]
  /// What each Revise on this design card did about an automatic hosted re-run
  /// (MOTIR-700) — the "re-running" / "skipped" line.
  designAutoReruns         DesignAutoRerun[]
  /// The gated runs held by a gate on this card (MOTIR-7703).
  heldRunGates             DispatchRunHeldGate[]
  // Organisation joins + watchers (Subtask 5.4.1). All three cascade with
  // the issue: label/component joins are pure association rows, watcher rows
  // are notification substrate.
  labels                   WorkItemLabel[]
  components               WorkItemComponent[]
  watchers                 Watcher[]
  // Custom-field values (Story 5.3). One row per (issue, field) pair; the FK
  // cascades so deleting an issue takes its custom values with it.
  customFieldValues        CustomFieldValue[]
  // Automation execution audit rows that name this issue as the trigger
  // (Story 6.6). SetNull, not Cascade: the audit log outlives the work item
  // (the rule's history is kept; the deleted item renders a tombstone), so the
  // FK nulls rather than deleting the execution row.
  automationExecutions     AutomationRuleExecution[]
  // In-app notifications that deep-link to this issue (Story 5.7 · Subtask
  // 5.7.2). Cascade — a hard-deleted issue takes its notification rows with
  // it (the deep-link target would 404 otherwise), the comments pattern. The
  // FK is nullable on the notification side (non-item notifications stay
  // modellable), so this back-relation lists only the rows that name the issue.
  notifications            Notification[]
  // Public-request upvotes (Story 6.12 · Subtask 6.12.3). A public request IS a
  // triage `work_item`; cross-org accounts upvote it (the demand signal the
  // 6.11.3 queue sorts by, wired in 6.12.6). Cascade — votes die with the item
  // (the comments / notifications pattern). Modelled on both sides per the
  // FK-`@relation` rule.
  publicRequestVotes       PublicRequestVote[]
  // Plan proposals targeting this work item (Story 7.21): a `modify`/`remove`
  // points at the live row; SetNull on the FK so archiving the target leaves the
  // PlanItem (history) intact. Modelled both sides per the FK-`@relation` rule.
  planItems                PlanItem[]                @relation("PlanItemWorkItem")
  // GitHub pull requests linked to this work item (Story 7.10 · MOTIR-891) — the
  // PR→work-item link the status sync (MOTIR-892) + CI loop (MOTIR-894) drive.
  // SetNull on delete (PR history survives). Modelled both sides per the
  // FK-`@relation` rule.
  // Import idempotency map rows pointing at this work item (Story 7.16 ·
  // MOTIR-939): the `(project, source, externalId) → workItem` mapping a re-run
  // resolves through. CASCADE on delete — if the work item is deleted its
  // mapping row goes too, so a re-import re-creates it. Modelled both sides per
  // the FK-`@relation` rule.
  importedIssues           ImportedIssue[]
  // The semantic-search SIDECAR (Story MOTIR-2694 · MOTIR-2696, per
  // docs/decisions/plan-tree-embeddings.md §4) — at most ONE row per item,
  // holding the vector derived from this item's title + description. Cascade:
  // the derivation dies with the row it describes. A MISSING row is the honest
  // representation of "not a candidate yet" — see WorkItemEmbedding's header.
  embedding                WorkItemEmbedding?
  // The planning-target LEASE (Story MOTIR-2786 · MOTIR-2787) — at most ONE, the
  // exclusion that stops two planning sessions expanding the same item. Cascade:
  // a deleted item cannot be held. Modelled both sides per the FK-`@relation`
  // rule so `migrate dev` reports no drift.
  planTargetLock           PlanTargetLock?
  // WHERE this item's work ships, as REFERENCES to the project's repository rows
  // (Story MOTIR-2732 · MOTIR-3039, ADR `docs/decisions/work-item-repository-set.md`
  // "Amendment 2026-08-18"). Ordered by `WorkItemRepo.position`; position 0 is the
  // PRIMARY the dispatch routes to. This REPLACES the `targetRepos` name array as
  // the authored state — see that column's own note and the amendment's §A7 for
  // the expand -> contract sequence the columns retire through. Cascade: a deleted
  // item's references are not a fact about anything. Modelled both sides per the
  // FK-`@relation` rule.
  repositories             WorkItemRepo[]
  deliveries               WorkItemDelivery[]
  // The CI feedback comment this card carries per (change request, head commit)
  // — MOTIR-3770. Cascade: a deleted card's feedback rows are not a fact.
  ciFeedbackComments       GithubCiFeedbackComment[]
  // The card's own TO-DO LIST (Story MOTIR-3808 · MOTIR-3813) — the ordered
  // steps of its work, each one operation. Cascade with the card, exactly as
  // `comments` does: a deleted card's steps are not a fact about anything.
  todos                    WorkItemTodo[]
  /// Kept translations of this card's fields (Story MOTIR-7735 · MOTIR-8114).
  /// Cascade: a deleted card's translations are not a fact about anything.
  translations             WorkItemTranslation[]
  /// The LEGS naming this card across every run that worked it (Story
  /// MOTIR-1789). `SetNull` on the leg, not cascade: a run's history outlives a
  /// deleted card, and the leg still says which key it was.
  dispatchRunCards         DispatchRunCard[]
  /// Runs that were pointed AT this card as their scope. Also `SetNull`.
  dispatchRunScopes        DispatchRun[]             @relation("DispatchRunScope")

  // The monitor issues this bug was filed for (MOTIR-4929 · MOTIR-5576). MANY
  // issues may point at one work item (MOTIR-4932's manual link), one issue at
  // most one. SetNull on the child: a deleted bug leaves the issue row with a
  // null pointer, which is how the reconciler tells "deleted" from "never filed".
  monitorIssues   MonitorIssue[]
  /// RETIRED with `SharpenSession.workItemId` (MOTIR-9314) — `@ignore`d until its
  /// column is dropped.
  sharpenSessions SharpenSession[] @ignore

  @@unique([projectId, key])
  @@unique([projectId, identifier])
  @@index([projectId, parentId, position])
  // A folder's level of filed work items, in order — the twin of the index above.
  @@index([projectId, folderId, position])
  @@index([projectId, status])
  @@index([projectId, assigneeId])
  @@index([workspaceId])
  // Serves BOTH the backlog read (`sprintId IS NULL`, `backlogRank` order) and a
  // sprint's ranked issues (`sprintId = ?`, `backlogRank` order) off one composite.
  @@index([projectId, sprintId, backlogRank])
  // Triage queue read + the read-exclusion predicate (Subtask 6.11.3): the queue
  // read (`triagedAt IS NOT NULL`, newest-first) and every normal read's
  // `triagedAt IS NULL` exclusion both ride this composite. (The ADR notes a
  // PARTIAL index `WHERE triagedAt IS NOT NULL` would be tighter, but Prisma can't
  // express a partial index without `migrate dev` re-proposing a DROP every run —
  // the migrate-dev-no-drift contract, CLAUDE.md, outranks that preference; the
  // triage staging set is small, so a plain composite stays cheap.)
  @@index([projectId, triagedAt])
  // Epic-privacy predicate support (Subtask 6.14.3, per docs/decisions/epic-privacy.md
  // §6.1): the exclusion resolves a project's private-epic id set with
  // `SELECT id FROM work_item WHERE projectId = ? AND kind = 'epic' AND
  // publicChildrenHidden = true`, then drops descendants of that set from every
  // public read. This composite keeps that lookup an indexable `where`, never a
  // load-all-then-filter-in-app (finding #57). (The ADR notes a PARTIAL index
  // `WHERE publicChildrenHidden` would be tighter, but — exactly like the triage
  // composite above — Prisma can't express a partial index without `migrate dev`
  // re-proposing a DROP every run; the migrate-dev-no-drift contract, CLAUDE.md,
  // outranks that preference, and the private-epic set is tiny so a plain
  // composite stays cheap.)
  @@index([projectId, publicChildrenHidden])
  // The `complete_session` bulk close-out (Subtask 7.8.11) reads every item
  // recorded on a given session branch (`sessionBranch = ?`); this index keeps
  // that an indexable lookup. `sessionBranch` is highly selective (a branch
  // names a handful of items) and the column is NULL on the vast majority of
  // rows, so a plain single-column index stays small.
  @@index([sessionBranch])
  // The FINISHED-WINDOW read (Story MOTIR-4777 · MOTIR-4780 · MOTIR-4781) — the
  // Workbench's "Recently finished" tab asks one project for the rows whose
  // `completedAt` falls inside a rolling window, ordered `completedAt DESC`.
  // This composite serves the range predicate AND the sort off one index, which
  // is what keeps the tab from degenerating into a scan of every finished row
  // the project has ever had. Leading with `projectId` matches the surface's
  // ACTIVE-PROJECT scope (`docs/decisions/home-scope.md`) and the shape of every
  // other composite on this table. `completedAt` is NULL on the overwhelming
  // majority of rows, which keeps the index small.
  @@index([projectId, completedAt])
  // The TO FIX read (Story MOTIR-6588 · MOTIR-6600) — the Workbench tab asks the
  // ACTIVE project for its `fixReason IS NOT NULL` rows, and the tab count asks the
  // same. Leading with `projectId` for the reason the finished-window composite
  // above does (the surface is project-scoped, `docs/decisions/home-scope.md`);
  // `fixReason` is NULL on nearly every row, so the non-null range is a handful of
  // entries and the membership predicate filters those rather than the project.
  @@index([projectId, fixReason])
  // The TO RESUME read (Story MOTIR-7701 · MOTIR-7707) — the same shape as To fix's.
  @@index([projectId, resumeState])
  @@index([resumeRunId])
  // pg_trgm GIN over the free-text contains-match columns (Story 6.1 · 6.1.1,
  // finding #57): the filter builder's `text contains` compiles to ILIKE over
  // title + description, which must not table-scan at 10k issues. A multicolumn
  // GIN serves predicates on either column. The pg_trgm EXTENSION itself is
  // created by the migration SQL (Prisma doesn't model extensions here).
  @@index([title(ops: raw("gin_trgm_ops")), descriptionMd(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("work_item")
}

/// The plan-tree SEMANTIC-SEARCH sidecar (Story MOTIR-2694 · Subtask
/// MOTIR-2696, per `docs/decisions/plan-tree-embeddings.md` §4) — one row per
/// work item, holding the embedding of that item's `title` + `descriptionMd`
/// so GATE 1's "does work like this already exist?" can be answered by MEANING
/// rather than by the 6.1.1 substring `contains` predicate.
///
/// A SIDECAR, not four columns on `work_item`, for three reasons the ADR
/// argues in full: `model` / `dimensions` / `contentHash` / `embeddedAt`
/// describe a DERIVATION rather than the card, and they do not belong on the
/// widest, hottest table in the schema; **absence is the semantics** — "this
/// item has no embedding yet" is most honestly a MISSING ROW, not five
/// nullable columns that must agree with each other; and the write cadences
/// differ (a background job writes this minutes after the item, on a different
/// trigger, and must never appear to modify the row a user is editing).
///
/// ⚠️ `embedding` is `Unsupported("vector(1536)")` — the typed Prisma client
/// can neither read, write nor order by it, exactly as in `motir-ai`'s
/// `Lesson`. So the WHOLE row is written by `workItemEmbeddingRepository`'s
/// `$executeRaw` upsert (row and vector land in ONE statement, so a row without
/// a vector is never created) and ranked by a `$queryRaw` `<=>`, with the
/// vector bound as a parameter and cast — NEVER string-concatenated. It is
/// nullable here for the same reason it is in `motir-ai`: Prisma cannot create
/// a required Unsupported column, and the mirror keeps `migrate diff` quiet.
/// The ranking read still guards `embedding IS NOT NULL`, belt and braces.
///
/// `vector(1536)` is the literal `motir-ai` uses, for the same reason: it is
/// the dimension `motir-ai`'s `docs/decisions/embedding-provider.md` pinned for
/// EVERY semantic store, so a vector produced by either service is comparable.
/// `dimensions` records it per row so a future re-dimension is a visible,
/// rolling backfill rather than a silent mismatch.
///
/// Tenancy (ADR §5): `workspaceId` is NOT NULL and the RLS policy ships in the
/// SAME migration — the no-unguarded-window rule; `projectId` is the search
/// filter, resolved server-side from the caller's token, never from a body.
/// Both FKs cascade (the vector is derived data, so it dies with either
/// parent) and both are modelled as `@relation`s on BOTH sides, per the
/// FK-`@relation` no-drift rule.
model WorkItemEmbedding {
  /// PK *and* FK — one embedding per work item, by construction.
  workItemId  String @id @map("work_item_id")
  workspaceId String @map("workspace_id")
  projectId   String @map("project_id")
  /// The model that produced this vector (e.g. `text-embedding-3-small`), as
  /// REPORTED by motir-ai's `POST /v1/embeddings` — not a local constant, so an
  /// `EMBEDDING_MODEL` override on the other side is recorded rather than
  /// assumed. ADR §6.1 makes it a HARD ranking filter: rows embedded with a
  /// different model are not comparable and are excluded, which turns a model
  /// swap into a visible, rolling backfill instead of a silent collapse in
  /// result quality.
  model       String
  /// The vector's length, asserted against the column type at write time.
  dimensions  Int
  /// SHA-256 of the §3 document (`title` + "\n\n" + `descriptionMd`, truncated
  /// to 8 000 chars). THE RE-EMBED TRIGGER: the embedding is re-derived exactly
  /// when this changes, so a status flip / re-parent / sprint move / assignee
  /// change costs nothing. It is also the job's idempotency guard — a re-run
  /// whose hash matches skips the provider call entirely.
  contentHash String @map("content_hash")

  /// When this vector was derived. `timestamptz` (ADR §4) — an instant, and the
  /// one column here that is compared across deployments.
  embeddedAt DateTime @map("embedded_at") @db.Timestamptz(3)

  embedding Unsupported("vector(1536)")?

  workItem  WorkItem  @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Tenant teardown + the workspace RLS predicate.
  @@index([workspaceId])
  /// The ranking pre-filter AND the coverage count, which both narrow on
  /// (project, model) before the `<=>` ordering — see the repository's
  /// under-return note for why that pre-filter needs its own index.
  @@index([projectId, model])
  /// ⚠️ THE ANN INDEX, DECLARED HERE ONLY SO THE DRIFT GATE CAN SEE IT. The real
  /// object is `CREATE INDEX … USING hnsw ("embedding" vector_cosine_ops)`, in
  /// the migration — Prisma's index types stop at Gin/Gist/Brin/SpGist/Hash and
  /// cannot express HNSW at all. Without this line the `build` job's
  /// `prisma migrate diff --from-schema … --to-config-datasource --exit-code`
  /// reports a permanent "[+] Added index on columns (embedding)", because the
  /// differ pairs a database index to a datamodel index BY COLUMN LIST and no
  /// datamodel index claimed this column. With it, the pair is complete and the
  /// only thing Prisma could still disagree about is the NAME — pinned by `map`
  /// to the literal the migration creates, so a future default-name change
  /// cannot silently re-open the drift (the partial-index lesson, MOTIR-1960).
  /// Nothing regenerates this as a btree: `migrate dev` diffs against a shadow
  /// database built from the committed migrations, where the hnsw index already
  /// holds the column list.
  @@index([embedding], map: "work_item_embedding_embedding_idx")
  @@map("work_item_embedding")
}

/// One upvote by one account on one public request (Story 6.12 · Subtask
/// 6.12.3). A public request IS a triage `work_item`; a signed-in account
/// (cross-org included) casts AT MOST ONE vote on it — the `@@unique` makes a
/// second upvote a no-op/toggle, never a double count (the demand signal the
/// 6.11.3 triage queue sorts by; the write + count land in 6.12.6). Both FKs
/// are modelled as `@relation` per the FK-`@relation` rule so `migrate dev`
/// reports no drift; both cascade (the vote is association substrate that dies
/// with either the request or the voter).
model PublicRequestVote {
  id         String   @id @default(cuid())
  workItemId String   @map("work_item_id")
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One vote per (request, account) — the server-enforced one-vote rule.
  @@unique([workItemId, userId])
  // The count read (votes for a request) + the toggle lookup both ride this.
  @@index([workItemId])
  @@map("public_request_vote")
}

/// A person following a PUBLIC project's changelog (Story 8.9 · Subtask 8.9.3 ·
/// `docs/decisions/public-follow-and-changelog.md` §1).
///
/// TWO of the three follower tiers are rows; the third is not. An ANONYMOUS
/// follower subscribes to the Atom feed in their own reader and Motir stores
/// nothing about them — there is deliberately no row for that tier. The two
/// stored tiers are:
///
///   * ACCOUNT — `user_id` set, `email` null. The Follow button's state.
///   * EMAIL-ONLY — `email` set, `user_id` null. A prospect who arrived from a
///     link and has no Motir account; the tier that exists because a public
///     project is a launch funnel and demanding a signup first inverts it.
///
/// EXACTLY ONE of the two is set, and that is a DATABASE invariant, not a
/// service convention: `public_follow_identity_exactly_one`
/// (`CHECK (("user_id" IS NULL) <> ("email" IS NULL))`) is in the migration.
/// An invariant one service enforces is an invariant a second service will one
/// day not enforce.
///
/// TENANCY. `workspace_id` is denormalized from the project — the same
/// denormalization `WorkItemLink` makes, for the same reason: every read starts
/// with a workspace gate and pulling it through the project at query time would
/// cost a join. It is what lets this table take the ORDINARY workspace RLS
/// policy, which matters more here than usual: a row in the email-only tier has
/// NO acting user, so the `public_request_vote` owner policy
/// (`user_id = app.user_id`) could never reach it, and the anonymous
/// public-project arm that would have covered it widens SELECT as well as
/// INSERT — making the whole follower list, addresses included, enumerable by
/// any unbound connection. There is therefore NO anonymous arm. Every write
/// runs inside `withWorkspaceServiceContext(project.workspaceId, …)`, which
/// binds `app.workspace_id` and nothing else, from a trusted project lookup.
/// (AMENDMENT 1 of the ADR records the correction and its reasoning.)
///
/// TOKENS. The CONFIRM token is random and stored HASHED, never in the clear —
/// it gates the email-only tier's double opt-in and expires in 24 hours.
///
/// There is deliberately NO unsubscribe-token column. That token is DERIVED
/// (an HMAC over this row's id, keyed by the app's signing secret —
/// `lib/publicProjects/followTokens.ts`, mirroring the shipped
/// `savedFilters/subscriptionToken.ts`), so it can be recomputed for a digest
/// sent years later and is valid forever. A stored random token would have to
/// be either kept in the clear or rotated per send, and rotating breaks exactly
/// the old-mail case an unsubscribe link exists for.
model PublicFollow {
  id          String @id @default(cuid())
  workspaceId String @map("workspace_id")
  projectId   String @map("project_id")

  /// Set on the ACCOUNT tier only; null on the email-only tier.
  userId String? @map("user_id")
  /// Set on the EMAIL-ONLY tier only; null on the account tier. Stored
  /// LOWERCASED — the unique index is on the stored form, so the service
  /// normalizes before it writes or looks up.
  email  String?

  /// Following is not subscribing: the digest is opt-IN and off by default on
  /// BOTH stored tiers (ADR §4).
  digestOptIn Boolean   @default(false) @map("digest_opt_in")
  /// Null until the email-only tier's confirmation link is followed. An account
  /// follow is confirmed at creation — `User.emailVerified` already verified the
  /// address, and re-verifying it is friction with no security content.
  confirmedAt DateTime? @map("confirmed_at")

  confirmTokenHash      String?   @map("confirm_token_hash")
  confirmTokenExpiresAt DateTime? @map("confirm_token_expires_at")

  /// The digest window's lower bound, per follower — so a follower who joins
  /// mid-week gets the next full week rather than a backfill, and a failed send
  /// does not silently skip a window.
  lastDigestAt DateTime? @map("last_digest_at")

  /// Language of the page an email-only follow was made from; NULL on account
  /// follows and on follows made before the column existed (MOTIR-8105). Plain
  /// text, validated on read by `isLocale`, so a new locale needs no migration.
  locale String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One follow per (project, account) and one per (project, address) — the
  // server-enforced follow-once rule, per tier. Postgres treats NULLs as
  // distinct in a unique index, so neither constrains the other tier's rows.
  @@unique([projectId, userId])
  @@unique([projectId, email])
  // The digest job's per-project sweep: "who on this project opted in?".
  @@index([projectId, digestOptIn])
  @@index([workspaceId])
  @@map("public_follow")
}

/// Many-to-many issue-to-issue relationships (Subtask 1.4.3). Models the four
/// link kinds Linear / Jira / GitHub all expose: `is_blocked_by` (dependency —
/// reading the AI planner's ready-set requires indexed traversal of this
/// table), `relates_to` (symmetric soft link), `duplicates`, `clones`.
///
/// Direction convention: the row reads "fromItem <kind> toItem" — so
/// `fromItem is_blocked_by toItem` means fromItem cannot start until toItem
/// is done. The `relates_to` reciprocal row (write A↔B → also persist B↔A) is
/// a SERVICE-layer concern (1.4.4); this repository writes one row per call.
///
/// `workspaceId` is denormalized from the fromItem for RLS speed: every link
/// query starts with a workspace gate, and pulling it from fromItem at query
/// time would require a join. The DB-layer trigger (see
/// prisma/sql/work_item_link_triggers.sql) keeps the denormalization honest —
/// it rejects any insert/update where fromItem.workspaceId ≠ toItem.workspaceId
/// (no cross-workspace links) or where NEW.workspaceId ≠ fromItem.workspaceId
/// (catches a service-layer bug that wrote the wrong workspaceId on the row).
///
/// Structural triggers (see work_item_link_triggers.sql):
///   - WI_LINK_CYCLE      — cycle prevention, scoped to `is_blocked_by` only.
///                          (relates_to is allowed to be reciprocal/cyclic by
///                           design — A relates_to B AND B relates_to A is the
///                           expected steady state for the symmetric kind.)
///   - WI_LINK_CROSS_WORKSPACE / WI_LINK_WORKSPACE_MISMATCH
///                        — workspaceId consistency (see above).
///   - WI_LINK_SELF       — fromId = toId rejected.
/// The repository translates these markers into the typed errors in
/// lib/workItems/linkErrors.ts at its edge (the 4-layer rule).
model WorkItemLink {
  id          String             @id @default(cuid())
  workspaceId String
  fromId      String
  toId        String
  kind        WorkItemLinkKind
  // Provenance (Subtask 5.8.3): `manual` for a link a user/agent created via the
  // link UI / MCP, `mention` for a `relates_to` edge auto-created because one
  // item's text/comment REFERENCED another (`[KEY](motir:<id>)` or a bare
  // `KEY-N`). The `relates_to` row IS the durable record of the reference — there
  // is deliberately no separate mention table; `source` is the only marker that
  // distinguishes an auto-related edge from a hand-made one. Additive with a
  // `manual` default so every pre-5.8.3 row reads as a manual link.
  source      WorkItemLinkSource @default(manual)
  createdById String
  createdAt   DateTime           @default(now())

  fromItem  WorkItem  @relation("LinksFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toItem    WorkItem  @relation("LinksTo", fields: [toId], references: [id], onDelete: Cascade)
  createdBy User      @relation("WorkItemLinkCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, kind])
  @@index([toId, kind])
  @@index([fromId, kind])
  @@index([workspaceId])
  @@map("work_item_link")
}

// Durable audit trail for work-item mutations (Subtask 1.4.6). Every
// create / update / archive / link / unlink the service performs writes ONE
// revision row inside the SAME transaction as the mutation it describes
// (workItemsService → workItemRevisionsService.recordRevision), so the
// history can never diverge from the data. Epic 5's activity feed reads it,
// Epic 6's reporting sums over it, Epic 7 diffs "what changed since the last
// planning pass" off it.
//
// `changeKind` is a plain `String`, NOT a Postgres enum, deliberately: future
// kinds ('linked', 'unlinked', 'restored', …) must not require a Postgres
// `ALTER TYPE` migration. The service is the validation boundary — it only
// ever writes the values the WorkItemRevisionDto union constrains
// ('created' | 'updated' | 'archived'); the mapper's `as` cast at the read
// edge is what makes the DB-text → DTO-union narrowing safe.
//
// `diff` is JSON: the field-diff shape ({ title: { from, to }, … }) for
// create/update/archive, and the link-diff shape ({ links: { added: [...] } })
// for link/unlink. It is intentionally untyped at the DB layer — the DTO
// pins the wire shape.
//
// `onDelete: Restrict` on `changedById` mirrors WorkItem.reporter (1.4.2):
// revisions preserve history even after a user soft-deletes, so hard-deleting
// a user who ever changed an issue requires explicit handling (a future
// user-archive Story) rather than silently shredding the audit trail.
// `workItemId` cascades — when an issue is hard-deleted its history goes with
// it (work items are soft-archived in practice, so this is the rare path).
//
// NOTE: there is no `workspaceId` column by design — denormalizing tenancy
// onto a revision row would let it lie about which workspace it belongs to.
// The RLS policy (see the add_work_item_revisions migration) joins to the
// parent work_item instead.
model WorkItemRevision {
  id          String   @id @default(cuid())
  workItemId  String
  changedById String
  changedAt   DateTime @default(now())
  changeKind  String // 'created' | 'updated' | 'archived' — String, not enum (see model note)
  diff        Json

  workItem  WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  changedBy User     @relation("WorkItemRevisionAuthor", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([workItemId, changedAt])
  @@index([workItemId])
  @@map("work_item_revision")
}

enum WorkItemLinkKind {
  is_blocked_by
  relates_to
  duplicates
  clones
  // `from` SUPERSEDES `to` (Story MOTIR-6574 · MOTIR-6580): `from` is the NEWER
  // work item, `to` the OLDER one it replaces. Directed, with NO reciprocal row
  // (the inverse `superseded_by` is read off the `to` end, the way `blocks` is
  // read off `is_blocked_by`). Descriptive only — it gates nothing: readiness,
  // the ready set and the cycle trigger read `is_blocked_by` alone. The MARK
  // itself lives on the older item's own `obsolescence` column; this edge says
  // WHICH item took over.
  supersedes

  @@map("work_item_link_kind")
}

// Where a work-item link came from (Subtask 5.8.3). `manual` — created through
// the link UI / MCP / create-modal links. `mention` — auto-created `relates_to`
// because a text field or comment referenced the other item. A Postgres enum
// (like WorkItemLinkKind) since the value set is closed and tenant-agnostic.
enum WorkItemLinkSource {
  manual
  mention

  @@map("work_item_link_source")
}

enum WorkItemKind {
  epic
  story
  task
  bug
  subtask

  @@map("work_item_kind")
}

enum WorkItemPriority {
  lowest
  low
  medium
  high
  highest

  @@map("work_item_priority")
}

enum WorkItemExplanationSource {
  user_authored
  ai_draft
  user_edited

  @@map("work_item_explanation_source")
}

/// How a work item was PLANNED (Story MOTIR-1685,
/// docs/decisions/work-item-provenance.md). A closed set — the AUTHOR CATEGORY,
/// mirroring `WorkItemExplanationSource`: `native` (materialized from a
/// motir-ai-generated plan), `mcp` (created through the Motir MCP agent tool
/// surface), `manual` (created by a human in the UI), `api` (created by an
/// external client over the public `/api/v1` REST surface — Story 11.2,
/// Subtask 11.2.5). The accompanying `harness`/`model` are open free-text
/// columns, not this enum. Extensible only by an explicit enum addition +
/// migration.
///
/// ⚠️ `api` is a PREREQUISITE of the v1 create endpoint, not a follow-up. Every
/// write surface stamps which surface made the row, and a row's origin cannot be
/// reconstructed after the fact: an API-created row left NULL would later be
/// CLASSIFIED by `lib/workItems/provenanceBackfill.ts` as `mcp` (its
/// post-seed-burst rule), permanently mislabelling it. Claiming `mcp` outright
/// would be the same lie told sooner.
enum WorkItemPlanningSource {
  native
  mcp
  manual
  api

  @@map("work_item_planning_source")
}

/// How a work item was IMPLEMENTED (Story MOTIR-1685,
/// docs/decisions/work-item-provenance.md). A closed set: `hosted` (the Motir
/// hosted agent — trusted, gateway-metered; Epic 9), `byok` (a bring-your-own-key
/// agent on the user's own machine — self-reported), `manual` (a human, no agent).
/// `hosted` is NOT reachable from the self-reported session tools; only Epic 9's
/// trusted seam stamps it. The accompanying `harness`/`model` are open free-text.
enum WorkItemImplementationSource {
  hosted
  byok
  manual

  @@map("work_item_implementation_source")
}

/// The NATURE of a piece of executable work (Story 2.7 · Subtask 2.7.3) —
/// DISTINCT from `WorkItemKind` (the structural hierarchy) and carried only on
/// executable leaves (task / subtask / bug). A FIXED ten-member enum, in this
/// canonical order, frozen by the 2.7.2 ADR
/// (docs/decisions/work-item-type-taxonomy.md): fixed (not free text) so Story
/// 7.6's per-type prompt generator is a TOTAL function over it (a `switch` with
/// no `default` hole) and the 2.7.6 filter facet is a closed set. Extensible
/// later ONLY by an explicit enum addition + migration, never by ad-hoc
/// strings. Each member's authoritative one-line gloss lives in the ADR.
enum WorkItemType {
  code
  design
  test
  content
  copy
  translate
  research
  review
  verification
  decision
  choice
  deploy
  manual
  legal
  chore

  @@map("work_item_type")
}

/// WHO executes a piece of work (Story 2.7 · Subtask 2.7.3). Nullable, set
/// alongside `type`: when a type is first chosen, `executor` is seeded from the
/// type→executor default map (`lib/issues/executorDefaults.ts`,
/// `defaultExecutorForType`) and stays overridable. The Epic-7 AI dispatch
/// layer routes on this — `coding_agent` → dispatch to a coding agent,
/// `human` → assign to a person.
enum Executor {
  coding_agent
  human

  @@map("executor")
}

/// How HARD a leaf is to REASON about (Story MOTIR-6016 · MOTIR-6096) — a
/// CLOSED four-step scale, `trivial` · `low` · `medium` · `high`, carried only on
/// executable leaves (task / subtask / bug) and nullable (unset). Closed rather
/// than free text because a model router reads it: extensible only by an
/// explicit enum addition + migration, and `lib/issues/difficulty.ts`'s
/// `WORK_ITEM_DIFFICULTIES` is asserted total against it at compile time.
enum WorkItemDifficulty {
  trivial
  low
  medium
  high

  @@map("work_item_difficulty")
}

/// Whether a work item is still TRUE OF THE CODE (Story MOTIR-6574 · MOTIR-6579)
/// — a CLOSED two-step scale, `outdated` · `deprecated`, settable on any kind in
/// any status and nullable (not marked). Closed because both planners branch on
/// its members: extensible only by an explicit enum addition + migration, and
/// `lib/issues/obsolescence.ts`'s `WORK_ITEM_OBSOLESCENCES` is asserted total
/// against it at compile time.
enum WorkItemObsolescence {
  outdated
  deprecated

  @@map("work_item_obsolescence")
}

/// WHY a card is stuck until something is repaired (Story MOTIR-6588 · MOTIR-6600)
/// — `WorkItem.fixReason`. DECLARATION ORDER IS PRIORITY: when several hold, the
/// first is the one to repair first and the one stored (`FIX_REASON_PRIORITY`,
/// `lib/workItems/fixReason.ts`, is asserted equal to this list).
///
/// `run_died` (Story MOTIR-6590 · MOTIR-6880) is FIRST: nothing else on a card can
/// be repaired until somebody owns its branch again. It was added with a hand-written
/// `ADD VALUE … BEFORE 'queue_failed'` — a generated `ADD VALUE` appends at the END,
/// which would have made it the LOWEST priority.
enum WorkItemFixReason {
  run_died
  queue_failed
  conflicted
  ci_failed
  changes_requested

  @@map("work_item_fix_reason")
}

/// WHERE a card waiting on a gated run stands (Story MOTIR-7701 · MOTIR-7707) —
/// `WorkItem.resumeState`. The *resuming* and *could not resume* sub-states are
/// NOT values: they are read from the per-decision resume record, so this column
/// stays a pure function of runs and gates.
enum WorkItemResumeState {
  waiting_on_gate
  ready_to_resume

  @@map("work_item_resume_state")
}

/// A per-project, customizable issue status (Story 2.2). Every project owns an
/// ordered set of these; `work_item.status` stores the `key` of one of them.
/// `category` is the durable Jira-style three-bucket taxonomy (todo /
/// in_progress / done) every later surface groups by — boards (Epic 3) draw a
/// column per status, reports (Epic 6) filter/group by category, and Story
/// 1.4's readiness predicate generalizes "terminal" from a hardcoded 'done'
/// string to `category = done` (finding #21).
///
/// Tenancy mirrors `work_item`: an explicit non-null `workspaceId` column +
/// `projectId` FK, with RLS (ENABLE + FORCE) gating on `app.workspace_id`.
/// There is NO system-admin escape hatch here (unlike `job_run`): these rows
/// are pure tenant data with a non-null workspaceId, always written under an
/// active workspace context (the 2.2.2 seed runs inside createProject's
/// withWorkspaceContext transaction) — exactly like `project`/`work_item`, so
/// the policy is their pure workspace gate. See the add_workflow_status_and_
/// transition_rls migration for the rationale.
///
/// `position` is a fractional index (the SAME `String`/`lib/workItems/
/// positioning.ts` shape `work_item.position` uses — opaque base-62 keys that
/// sort lexicographically), so a status reorder is a single-row write. (The
/// 2.2.1 card's "Decimal(20,10)" wording contradicts its own "same
/// fractional-indexing path the work-item ordering uses" clause; the shipped
/// ordering path is string-keyed, so `String @db.Text` is the consistent
/// shape — decision-authority rung 2 over rung 3.)
///
/// `color` is an OPTIONAL per-status hex override; null means "derive from the
/// category" (the Jira default, where category drives the swatch). `isInitial`
/// marks the one status new work items land in; a partial unique index
/// (`workflow_status_one_initial_per_project`, in the migration — Prisma can't
/// express a partial index in the DSL) enforces exactly one initial status per
/// project. Seeding the default rows is 2.2.2's job (application-layer, under
/// the request's workspace context — NOT a SQL INSERT in the migration).
model WorkflowStatus {
  id          String         @id @default(cuid())
  workspaceId String         @map("workspace_id")
  projectId   String         @map("project_id")
  key         String
  label       String
  category    StatusCategory
  color       String?
  position    String         @db.Text
  isInitial   Boolean        @default(false) @map("is_initial")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // A transition references two statuses (from / to); both edges cascade so
  // deleting a status removes the transitions that touch it.
  transitionsFrom     WorkflowTransition[] @relation("WorkflowTransitionFrom")
  transitionsTo       WorkflowTransition[] @relation("WorkflowTransitionTo")
  // Board columns this status is mapped into (Story 3.1). Cascades: deleting a
  // status removes its column mappings (a card whose status vanished can't sit
  // in a column keyed on it).
  boardColumnStatuses BoardColumnStatus[]

  // `key` is the machine-stable handle work_item.status stores; unique per
  // project. The partial "exactly one initial per project" unique index is
  // raw SQL in the migration (not expressible here).
  @@unique([projectId, key])
  @@index([workspaceId])
  @@index([projectId, position])
  @@map("workflow_status")
}

/// A legal status move within a project (Story 2.2). One row = one directed
/// edge `fromStatus → toStatus`. Consulted only when the project's
/// `workflowPolicyMode = restricted`; under `open` these rows are ignored at
/// validation time (but kept, so flipping back to `restricted` restores the
/// curated graph). The denormalized non-null `workspaceId` mirrors
/// `work_item_link` — it makes the RLS gate a direct comparison (no join) and
/// is kept honest by the FK chain (both endpoints + the project share one
/// workspace). Same pure-workspace-gate RLS as `workflow_status`.
model WorkflowTransition {
  id           String   @id @default(cuid())
  workspaceId  String   @map("workspace_id")
  projectId    String   @map("project_id")
  fromStatusId String   @map("from_status_id")
  toStatusId   String   @map("to_status_id")
  createdAt    DateTime @default(now()) @map("created_at")

  workspace  Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromStatus WorkflowStatus @relation("WorkflowTransitionFrom", fields: [fromStatusId], references: [id], onDelete: Cascade)
  toStatus   WorkflowStatus @relation("WorkflowTransitionTo", fields: [toStatusId], references: [id], onDelete: Cascade)

  // No duplicate edges between the same ordered pair within a project.
  @@unique([projectId, fromStatusId, toStatusId])
  @@index([workspaceId])
  @@index([projectId])
  @@index([fromStatusId])
  @@index([toStatusId])
  @@map("workflow_transition")
}

/// The Jira-style three-bucket status taxonomy. Every `workflow_status` falls
/// in exactly one bucket; downstream surfaces (boards, reports, the readiness
/// predicate) group/branch on this, not on the per-project `key`. Closed +
/// stable set, so a Postgres enum (unlike `work_item.status`, kept a String
/// for per-project customizability/portability).
enum StatusCategory {
  todo
  in_progress
  done

  @@map("status_category")
}

/// Per-project transition-enforcement mode (`project.workflowPolicyMode`).
/// `restricted` = only explicit `workflow_transition` edges are legal;
/// `open` = any status → any status. Default `restricted`.
enum WorkflowPolicyMode {
  restricted
  open

  @@map("workflow_policy_mode")
}

/// A board (Story 3.1) is a per-project READ PROJECTION over issues — columns
/// of cards, where a card's column is DERIVED from its `work_item.status`,
/// never stored as board-local placement. A project owns one-or-more boards;
/// v1 auto-seeds exactly ONE Kanban board (Subtask 3.1.2). `projectId` is a
/// plain FK and is deliberately NOT unique, so multiple-boards-per-project is
/// a non-breaking later addition (board CRUD is post-v1). The Scrum
/// sprint-scoped board is Story 3.4 — `BoardType.scrum` ships now so 3.4 adds
/// no enum migration. RLS is the pure workspace gate (non-null `workspace_id`,
/// every write under an active workspace context) — same as `workflow_status`
/// / `project` / `work_item`, with NO system-admin escape hatch.
model Board {
  id              String               @id @default(cuid())
  workspaceId     String               @map("workspace_id")
  projectId       String               @map("project_id")
  name            String
  type            BoardType            @default(kanban)
  // The project's ONE default board (Story 3.7.2). Multiple boards per project
  // now exist (CRUD is 3.7.3); exactly one is the default — the board `/boards`
  // opens when no `?board=` is given. The invariant ("at most one default per
  // project") is enforced by a PARTIAL unique index in the migration
  // (`board_one_default_per_project`, `WHERE is_default`) — Prisma's DSL can't
  // express a filtered unique index, so it lives as raw SQL there, exactly like
  // `workflow_status_one_initial_per_project`. The 3.1-seeded board backfills to
  // `true`; `seedDefaultBoard` sets it on every new project's first board.
  isDefault       Boolean              @default(false) @map("is_default")
  // Stable switcher ordering (Story 3.7.2). The SAME opaque base-62 fractional-
  // index String the `work_item` / `board_column` / `workflow_status` positions
  // use (`lib/workItems/positioning.ts`) — app-assigned (no DB default), so a
  // reorder is a single-row write. Seeded/backfilled to the first key (`a0`).
  position        String               @db.Text
  // Swimlane grouping (Story 3.3.2). `none` is the flat 3.2 board (the default,
  // so every existing/seeded board is unchanged). The 3.3.4 projection resolves
  // each card's lane server-side from this value (epic groups by ANCESTOR epic).
  swimlaneGroupBy BoardSwimlaneGroupBy @default(none) @map("swimlane_group_by")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns        BoardColumn[]
  columnStatuses BoardColumnStatus[]

  @@index([workspaceId])
  // Non-unique — a project has N boards (3.7); the switcher lists them by
  // `position` (3.7.2), so the lookup is ordered on this composite index.
  @@index([projectId, position])
  @@map("board")
}

/// An ordered column on a board (Story 3.1). It maps to a SET of workflow
/// statuses via `board_column_status` (many statuses → one column — the Jira
/// "merge In Progress + In Review" shape). `position` is the SAME opaque
/// base-62 fractional-index String the `work_item` / `workflow_status` columns
/// use (`lib/workItems/positioning.ts`) — a column reorder is a single-row
/// rewrite needing no new mechanism. (The 3.1.1 card said `Decimal(20,10)`
/// citing finding #18, but the shipped position columns are `String @db.Text`;
/// per the decision-authority ladder shipped code wins — see the migration
/// header.) `wipLimit` ships nullable now so Story 3.3 (WIP enforcement) adds
/// no migration; THIS story only persists the column — no enforcement.
model BoardColumn {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  projectId   String   @map("project_id")
  boardId     String   @map("board_id")
  name        String
  position    String   @db.Text
  wipLimit    Int?     @map("wip_limit")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  board          Board               @relation(fields: [boardId], references: [id], onDelete: Cascade)
  statusMappings BoardColumnStatus[]

  @@index([workspaceId])
  @@index([boardId, position])
  @@map("board_column")
}

/// The column ↔ status mapping (Story 3.1). One row links one `workflow_status`
/// to one `board_column`. `@@unique([boardId, statusId])` enforces that a
/// status maps to AT MOST ONE column per board (many statuses MAY share a
/// column, but a status is never in two columns at once). A project status
/// with NO row here is UNMAPPED — surfaced by the 3.1.4 projection's
/// `unmappedStatuses`, never shown as a column and never silently dropped.
model BoardColumnStatus {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  projectId   String   @map("project_id")
  boardId     String   @map("board_id")
  columnId    String   @map("column_id")
  statusId    String   @map("status_id")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  board     Board          @relation(fields: [boardId], references: [id], onDelete: Cascade)
  column    BoardColumn    @relation(fields: [columnId], references: [id], onDelete: Cascade)
  status    WorkflowStatus @relation(fields: [statusId], references: [id], onDelete: Cascade)

  @@unique([boardId, statusId])
  @@index([workspaceId])
  @@index([columnId])
  @@map("board_column_status")
}

/// Board kind (Story 3.1). `kanban` is the v1 default auto-seeded per project;
/// `scrum` (the sprint-scoped board) is Story 3.4 — the value exists now so
/// 3.4 adds no enum ALTER.
enum BoardType {
  kanban
  scrum

  @@map("board_type")
}

/// Board swimlane grouping (Story 3.3 · Subtask 3.3.2). The dimension a board's
/// cards are sliced into horizontal lanes by. `none` is the flat 3.2 board (the
/// DEFAULT — `board.swimlaneGroupBy @default(none)`, so every existing/seeded
/// board is unchanged and needs no backfill). `assignee` / `epic` / `priority`
/// are the stub-specified group-by dimensions; the lane a card lands in is
/// resolved server-side by the Story-3.3.4 projection (epic groups by the
/// ANCESTOR epic, not the immediate parent). Adding a value later (e.g. a
/// custom-query lane) is a non-breaking enum addition — same as `BoardType.scrum`
/// shipping ahead of Story 3.4.
enum BoardSwimlaneGroupBy {
  none
  assignee
  epic
  priority

  @@map("board_swimlane_group_by")
}

/// A Sprint — the unit of Agile time-boxing (Story 4.1). Scoped to a PROJECT,
/// not a board: a board in this product is a per-project READ projection (Story
/// 3.1), not Jira's cross-project saved-filter view, so a project has a single
/// logical sprint sequence regardless of how many scrum boards (Story 3.7) view
/// it. (Justified rung-1 deviation from Jira's `originBoardId` — see
/// scripts/plan-seed/data/story-4.1.ts.) `workspaceId` is denormalized for the
/// pure-workspace RLS gate, matching `board` / `work_item`.
///
/// State machine `planned → active → complete` (one-way: no skip, no reopen) is
/// enforced in the service layer (`assertSprintTransition`, Story 4.1.3). The
/// "one active sprint per project" invariant is a PARTIAL unique index
/// (`sprint_one_active_per_project`, `WHERE state = 'active'`) — Prisma's DSL
/// can't express a filtered unique index, so it lives as raw SQL in the
/// migration, exactly like `board_one_default_per_project`.
///
/// 4.1 ships the ENTITY + its CRUD rules; Story 4.4 owns the lifecycle
/// ORCHESTRATION (`startDate`/`endDate` stamped on *start*, `completedAt` on
/// *complete*, scope-lock, carry-over, sprint report). `sequence` is the
/// per-project monotonic ordinal that produces the default name ("Sprint N")
/// and a stable listing.
model Sprint {
  id                  String      @id @default(cuid())
  workspaceId         String      @map("workspace_id")
  projectId           String      @map("project_id")
  name                String
  goal                String?     @db.Text
  state               SprintState @default(planned)
  startDate           DateTime?   @map("start_date")
  endDate             DateTime?   @map("end_date")
  completedAt         DateTime?   @map("completed_at")
  // Scope-lock baseline (Story 4.4.2) — the immutable "Committed" snapshot taken
  // once by `startSprint` and never mutated thereafter (the Jira "Committed"
  // line). `committedPoints` is Decimal (NOT the card's `Int?`): the snapshot is
  // a SUM over `work_item.storyPoints`, itself `Decimal(6,2)` (rung 2 — the
  // shipped column wins over the card's prose), so an Int would truncate
  // fractional estimates; widened to (8,2) for the multi-issue sum's headroom.
  committedPoints     Decimal?    @map("committed_points") @db.Decimal(8, 2)
  committedIssueCount Int?        @map("committed_issue_count")
  sequence            Int
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Back-relation for WorkItem.sprint. The FK lives on work_item with
  // onDelete: SetNull (deleting a sprint frees its issues to the backlog).
  workItems     WorkItem[]
  // The frozen at-completion report snapshot (one row per member issue at
  // close). Cascade so deleting a sprint removes its snapshot too.
  reportEntries SprintReportEntry[]

  @@index([workspaceId])
  // Resolve the active sprint + list a project's sprints.
  @@index([projectId, state])
  @@map("sprint")
}

/// The FROZEN at-completion snapshot of a sprint's report
/// (bug-sprint-report-incomplete-list-zero-after-carry-over). `completeSprint`
/// (Story 4.4.3) writes ONE row per non-archived issue that was a member of the
/// sprint at the moment it closed, BEFORE the carry-over moves the unfinished
/// issues out. `getSprintReport` (Story 4.4.4/4.4.6) reads this snapshot for a
/// `complete` sprint so the "Completed" / "Issues not completed" split,
/// counts, points, and "added during sprint" figure stay frozen at close —
/// exactly like Jira, where carrying issues into the next sprint never empties
/// the closed sprint's report. An `active`/`planned` sprint has no snapshot and
/// is reported from live membership (the complete-modal preview).
///
/// Only the BUCKET membership (`completed`), the order (`backlogRank`), and the
/// scope-change flag (`addedAfterStart`) are frozen; the issue ROW content
/// (title / status / assignee / estimate) is read LIVE through the `workItem`
/// relation, matching Jira ("the grouping is frozen; the row reflects the
/// issue's current state"). The committed baseline (`Sprint.committedPoints`,
/// 4.4.2) is the symmetric at-START snapshot.
model SprintReportEntry {
  id              String   @id @default(cuid())
  workspaceId     String   @map("workspace_id")
  sprintId        String   @map("sprint_id")
  workItemId      String   @map("work_item_id")
  // The done-category bucket AT CLOSE: true = completed, false = not completed
  // (carried over). Frozen — unaffected by later status/membership changes.
  completed       Boolean
  // Whether the issue was associated with the sprint AFTER its startDate (the
  // Jira "added during sprint" figure), frozen at close so a later carry-over
  // can't drop it from the count.
  addedAfterStart Boolean  @map("added_after_start")
  // The issue's `backlogRank` at close — the frozen list order (nullable, like
  // work_item.backlogRank; the report read tiebreaks on workItemId).
  backlogRank     String?  @map("backlog_rank") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sprint    Sprint    @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  workItem  WorkItem  @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  // One snapshot row per (sprint, issue).
  @@unique([sprintId, workItemId])
  // The report's per-bucket, rank-ordered, cursor-paginated list read.
  @@index([sprintId, completed, backlogRank, workItemId])
  @@index([workspaceId])
  @@map("sprint_report_entry")
}

/// Sprint lifecycle state (Story 4.1). `planned → active → complete`, mirroring
/// Jira's future/active/closed. All three values exist now so Story 4.4 (start /
/// complete flows) adds no enum ALTER — same pattern as `BoardType.scrum`
/// shipping ahead of Story 3.4.
enum SprintState {
  planned
  active
  complete

  @@map("sprint_state")
}

// Background-job run ledger (Story 1.6 · Subtask 1.6.2). Every invocation of a
// `defineJob`-wrapped Inngest function writes ONE row here: a `running` row at
// start, flipped to `succeeded` / `failed` on completion. This is the read
// path the operator dashboard (1.6.5) renders WITHOUT calling Inngest's own
// API — Motir owns its job-observability data.
//
// `workspaceId` is NULLABLE on purpose: most jobs are workspace-scoped (the
// durable invariant `sendEvent` enforces — every business event carries a
// workspaceId), but SYSTEM jobs (`system.ping` here, `system.daily-health-
// check` in 1.6.4) are untenanted and write a null-workspace row. The FK
// cascades: archiving/deleting a workspace removes its job-run history with it.
//
// RLS landed in Subtask 1.6.4 (migration add_job_run_dlq_and_rls), folded in
// alongside the dead-letter-queue table so the two policies + the new table
// land in one atomic migration-by-concern (mirrors PRODECT_FINDINGS #20's
// "create table + its policy in one migration" lesson). The policy is the
// workspace gate with a system-admin escape hatch (`app.system_admin = 'true'`)
// so the trusted wrapper can write rows for any/no workspace and operator
// tooling can see untenanted system rows — see the migration for the shape.
//
// `status` is a Postgres enum (running / succeeded / failed) — the set is closed
// and stable, unlike `WorkItemRevision.changeKind` (left as text precisely
// because its value set is open). `failure` is JSON: `{ message, stack, code? }`.
// `idempotencyKey` is the rendered template (1.6.4 wires the dedup semantics;
// the column ships now so the dashboard + dedup land without a later migration).
// `output` (5.2.7) is the handler's JSON-safe resolved value, recorded on
// success — what lets a run's summary (e.g. the attachment-GC's scanned/
// deleted/failed counts) live on the ledger row itself, not only in Inngest.
model JobRun {
  id             String       @id @default(cuid())
  workspaceId    String?      @map("workspace_id")
  functionId     String       @map("function_id")
  eventName      String       @map("event_name")
  eventId        String       @map("event_id")
  /// WHICH ENGINE RAN THIS (Bug MOTIR-3683) — declared by the writer, never
  /// inferred. Both lanes write this one ledger, and the lane used to be read
  /// out of `event_id`'s FORMAT (a cuid meant the engine, a ULID meant Inngest).
  /// That inference has a hole: an `event_id` matching neither pattern is
  /// counted as neither lane, so it is invisible to every audit the Inngest
  /// migration is verified with — and 30 such rows existed, written by the very
  /// defect this column is part of fixing. A row's lane is a fact its writer
  /// knows for certain; this is where it says so.
  lane           JobRunLane
  attempt        Int
  status         JobRunStatus
  startedAt      DateTime     @default(now()) @map("started_at")
  finishedAt     DateTime?    @map("finished_at")
  durationMs     Int?         @map("duration_ms")
  failure        Json?
  output         Json?
  idempotencyKey String?      @map("idempotency_key")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Dashboard read paths (1.6.5): newest-first per workspace, and the same
  // filtered by status. The eventId / idempotencyKey indexes serve the
  // correlation + dedup lookups (1.6.4).
  @@index([workspaceId, startedAt(sort: Desc)])
  @@index([workspaceId, status, startedAt(sort: Desc)])
  @@index([eventId])
  @@index([idempotencyKey])
  // The ABANDONED-RUN REAP's discovery read (MOTIR-3683): the oldest rows still
  // `running`. Status-first, because `running` is a tiny minority of the table
  // (29 of ~203 000 when the defect was measured).
  @@index([status, startedAt])
  @@map("job_run")
}

// Dead-letter queue for background jobs (Story 1.6 · Subtask 1.6.4). When a
// `defineJob`-wrapped function exhausts its retry budget (the final attempt
// throws), the wrapper writes ONE row here — inside the same transaction that
// flips the run's `job_run.status` to `failed` — capturing enough to REPLAY:
// the function id, the original event name + full payload, the final failure,
// and the attempt count. This is the durable operator surface the 1.6.5
// dashboard's DLQ tab reads from and the "Replay" button acts on; Inngest's
// own failure view stays available for deep tracing but is NOT the source of
// truth for operator action.
//
// Deliberately NOT FK'd to `job_run`: a DLQ entry is a self-contained replay
// record (it carries the event payload), so it survives independent of the
// ledger row and a future retention sweep can prune `job_run` without
// orphaning replayable failures. `workspaceId` is nullable (system/cross-
// workspace jobs) and cascades on workspace delete, exactly like `job_run`.
//
// `firstFailedAt` is the run's `started_at` (when the failing run began);
// `lastFailedAt` is the exhaustion timestamp. `replayedAt` is null until an
// operator replays the entry (stamped by `replayDLQ`, lib/jobs/dlq.ts).
model JobRunDlq {
  id            String    @id @default(cuid())
  workspaceId   String?   @map("workspace_id")
  functionId    String    @map("function_id")
  eventName     String    @map("event_name")
  eventData     Json      @map("event_data")
  failure       Json
  attempts      Int
  firstFailedAt DateTime  @default(now()) @map("first_failed_at")
  lastFailedAt  DateTime  @default(now()) @map("last_failed_at")
  replayedAt    DateTime? @map("replayed_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Dashboard DLQ-tab read path (1.6.5): newest-failure-first per workspace.
  @@index([workspaceId, lastFailedAt(sort: Desc)])
  @@map("job_run_dlq")
}

// The DLQ STANDING-DEPTH filer's dedup row (MOTIR-5869, implementing
// `docs/decisions/dead-letter-standing-depth-filing.md`). ONE row per
// `function_id` whose standing dead letters the sweep has filed a `bug` for.
//
// `armed` is the whole state machine, and it is deliberately NOT derived from
// the bug's status:
//
//   · armed ⇒ the next sweep MAY file for this function (a row that does not
//     exist yet is armed too);
//   · filing sets it false, and while it is false the sweep files nothing more
//     for this function, whatever the depth does;
//   · ONLY the function's standing depth returning to ZERO sets it back —
//     closing, archiving or deleting the bug does NOT, or a backlog nobody
//     drains would file a new card every sweep.
//
// So the sweep never reads the bug it filed, and there is no FK to it: the key
// is kept as text so a re-file after a re-arm can name the card before it.
//
// Deployment-wide and untenanted, like `job_run_dlq` itself (its `system.*`
// rows have no workspace), so its RLS policy has a system-admin arm only.
model JobDlqStandingFiling {
  id                      String    @id @default(cuid())
  functionId              String    @unique @map("function_id")
  armed                   Boolean   @default(true)
  /// The `KEY-<n>` of the bug last filed for this function.
  filedWorkItemIdentifier String?   @map("filed_work_item_identifier")
  filedAt                 DateTime? @map("filed_at")
  /// When the function's standing depth was last seen at zero after a filing.
  rearmedAt               DateTime? @map("rearmed_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  @@map("job_dlq_standing_filing")
}

enum JobRunStatus {
  running
  succeeded
  failed
  /// THE RUN NOBODY WILL EVER FINISH (Bug MOTIR-3683). A `running` row is only
  /// honest while something is still holding it; once nothing is, `running` is
  /// the most reassuring possible way to render a dead run, and an operator
  /// scrolls past it. This is the terminal state the reap writes instead — a
  /// DISTINCT member rather than `failed`, because "the handler threw" and
  /// "nothing ever came back" are different facts and only one of them has a
  /// stack trace to show.
  abandoned

  @@map("job_run_status")
}

/// Which engine executed a run (Bug MOTIR-3683). See `JobRun.lane`.
enum JobRunLane {
  inngest
  engine

  @@map("job_run_lane")
}

// ───────────────────────────────────────────────────────────────────────────
// The Postgres job engine (Story MOTIR-3414 · Subtask MOTIR-3420).
//
// Three tables, decided in `docs/decisions/job-queue-foundation.md`: the engine
// is hand-rolled rather than built on Graphile Worker or pg-boss, precisely so
// these live in `public` where the repository's own grants and RLS reach them.
// A library's schema is outside `motir_app`'s privileges (every GRANT in
// 20260810000000_rename_app_role_to_motir_app is `IN SCHEMA public`).
//
// These tables are ADDITIVE. Nothing routes to them until the cutover switch
// (MOTIR-3423) moves a job id onto the new lane; the 24 job definitions and the
// `job_run` / `job_run_dlq` ledger are untouched by this migration.
// ───────────────────────────────────────────────────────────────────────────

/// One emitted event. `sendEvent(name, data)` writes exactly one row here, and
/// the dispatcher (MOTIR-3423) fans it out to one `JobQueueRun` per subscribing
/// job — which is why the event log is a table of its own rather than a column
/// on the run: `work-item/transitioned` has four subscribers today and the
/// payload is stored once.
///
/// `workspaceId` is NULL for a genuinely system / cross-workspace event (the
/// `system.*` namespace, and the one `email.send` whose payload permits null).
/// The RLS policy handles that case explicitly — see the migration header.
model JobEvent {
  id             String   @id @default(cuid())
  name           String
  data           Json
  workspaceId    String?  @map("workspace_id")
  idempotencyKey String?  @map("idempotency_key")
  receivedAt     DateTime @default(now()) @map("received_at")

  workspace Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs      JobQueueRun[]

  // The dispatcher's own sweep: events newest-first within a tenant.
  @@index([workspaceId, receivedAt(sort: Desc)])
  // Event-level dedup (`defineJob`'s `idempotency` option, one consumer today:
  // `email.send`) — a LOOKUP index, not the constraint. Not UNIQUE because the
  // key is scoped per subscribing job, and the pair that enforces the dedup is
  // `job_queue`'s: `job_queue_job_idempotency_key`, a hand-written PARTIAL
  // UNIQUE on `(job_id, idempotency_key) WHERE idempotency_key IS NOT NULL`
  // (MOTIR-3459, migration `20260825220000_job_queue_idempotency_key`) — see
  // the JobQueueRun note below.
  //
  // ⚠️ `job_queue`'s `(event_id, job_id)` unique is a DIFFERENT guarantee and is
  // NOT this one: it stops the DISPATCHER double-enqueueing a single event, not
  // two distinct events that share an idempotency key. This comment used to give
  // that pair as the reason no unique was needed here, which stopped being true
  // the moment the partial unique landed.
  @@index([idempotencyKey])
  @@map("job_event")
}

/// One RUN — the row a worker claims. The unit of work, of retry and of the
/// step ledger below.
///
/// ⚠️ `eventId` is NULLABLE, and deliberately: a CRON run has no triggering
/// event. That is also what makes the `(eventId, jobId)` unique constraint
/// below the right shape — in Postgres a NULL never equals another NULL, so the
/// constraint dedups event-triggered enqueues without ever constraining
/// scheduled ones.
///
/// ⚠️ AND THE MIRROR OF THAT SENTENCE IS `scheduledFor` (MOTIR-3469). The note
/// above named a gap as well as a design: an enqueue with no `event_id` had no
/// constraint at all, so two workers ticking the same minute each inserted a row
/// and the job ran twice. `scheduledFor` is the identity a SCHEDULED run was
/// missing, and `(jobId, scheduledFor)` is the constraint that dedups it — by the
/// SAME NULL-never-equals-NULL property, read the other way round: an
/// event-triggered row carries a NULL `scheduled_for` and is untouched by it. The
/// two constraints are complementary halves of one idea, each covering exactly
/// the population the other cannot see.
model JobQueueRun {
  id                  String      @id @default(cuid())
  /// The `defineJob` function id — `email.send`, `system.attachment-gc`, …
  jobId               String      @map("job_id")
  eventId             String?     @map("event_id")
  /// Denormalised from the event (or synthesised as `scheduled.<id>` for a cron
  /// run) so the ledger write needs no join, exactly as `job_run.event_name` is.
  eventName           String      @map("event_name")
  workspaceId         String?     @map("workspace_id")
  /// When this run becomes claimable. A `step.sleep` re-enqueue moves it
  /// forward; a retry moves it forward by the backoff.
  runAt               DateTime    @map("run_at")
  /// THE PER-TICK KEY for a SCHEDULED run (MOTIR-3469) — the cron FIRE INSTANT
  /// this row stands for, never the moment it was enqueued. NULL on every
  /// event-triggered row, which is what keeps the unique below off them.
  ///
  /// It differs from `runAt` the moment a run is retried or yields: `run_at` moves
  /// forward, `scheduled_for` does not. That is the point — the identity of a tick
  /// must survive its own rescheduling, or a retry would look like a new fire.
  scheduledFor        DateTime?   @map("scheduled_for")
  attempts            Int         @default(0)
  /// The run's total attempt budget, resolved from the job's named retry policy
  /// at enqueue (`lib/jobs/retries.ts`). Stored per-run so a policy change does
  /// not retroactively re-budget rows already in flight.
  maxAttempts         Int         @map("max_attempts")
  state               JobRunState @default(pending)
  /// The worker holding this run, and until when. A worker that dies leaves the
  /// row `running` with an expired lease, which is what makes it reclaimable
  /// rather than stuck (MOTIR-3421).
  claimedBy           String?     @map("claimed_by")
  leaseExpiresAt      DateTime?   @map("lease_expires_at")
  lastError           Json?       @map("last_error")
  /// EVENT-LEVEL DEDUP KEY (MOTIR-3459), resolved from `defineJob`'s
  /// `idempotency` template at ENQUEUE and denormalised here — the only moment
  /// the event payload is in hand. NULL for every job that declares no template,
  /// and for an event that carries no value for it.
  idempotencyKey      String?     @map("idempotency_key")
  /// THE COALESCING KEY (MOTIR-3483), resolved from `defineJob`'s `debounce.key`
  /// expression at ENQUEUE — the same moment and for the same reason as
  /// `idempotency_key` above. A same-key event arriving while this row is still
  /// PENDING pushes its `run_at` forward and repoints its `event_id` at the new
  /// event, instead of enqueuing a second run.
  ///
  /// ⚠️ CLEARED BY THE CLAIM, and that is what makes the whole mechanism exact.
  /// The debounce window belongs to a PENDING row; once a worker has claimed the
  /// run, the window is over and a same-key push must enqueue a NEW run rather
  /// than be silently folded into work that has already started. Clearing it at
  /// the claim is also what keeps the partial unique index below satisfiable
  /// across a RETRY: a `rescheduleAt` puts the row back to `pending`, and a row
  /// that still carried its key would then collide with the fresh row a push
  /// enqueued while it was running — a unique violation on the retry path, which
  /// is the worst possible place to discover one.
  debounceKey         String?     @map("debounce_key")
  /// WHEN THIS ROW'S DEBOUNCE WINDOW FIRST OPENED — stamped once, at the first
  /// arrival, and never moved. `debounce.timeout` is measured from it, so a
  /// steady stream cannot defer a run forever. NULL on every row that carries no
  /// `debounce_key`.
  debounceFirstSeenAt DateTime?   @map("debounce_first_seen_at")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  event        JobEvent?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  workspace    Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  steps        JobStep[]
  supervisions JobSupervision[]

  /// FAN-OUT IDEMPOTENCY (consumed by MOTIR-3423). One run per (event, job), so
  /// a dispatcher that retries cannot double-enqueue. Scheduled runs carry a
  /// NULL `event_id` and are therefore not constrained — see the note above.
  @@unique([eventId, jobId])
  /// TICK IDEMPOTENCY (consumed by MOTIR-3471). One run per (job, fire instant),
  /// so two workers ticking the same minute produce ONE run. The model comment
  /// carries the argument; what belongs here is that this is the guarantee, not a
  /// check-then-insert — `enqueueScheduled` reads a `P2002` as *already queued*,
  /// exactly as `dispatchEventToEngine` reads its own, and for the same reason: a
  /// check would be a read-derived write with a race in the middle.
  @@unique([jobId, scheduledFor])
  /// THE CLAIM INDEX. The worker's claim is
  /// `WHERE state = 'pending' AND run_at <= now() ORDER BY run_at
  ///  FOR UPDATE SKIP LOCKED LIMIT n`
  /// — so the index is `(state, run_at)`: the equality column first, then the
  /// column the query both ranges over and orders by, which lets Postgres seek
  /// to the first due row and walk forward in order with no sort.
  ///
  /// ⚠️ UNDER THE RUNTIME ROLE THE CLAIM DOES NOT USE THIS INDEX — it uses the
  /// hand-written PARTIAL `job_queue_pending_run_at_idx` on `(run_at) WHERE
  /// state = 'pending'` (bug MOTIR-8519, migration
  /// `20261013230000_job_queue_rls_usable_partial_indexes`). `job_queue` is FORCE
  /// RLS and `motir_app` does not bypass it, so the policy is a security barrier,
  /// and Postgres will not drive an index scan with `state = 'pending'` behind it:
  /// the enum equality operator is not LEAKPROOF. Every claim was a full scan of
  /// a table no retention empties (~268k terminal rows in production). A partial
  /// index's `WHERE` is PROVEN from the query rather than evaluated per row, so the
  /// planner can use it. This composite stays for non-RLS readers (the owner).
  ///
  /// The partial indexes cannot be declared here (Prisma has no `WHERE` on an
  /// index) and the differ pairs indexes BY COLUMN LIST (`CLAUDE.md` § Migrations),
  /// so their column lists, `(run_at)` and `(lease_expires_at)`, must never be
  /// given to an `@@index` on this model: that would turn them into a permanent
  /// spurious RENAME.
  @@index([state, runAt])
  /// The LEASE-RECLAIM sweep: `WHERE state = 'running' AND lease_expires_at < now()`.
  /// A distinct column list from the claim index, so the differ pairs each with
  /// its own datamodel entry. Under the runtime role the sweep uses the partial
  /// `job_queue_running_lease_expires_at_idx` instead, for the reason above.
  @@index([state, leaseExpiresAt])
  /// Operator surfaces and the ledger correlation, per tenant.
  @@index([workspaceId, createdAt(sort: Desc)])
  /// ⚠️ THE DEDUP CONSTRAINT IS A HAND-WRITTEN PARTIAL UNIQUE INDEX and is
  /// DELIBERATELY NOT DECLARED HERE — `job_queue_job_idempotency_key`, on
  /// `(job_id, idempotency_key) WHERE idempotency_key IS NOT NULL`, created in
  /// `20260825220000_job_queue_idempotency_key`.
  ///
  /// Prisma's `@@unique` takes no `WHERE`, and a non-partial unique on those
  /// columns would be WRONG rather than merely stricter: NULLs would still be
  /// permitted, but every job declaring no template would be constrained on a
  /// column it never fills — and more importantly the whole point is that only
  /// non-NULL keys collide.
  ///
  /// It is SAFE from the drift trap the claim index above describes, and for the
  /// stated reason rather than by luck: the differ pairs a database index to a
  /// datamodel index BY COLUMN LIST, and NO `@@index` / `@@unique` on this model
  /// claims `(job_id, idempotency_key)`. With nothing to pair against, an index
  /// carrying a `WHERE` the differ cannot express is ignored instead of being
  /// reported as a spurious rename. **Do not add an `@@index` on those two
  /// columns** — that is precisely what would arm the trap.
  ///
  /// ⚠️ THE SAME IS TRUE OF THE DEBOUNCE CONSTRAINT (MOTIR-3483) —
  /// `job_queue_job_debounce_key`, on `(job_id, debounce_key) WHERE debounce_key
  /// IS NOT NULL AND state = 'pending'`, created in
  /// `20260826010000_job_queue_debounce`. It is what makes the coalescing race
  /// recoverable rather than silent: two concurrent same-key dispatches that both
  /// find no pending row cannot both insert, because `SELECT … FOR UPDATE` has
  /// nothing to lock when the set is EMPTY. The loser reads a `P2002` and
  /// coalesces into the winner instead. **Do not add an `@@index` on
  /// `(job_id, debounce_key)`** — nothing claims that column list today, which is
  /// exactly why the differ ignores the partial index rather than mis-pairing it.
  @@map("job_queue")
}

/// A MEMOIZED STEP RESULT — the table that makes `step.run` idempotent across
/// retries and restarts, and the whole reason the existing `step.run` call
/// sites do not have to change (MOTIR-3422).
///
/// `result` is the step's JSON-round-tripped return value. It is NULLABLE for
/// two distinct reasons that the shim must keep apart: a step that returned
/// `undefined`/`null`, and a `step.sleep` checkpoint, which records `sleepUntil`
/// and no result. `kind` is what tells them apart without overloading NULL.
model JobStep {
  id          String      @id @default(cuid())
  runId       String      @map("run_id")
  /// The step's own id — the first argument to `step.run` / `step.sleep`. Author
  /// -supplied and stable across replays; never a loop position.
  stepId      String      @map("step_id")
  kind        JobStepKind @default(run)
  result      Json?
  /// Set only for a `sleep` step: when the run becomes resumable.
  sleepUntil  DateTime?   @map("sleep_until")
  /// Denormalised from the run so the policy below is the same predicate as the
  /// other two tables and the hot `(run_id, step_id)` lookup stays a single
  /// index probe with no join to `job_queue` for the tenancy check.
  workspaceId String?     @map("workspace_id")
  createdAt   DateTime    @default(now()) @map("created_at")

  run       JobQueueRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  workspace Workspace?  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// THE memoization key. `step.run(id, fn)` is "look up (run_id, step_id); if
  /// present return it, else execute, persist, return" — and the uniqueness is
  /// what makes a concurrent or replayed second execution impossible rather
  /// than merely unlikely.
  @@unique([runId, stepId])
  @@map("job_step")
}

/// The lifecycle of one `job_queue` row. Distinct from `JobRunStatus`, which is
/// the LEDGER's status (`job_run`, the operator-facing history): a queue row is
/// `pending` before it is claimable, and the ledger has no such state.
enum JobRunState {
  pending
  running
  succeeded
  failed
  cancelled

  @@map("job_run_state")
}

/// Which step contract a `job_step` row records.
enum JobStepKind {
  run
  sleep

  @@map("job_step_kind")
}

/// WHERE A SUPERVISION IS IN ITS OWN LIFECYCLE (Story MOTIR-3778 · MOTIR-3826).
///
/// A closed three-member set, and an ENUM rather than TEXT for exactly that
/// reason: `docs/decisions/job-queue-foundation.md` §16.4 makes the terminal
/// transition an invariant with three named entrances, so a fourth member is a
/// change to the invariant and should cost a migration and a reader.
/// {@link JobSupervision.kind} is TEXT for the opposite reason — see it there.
enum JobSupervisionState {
  /// The chain is advancing: one poll per run, deferring itself between them.
  watching
  /// A terminal transition has been entered and teardown is in flight. Distinct
  /// from `watching` so a concurrent pass (a lease reclaim overlapping the
  /// previous claimant's last moments) does not start a second teardown, and
  /// distinct from `settled` so the sweep can tell "tearing down now" from
  /// "torn down".
  settling
  /// Teardown completed. The row is deleted with the rest of the run's state;
  /// this member exists for the window between the teardown and that delete.
  settled

  @@map("job_supervision_state")
}

/// THE PER-POLL STATE OF ONE SUPERVISION (Story MOTIR-3778 · Subtask MOTIR-3826).
///
/// `docs/decisions/job-queue-foundation.md` §16.2 decides that this is a table
/// rather than the queue row's payload or an existing fleet row, and §16.3 is
/// why it cannot be the step ledger: a `step.run` under a fixed id freezes its
/// FIRST answer for the life of the run (§13.3(b) rejected `index-started:<pid>`
/// by name), and this is precisely the state that must CHANGE between passes.
///
/// ⚠️ IT HOLDS THE OBSERVATIONS AND NOT THE HANDLES. The container handle,
/// `bootedAt`, `queuedAt`, the credential expiry, the admission ticket and the
/// `slotRef` all keep riding `index-boot:<pid>`'s / `boot-runner`'s memo, which
/// is what buys re-attachment after a worker restart TODAY. Copying them here
/// would create a second source of truth for the one fact whose second copy
/// costs a billed container.
///
/// ⚠️ AND ANYTHING DERIVABLE FROM THOSE TWO IS NOT A COLUMN. The CI fleet's
/// `bootLatencyMs` is `startedAt − session.queuedAt` — one field from this row
/// and one from the boot memo — so it is recomputed on the pass that needs it
/// rather than carried.
model JobSupervision {
  id                      String              @id @default(cuid())
  runId                   String              @map("run_id")
  /// WHAT is being supervised, within this run — the `projectId` for the index
  /// fleet, the intent id for the CI fleet.
  ///
  /// ⚠️ THE ROW IS NOT ONE PER RUN, AND THAT IS THE DESIGN QUESTION RATHER THAN
  /// A DETAIL. `runIndexFleetSteps` fans out over `target.projectIds` — one
  /// container per (repo × project) — so a supervision is a SET whose degenerate
  /// case is one. A schema keyed by `run_id` alone models the fan-out as a
  /// singular and is re-shaped the first time a workspace has two projects.
  ///
  /// It is also what builds the step ids the sweep reads a session back out of
  /// (`index-boot:<subject>`), which is the same discipline §13.1 limb 4 states
  /// for a step id: it names the UNIT OF WORK, never a loop position.
  subject                 String
  /// WHICH supervisor this row belongs to — `index` / `ci-runner`.
  ///
  /// TEXT rather than an enum, the same call `FleetInFlightSlot.workload` makes
  /// and for the same reason: a third supervisor should be a registry edit
  /// rather than a migration, and the driver's exhaustive handler map is what
  /// makes forgetting one a COMPILE error. {@link JobSupervisionState} is an
  /// enum because it is a closed lifecycle rather than an open registry.
  kind                    String
  /// How many polls this supervision has performed, across every pass. It was a
  /// PER-PASS counter while a pass was a whole loop (§13.3(a) demoted the
  /// iteration ceiling to a runaway guard for exactly that reason); a pass is
  /// one poll now, so a durable count is a real total-poll bound again.
  pollNumber              Int                 @default(0) @map("poll_number")
  /// ISO instant at which the container was OBSERVED running — null until a
  /// SUCCESSFUL provider read has produced one. §13.3(b)'s state, in a home that
  /// can hold it, and §13.1's corollary still governs it: a boot-deadline
  /// verdict may only be reached from a successful read, never from the absence
  /// of an observation.
  startedAt               DateTime?           @map("started_at")
  /// Consecutive failed provider reads, carried between polls so the
  /// read-failure tolerance still applies when the polls are in different
  /// processes.
  consecutiveReadFailures Int                 @default(0) @map("consecutive_read_failures")
  /// When the next poll is due — the instant the run was deferred to. The
  /// SWEEP's predicate reads it: a chain that has stopped advancing is one whose
  /// next poll is long past and whose state is still `watching`.
  nextPollAt              DateTime            @map("next_poll_at")
  state                   JobSupervisionState @default(watching)
  /// Denormalised from the run, exactly as `job_step.workspace_id` is and for
  /// the same reason: the policy below is then the same predicate as the other
  /// job tables, and the hot `(run_id, subject)` lookup stays a single index
  /// probe with no join to `job_queue` for the tenancy check. Never a tenancy
  /// boundary of its own — the supervisors span tenants because the
  /// infrastructure bill does.
  workspaceId             String?             @map("workspace_id")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  run       JobQueueRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  workspace Workspace?  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// THE identity. Two projects of one index run hold two rows; a second write
  /// for the same pair is a constraint violation rather than a silent overwrite.
  @@unique([runId, subject])
  /// THE SWEEP'S READ: `WHERE state = 'watching' AND next_poll_at < $1`. A plain
  /// `@@index`, deliberately — a hand-written PARTIAL index on `next_poll_at`
  /// alone would share no column list with this one, but a partial index that
  /// DID share one is the permanent-spurious-RENAME trap `CLAUDE.md`
  /// § Migrations records, and the table is small enough (a row per LIVE
  /// supervision, deleted at teardown) that the difference cannot pay for a
  /// standing drift hazard.
  @@index([state, nextPollAt])
  @@map("job_supervision")
}

// ───────────────────────────────────────────────────────────────────────────
// Transactional-mail DELIVERY (Bug MOTIR-3507 · Subtask MOTIR-3513).
//
// The job ledger records whether the SEND succeeded — which, for a real
// provider, means only "the provider accepted the POST". It says nothing about
// whether the message was delivered, and `succeeded` next to a bounced
// invitation is what hid MOTIR-3507 for a day. This table is the other half:
// one row per accepted message, keyed on the PROVIDER's own id, so the events
// the provider already emits about it have somewhere to land.
//
// ⚠️ `workspaceId` is NULLABLE, exactly as `JobEvent.workspaceId` is and for
// the same reason: `email.send` is the one job whose payload permits a null
// workspace (a password reset is not owned by a workspace). The RLS policy
// handles that case with the system-admin branch — see the migration header.
// ───────────────────────────────────────────────────────────────────────────

/// One transactional message the provider ACCEPTED, and what became of it.
model EmailDelivery {
  id String @id @default(cuid())

  /// The provider's own handle for the message — Resend's `{ id }`. UNIQUE, so
  /// a retried job attempt that the provider deduped to the same message
  /// cannot write a second row. NULLABLE because the dev providers issue no id
  /// and a 2xx whose body does not parse is still an accepted send (see
  /// `EmailSendResult` in lib/email.ts); Postgres allows many NULLs under a
  /// unique index, which is the wanted behaviour.
  providerMessageId String? @unique @map("provider_message_id")

  /// Which provider took it — `resend`, `console`, `file`. Recorded because a
  /// null `provider_message_id` means something different per provider.
  provider  String
  recipient String
  /// The `TransactionalEmail` discriminant this message was rendered from.
  template  String

  workspaceId String? @map("workspace_id")

  state EmailDeliveryState @default(accepted)

  /// The send's dedup key (the reset token, the invite token). Indexed on BOTH
  /// job ledgers (`job_run.idempotency_key`, `job_event.idempotency_key`), so
  /// it is the lane-independent join back to the run — it is on the payload
  /// itself and needs no context plumbing.
  idempotencyKey String? @map("idempotency_key")
  /// The run that sent it, as the ACTIVE lane numbers runs: a `job_queue.id`
  /// cuid on the Postgres engine, an Inngest ULID on the Inngest lane. Recorded
  /// truthfully rather than normalised — the discriminator is the id's shape.
  runId          String? @map("run_id")
  /// The triggering event's id, same lane caveat as `runId`.
  eventId        String? @map("event_id")

  /// When the provider last told us something about this message. Null until
  /// the first delivery event arrives.
  lastEventAt DateTime? @map("last_event_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// The operator surface's read: this workspace's deliveries, newest first.
  @@index([workspaceId, createdAt(sort: Desc)])
  /// The join the jobs dashboard makes from a run row to its delivery.
  @@index([idempotencyKey])
  @@index([runId])
  /// The notification budget's read (MOTIR-5873): accepted sends in the last
  /// 24 hours, counted across every workspace on every notification send.
  @@index([createdAt])
  @@map("email_delivery")
}

/// What became of an accepted message. `accepted` is what every row starts at —
/// the provider took the POST and nothing has been heard since. The other four
/// are the provider's own delivery events, and they are the WHOLE set: the
/// webhook that writes them (MOTIR-3515) adds no sixth value.
///
/// ⚠️ `delivered` does NOT mean "read", and it does not mean "in the inbox" —
/// a spam-foldered message is `delivered`. That distinction is why MOTIR-3516
/// exists and why nothing in this table can answer it.
enum EmailDeliveryState {
  accepted
  delivered
  bounced
  complained
  delayed

  @@map("email_delivery_state")
}

/// Where an attachment row entered the system (Subtask 5.2.1). `editor` =
/// uploaded through the Markdown editor (description / explanation / comment
/// body) and linked to its issue by the link-on-write parse (5.2.3); `panel` =
/// uploaded through the attachments panel (5.2.2). The panel BLOCKS deleting
/// editor-sourced rows (it points the user at the source field instead) — the
/// Jira-verified rule that prevents the broken-embed hole, and the ONLY reason
/// this column exists (no `commentId`: jump-to-exact-comment is a documented
/// extension, "no complexity for nothing").
enum AttachmentSource {
  editor
  panel
  // Story-acceptance video (Story MOTIR-1627 · MOTIR-1629). Set ONLY on the
  // acceptance-upload path; a video via the generic editor/panel upload is still
  // 415 (the allowlist gate stays unchanged for `editor`/`panel`). These rows are
  // owned by the AcceptanceEvidence lifecycle, so the attachments panel excludes
  // this source from its listing.
  acceptance_video
  // Story-acceptance Playwright trace (MOTIR-1674) — a private diagnostic served
  // through the content route like the video; owned by the AcceptanceEvidence
  // lifecycle, excluded from the attachments panel listing.
  //
  // ⚠️ That exclusion was DOCUMENTED here and absent from the query for a year
  // (MOTIR-3085): the panel's denylist was written twice, and this member was in
  // neither copy, so every story with a trace-carrying recording listed a `.zip`
  // nobody wanted — deletable from a panel its lifecycle never intended, which
  // would strand `AcceptanceEvidence.traceAttachmentId`. The predicate now lives
  // once, in `attachmentRepository.LIFECYCLE_OWNED_SOURCES`.
  acceptance_trace
  // A published DESIGN RESULT artifact (Story MOTIR-2664 · MOTIR-2666) — the
  // `*.mock.html`, its `.png` export, or the extracted `design-notes.md`
  // section text. Set ONLY on the design-publish path; `text/html` via the
  // generic editor/panel upload is still 415 (the design-scoped allowlist in
  // lib/blob/allowlist.ts is deliberately NOT spread into ALLOWED_UPLOAD_TYPES
  // — docs/decisions/design-result.md §5a). Owned by the DesignEvidence
  // lifecycle, so the attachments panel excludes this source from its listing.
  design_asset
  // A file uploaded through the GENERAL public-API door (Story MOTIR-3000 ·
  // MOTIR-3056) — `POST /api/v1/work-items/[key]/attachments` and the MCP tool
  // in front of it. Named for the DOOR, not the actor: Motir cannot distinguish
  // an agent from a person holding a personal access token, and this column
  // feeds filtering, GC and analytics (docs/decisions/attachment-api-door.md
  // §2). Unlike every other member added since the original two, an `api` row is
  // an ORDINARY attachment: it is LISTED and COUNTED in the attachments panel
  // exactly like `editor` / `panel`, and it takes the general
  // `ALLOWED_UPLOAD_TYPES` allowlist — `text/html` is still 415 here, because
  // the three serving layers that make HTML safe belong to the design
  // lifecycle (design-result.md §5a).
  //
  // ⚠️ The panel queries filter with `notIn` — a DENYLIST — so this member is
  // visible BY DEFAULT and no listing change was needed. Adding `api` to
  // `attachmentRepository.listByWorkItem` or `countByWorkItem`'s exclusion is
  // the regression; `tests/attachments/apiSourceListing.test.ts` asserts it is
  // in neither.
  api

  @@map("attachment_source")
}

/// The acceptance state of a story-acceptance video (Story MOTIR-1627 ·
/// MOTIR-1629). `pending` = a video is attached and awaiting a reviewer;
/// `approved` = the reviewer accepted (drives the `in_review → done` gate);
/// `changes_requested` = the reviewer sent it back.
enum AcceptanceEvidenceStatus {
  pending
  approved
  changes_requested

  @@map("acceptance_evidence_status")
}

/// An uploaded blob (Subtask 2.3.7) — a description image/file persisted to
/// Vercel Blob. 2.3.7 shipped it as a billing/audit trail: it records WHO
/// uploaded WHAT. Story 5.2 adds the `workItemId` link + `source` (Subtask
/// 5.2.1) so the attachments panel can manage files per issue, REUSING this
/// table + the upload service/route (finding #52). `workItemId` is NULLABLE —
/// rows are born unlinked (an editor upload at create-modal time happens
/// before the issue exists); the link-on-write parse (5.2.3) or the panel
/// upload (5.2.2) sets it, and the orphan-GC (5.2.7) sweeps rows that never
/// get linked. RLS = workspace gate + the `app.system_admin` hatch (added in
/// the 5.2.1 migration — the GC is a context-less background reader/writer,
/// the same criterion that earned job_run its hatch); policy is in the
/// migration SQL.
/// `uploaderUserId`'s FK (cascade) is created in the 2.3.7 migration; this
/// model MODELS it as the `uploader` relation (with `User.uploadedAttachments`
/// as the back-relation) so the schema graph matches the migration-built DB.
/// Modelling it is required: a hand-managed FK with no `@relation` makes every
/// `prisma migrate dev` re-propose dropping it (bug-attachment-fk-migration-drift).
model Attachment {
  id               String           @id @default(cuid())
  workspaceId      String           @map("workspace_id")
  uploaderUserId   String           @map("uploader_user_id")
  // The issue this file is attached to (Subtask 5.2.1). `onDelete: SetNull`,
  // NOT Cascade — hard-deleting an issue must leave the row behind (unlinked)
  // so the orphan-GC (5.2.7) can also remove the BLOB; a cascade would
  // vaporise the rows and strand their blobs invisibly.
  workItemId       String?          @map("work_item_id")
  // The PAGE this file belongs to (Story MOTIR-5752 · MOTIR-7279) — an image
  // pasted into a page, owned from upload so the orphan-GC never takes it. At
  // most one of `workItemId` / `pageId` is set (CHECK
  // `attachment_owner_at_most_one`, in the migration SQL). `SetNull` for the
  // `workItemId` reason above: a deleted page's rows stay for the GC to reclaim.
  pageId           String?          @map("page_id")
  // Default `editor`: every pre-5.2 row came through the editor upload path,
  // so the migration's ADD COLUMN backfills existing rows correctly.
  source           AttachmentSource @default(editor)
  blobPathname     String           @map("blob_pathname")
  mimeType         String           @map("mime_type")
  sizeBytes        Int              @map("size_bytes")
  originalFilename String           @map("original_filename")
  createdAt        DateTime         @default(now()) @map("created_at")

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploader           User                @relation(fields: [uploaderUserId], references: [id], onDelete: Cascade)
  workItem           WorkItem?           @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  page               Page?               @relation(fields: [pageId], references: [id], onDelete: SetNull)
  // Back-relations for AcceptanceEvidence: an `acceptance_video` Attachment is
  // the video of one evidence row (MOTIR-1629); an `acceptance_trace` Attachment
  // is its trace (MOTIR-1674). Both FKs SetNull, so the orphan-GC deleting a blob
  // leaves the evidence history row intact.
  acceptanceEvidence AcceptanceEvidence? @relation("AcceptanceVideo")
  traceEvidence      AcceptanceEvidence? @relation("AcceptanceTrace")
  // Back-relation for DesignAsset (Story MOTIR-2664 · MOTIR-2666): a
  // `design_asset` Attachment is the stored bytes of ONE design-result asset.
  // SetNull on that FK, same as the acceptance pair — the orphan-GC reclaiming
  // a superseded mock's blob leaves the asset row (and its history) standing.
  designAsset        DesignAsset?

  @@index([workspaceId, createdAt(sort: Desc)])
  // The paged panel read (5.2.2): an issue's attachments, newest first.
  @@index([workItemId, createdAt(sort: Desc)])
  // A page's images, newest first (MOTIR-7279).
  @@index([pageId, createdAt(sort: Desc)])
  @@map("attachment")
}

/// Story-acceptance evidence (Story MOTIR-1627 · Subtask MOTIR-1629). Wraps a
/// video Attachment (the E2E's recorded receipt) with acceptance semantics on a
/// STORY: the reviewer watches the video in the acceptance panel and Approves
/// (drives `in_review → done`) or Requests changes.
///
/// **One CURRENT evidence per story.** A new green run SUPERSEDES the prior
/// current (`isCurrent` flips to false on the old row and its video Attachment is
/// unlinked so the orphan-GC reclaims the blob after its safety window). A
/// partial unique index (`WHERE is_current`, in the migration SQL) enforces the
/// invariant at the DB level; history rows are retained (audit), only one is
/// current.
///
/// `workspaceId` is the denormalised tenancy gate every read filters on and the
/// RLS policy uses (pure active-workspace gate, mirroring `attachment` — policy
/// in the MOTIR-1629 migration; the publish path runs under withWorkspaceContext).
/// Every FK is modelled as an `@relation` (the migration rule): `workItem`
/// (Cascade — evidence dies with its story), `attachment` (SetNull — GC deleting
/// the blob leaves the history row), `approvedBy` (SetNull — the approval stamp
/// outlives the approver).
model AcceptanceEvidence {
  id                String                   @id @default(cuid())
  workspaceId       String                   @map("workspace_id")
  // The STORY this evidence accepts.
  workItemId        String                   @map("work_item_id")
  // The stored video (source `acceptance_video`). Nullable + SetNull so the
  // orphan-GC removing a superseded blob leaves the history row intact.
  attachmentId      String?                  @unique @map("attachment_id")
  // The Playwright trace, stored as a private `acceptance_trace` Attachment
  // (MOTIR-1674) — served through the auth'd content route, never a raw URL.
  traceAttachmentId String?                  @unique @map("trace_attachment_id")
  // `[{ label, tSeconds }]` chapter markers the player renders as scrubbable
  // jumps. Defaults to an empty array so a video with no chapters is well-formed.
  chapters          Json                     @default("[]")
  status            AcceptanceEvidenceStatus @default(pending)
  // Provenance from the CI run that produced the video (the BYOK publish path).
  commitSha         String?                  @map("commit_sha")
  ciRunUrl          String?                  @map("ci_run_url")
  // The E2E subtask key that produced this receipt (e.g. "MOTIR-1638").
  producedByKey     String?                  @map("produced_by_key")
  // True for exactly one row per story (the partial unique index enforces it);
  // a superseded row is false.
  isCurrent         Boolean                  @default(true) @map("is_current")
  approvedById      String?                  @map("approved_by_id")
  approvedAt        DateTime?                @map("approved_at")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  workspace       Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workItem        WorkItem    @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  attachment      Attachment? @relation("AcceptanceVideo", fields: [attachmentId], references: [id], onDelete: SetNull)
  traceAttachment Attachment? @relation("AcceptanceTrace", fields: [traceAttachmentId], references: [id], onDelete: SetNull)
  approvedBy      User?       @relation(fields: [approvedById], references: [id], onDelete: SetNull)

  // The panel read: a story's evidence, newest first (the current is the head).
  @@index([workItemId, createdAt(sort: Desc)])
  @@map("acceptance_evidence")
}

/// What kind of design artifact a {@link DesignAsset} row stores (Story
/// MOTIR-2664 · Subtask MOTIR-2666).
enum DesignAssetKind {
  /// A `*.mock.html` page/view mockup — rendered in the panel's sandboxed,
  /// cross-origin iframe (docs/decisions/design-result.md §5).
  mock
  /// A `.png` export — opened in the shipped attachment lightbox.
  image
  /// The extracted `design-notes.md` section text as a `text/markdown` file.
  /// ALWAYS published alongside the inline `DesignEvidence.noteMd`, which is
  /// capped at 64 KiB for rendering — this is what makes that cap a rendering
  /// bound rather than a data-loss bound (§1).
  note_file

  @@map("design_asset_kind")
}

/// A published DESIGN RESULT (Story MOTIR-2664 · Subtask MOTIR-2666) — what a
/// `type: design` subtask's CI run produced, attached to the work item so a
/// reviewer reads the design in Motir instead of opening raw files on GitHub.
///
/// **It hangs off the card that PRODUCED it, not the parent story** — the
/// opposite of `AcceptanceEvidence`, whose publish path resolves a subtask key
/// UP to its story because a story has exactly one end-to-end receipt. A story
/// has MANY designs, one per design subtask (docs/decisions/design-result.md §3).
///
/// **One CURRENT result per work item.** A new publish supersedes the prior
/// current (`isCurrent` flips to false on the old row); the partial unique index
/// `design_evidence_one_current_per_item` enforces it at the DB level, so a
/// concurrent double publish loses at the constraint instead of leaving two
/// current rows. Superseded rows are KEPT as history; their asset blobs become
/// orphaned Attachments the existing orphan-GC reclaims.
///
/// `noteMd` is the extracted `design-notes.md` SECTION text — not the whole
/// per-AREA file, which on `origin/main` runs to 303,395 bytes across 29
/// sections. Capped at 64 KiB (§1) and rendered through the single Markdown
/// path; the full text always ships as a `note_file` asset.
model DesignEvidence {
  id              String    @id @default(cuid())
  workspaceId     String    @map("workspace_id")
  /// The work item whose design this is — the design subtask itself.
  workItemId      String    @map("work_item_id")
  /// The extracted `design-notes.md` section(s), capped at 64 KiB. Null when
  /// the PR changed no section (the above-the-first-heading case, §1).
  noteMd          String?   @map("note_md") @db.Text
  /// True when the inline copy was truncated at a section boundary; the
  /// `note_file` asset always carries the complete text.
  noteTruncated   Boolean   @default(false) @map("note_truncated")
  /// Provenance from the CI run that published it (the BYOK publish path).
  commitSha       String?   @map("commit_sha")
  ciRunUrl        String?   @map("ci_run_url")
  /// The card key whose PR produced this result (e.g. "MOTIR-2669").
  producedByKey   String?   @map("produced_by_key")
  /// True for exactly one row per work item (the partial unique index enforces
  /// it); a superseded row is false.
  isCurrent       Boolean   @default(true) @map("is_current")
  /// When this result was WITHDRAWN — cleared without a replacement being
  /// published (MOTIR-3215). NULL on every row that was never withdrawn.
  ///
  /// ⚠️ This is the column that makes `isCurrent = false` legible. Before it,
  /// one flag covered two histories a reader cannot tell apart and needs to:
  ///
  /// | what happened                          | `isCurrent` | `withdrawnAt` |
  /// | -------------------------------------- | ----------- | ------------- |
  /// | a later publish superseded it          | false       | NULL          |
  /// | somebody took it back, nothing replaced| false       | set           |
  ///
  /// and the ABSENCE of any row at all is the third: the card never had a
  /// design. The design gate reads that same absence, so a withdrawal that
  /// left no trace would swap one silent wrong answer for another.
  withdrawnAt     DateTime? @map("withdrawn_at")
  /// WHO withdrew it. NULL with `withdrawnAt` set means the SYSTEM did — today
  /// that is the data-repair migration that drained the strays MOTIR-3213's
  /// publisher defect left behind, and it is deliberately distinguishable from
  /// a person's withdrawal. SetNull, like every other audit stamp here: a
  /// deleted actor loses attribution, never the record.
  withdrawnById   String?   @map("withdrawn_by_id")
  /// WHY, in the withdrawer's own words. Free text rather than an enum: unlike
  /// `Plan.decisionReason`'s three closed histories, the reasons a design
  /// result is wrong are open-ended, and a vocabulary invented up front would
  /// be a guess written into the record this column exists to make honest.
  withdrawnReason String?   @map("withdrawn_reason") @db.Text
  /// When an APPROVAL pinned this version's bytes (MOTIR-4913; ADR
  /// docs/decisions/approval-gates.md §6c and its MOTIR-4911 amendment). NULL on
  /// every version nobody approved, which is the ordinary case.
  ///
  /// ⚠️ It is a RETENTION marker, not an audit stamp, and the two are
  /// deliberately not merged. What was approved, by whom, under what authority
  /// and through which surface is the `approval_gate` row's — including which
  /// version, once MOTIR-4912's `subject_version` lands. This column answers ONE
  /// question, asked by the supersede path: **may these blobs be handed to the
  /// orphan-GC?** So it carries no actor and no gate FK; a second home for the
  /// audit is a second thing to keep in agreement with the table an auditor
  /// trusts.
  ///
  /// ⚠️ THE PIN IS NOT THE FREEZE. A pinned row on a card that is still open
  /// supersedes normally. The FREEZE is the card's status: a design card in the
  /// `done` category accepts no new version at all (`DESIGN_CARD_CLOSED`,
  /// MOTIR-5556, ADR §6c second amendment), so a design evolves after approval
  /// only once a person reopens its card. The only thing the pin changes is that
  /// the supersede stops unlinking this row's attachments, so the orphan-GC never
  /// reaches them.
  ///
  /// ⚠️ PER APPROVED VERSION, never "the approved one" (§6d). Approvals
  /// accumulate: a card approved, reopened and approved again holds two pinned
  /// rows, both fetchable. The FIRST pin wins on any one row — re-approving the
  /// same version keeps the timestamp of the decision that first bought it.
  pinnedAt        DateTime? @map("pinned_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workItem    WorkItem      @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  withdrawnBy User?         @relation("DesignEvidenceWithdrawnBy", fields: [withdrawnById], references: [id], onDelete: SetNull)
  assets      DesignAsset[]

  /// The panel read: an item's results, newest first (the current is the head).
  @@index([workItemId, createdAt(sort: Desc)])
  @@map("design_evidence")
}

/// ONE artifact of a {@link DesignEvidence} (Story MOTIR-2664 · Subtask
/// MOTIR-2666). A design result is a SET, not a fixed triple: a design PR may
/// touch several mocks and several exports, and some add no PNG — so the count
/// comes from the PR, never from a convention. The familiar
/// notes + mock + screenshot trio is the degenerate case.
///
/// `attachmentId` is nullable + SetNull so the orphan-GC removing a superseded
/// blob leaves the row (and the record of what was published) intact.
model DesignAsset {
  id               String          @id @default(cuid())
  /// Denormalized tenancy, exactly as every other RLS-gated table carries it:
  /// the policy is then a PURE active-workspace gate with no per-row subquery
  /// through the parent. Always equal to the parent evidence's workspace.
  workspaceId      String          @map("workspace_id")
  designEvidenceId String          @map("design_evidence_id")
  kind             DesignAssetKind
  attachmentId     String?         @unique @map("attachment_id")
  /// The repository path the file came from, e.g.
  /// `design/work-items/design-result.mock.html` — shown as provenance and
  /// used to group a mock with its same-basename export.
  sourcePath       String          @map("source_path")
  /// Render order within the result; stable across republishes.
  position         Int             @default(0)
  createdAt        DateTime        @default(now()) @map("created_at")

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  designEvidence DesignEvidence @relation(fields: [designEvidenceId], references: [id], onDelete: Cascade)
  attachment     Attachment?    @relation(fields: [attachmentId], references: [id], onDelete: SetNull)

  /// The panel read: one result's assets in render order.
  @@index([designEvidenceId, position])
  @@map("design_asset")
}

/// HOW TO TEST one work item's change in one repository (Story MOTIR-4906 ·
/// Subtask MOTIR-5328; `docs/decisions/approval-gates.md` §9).
///
/// The dispatched agent writes it onto the WORK ITEM through
/// `publish_test_instructions`, instead of into a pull-request body Motir cannot
/// read. A card whose pull requests land in two repositories carries two current
/// records, because install / migrate / seed / run differ per repository — a
/// single-repository card is the degenerate case of one.
///
/// VERSIONED like {@link DesignEvidence}: every publish is kept, and exactly one
/// row per `(workItemId, repoId)` is current (the partial unique index
/// `test_instructions_one_current_per_item_repo` enforces it). History is what
/// lets the item page say *these were written for an earlier commit* rather than
/// showing stale steps as though they were fresh.
///
/// The branch fetch is deliberately NOT stored: the read composes it from the
/// pull request's own `headRef`, so the copyable block always checks out the
/// branch Motir recorded rather than whatever the agent typed.
model TestInstructions {
  id            String   @id @default(cuid())
  /// Tenancy of record ON THE ROW — RLS does not traverse foreign keys (the
  /// `work_item_delivery` / `dispatch_run` precedent), so the policy stays a
  /// pure active-workspace gate with no per-row subquery.
  workspaceId   String   @map("workspace_id")
  projectId     String   @map("project_id")
  /// The RUN TARGET — the item the run was launched against (a story for a
  /// container / scoped run, the card itself for a single-card dispatch).
  /// `docs/decisions/approval-gates.md` §9's 2026-09-13 amendment: HOW TO TEST
  /// is per RUN, so one record per run lands here, never one per pull request.
  workItemId    String   @map("work_item_id")
  /// The run's HOW TO TEST as RICH TEXT (Markdown), exactly as the agent wrote it
  /// over MCP — sections allowed, every command in a fenced code block (rendered
  /// click-to-copy). `docs/decisions/approval-gates.md` §9 amendment, point 4.
  bodyMd        String   @map("body_md") @db.Text
  /// The path to open on the preview host, e.g. `/items/ACME-7`.
  previewPath   String?  @map("preview_path")
  /// The dispatch run that wrote it — the run this record is the output of. Null
  /// for a runbook-driven run with no dispatch row. SetNull: a pruned run loses
  /// attribution, never the record.
  dispatchRunId String?  @map("dispatch_run_id")
  /// WHO published it. SetNull, like every other audit stamp.
  publishedById String?  @map("published_by_id")
  isCurrent     Boolean  @default(true) @map("is_current")
  createdAt     DateTime @default(now()) @map("created_at")

  workspace   Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItem    WorkItem               @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  dispatchRun DispatchRun?           @relation(fields: [dispatchRunId], references: [id], onDelete: SetNull)
  publishedBy User?                  @relation("TestInstructionsPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  repos       TestInstructionsRepo[]

  /// The history read: one item's runs, newest first. Its column list is
  /// deliberately NOT the partial unique index's `(work_item_id)` — Prisma's
  /// differ pairs indexes by column list (the partial-index rule in CLAUDE.md,
  /// MOTIR-1960).
  @@index([workItemId, createdAt(sort: Desc)])
  @@index([workspaceId])
  @@map("test_instructions")
}

/// One REPOSITORY SECTION of a run's HOW TO TEST record (Story MOTIR-4906 ·
/// Subtask MOTIR-5328): the commit that repository's section was written for,
/// and the setup commands a reviewer runs after checking out its branch. A run
/// touching two repositories writes one `TestInstructions` with two of these.
model TestInstructionsRepo {
  id                 String @id @default(cuid())
  workspaceId        String @map("workspace_id")
  projectId          String @map("project_id")
  testInstructionsId String @map("test_instructions_id")
  /// FK → `GithubRepo`, the provider-agnostic repository row
  /// `github_pull_request.repo_id` and `work_item_delivery.repo_id` already key on.
  repoId             String @map("repo_id")
  /// The head commit this repository's section was written for.
  commitSha          String @map("commit_sha")
  /// Section order within the record, as the publisher gave it.
  position           Int    @default(0)

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testInstructions TestInstructions @relation(fields: [testInstructionsId], references: [id], onDelete: Cascade)
  repo             GithubRepo       @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([testInstructionsId, repoId])
  @@index([repoId])
  @@index([workspaceId])
  @@map("test_instructions_repo")
}

/// Which vocabulary of decision verbs a gate carries (the approval-gate ADR
/// `docs/decisions/approval-gates.md` §1, Story MOTIR-4778 · Subtask MOTIR-4788).
/// A Prisma enum rather than free text so the registry that dispatches on it is
/// TOTAL over its values and a compiler can prove a third kind cannot ship
/// half-wired. MOTIR-4790's registry registers ONE handler (`design_result`)
/// and carries deliberate compile-time holes for the other three.
enum ApprovalGateKind {
  /// A design result (mock + notes + screenshot) with NO pull request — approve
  /// is TERMINAL and writes `done` (Workflow A).
  design_result
  /// An agent-proposed decision DOC with NO pull request — approve accepts the
  /// agent's proposed decision.
  decision_approval
  /// A pull request's APPROVAL (the code was approved), any card WITH a PR. May
  /// be decided in Motir or synced from a GitHub review.
  pull_request_approval
  /// A pull request's MERGE — recorded when the host webhook lands the merge;
  /// the gate that the `pull_request_approval` decision caused.
  pull_request_merge
  /// A story's ACCEPTANCE RECEIPT (the acceptance video) — "is this what I
  /// wanted?". Raised on the STORY that owns the receipt, whatever the run target;
  /// on a story run it is the PRIMARY of two gates (ADR `approval-gates.md` §1,
  /// the MOTIR-5787 amendment).
  acceptance_result
  /// A person PICKS one of N options on a `type: choice` work item (Story
  /// MOTIR-4914; ADR `approval-gates.md` §1, the MOTIR-5887 amendment). No pull
  /// request — choosing is TERMINAL and writes `done` (Workflow A).
  decision_choice
  /// A person CONFIRMS — or OVERTURNS — a decision the planner settled WITH them:
  /// a `type: decision` + `executor: human` work item (Story MOTIR-5871; ADR
  /// `approval-gates.md` §1, the MOTIR-5952 amendment). No pull request — both
  /// verbs are TERMINAL (Workflow A): Confirm writes `done`, Overturn `cancelled`.
  decision_confirmation
  /// A person APPROVES — or DECLINES — a PLAN the planner wrote for them (Story
  /// MOTIR-6012; ADR `approval-gates.md` §11). The FIRST kind whose gate belongs
  /// to NO work item: `workItemId` is NULL on this kind and on no other
  /// (`approval_gate_work_item_iff_not_plan`), and `subjectId` is the `Plan.id`.
  /// UNREGISTERED until its handler lands (MOTIR-6035).
  plan_approval
  /// The REVIEW AGENT's question (Story MOTIR-1626 · MOTIR-6818; ADR `approval-gates.md`
  /// §12) — a hosted AI reviews the run target's green delivery SET against the card
  /// BEFORE the approve-and-merge gate is asked or anything auto-merges. Raised only
  /// when `Project.reviewAgentEnabled`; decided by the review run (`review_agent`) or
  /// by the routed person continuing without it (§12.3).
  agent_review
  /// MANUAL WORK a run reached and could not do (Story MOTIR-7460 · MOTIR-7474;
  /// `docs/decisions/manual-work-gate.md`). The subject is the work item itself;
  /// the decision is the card reaching Done through a person's door (Mark done).
  /// No pull request — Mark done is TERMINAL and writes `done` (Workflow A).
  manual_work

  /// A HOSTED PLANNING SESSION that needs its person (Story MOTIR-7905 · MOTIR-7913;
  /// ADR `approval-gates.md` §1's MOTIR-7906 amendment): the planner stopped with a
  /// WHAT question, or the conversation waits on the person's reply. Card-less like
  /// `plan_approval`, its subject is the `PlanChangeSession.id`, it is routed to the
  /// session's owner, and it has NO verbs — the person answers by sending a turn.
  planning_session

  @@map("approval_gate_kind")
}

/// Where a gate's decision stands (the ADR §6b). `awaiting` is written by the
/// product when the subject appears; `approved` / `changes_requested` by a
/// person; `superseded` by the product when the subject is superseded — a
/// withdrawn question that carries no actor, no permission and no note, so the
/// audit can never read it as a human decision.
enum ApprovalGateState {
  awaiting
  approved
  changes_requested
  superseded
  /// A person REFUSED the direction a `decision_confirmation` gate asked them to
  /// confirm — "that's not what we discussed" (Story MOTIR-5871 · MOTIR-5956; ADR
  /// `approval-gates.md` §1's MOTIR-5952 amendment, point 6). TERMINAL and carries a
  /// REQUIRED note; never overloads `changes_requested`, which is non-terminal.
  overturned
  /// A person ENDED the plan a `plan_approval` gate asked about (Story MOTIR-6012;
  /// ADR `approval-gates.md` §11.4). TERMINAL, its note OPTIONAL. Never
  /// `changes_requested` (non-terminal) and never `overturned` (a refused
  /// direction with a re-plan owed).
  declined

  @@map("approval_gate_state")
}

/// WHY a gate was superseded (Story MOTIR-5652 · Subtask MOTIR-5659;
/// `design-result.md` AMENDMENT 6 Q5, `approval-gates.md` §6b's MOTIR-5658
/// amendment).
///
/// §6b made a supersede write `state` and NOTHING else, so the row could not tell
/// the causes apart and every surface rendering one had to guess or go vague. That
/// is two shipped defects — MOTIR-5586 and MOTIR-5651 — which are the same false
/// sentence (_a newer design was published … the current version is above_) on two
/// surfaces, each repaired by making the sentence vaguer because the honest
/// sentence was the only one available.
///
/// ⚠️ ONE MEMBER PER WRITING PATH, AND NO MEMBER MEANING "UNSAID". An optional
/// cause would let the eighth superseding path — written by somebody who does not
/// know this history — write a row that says nothing, with nothing reporting that
/// it did. The repository writes take it as a REQUIRED argument so that omission
/// is a compile error at the one moment anybody is positioned to answer it.
///
/// `unknown` is NOT that hole: it means THIS ROW PREDATES THE COLUMN, which is a
/// different fact from any live cause, and the backfill is its only writer. A
/// surface renders it as *the reason was not recorded* — never as a real cause,
/// because reconstructing one from a row's shape manufactures evidence and these
/// sentences are shown to a person as fact.
enum ApprovalGateSupersedeCause {
  /// A newer design version superseded the one the gate asked about.
  republished
  /// The design result was withdrawn.
  withdrawn
  /// A member's head moved, so the commits are not the ones asked about.
  head_moved
  /// A member pull request closed.
  member_closed
  /// A member pull request was converted back to a DRAFT (MOTIR-5699).
  member_drafted
  /// A member pull request CONFLICTS with its base branch — the host reports it
  /// `dirty` at its head, found by a base-branch push or at the press (MOTIR-5914,
  /// for bug MOTIR-5907; design/github § 30).
  conflict
  /// A delivery row joined or left the card.
  set_changed
  /// CI reported a terminal FAILURE at the very commits the gate asked about
  /// (MOTIR-6271, for the bug of the same key; `approval-gates.md` §8's amendment,
  /// decision 2 — *every event that takes the set out of green withdraws it*).
  /// The CAN'T-LAND class, reached from the build rather than from the base:
  /// a red set cannot merge, so the question stops being one anybody can act on.
  ci_failed
  /// A check at the very commits the gate asked about is `pending` again — the set left
  /// green WITHOUT going red (MOTIR-6946, `approval-gates.md` §8's amendment, decision
  /// 2): a workflow run the raise could not see, a re-run, an App reporting late. The
  /// verdict is not in, so the question waits for the next green.
  ci_rerunning
  /// The work was pulled out of review, moved to Cancelled, or archived (MOTIR-7109).
  pulled_back
  /// A person re-opened a decided design gate (AMENDMENT 6 Q3's door back).
  /// Written ONLY by MOTIR-5659's backfill: this row predates the column.
  unknown
  /// The plan a `plan_approval` gate asked about went `stale` — a work item it
  /// changes reached a terminal status elsewhere (ADR `approval-gates.md` §11.7).
  plan_stale
  /// The plan's LAST proposal was withdrawn, so the plan was discarded (ADR
  /// `approval-gates.md` §11.7).
  plan_discarded
  /// The merge queue removed a member for a FAILURE at the commits the gate asked
  /// about — CAN'T-LAND since `approval-gates.md` §4's FIFTH AMENDMENT (MOTIR-6595).
  /// Only the convergence writes it, because a live failure raises no gate to withdraw.
  queue_failed
  /// The project turned its review agent OFF while this `agent_review` gate was
  /// awaiting (ADR `approval-gates.md` §12.5); the ordinary flow is raised instead.
  review_agent_disabled
  /// The gate's SUBJECT no longer resolves through its kind's handler — the design or
  /// recording it asked about is gone, the body no longer parses, the delivery set emptied
  /// (MOTIR-7146). Written when a read observes it, after the handler re-reads the subject
  /// under the gate's lock, so the question nobody can answer leaves To approve.
  subject_gone
  /// A `manual_work` gate's card stopped being manual — its executor or type was
  /// edited so a person no longer owes the work (MOTIR-7474;
  /// `docs/decisions/manual-work-gate.md` §6).
  no_longer_manual
  /// A `manual_work` gate's card reached a done status by a write nobody decided — the
  /// parent cascade, the rollup — so the question closes without being recorded as
  /// approved (MOTIR-7474; `docs/decisions/manual-work-gate.md` §6).
  closed_without_decision
  /// A `manual_work` gate's card stopped being ready for a person — it was moved to
  /// Blocked, or gained a `blocked_by` on unfinished work — so nobody can do the work
  /// it asks for (MOTIR-8670; `docs/decisions/manual-work-gate.md` §6, amended).
  not_ready
  /// A `manual_work` gate's card was re-planned — parked or moved to Planning, or a plan
  /// approval rewrote its title or body — so the card the run reached is not the card
  /// as planned (MOTIR-8670; `docs/decisions/manual-work-gate.md` §6, amended).
  replanned

  /// The person SENT A TURN on the planning session a `planning_session` gate asked
  /// about (MOTIR-7913) — the question is answered.
  answered
  /// The planning session a `planning_session` gate asked about ENDED, for any reason
  /// (MOTIR-7913).
  session_ended

  @@map("approval_gate_supersede_cause")
}

/// UNDER WHICH PERMISSION a gate was decided (the ADR §6a audit set · Subtask
/// MOTIR-4912). §2's amendment makes AUTHORITY `assignee OR reporter OR admin`,
/// and a role is a MOVING fact: a member promoted or demoted after the decision
/// makes "was this person entitled?" unanswerable from the membership table. So
/// the answer is FROZEN onto the row at decision time, as an enum rather than a
/// string, so a reader cannot meet a fourth spelling of `admin`.
///
/// It is the authority the decider ACTED under, not every authority they held:
/// an admin who is also the assignee decides under ONE of them, and the door
/// records which rung it checked.
enum ApprovalGateAuthority {
  /// The work item's assignee — the person the gate was routed to (§2).
  assignee
  /// The work item's reporter — the routing fallback when there is no assignee.
  reporter
  /// Decided under `approval:decide_any` — a gate the actor was NOT routed
  /// (MOTIR-5292). Until then it meant a workspace owner / admin; every such row
  /// was written by an actor who holds the key, so none is migrated.
  admin
  /// Authority conferred by the HOST'S REVIEW PERMISSION, not by Motir's §2
  /// relationship (ADR §8 FOURTH AMENDMENT, MOTIR-5590, decision 4). A GitHub
  /// reviewer is not the card's assignee or reporter and holds no Motir
  /// permission — an unmapped one holds no Motir anything — so none of the three
  /// above is true of them, and recording one would be a claim about a
  /// relationship that does not exist.
  ///
  /// ⚠️ NEVER RESOLVED BY `resolveGateAuthority`, and unreachable from a route, a
  /// press or the MCP: it is written only by the synced decision, whose actor
  /// arrives as an internal option. §2 is unchanged for every Motir surface.
  github_review
  /// Authority conferred by the permission `ai:decide_plan` ALONE — the
  /// `plan_approval` kind has no work item, so §2's relationship rungs are not true
  /// of its decider (ADR `approval-gates.md` §11.6).
  plan_permission
  /// The REVIEW AGENT (ADR `approval-gates.md` §12.3) — a hosted review run's verdict
  /// on an `agent_review` gate, through the run-token verdict route. `decidedById` is
  /// the run's attributed user; THIS column is what says a machine decided, so the row
  /// never claims a person reviewed the code. Never resolved by
  /// `resolveGateAuthority`, and unreachable from a person's press.
  review_agent
  /// Authority conferred by a PROJECT SETTING rather than by any person — the
  /// design gate a project with design approval switched OFF approves at raise
  /// time (MOTIR-697; `hosted-design-rerun-and-design-approval-switch.md` §2c).
  /// ⚠️ NEVER RESOLVED BY `resolveGateAuthority` and unreachable from a route, a
  /// press or the MCP: its ONE writer is the publish path's system decision.
  project_setting

  @@map("approval_gate_authority")
}

/// THROUGH WHICH SURFACE a decision arrived (the ADR §6a audit set, with
/// `github` added by §6b's MOTIR-4911 amendment · Subtask MOTIR-4912). A human
/// click must be distinguishable from a programmatic call, and both from a
/// review synced out of GitHub — an audit that cannot tell them apart cannot
/// answer whether a human was in the loop, which is the whole claim the table
/// exists to support.
enum ApprovalGateDecisionSource {
  /// A person pressed the control in Motir.
  ui
  /// A token called the REST API.
  api
  /// An agent called the MCP.
  mcp
  /// A review approved in GitHub's own UI, synced into the
  /// `pull_request_approval` gate (§4's amendment, §8 row 4b). None of the three
  /// above is true of it: nobody clicked in Motir, no token called the API, no
  /// agent called the MCP — and the approving identity may not resolve to a
  /// member at all, which is why `decidedByLabel` is not optional context.
  github
  /// NOBODY pressed anything: a project setting decided it (MOTIR-697;
  /// `hosted-design-rerun-and-design-approval-switch.md` §2c). Read with
  /// `decidedUnderAuthority = project_setting`. "The decisions people made" is every
  /// row whose source is one of the four above — a `system` row is never in it.
  /// ⚠️ Never accepted from a caller: the decide door's `source` input excludes it,
  /// and its ONE writer is the publish path's system decision.
  system

  @@map("approval_gate_decision_source")
}

/// The VERDICT a Motir-pressed refusal carries (Story MOTIR-6070 · MOTIR-6421; ADR
/// `approval-gates.md` §10d; widened by MOTIR-6501, `acceptance-refusal-verdict.md`
/// §1). Required on a Motir-pressed design refusal and a story-run acceptance refusal,
/// and refused on every other kind, run shape, verb and source by the decide door.
enum ApprovalGateRefusalVerdict {
  /// Send it back to be REVISED — the card returns to To do for the next run.
  revise
  /// The plan around it is wrong — the card returns to To do, and the decided band
  /// asks whether to open the planner seeded from this gate.
  re_plan

  @@map("approval_gate_refusal_verdict")
}

/// An APPROVAL GATE — one row per decision that holds work up, the
/// human-in-the-loop evidence an agent-driven pipeline owes an auditor (ADR
/// §6a). BASE record (MOTIR-4788): the subject, the kind, the state, who
/// decided it and when, and the note. The AUDIT columns (the immutable subject
/// version, the surviving actor label, the routed-to, the permission, the
/// source, the outcome) and the immutability guard land in a sibling
/// `blocked_by` this card — adding them here would re-cross the estimation gate
/// the epic-wide re-plan split along.
///
/// EAGER: a row is written when its subject appears (the design-result publish
/// or the `link_pull_request` call), not derived on read — the partial unique
/// index over the `awaiting` state and the decide door's `SELECT … FOR UPDATE`
/// both need a row to lock. A derived model is the eager model minus its index
/// and its lock.
///
/// `subjectId` is a polymorphic id (a `DesignEvidence` id; a pull-request
/// delivery id; …) resolved by the registry handler for its `kind`, NOT an FK —
/// the subject's table depends on the kind, and a polymorphic FK is worse than
/// none. RLS is a pure active-workspace gate (`ENABLE` + `FORCE`, no
/// `app.system_admin` hatch), mirroring `design_evidence` / `acceptance_evidence`.
model ApprovalGate {
  id          String            @id @default(cuid())
  workspaceId String            @map("workspace_id")
  projectId   String            @map("project_id")
  /// The card the gate hangs off — the join every read and every surface uses.
  /// NULL ⟺ `kind = plan_approval` (ADR `approval-gates.md` §11.1, enforced by the
  /// CHECK `approval_gate_work_item_iff_not_plan`): a plan gate belongs to no card,
  /// and what it is about is its `subjectId`, the `Plan.id`.
  workItemId  String?           @map("work_item_id")
  /// Which vocabulary of verbs applies (ADR §1).
  kind        ApprovalGateKind
  /// What is being decided — resolved by the registry handler for `kind`.
  subjectId   String            @map("subject_id")
  state       ApprovalGateState @default(awaiting)
  /// WHO decided. `SetNull` so a departing member loses attribution, never the
  /// record that a decision happened (mirrors `WorkItemTodo.doneById`). Read it
  /// beside `decidedByLabel`, which is what survives the deletion.
  decidedById String?           @map("decided_by_id")
  decidedAt   DateTime?         @map("decided_at")
  /// Why they said yes, or what they sent back. Free text, not an enum.
  noteMd      String?           @map("note_md") @db.Text

  // ── THE AUDIT SET (ADR §6a · Subtask MOTIR-4912) ───────────────────────────
  // Six fields that make this row EVIDENCE rather than a workflow row that
  // happens to keep a timestamp. Every one is NULLABLE — five are null while
  // `awaiting` and written by the decision; `routedToId` is written at CREATION
  // — so the migration adding them is additive and leaves existing rows valid.
  // They are WRITTEN by the decide door (MOTIR-4790) and the creation path,
  // never here: this card ships the columns, the DTO that carries them, and the
  // immutability guard that stops any of them being edited after the fact.

  /// ⚠️ THE ONE THAT CARRIES THE WHOLE CLAIM — the subject's IMMUTABLE VERSION
  /// at decision time: a `DesignEvidence.commitSha`, a pull request's `headSha`.
  ///
  /// Without it the row says somebody approved *a design*, and a design is a
  /// moving object — republished, superseded, reclaimed (§6c). With it the row
  /// says they approved *these bytes*, which is a fact that stays true. Opaque
  /// text rather than an FK, for the same reason `subjectId` is one: the
  /// version's shape depends on the kind, and a polymorphic FK is worse than
  /// none.
  subjectVersion        String?                     @map("subject_version")
  /// WHO decided, SURVIVING THEIR DEPARTURE — the actor's name and email as at
  /// the decision, denormalised beside the nullable FK above.
  ///
  /// `decidedById` is `SetNull`, which preserves THAT a decision happened and
  /// destroys WHO made it — the one thing the audit is for. And a null FK
  /// already means something else, and something worse: §6b's `superseded` uses
  /// exactly that shape to mean *the question was withdrawn and nobody decided
  /// it*, so an unattributable decision recorded as a bare null is
  /// indistinguishable, in the one table an auditor trusts, from a decision that
  /// never happened. It also carries the GITHUB LOGIN for a synced approval
  /// whose identity resolves to no member (§6b's amendment) — *"a GitHub
  /// identity we could not map, and here is the handle"* is true and legible;
  /// *"nobody"* is neither.
  decidedByLabel        String?                     @map("decided_by_label")
  /// WHO THE GATE WAS ROUTED TO at creation — §2's answer, computed once.
  ///
  /// The assignee can change afterwards, so the live card cannot answer who the
  /// product actually ASKED. `SetNull` with NO surviving label, deliberately and
  /// unlike `decidedById`: the harm §6a names for this field is the ROUTING
  /// moving, not the person leaving, and the attribution the audit is built
  /// around is the DECIDER's. A gate can be routed to nobody, hence nullable.
  routedToId            String?                     @map("routed_to_id")
  /// UNDER WHICH PERMISSION — the §2 authority rung the door actually checked,
  /// frozen on the row so *"was this person entitled?"* survives a role that has
  /// since changed.
  decidedUnderAuthority ApprovalGateAuthority?      @map("decided_under_authority")
  /// THROUGH WHICH SURFACE the decision arrived — `ui` / `api` / `mcp`, plus
  /// `github` for a synced review (§6b's amendment).
  decisionSource        ApprovalGateDecisionSource? @map("decision_source")
  /// WHAT IT CAUSED — the merge commit sha, or the transition applied. Closes
  /// the loop from decision to effect.
  ///
  /// ⚠️ Written IN the deciding write, never backfilled, and the immutability
  /// guard is what holds that. The guard's width is not an accident this field
  /// has to live with: §4 attempts the merge FIRST and RENDERS a refusal rather
  /// than recording a decision (*"an approval that does not merge is a note, not
  /// a gate"*), and §6c requires the retention pin in the decision's own
  /// transaction for the same reason — so the outcome is known before the row is
  /// written.
  outcomeRef            String?                     @map("outcome_ref")
  /// WHAT A CHOICE PICKED (Story MOTIR-4914 · MOTIR-5893; ADR `approval-gates.md`
  /// §1's MOTIR-5887 amendment, point 7) — `{ optionId, label, bestFor, followUp,
  /// situation }`, taken from the body's parse at the decided version and written
  /// IN the deciding write, so `trg_approval_gate_decided_immutable` holds it with
  /// the rest of the row. Null on every other kind and on a choice sent back.
  chosenOption          Json?                       @map("chosen_option")
  /// WHAT A CONFIRMED DECISION'S WRITTEN RECORD WAS (Story MOTIR-5871 · MOTIR-5954;
  /// ADR `approval-gates.md` §1's MOTIR-5952 amendment, point 8) — a discriminated
  /// union: `{ kind: 'attachment', attachmentId, originalFilename, mimeType,
  /// sizeBytes, createdAt }` or `{ kind: 'none' }`, stamped IN the deciding write.
  /// A page arm (MOTIR-5761) is a new `kind`, never a migration. Null on every
  /// other kind and on an undecided or overturned decision.
  confirmedRecord       Json?                       @map("confirmed_record")
  /// WHAT A PERSON MEANT BY "NO" on a refused `design_result` gate, or a story run's
  /// `acceptance_result` gate (Story MOTIR-6070 · MOTIR-6421, MOTIR-6501; ADR
  /// `approval-gates.md` §10d, amended by `design-refusal-verdict.md` and
  /// `acceptance-refusal-verdict.md`) — `revise` or `re_plan`, chosen at the press and
  /// stamped IN the deciding write, so `trg_approval_gate_decided_immutable` holds it
  /// with the rest of the row. ⚠️ A COLUMN OF ITS OWN, NOT `outcomeRef`: the surfaces
  /// that repaint a card read `outcomeRef` as a status key. Null on every approval, on
  /// every kind that offers no verdict, on a GitHub-synced refusal (nobody was asked),
  /// and on every gate decided before this column existed.
  refusalVerdict        ApprovalGateRefusalVerdict? @map("refusal_verdict")

  /// WHY this gate was superseded — null for every row that is not `superseded`,
  /// and `unknown` for a row superseded before the column existed (MOTIR-5659).
  /// Nullable is the right shape and is NOT the "unsaid" hole the enum's own
  /// comment forbids: a live supersede supplies a cause because the repository
  /// write REQUIRES one, so null here means the row was never superseded at all.
  ///
  /// ⚠️ It carries no actor, no authority and no note, exactly as `state` does not
  /// (§6b). A cause says what HAPPENED to the question; it must never make a
  /// withdrawn question readable as a decision somebody made.
  supersededCause ApprovalGateSupersedeCause? @map("superseded_cause")

  /// WHY an `agent_review` gate's review COULD NOT RUN (ADR `approval-gates.md` §12.6)
  /// — the hosted start's refusal code (out of credits, no model offered, a
  /// repository the run cannot read, …) or `no_verdict` for a run that ended without
  /// one. Written on the AWAITING gate, never in `noteMd` (which is the decider's),
  /// and cleared when *Review again* starts a new run. Null on every other kind.
  reviewUnavailableReason String? @map("review_unavailable_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItem           WorkItem?           @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  /// Both relations to `User` carry a NAME because there are two of them now and
  /// an unnamed pair is ambiguous. A relation name does not change a constraint
  /// name — the FK is derived from table + column — so `decidedBy`'s existing
  /// `approval_gate_decided_by_id_fkey` is untouched, and `migrate diff` reports
  /// only the additions.
  decidedBy          User?               @relation("ApprovalGateDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  routedTo           User?               @relation("ApprovalGateRoutedTo", fields: [routedToId], references: [id], onDelete: SetNull)
  /// The planning sessions this REFUSED gate seeded (MOTIR-6207; AMENDMENT 17 §9
  /// of `agent-authored-plans.md`). SetNull on the session side.
  seededPlanSessions PlanChangeSession[] @relation("PlanChangeSessionSeedGate")

  /// The WORKSPACE-tier read: a workspace's gates by state. Kept for
  /// MOTIR-2920's "what is on me across everything" surface, which is the
  /// caller it was added for.
  /// The automatic hosted re-run a Revise on this gate caused or skipped (MOTIR-700).
  designAutoRerun    DesignAutoRerun?
  /// The runs that closed `gated` waiting on this gate (MOTIR-7703).
  heldRuns           DispatchRunHeldGate[]
  /// What its approval did about resuming the hosted run it held (MOTIR-7710).
  gateResume         GateResume?
  /// The page versions this gate FROZE at its approval (Story MOTIR-5761 ·
  /// MOTIR-7428). SetNull on the version side: the freeze outlives the row.
  frozenPageVersions PageVersion[]         @relation("PageVersionFrozenByGate")

  @@index([workspaceId, state])
  /// THE ROUTING READ's index (MOTIR-4791) — the Approvals tab asks for one
  /// PROJECT's `awaiting` gates, because the Workbench is active-project scoped
  /// (MOTIR-2761), and the workspace index above cannot serve that: a workspace
  /// with many projects would scan every project's gates to render one
  /// project's tab. The routing half of the predicate (`assignee_id ??
  /// reporter_id`) lives on `work_item` and is reached from these rows by
  /// primary key, so narrowing the GATE side is what the plan needs.
  @@index([projectId, state])
  /// THE APPROVALS ROOM's OWN-RECORDS decided read (MOTIR-5301) — *what did I
  /// decide in this project*, `project_id = ? AND decided_by_id = ? AND state IN
  /// (approved, changes_requested) ORDER BY decided_at DESC, id DESC`. Nothing
  /// served it: the queue only ever asked what is WAITING, so `(projectId, state)`
  /// narrows to one project's decided rows and then filters every other person's
  /// decisions out of them. Equality on the first two columns and the sort on the
  /// third lets the plan walk the index backwards and stop at `LIMIT` (only an
  /// incremental sort on the `id` tie-break is left). Measured on 300k gates: 29
  /// buffers with it, 4,641 without; the `EXPLAIN` is on MOTIR-5301's pull request.
  @@index([projectId, decidedById, decidedAt])
  /// The per-card read: every gate on one work item.
  @@index([workItemId])
  /// THE CARD-LESS LOOKUP (ADR `approval-gates.md` §11.2) — a `plan_approval` gate
  /// has no `work_item_id`, so "is there a live gate for this plan?" is keyed on the
  /// kind and the subject. ⚠️ Its column list is deliberately NOT `(subject_id,
  /// kind)`, the list of the raw-SQL partial unique index
  /// `approval_gate_one_awaiting_per_cardless_subject`: the differ pairs indexes by
  /// column list and would report a permanent rename (CLAUDE.md's partial-index rule).
  @@index([kind, subjectId, state])
  @@map("approval_gate")
}

/// WHAT A DESIGN REVISE DID ABOUT AN AUTOMATIC HOSTED RE-RUN (Story MOTIR-693 ·
/// MOTIR-700; `docs/decisions/hosted-design-rerun-and-design-approval-switch.md` §1).
///
/// ONE ROW PER REFUSAL, keyed on the deciding gate — which is what makes the job that
/// writes it idempotent (a redelivered event finds the row and does nothing) and what
/// lets the design card say, per Revise, whether a run started or why not (§1g).
///
/// Written only for a refusal that WAS a candidate: a Motir-pressed Revise on a card
/// whose latest dispatch run was hosted. A card last run BYOK or by hand gets no row
/// at all — nothing was attempted, so there is nothing to say (§1a).
model DesignAutoRerun {
  id          String @id @default(cuid())
  /// Tenant of record — RLS does not traverse foreign keys.
  workspaceId String @map("workspace_id")
  workItemId  String @map("work_item_id")
  /// The `changes_requested` + `revise` design gate this attempt answers. Unique:
  /// one refusal, one attempt.
  gateId      String @unique @map("gate_id")

  outcome       DesignAutoRerunOutcome
  /// Why nothing started. Null exactly when `outcome` is `started`.
  skipReason    DesignAutoRerunSkipReason? @map("skip_reason")
  /// The run it started. `SET NULL`: the record that a run was started outlives the run.
  dispatchRunId String?                    @map("dispatch_run_id")
  /// Which automatic re-run of this card this was, counting Motir-pressed Revise
  /// refusals (§1e). The cap reads the same count; storing it lets the line say "2 of 3".
  ordinal       Int
  /// What the skipped line NAMES, captured when it was written (MOTIR-702; the design's
  /// `design-result--auto-rerun.mock.html`): the dispatcher's name for
  /// `no_project_access`, the model for `model_not_offered`, the repository for
  /// `repository_not_writable`. Null for every other outcome. A record of the moment, so
  /// the line still says who it was after that person's name changes.
  detail        String?

  createdAt DateTime @default(now()) @map("created_at")

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workItem    WorkItem     @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  gate        ApprovalGate @relation(fields: [gateId], references: [id], onDelete: Cascade)
  dispatchRun DispatchRun? @relation(fields: [dispatchRunId], references: [id], onDelete: SetNull)

  /// The card's line: its attempts, newest first.
  @@index([workItemId, createdAt])
  @@map("design_auto_rerun")
}

enum DesignAutoRerunOutcome {
  /// A hosted run was started, as the last hosted run's dispatcher, with its model.
  started
  /// Nothing started; `skipReason` says why and the card waits at To do for a person.
  skipped

  @@map("design_auto_rerun_outcome")
}

/// Why an automatic re-run did not start (§1d, §1e). Each is a refusal of the SAME
/// start path Run hosted takes, except the cap and a missing dispatcher.
enum DesignAutoRerunSkipReason {
  /// The card has had its three automatic re-runs (§1e).
  cap_reached
  /// The last hosted run's dispatcher no longer exists.
  dispatcher_gone
  /// The dispatcher can no longer edit the project.
  no_project_access
  /// The organization's CI allowance refused the dispatch.
  ci_credits_exhausted
  /// The model the last run used is no longer offered. Never substituted (§1d).
  model_not_offered
  /// The model list could not be read.
  models_unavailable
  /// The organization is out of credits.
  out_of_credits
  /// The credit balance could not be read.
  credits_unavailable
  /// A repository the run touches is not writable.
  repository_not_writable
  /// The card is not ready or not claimable (for example, a person claimed it first).
  card_not_ready

  @@map("design_auto_rerun_skip_reason")
}

/// A comment on a work item (Story 5.1 · Subtask 5.1.1) — the Activity
/// section's conversation layer. Threaded ONE level deep (the Jira-verified
/// decision recorded in scripts/plan-seed/data/story-5.1.ts): a root comment
/// has `parentCommentId = NULL`, a reply points at a root, and depth >1 is
/// rejected in the SERVICE (5.1.2) — the column is just the self-relation.
///
/// `bodyMd` is Markdown source — the same substrate as
/// `work_item.descriptionMd` (one storage format; mentions serialize into it
/// as `[@Name](mention:<userId>)` tokens). `editedAt` is set on a BODY edit
/// and drives the "Edited" tag — deliberately distinct from `updatedAt`,
/// which any write touches. Delete is a HARD delete (Jira-faithful: no
/// tombstone) — deleting a root cascades its replies (the `parent`
/// self-relation) and its mention rows; what survives is the
/// `work_item_revision` deletion record the service writes (5.1.2).
///
/// `workspaceId` is the denormalized tenancy gate every read filters on
/// (finding #26) and the RLS policy tests (pure workspace gate, mirroring
/// `attachment` / `sprint` — policy in the add_comments_and_rls migration).
/// `author` is Restrict, mirroring WorkItem.reporter: a user with comments
/// on record cannot be hard-deleted silently.
model Comment {
  id              String    @id @default(cuid())
  workspaceId     String    @map("workspace_id")
  workItemId      String    @map("work_item_id")
  authorId        String    @map("author_id")
  parentCommentId String?   @map("parent_comment_id")
  bodyMd          String    @map("body_md") @db.Text
  // Public-visible marker (Story 6.12 · Subtask 6.12.6, per
  // docs/decisions/public-projects.md §4 — the comment split). A
  // PUBLIC-REQUEST comment (authored on a public project through the
  // `canCommentPublicRequest` grant) is `true`; the work item's INTERNAL
  // discussion (every Story 5.1 comment) stays `false`. The 6.12.4 public
  // projection returns ONLY `isPublic` comments for a request and never the
  // internal thread — so the line is a data fact, not a UI convention.
  isPublic        Boolean   @default(false) @map("is_public")
  editedAt        DateTime? @map("edited_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  workspace     Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workItem      WorkItem                  @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  author        User                      @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  parent        Comment?                  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies       Comment[]                 @relation("CommentReplies")
  mentions      CommentMention[]
  // The (change request, head commit, card) THIS comment is the CI feedback for
  // — MOTIR-3770. CASCADE, deliberately: deleting the comment must leave no
  // dangling id for the next delivery to edit, which is the property that keeps
  // a webhook retry loop from forming.
  ciFeedbackFor GithubCiFeedbackComment[]

  // The paged list read (newest-first cursor walk, 5.1.2) + the thread read.
  @@index([workItemId, createdAt])
  @@index([parentCommentId])
  @@index([workspaceId])
  @@map("comment")
}

/// One validated @mention inside a comment (Subtask 5.1.1) — the queryable
/// "comments mentioning me" substrate Epic 6 search filters on and the 5.1.6
/// notification job fans out from. The SERVICE (5.1.2) is the authority: it
/// parses `[@Name](mention:<userId>)` tokens out of `bodyMd`, validates each
/// user can VIEW the issue, dedups, and persists these rows in the same
/// transaction as the comment write. `@@unique([commentId, mentionedUserId])`
/// keeps one row per mention regardless of how many times a token repeats.
/// No `workspaceId` by design (the work_item_revision pattern — denormalizing
/// tenancy onto a child row would let it lie); the RLS policy joins through
/// `comment` instead.
model CommentMention {
  id              String   @id @default(cuid())
  commentId       String   @map("comment_id")
  mentionedUserId String   @map("mentioned_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  comment       Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUser User    @relation(fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@unique([commentId, mentionedUserId])
  // The "mentions me" read path (Epic 6 search; the unique above already
  // serves the by-comment lookup).
  @@index([mentionedUserId])
  @@map("comment_mention")
}

/// ONE STEP of a work item's own work (Story MOTIR-3808 · Subtask MOTIR-3813),
/// specified by `docs/decisions/work-item-todo-list.md`.
///
/// A to-do is ONE OPERATION — *change this one setting*, *run this one command*
/// — and deliberately NOT a small work item: a short plain-text line with
/// state, no Markdown body, no criteria of its own. The bar is a NUMBER
/// (`TODO_TEXT_MAX_LENGTH`) the service rejects past with a typed error, so it
/// is a constraint rather than advice (ADR §1).
///
/// ⚠️ TENANCY IS ON THE ROW, and which of the schema's two shapes applies is
/// decided by the tier, not by taste. `Comment` is a DIRECT child of
/// `work_item` and carries its own `workspace_id`, gated on it by RLS;
/// `CommentMention` is a GRANDCHILD and reaches tenancy through its parent. A
/// to-do is a direct child, so it takes the comment's shape — and it has to,
/// because RLS does not traverse foreign keys.
///
/// `executor` is the SHIPPED `Executor` enum, reused rather than mirrored, and
/// it is DECLARATIVE: it records who an operation is FOR and authorizes nothing
/// (ADR §2). A person may tick an agent's step; an agent's step with nothing
/// able to run it renders as the agent's with no run control, never disabled.
/// Nullable exactly as `work_item.executor` is, and seeded from the parent
/// card's own value at create.
///
/// `position` is the SAME opaque fractional index `work_item.position` and
/// `workflow_status.position` use (`lib/workItems/positioning.ts`), so a
/// reorder is a ONE-ROW write rather than a renumber of everything below it.
///
/// `doneAt` IS the done state — there is no `isDone` boolean beside it, because
/// two columns encoding one fact can disagree (`doneAt` set with `isDone false`
/// would be representable and meaningless). `doneById` is SetNull so a
/// departing member cannot erase the record that a step was completed.
model WorkItemTodo {
  id            String    @id @default(cuid())
  workspaceId   String    @map("workspace_id")
  workItemId    String    @map("work_item_id")
  /// The step, in plain text. One operation. Capped by the service at
  /// `TODO_TEXT_MAX_LENGTH` — see the model note on why the number is a
  /// constraint and `lib/workItemTodos/limits.ts` for its single home.
  text          String    @db.Text
  /// The INSTRUCTIONS for this one operation — optional Markdown, the *how*.
  ///
  /// ⚠️ THIS IS NOT A SECOND WORK ITEM, and the reason is what it does NOT
  /// carry: no status, no assignee, no dependencies, no sprint, no estimate, no
  /// executor of its own, and nothing dispatches it. Prose is not what makes
  /// something a work item — `Comment` has a Markdown body and is not one
  /// either. Capped by the service at `TODO_NOTES_MAX_LENGTH`; above that it
  /// stops being the how of one operation and starts being a document, which is
  /// the point at which it genuinely wants a card (ADR §1, *Instructions*).
  ///
  /// The row's `text` still answers *"is this one operation?"* on its own
  /// one-line bar — NAVIGATION IS NOT AN OPERATION, so "go to the dashboard,
  /// find the setting" belongs here and never as three tickable rows.
  notesMd       String?   @map("notes_md") @db.Text
  /// The language `text` / `notesMd` were written in (Story MOTIR-7731 ·
  /// MOTIR-8092): a `lib/i18n/locales.ts` code, or NULL for "no language
  /// recorded". No default, so an unrecorded row never reads as `en`.
  textLanguage  String?   @map("text_language")
  notesLanguage String?   @map("notes_language")
  /// The command this step runs, when it runs one — its OWN column, never
  /// parsed out of `text` (ADR §5). Non-null ⇔ the row is copyable; a parse
  /// would break on the first sentence containing a backtick, and silently.
  commandText   String?   @map("command_text") @db.Text
  executor      Executor?
  position      String    @db.Text
  doneAt        DateTime? @map("done_at")
  doneById      String?   @map("done_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workItem  WorkItem  @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  doneBy    User?     @relation("WorkItemTodoCompletedBy", fields: [doneById], references: [id], onDelete: SetNull)

  // The list read, already in display order — the section reads a card's whole
  // list ordered by `position`, so the index serves it without a sort.
  @@index([workItemId, position])
  @@index([workspaceId])
  @@map("work_item_todo")
}

/// One KEPT translation of one work content FIELD (Story MOTIR-7735 ·
/// MOTIR-8114): per field, per revision of that field's text, per target
/// language. Shared across the organisation — the key holds no reader, so two
/// readers in one language read one row.
///
/// ⚠️ STALENESS IS A PROPERTY OF THE LOOKUP. `sourceHash` is `sha256` (hex) of
/// the field's text when it was translated, and every read supplies the
/// field's CURRENT text: a row for older text never matches, so it is never
/// served, and no edit path has to hook anything. Superseded rows are removed
/// when a fresh translation of the same field and language is kept, and by the
/// work item's cascade. The table holds no copy of the source text.
///
/// `fieldRef` is built only by `lib/translation/fieldRevision.ts`: `title`,
/// `description`, `explanation`, `todo:<todoId>:text`, `todo:<todoId>:notes`.
/// A to-do's rows go with the CARD, not the to-do: a deleted to-do's rows are
/// unreachable (no field asks for that ref) until the card is deleted.
///
/// Tenanted on the row: `workspace_id` for the `app.workspace_id` arm every
/// work-item read binds, `organization_id` for the org arm — RLS does not
/// traverse foreign keys.
model WorkItemTranslation {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  workspaceId    String   @map("workspace_id")
  workItemId     String   @map("work_item_id")
  fieldRef       String   @map("field_ref")
  sourceHash     String   @map("source_hash")
  /// A `lib/i18n/locales.ts` code, validated in code (`isLocale`).
  targetLanguage String   @map("target_language")
  translatedText String   @map("translated_text") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workItem     WorkItem     @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@unique([workItemId, fieldRef, sourceHash, targetLanguage])
  /// The per-item read: every kept field of one card in one language.
  @@index([workItemId, targetLanguage])
  @@index([organizationId])
  @@index([workspaceId])
  @@map("work_item_translation")
}

/// A project-scoped label (Story 5.4 · Subtask 5.4.1) — the folksonomy row.
/// Jira labels are site-GLOBAL; project scoping is the recorded justified
/// deviation (the global pool leaking across projects is the mirror's
/// documented pain — open suggestion JRACLOUD-23656). Folksonomy semantics
/// (the SERVICE, 5.4.2, is the authority): labels are created by TYPING in
/// the issue field (find-or-create), there is NO admin UI, and a label row
/// lives ONLY while used — removing its last `work_item_label` join row
/// deletes the label (delete-on-last-use; no orphan-label GC needed by
/// design). `name` keeps the first-typed display casing; `nameLower` is the
/// case-INSENSITIVE uniqueness key per project (the wart-fix decision: Jira's
/// 'Performance' vs 'performance' duplicate complaint, JRACLOUD-24907) and
/// the autocomplete prefix-match column (`searchByPrefix`, bounded take).
/// No-spaces / length / per-issue-cap validation is service-layer (5.4.2) —
/// the schema carries only the uniqueness invariant.
model Label {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  projectId   String   @map("project_id")
  name        String
  nameLower   String   @map("name_lower")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItems WorkItemLabel[]

  // Case-insensitive uniqueness per project; doubles as the autocomplete
  // prefix-scan index (searchByPrefix walks projectId = ? AND name_lower
  // LIKE 'q%', bounded).
  @@unique([projectId, nameLower])
  @@index([workspaceId])
  @@map("label")
}

/// Issue ↔ label join row (Subtask 5.4.1) — labels are multi-valued.
///
/// ⚠️ THE EPIC-6 JOIN-PREDICATE CONTRACT (documented beside the 5.3.1
/// custom-field one): the Story 6.1 filter builder compiles a by-label
/// filter into a REAL join predicate — no array column, no JSON:
///
///   SELECT wi.* FROM "work_item" wi
///   JOIN "work_item_label" wil ON wil."work_item_id" = wi."id"
///   JOIN "label" l            ON l."id" = wil."label_id"
///   WHERE l."project_id" = $1 AND l."name_lower" = $2
///
/// The `@@index([labelId])` below is the reverse edge that join walks
/// ("issues carrying label X"); the `@@unique([workItemId, labelId])` serves
/// the forward direction ("labels of issue Y") as its left-prefix. Both
/// FKs Cascade: deleting an issue sheds its label joins; deleting a label
/// (the service's delete-on-last-use path) sheds nothing in practice — the
/// row only deletes at zero uses.
/// No `workspaceId` by design (the comment_mention / work_item_revision
/// pattern — denormalized tenancy on a child row could lie); the RLS policy
/// joins through the parent `work_item` instead.
model WorkItemLabel {
  id         String   @id @default(cuid())
  workItemId String   @map("work_item_id")
  labelId    String   @map("label_id")
  createdAt  DateTime @default(now()) @map("created_at")

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  label    Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([workItemId, labelId])
  // The Epic-6 by-label reverse edge (see the contract block above) AND the
  // service's `countUsesByLabel` (the delete-on-last-use guard count).
  @@index([labelId])
  @@map("work_item_label")
}

/// A project component (Story 5.4 · Subtask 5.4.1) — the admin-managed
/// taxonomy ("which part of the product"), mirroring company-managed Jira:
/// name (required, case-insensitively unique per project — same `nameLower`
/// mechanic as `label`), optional description, optional DEFAULT ASSIGNEE.
/// Managed at Project settings → Components by project admins (the 6.4
/// two-tier gate, enforced in the SERVICE, 5.4.3); issues carry multiple
/// components via `work_item_component`.
///
/// `defaultAssigneeId` is the verified Jira five-way default-assignee enum
/// COLLAPSED to a nullable user (recorded simplification: Motir has no
/// project-lead concept and component *lead* exists in Jira chiefly to feed
/// that enum — the lead field is the documented extension). `SetNull`: a
/// departed user clears the default, never blocks deletion. The at-create
/// assignment rule (unassigned new issue takes the default of its
/// first-alphabetical component that has one) lives in the service (5.4.3).
model Component {
  id                String   @id @default(cuid())
  workspaceId       String   @map("workspace_id")
  projectId         String   @map("project_id")
  name              String
  nameLower         String   @map("name_lower")
  description       String?  @db.Text
  defaultAssigneeId String?  @map("default_assignee_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  defaultAssignee User?               @relation("ComponentDefaultAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)
  workItems       WorkItemComponent[]

  @@unique([projectId, nameLower])
  @@index([workspaceId])
  @@map("component")
}

/// Issue ↔ component join row (Subtask 5.4.1) — components are multi-valued.
///
/// ⚠️ THE EPIC-6 JOIN-PREDICATE CONTRACT (the by-component twin of the
/// `work_item_label` sketch above):
///
///   SELECT wi.* FROM "work_item" wi
///   JOIN "work_item_component" wic ON wic."work_item_id" = wi."id"
///   WHERE wic."component_id" = $1
///
/// served by the `@@index([componentId])` reverse edge; the
/// `@@unique([workItemId, componentId])` left-prefix serves "components of
/// issue Y".
///
/// `componentId` is **Restrict** — deliberately asymmetric with the label
/// join's Cascade: a component delete MUST run the service's verified
/// move-or-remove flow (5.4.3: move the joins to another component, or
/// remove them — issues untouched either way) before the row can go; the
/// DB backstops any missed path. `workItemId` Cascades (an issue delete
/// sheds its component joins). No `workspaceId` by design — RLS joins
/// through the parent `work_item` (the comment_mention pattern).
model WorkItemComponent {
  id          String   @id @default(cuid())
  workItemId  String   @map("work_item_id")
  componentId String   @map("component_id")
  createdAt   DateTime @default(now()) @map("created_at")

  workItem  WorkItem  @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  component Component @relation(fields: [componentId], references: [id], onDelete: Restrict)

  @@unique([workItemId, componentId])
  // The Epic-6 by-component reverse edge (contract above), the service's
  // `countItemsByComponent` (the delete dialog's count + in-use check), and
  // the `reassignItems` move branch all walk this.
  @@index([componentId])
  @@map("work_item_component")
}

/// A project TOPIC TAG (Story 6.13 · Subtask 6.13.5) — the category axis that
/// makes the public-project SQUARE browsable by topic (the GitHub-Topics /
/// GitLab-Topics mirror). UNLIKE `label` / `component` (project-scoped
/// folksonomies), a tag is a SHARED, NORMALIZED vocabulary row reused across
/// every project: one `ProjectTag` per topic, many projects assigned to it via
/// `ProjectTagAssignment`. The vocabulary is CURATED (the admin assigns from the
/// bounded set in `lib/projectTags/vocabulary.ts`, never mints free-text — the
/// "clean browse axis, not a long tail of near-dupes" decision the card seals),
/// so a tag carries no workspace/tenant scope: it is system-level reference data
/// the service materializes by `slug` on first assignment (idempotent upsert).
/// `slug` is the stable URL-safe handle the 6.13.3 category filter keys off;
/// `label` is the display name.
model ProjectTag {
  id        String   @id @default(cuid())
  slug      String   @unique
  label     String
  createdAt DateTime @default(now()) @map("created_at")

  assignments ProjectTagAssignment[]

  @@map("project_tag")
}

/// Project ↔ tag join (Subtask 6.13.5) — a project carries multiple topic
/// tags, a tag spans multiple projects (the shared-vocabulary shape). BOTH FKs
/// are modelled as Prisma `@relation` on both sides (the CLAUDE.md
/// FK-as-`@relation` rule — no raw-SQL-only FK), and BOTH Cascade: deleting a
/// project sheds its assignments, and removing a tag from the vocabulary sheds
/// the assignments that referenced it (the assignment is pure linkage, never the
/// owner of either side).
///
/// `@@unique([projectId, tagId])` keeps a tag assigned at most once per project
/// (the set semantics the per-project tagging service relies on) AND serves the
/// forward "tags of project Y" read as its left-prefix. The `@@index([tagId])`
/// is the reverse edge the tag-FACET read walks — "how many PUBLIC projects
/// carry tag X" — counting through to the project being public (the 6.13.2
/// filter the category counts respect; it read `project.access_level = 'public'`
/// until the level was retired for `access_mode` and dropped by MOTIR-6694), so
/// a tag's count is its
/// public-project count and a tag with only non-public projects never inflates
/// the square.
model ProjectTagAssignment {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  tagId     String   @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag     ProjectTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([projectId, tagId])
  @@index([tagId])
  @@map("project_tag_assignment")
}

/// A watcher row (Story 5.4 · Subtask 5.4.1): `userId` follows `workItemId`
/// for notifications — distinct from assignee. The verified Jira contract
/// (enforced in the SERVICE, 5.4.4): anyone who can VIEW the issue watches
/// THEMSELVES (a `viewer` may watch — watching is not editing); project
/// admin + workspace admin/owner manage OTHERS; a watcher MUST hold view
/// access (we reject with a typed error where Jira silently drops — the
/// documented trap, fixed). Auto-watch on create/comment is the service's
/// constant-on hook (the Story-5.7 preference is the documented seam).
/// Watch/unwatch writes NO `work_item_revision` row (mirror: watching is
/// not a field change). The 5.4.5 notification job pages through an issue's
/// watchers off the unique's left-prefix; `@@index([userId])` is the
/// "issues I watch" read Stories 5.7 / Epic 6 want.
///
/// Both FKs Cascade: an issue hard-delete sheds its watchers; a deleted
/// user simply stops watching (notification substrate, not audit — the
/// comment_mention precedent, NOT the reporter Restrict). No `workspaceId`
/// by design — RLS joins through the parent `work_item`.
model Watcher {
  id         String   @id @default(cuid())
  workItemId String   @map("work_item_id")
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workItemId, userId])
  // The "issues I watch" read path (Story 5.7 / Epic 6).
  @@index([userId])
  @@map("watcher")
}

/// One in-app notification row (Story 5.7 · Subtask 5.7.2) — the persistence
/// layer behind the header bell + unread feed. WRITTEN by the 5.7.3 fan-in job
/// (a SECOND consumer of the SHIPPED channel-agnostic 5.1.6 events, beside the
/// email job — never a second emit path) and READ by the 5.7.4
/// `notificationsService`. A row is FOR exactly one recipient; every read is
/// scoped to the session user.
///
/// The badge-vs-row split (the Jira/Linear-verified model, Story 5.7 desc): the
/// bell badge is a SEEN-since-last-open count the drawer clears, while `readAt`
/// is PER-ROW read state (the blue-dot / greyed driver) — distinct concepts, so
/// the schema carries `readAt` and the badge is a cheap unread aggregate over
/// the partial index below.
///
/// `type` is a STRING discriminator, NOT a Prisma enum — the deliberate
/// justified deviation (the "no complexity for nothing" rule, inverted: the
/// EXTENSIBILITY use case earns the looser shape). The 5.7.3 handler is
/// registry-driven so Story 5.4 (`transitioned`) and Story 6.6 (`created` /
/// `field.changed`) fan in by ADDING a registry entry + a 5.7.6 preference-
/// matrix row, with NO migration and no 5.7 change. An enum would force a
/// schema migration per new event type, defeating that seam. The 5.7.6
/// preference matrix keys on this same string. `category` IS an enum: the
/// Direct/Watching drawer split is Jira's closed two-tab set, not extensible.
///
/// `data` (Json) is the DENORMALIZED render payload captured at fan-in (issue
/// key + title, actor name, comment excerpt, from→to status) so the feed read
/// is a single-table scan — no join storm per row (finding #57).
///
/// Idempotency: `dedupeKey` carries the SOURCE identity (e.g. `comment:<id>` /
/// `mentioned:<revisionId>`), scoped per recipient by `@@unique([dedupeKey,
/// recipientUserId])`. This mirrors the SHIPPED 5.1.6 email idempotency
/// (`mention:<sourceId>:<userId>`, keyed on the stable source id — NOT the
/// per-delivery Inngest event id, which a comment-edit re-fire changes), the
/// decision-ladder rung-2 precedent. A replayed/retried event `createMany`s
/// with `skipDuplicates`, so the unique turns a double-write into a no-op.
///
/// Every FK is a two-sided Prisma `@relation` with explicit `onDelete` (the
/// FK-as-@relation migration rule; the 2.3.7 attachment-FK drift lesson):
/// recipient Cascade, actor SetNull, workItem Cascade, workspace Cascade.
///
/// RLS: pure workspace gate (NON-NULL `workspace_id`), the same single
/// PERMISSIVE FOR ALL policy as `comment` — see the migration. The PER-USER
/// scoping (a user reads only their OWN rows) is an APPLICATION concern the
/// 5.7.4 service enforces (`recipientUserId = session user`); RLS is the
/// tenant boundary, not the per-user boundary.
model Notification {
  id              String               @id @default(cuid())
  workspaceId     String               @map("workspace_id")
  recipientUserId String               @map("recipient_user_id")
  type            String
  category        NotificationCategory
  workItemId      String?              @map("work_item_id")
  actorId         String?              @map("actor_id")
  data            Json
  dedupeKey       String               @map("dedupe_key")
  readAt          DateTime?            @map("read_at")
  createdAt       DateTime             @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipient User      @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  actor     User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  workItem  WorkItem? @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  // Idempotency — one row per (source event × recipient); a replayed event's
  // createMany(skipDuplicates) no-ops against this.
  @@unique([dedupeKey, recipientUserId])
  // The feed cursor walk: newest-first per recipient, optionally narrowed by
  // category. `id` is the cursor tie-break (createdAt alone is not a total
  // order — PRODECT_FINDINGS #38); it is the @id, so no extra index needed.
  @@index([recipientUserId, createdAt])
  // The RLS workspace gate.
  @@index([workspaceId])
  // NOTE: the cheap unread-count aggregate is backed by a PARTIAL index
  //   CREATE INDEX notification_unread_idx ON notification(recipient_user_id)
  //     WHERE read_at IS NULL
  // created in raw migration SQL — Prisma's schema DSL cannot express a
  // WHERE-filtered index (the workflow_status_one_initial_per_project /
  // board_one_default_per_project precedent), so it lives in the migration and
  // is intentionally absent here. migrate dev does not drift on it.
  @@map("notification")
}

/// The two drawer tabs of Jira's notification surface (Story 5.7 · 5.7.2):
/// `direct` = the actions involving YOU (mentioned / assigned / reporter —
/// "mentions first", the default tab), `watching` = items you watch (the
/// Story 5.4 `work-item/transitioned` fan-in slot, populated when 5.4 lands —
/// no 5.7 change). A CLOSED set (Jira ships exactly these two), so an enum,
/// unlike the open `type` string above.
enum NotificationCategory {
  direct
  watching

  @@map("notification_category")
}

/// Per-user notification PREFERENCES (Story 5.7 · Subtask 5.7.6) — the Jira
/// *Personal settings → Notification settings* shape, generalized to a
/// per-user × EVENT-TYPE × CHANNEL toggle matrix. One row = "user U wants (or
/// not) channel C for event-type E". The resolved value is the single CHANNEL
/// GATE consulted by BOTH the 5.7.3 in-app fan-in job (the `in_app` channel)
/// AND the DONE 5.1.6 email job (the `email` channel) — toggling a channel off
/// suppresses that channel without touching either emit site (the event still
/// fires once; only the SEND decision asks the resolver).
///
/// ABSENCE = the documented DEFAULT (the resolver supplies it — an unset row is
/// NOT "off"; direct/mention events default ON for both channels). So an
/// untouched user has ZERO rows and still gets the default behaviour; a row
/// exists only once the user has explicitly toggled that (event, channel) cell.
///
/// `eventType` is a String (NOT an enum) to match `Notification.type` — the
/// SAME open event-type axis, so Story 5.4 (`transitioned`) and Story 6.6
/// (`created` / `field.changed`) extend it with no migration. `channel` is a
/// CLOSED two-value set, so an enum (the `NotificationCategory` precedent).
model NotificationPreference {
  id        String              @id @default(cuid())
  userId    String              @map("user_id")
  eventType String              @map("event_type")
  channel   NotificationChannel
  enabled   Boolean
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  user User @relation("UserNotificationPreferences", fields: [userId], references: [id], onDelete: Cascade)

  // One row per (user × event-type × channel): the upsert target the settings
  // toggle and the resolver both key on.
  @@unique([userId, eventType, channel])
  // The resolver's per-user read (the settings-page matrix + the gate lookups).
  @@index([userId])
  @@map("notification_preference")
}

/// Cross-device appearance sync — the per-user persistence row for the 3-axis
/// design system (Story 7.3 · Subtask 7.3.59). A cookie (how the language pref
/// works) is per-device and won't sync; this DB-backed 1:1-with-User row does.
/// Modelled on `NotificationPreference`'s absence-semantics: every column is
/// NULLABLE and **NULL/absent = the documented DEFAULT** — an untouched user
/// has no row at all and the resolver supplies the defaults. A single typed row
/// (not a generic key-value `UserPreference`): the pref set is fixed + small,
/// so typed columns are clearer and type-safe.
model UserAppearancePreference {
  // The user this preference belongs to — 1:1 (`@unique`), so a user has at
  // most one row.
  userId     String   @unique @map("user_id")
  // The four appearance axes (the theme context's `pattern` / `styleId` /
  // `paletteId` / `typeId`). All NULLABLE: a null column means "use the
  // documented default for that axis" (resolved in the service — 7.3.60).
  pattern    String?
  styleId    String?  @map("style_id")
  paletteId  String?  @map("palette_id")
  typeId     String?  @map("type_id")
  // The fifth axis (Story MOTIR-7736 · Subtask MOTIR-7894): one optional
  // font-set member id PER LOCALE, the person's pick for that language. A
  // column per locale, not one JSON map, so two tabs saving different locales
  // each write one column and both land with no read-merge-write. NULL means
  // "automatic" — the locale's set default (the registry in
  // `@motir/design-system`'s `theme/fontSets.ts` is the source of truth; the
  // service validates against it and the mapper drops a stale member).
  fontPickEn String?  @map("font_pick_en")
  fontPickZh String?  @map("font_pick_zh")
  fontPickJa String?  @map("font_pick_ja")
  fontPickKo String?  @map("font_pick_ko")
  fontPickDe String?  @map("font_pick_de")
  fontPickFr String?  @map("font_pick_fr")
  fontPickEs String?  @map("font_pick_es")
  fontPickIt String?  @map("font_pick_it")
  fontPickNl String?  @map("font_pick_nl")
  fontPickPl String?  @map("font_pick_pl")
  fontPickPt String?  @map("font_pick_pt")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation("UserAppearancePreference", fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_appearance_preference")
}

/// The notification delivery channels (Story 5.7 · Subtask 5.7.6). A CLOSED set
/// — `email` (the DONE 5.1.6 job) and `in_app` (the 5.7.3 bell feed) — so an
/// enum. Mobile/native push is explicitly out of scope (a non-Motir surface).
enum NotificationChannel {
  email
  in_app

  @@map("notification_channel")
}

/// The five per-project custom-field types (Story 5.3). Each maps 1:1 to a
/// verified member of Jira's team-managed set: Short text / Number / Date /
/// Dropdown (single-select — multi-select is a separate mirror type, a
/// documented extension) / People (restricted to single). Additive types
/// (paragraph, checkbox-multi, labels, multi-person, formula) extend this
/// enum + add a value column on the same typed-EAV substrate.
enum CustomFieldType {
  text
  number
  date
  select
  user

  @@map("custom_field_type")
}

/// A per-project custom-field DEFINITION (Story 5.3 · Subtask 5.3.1) — the
/// extensible-schema layer mirroring Jira team-managed "Project settings →
/// Fields". Fields are project-scoped, never shared across projects (the
/// team-managed rule); the service layer (5.3.2) caps them at 50 per project.
///
/// `key` is the machine slug — the stable handle revision diffs
/// (`customFields.<key>`) and Epic-6 predicates reference. Generated from the
/// label at create time and IMMUTABLE afterwards (renames touch `label` only),
/// unique per project. The key/label split + fractional `position` mirror the
/// `WorkflowStatus` project-scoped-config precedent.
///
/// Tenancy mirrors `workflow_status`: explicit non-null `workspaceId` + RLS
/// (ENABLE + FORCE) gating on `app.workspace_id` — the pure workspace-gate
/// policy (see the add_custom_fields migration).
model CustomFieldDefinition {
  id          String          @id @default(cuid())
  workspaceId String          @map("workspace_id")
  projectId   String          @map("project_id")
  key         String
  label       String
  fieldType   CustomFieldType @map("field_type")
  description String?
  /// Fractional index (the `WorkflowStatus` convention — opaque base-62 keys
  /// from lib/workItems/positioning.ts that sort lexicographically), so a
  /// field reorder is a single-row write.
  position    String          @db.Text
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Managed options (select fields). Cascades: deleting a field removes its
  // option rows.
  options   CustomFieldOption[]
  // Stored values. Cascades: team-managed field delete is hard — immediate,
  // permanent, values destroyed (the service confirms with the value count).
  values    CustomFieldValue[]

  @@unique([projectId, key])
  @@index([projectId, position])
  @@index([workspaceId])
  @@map("custom_field_definition")
}

/// A managed option of a `select` custom field (Story 5.3). Options are ROWS,
/// not a JSON config blob: orderable (fractional `position`), renameable, and
/// FK-able from value rows — the archive/delete rules need referential
/// integrity. The verified Jira split: an option may be ARCHIVED any time
/// (hidden from new selection; existing values keep rendering) but may be
/// DELETED only when unused — the value FK's `Restrict` backstops that rule
/// at the DB layer. The service (5.3.2) caps options at 55 per field.
///
/// No denormalized `workspaceId` (by design — the row's tenancy is its
/// field's): RLS joins through the parent definition, the
/// `work_item_revision` / `comment_mention` pattern.
model CustomFieldOption {
  id        String   @id @default(cuid())
  fieldId   String   @map("field_id")
  label     String
  /// Fractional index — same shape as the parent definition's `position`.
  position  String   @db.Text
  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  field  CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  // Values holding this option. Restrict (see CustomFieldValue.valueOption):
  // the service must clear/migrate values before an option hard-deletes.
  values CustomFieldValue[]

  @@index([fieldId, position])
  @@map("custom_field_option")
}

/// A custom-field VALUE on a work item (Story 5.3) — typed EAV, the shape
/// Jira's own `customfieldvalue` table uses (STRINGVALUE / NUMBERVALUE /
/// DATEVALUE… columns). One row per (workItemId, fieldId) pair — the unique
/// is the upsert target; clearing a value DELETES the row (no tombstones).
/// Exactly ONE per-type column is populated per row (matching the field's
/// `fieldType`); the service layer (5.3.3) is the validation authority.
///
/// ── THE EPIC-6 PREDICATE CONTRACT (Story 6.1 consumes this) ───────────────
/// Typed value columns + the four `[fieldId, value*]` indexes exist so the
/// 6.1 filter builder compiles REAL JOIN predicates — no JSON parsing, every
/// probe index-served. The sketch, for "issues where Severity = High":
///
///   SELECT w.* FROM "work_item" w
///   JOIN "custom_field_value" v
///     ON v."work_item_id" = w."id"
///    AND v."field_id"       = $severityFieldId
///   WHERE v."value_option_id" = $highOptionId;
///
/// — served by @@index([fieldId, valueOptionId]). Number/date range filters
/// (`Effort >= 3`, `Go-live < 2026-07-01`) ride [fieldId, valueNumber] /
/// [fieldId, valueDate] the same way; user filters ride [fieldId,
/// valueUserId]; text probes ride the per-item unique ([workItemId, fieldId])
/// or escalate to Epic-6's search infrastructure. "Field is empty" compiles
/// to NOT EXISTS on the same join (absent row == empty — no tombstones is
/// what makes that sound).
/// ──────────────────────────────────────────────────────────────────────────
///
/// FK actions, each deliberate: workItem/field Cascade (values die with the
/// issue; team-managed field delete destroys values), valueUser SetNull (a
/// deleted user clears the value, never blocks — the assignee semantics),
/// valueOption Restrict (the DB backstop of the only-when-unused option
/// delete). Tenancy: explicit non-null `workspaceId` + the pure
/// workspace-gate RLS policy (the `work_item` pattern).
model CustomFieldValue {
  id            String    @id @default(cuid())
  workspaceId   String    @map("workspace_id")
  workItemId    String    @map("work_item_id")
  fieldId       String    @map("field_id")
  valueText     String?   @map("value_text") @db.Text
  /// Decimal, not Float — preserves scale, no floating-point drift (the
  /// `storyPoints` rationale). Prisma's default Postgres mapping (numeric)
  /// keeps arbitrary precision; the service caps input range.
  valueNumber   Decimal?  @map("value_number")
  /// Date-only (the dueDate convention: date-only ISO, UTC-safe).
  valueDate     DateTime? @map("value_date") @db.Date
  valueUserId   String?   @map("value_user_id")
  valueOptionId String?   @map("value_option_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workItem    WorkItem              @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  field       CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  valueUser   User?                 @relation(fields: [valueUserId], references: [id], onDelete: SetNull)
  valueOption CustomFieldOption?    @relation(fields: [valueOptionId], references: [id], onDelete: Restrict)

  // One value per (issue, field) pair — the upsert target; also serves the
  // by-item read (listByWorkItem) as its leading column is workItemId.
  @@unique([workItemId, fieldId])
  // The Epic-6 predicate indexes (see the contract block above).
  @@index([fieldId, valueOptionId])
  @@index([fieldId, valueNumber])
  @@index([fieldId, valueDate])
  @@index([fieldId, valueUserId])
  @@index([workspaceId])
  @@map("custom_field_value")
}

/// Saved-filter visibility (Story 6.2). Two levels — `private` (the owner +
/// project/workspace admins, who can SEE every filter but manage only shared
/// ones) and `project` (everyone who can browse the project, riding the 6.4
/// gate). Jira Cloud's six share scopes + per-filter Viewers/Editors grant
/// lists presuppose site-global filters and groups, which Motir doesn't
/// have — the recorded two-visibility deviation; the grant list is the
/// documented extension.
enum SavedFilterVisibility {
  private
  project

  @@map("saved_filter_visibility")
}

/// A saved filter (Story 6.2 · Subtask 6.2.1) — a named, owned, shareable
/// row carrying the SAME versioned FilterAST envelope the `?filter=v1:` URL
/// codec serializes (one codec, two carriers — see lib/filters/ast.ts
/// encode/decodeFilterEnvelope). `astEnvelope` stores the compact wire form
/// PLUS the version field (`{ v, c, f }`); every read decodes +
/// registry-validates it (never trust-and-compile), so a malformed or
/// future-versioned envelope degrades to a typed recoverable state and a
/// stale open referent (deleted member/sprint/status) falls under the 6.1.2
/// match-nothing rule.
///
/// Project-contained, not site-global (the recorded 6.2 deviation: the AST's
/// referents and the whole search substrate are project-scoped); name is
/// case-insensitively unique per project via the `name`/`nameLower` split
/// (the `label` mechanic — two "Sprint blockers" in one shared dropdown is
/// ambiguity nobody wants). Owner Cascade mirrors `uploadedAttachments`
/// (admins change owner FIRST when a filter must survive a departure —
/// Jira's admin power, project-sized).
model SavedFilter {
  id          String                @id @default(cuid())
  workspaceId String                @map("workspace_id")
  projectId   String                @map("project_id")
  ownerId     String                @map("owner_id")
  name        String
  nameLower   String                @map("name_lower")
  description String?               @db.Text
  visibility  SavedFilterVisibility @default(private)
  astEnvelope Json                  @map("ast_envelope")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  workspace        Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project          Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner            User                      @relation("SavedFilterOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  stars            SavedFilterStar[]
  // Filter-sourced dashboard widgets (Story 6.3). SetNull: a deleted
  // filter STALES the widget (the designed "filter missing" card) — the
  // verified Cloud gadget behaviour the 6.2.1 dependents read counts.
  dashboardWidgets DashboardWidget[]
  // Per-user email subscriptions (Subtask 6.2.5). Cascade: deleting a filter
  // removes its subscriptions in the same transaction (the 6.2.1 delete cascade
  // the dependents warning enumerates).
  subscriptions    SavedFilterSubscription[]

  // Case-insensitive uniqueness per project; doubles as the directory /
  // dropdown search index (list reads walk projectId = ? AND name_lower
  // LIKE/ILIKE, bounded + cursor-paged in name_lower order).
  @@unique([projectId, nameLower])
  // The "my filters" view (ownerId = ? within a project read).
  @@index([projectId, ownerId])
  @@index([workspaceId])
  @@map("saved_filter")
}

/// Saved-filter star (Story 6.2) — the per-user pin that floats a filter to
/// the top of the dropdown (Jira's starred-first Filters menu). Pure
/// preference substrate, not audit: both FKs Cascade (the `watcher`
/// precedent). Star counts aggregate in SQL over the `@@unique` left prefix
/// (the directory's popularity column — finding #57: never a JS count over
/// all rows). No `workspaceId` by design (the work_item_label pattern —
/// denormalized tenancy on a child row could lie); the RLS policy joins
/// through the parent `saved_filter` instead.
model SavedFilterStar {
  id            String   @id @default(cuid())
  savedFilterId String   @map("saved_filter_id")
  userId        String   @map("user_id")
  createdAt     DateTime @default(now()) @map("created_at")

  savedFilter SavedFilter @relation(fields: [savedFilterId], references: [id], onDelete: Cascade)
  user        User        @relation("SavedFilterStarUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([savedFilterId, userId])
  // The "starred" dropdown group ("filters I starred" within a project read).
  @@index([userId])
  @@map("saved_filter_star")
}

/// Filter-subscription schedule preset (Story 6.2 · Subtask 6.2.5) — Jira's
/// preset tier (the advanced-cron editor is the recorded extension). `daily`
/// (every day at `hour`), `weekdays` (Mon–Fri at `hour`), `weekly` (the row's
/// `weekday` at `hour`). The hourly cron ticks and these decide due-ness.
enum SavedFilterSubscriptionSchedule {
  daily
  weekdays
  weekly

  @@map("saved_filter_subscription_schedule")
}

/// Per-user filter subscription (Story 6.2 · Subtask 6.2.5) — emails the first
/// 50 results + total count of a saved filter on a preset schedule, resolved AS
/// the subscriber at send time (the 6.2.1 permission matrix applies). Runs on
/// the Story 1.6 jobs substrate (the `dailyHealthCheck` cron precedent): an
/// hourly cron ticks, lists DUE rows across every workspace, and fans each out
/// as one delivery event.
///
/// `hour` is interpreted in UTC — the app's pinned timezone (lib/utils/datetime
/// pins UTC everywhere; no per-workspace timezone is persisted yet, the
/// recorded extension). UTC has no DST, so due-ness is stable across the wall-
/// clock shifts a local timezone would introduce. `weekday` (0=Sunday … 6=
/// Saturday, JS `getUTCDay`) is set only for `weekly` and ignored otherwise.
///
/// Tenancy: `workspaceId` is DENORMALIZED (unlike `saved_filter_star`, which
/// joins through its parent) BECAUSE the cross-workspace cron tick scans this
/// table under `withSystemContext` and must enqueue a workspace-scoped delivery
/// event WITHOUT reading the RLS-protected parent `saved_filter` (whose policy
/// has no system-admin branch). `saved_filter.workspace_id` is immutable (no
/// write path changes it), so the denormalized copy cannot drift — the
/// "could lie" risk the star comment guards against does not apply here.
model SavedFilterSubscription {
  id            String                          @id @default(cuid())
  workspaceId   String                          @map("workspace_id")
  savedFilterId String                          @map("saved_filter_id")
  userId        String                          @map("user_id")
  schedule      SavedFilterSubscriptionSchedule
  /// 0=Sun … 6=Sat (JS getUTCDay); set only when `schedule = weekly`.
  weekday       Int?
  /// 0–23, interpreted in UTC.
  hour          Int
  createdAt     DateTime                        @default(now()) @map("created_at")
  updatedAt     DateTime                        @updatedAt @map("updated_at")

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  savedFilter SavedFilter @relation(fields: [savedFilterId], references: [id], onDelete: Cascade)
  user        User        @relation("SavedFilterSubscriptionUser", fields: [userId], references: [id], onDelete: Cascade)

  // One subscription per (filter, user) — re-subscribing edits the schedule.
  @@unique([savedFilterId, userId])
  // The hourly cron's due scan walks `hour = ?` (then filters schedule/weekday).
  @@index([hour])
  // The delete-cascade + dependents count walk the filter; the workspace index
  // backs cross-workspace operator reads.
  @@index([savedFilterId])
  @@index([workspaceId])
  @@map("saved_filter_subscription")
}

/// The trigger event an automation rule fires on (Story 6.6 · Subtask 6.6.1) —
/// Jira's four most-used issue-event triggers (rung-1 verified). Stored as a
/// column (not only inside `triggerConfig`) so the engine loads a project's
/// matching rules with an indexed `project_id, trigger_type, enabled` read
/// rather than scanning + JSON-probing. The registry in lib/automation/registry.ts
/// is the matching TOTAL source of truth for the per-type config shape; these
/// identifiers are byte-identical to the registry's trigger-type ids.
enum AutomationTriggerType {
  created
  transitioned
  field_changed
  commented

  @@map("automation_trigger_type")
}

/// The outcome of one rule execution (Story 6.6 · Subtask 6.6.2 writes these;
/// 6.6.1 ships the table). `success` = the action list ran; `failure` = an
/// action threw (the typed error is recorded); `no_actions` = the condition
/// group gated the rule out (a matched trigger whose conditions didn't hold —
/// distinct from a failure, the verified Jira "no actions performed" outcome);
/// `plan_held` = a `transition` action met a card an undecided plan holds at
/// `planning` (`PLAN_TARGET_HELD`, recorded in `error`) — the card is not the
/// rule's to move while a plan rewrites it, so this is neither a success nor a
/// failure and never counts toward auto-disable (MOTIR-6340;
/// `agent-authored-plans.md` AMENDMENT 21 §5(b)). `held_by_mark` = a `transition`
/// action met a card carrying an obsolescence mark (`MARKED_CARD_CANNOT_REOPEN`,
/// recorded in `error`) — a marked card stays finished, so the rule declined, and like
/// `plan_held` it is neither a success nor a failure (MOTIR-6681).
enum AutomationExecutionStatus {
  success
  failure
  no_actions
  plan_held
  org_closing
  held_by_mark

  @@map("automation_execution_status")
}

/// An automation rule (Story 6.6 · Subtask 6.6.1) — project-scoped
/// when/then: ONE trigger (`triggerType` + typed `triggerConfig`) → one flat
/// condition group (`conditionAst`, the 6.1 FilterAST envelope shape,
/// row-capped 20) → an ordered `actions` list (max 10). Actions run as the
/// `owner` (the recorded 6.6 deviation: the rule actor is the admin who
/// created it, not a synthetic app user). `consecutiveFailureCount` drives the
/// verified auto-disable-at-10 (the engine, 6.6.2, increments it; enabling a
/// rule resets it). The three JSON columns are validated by the TOTAL
/// trigger/action registries + the 6.1 condition validation at the service
/// layer — never trust-and-execute; a stale referent (deleted status/field)
/// degrades typed, the 6.1 rule.
model AutomationRule {
  id                      String                @id @default(cuid())
  workspaceId             String                @map("workspace_id")
  projectId               String                @map("project_id")
  ownerId                 String                @map("owner_id")
  name                    String
  enabled                 Boolean               @default(true)
  triggerType             AutomationTriggerType @map("trigger_type")
  triggerConfig           Json                  @map("trigger_config")
  conditionAst            Json                  @map("condition_ast")
  actions                 Json
  consecutiveFailureCount Int                   @default(0) @map("consecutive_failure_count")
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")

  workspace  Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project    Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner      User                      @relation("AutomationRuleOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  // The execution audit log cascades with the rule (deleting a rule clears its
  // history — the per-rule log has no meaning without the rule).
  executions AutomationRuleExecution[]

  // The engine's hot read: a project's enabled rules for a given trigger.
  @@index([projectId, triggerType, enabled])
  @@index([workspaceId])
  @@map("automation_rule")
}

/// One execution-audit row (Story 6.6 · Subtask 6.6.2 writes them; 6.6.1 ships
/// the table + relations). `workItemId` is NULLABLE and SetNull on the work
/// item's delete: the audit log outlives the triggering issue (its history is
/// kept; the UI renders a tombstone for the gone item — 6.6.6). No
/// `workspace_id` by design (the saved_filter_star pattern: denormalised
/// tenancy on a child row could lie) — the RLS policy joins through the parent
/// `automation_rule`. Indexed `[ruleId, createdAt]` for the paged per-rule log
/// (6.6.6) and the 90-day retention sweep (6.6.2).
model AutomationRuleExecution {
  id         String                    @id @default(cuid())
  ruleId     String                    @map("rule_id")
  status     AutomationExecutionStatus
  workItemId String?                   @map("work_item_id")
  error      String?                   @db.Text
  durationMs Int?                      @map("duration_ms")
  /// The id of the job event this run processed (Subtask 6.6.2). The engine
  /// claims an (rule, event) pair before executing actions and the partial
  /// unique index below makes that claim atomic, so an Inngest replay / retry
  /// of the same event never double-executes a rule's actions — the verified
  /// "idempotent per (event × rule)" contract. Nullable for the rare context
  /// (a manual/test write) that carries no event id; NULLs don't collide.
  eventId    String?                   @map("event_id")
  createdAt  DateTime                  @default(now()) @map("created_at")

  rule     AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  workItem WorkItem?      @relation(fields: [workItemId], references: [id], onDelete: SetNull)

  @@index([ruleId, createdAt])
  // The idempotency claim — one execution row per (rule, event). Partial
  // (event_id IS NOT NULL) so no-event writes never collide; declared in raw
  // SQL in the 6.6.2 migration (Prisma can't express a partial unique index).
  @@map("automation_rule_execution")
}

/// Dashboard access (Story 6.3) — who may SEE a dashboard. `private` =
/// owner-only; `workspace` = every workspace member (read-only; edit stays
/// owner-only). Jira's richer audience matrix (user/group/project-role/
/// public viewer + editor lists) is the documented extension this enum
/// grows into — the recorded 6.3 deviation.
enum DashboardAccess {
  private
  workspace

  @@map("dashboard_access")
}

/// Dashboard column layout (Story 6.3) — the Jira edit-mode column count.
enum DashboardLayout {
  one
  two
  three

  @@map("dashboard_layout")
}

/// The TOTAL widget-type vocabulary (Story 6.3). Every value MUST have a
/// `lib/dashboards/widgetRegistry.ts` entry (config schema + data-source
/// resolver + renderer/editor kinds) — the registry enumeration test fails
/// on any gap (mistake #29). More gadget types (Assigned to Me, Activity
/// Stream, …) are registry + enum additions, the documented extension.
enum DashboardWidgetType {
  filter_results
  distribution
  created_vs_resolved
  average_age
  resolution_time
  workload

  @@map("dashboard_widget_type")
}

/// Dashboard (Story 6.3) — a named, shareable widget grid, scoped to the
/// WORKSPACE (our "site" — the recorded deviation from Jira's site-level
/// dashboards; the shell's outer boundary). Any member creates; the owner
/// alone mutates (rename / relayout / access / delete / widget edits).
/// Owner FK cascades (the SavedFilter owner semantics — change owner is a
/// future extension; today a departing user takes their dashboards).
model Dashboard {
  id          String          @id @default(cuid())
  workspaceId String          @map("workspace_id")
  ownerId     String          @map("owner_id")
  name        String
  access      DashboardAccess @default(private)
  layout      DashboardLayout @default(two)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User              @relation("DashboardOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  widgets   DashboardWidget[]

  // The list read (mine + workspace-shared within the active workspace).
  @@index([workspaceId])
  @@map("dashboard")
}

/// Dashboard widget (Story 6.3) — one gadget on a dashboard. The data
/// source is EXACTLY ONE of `savedFilterId` / `projectId` (the verified
/// Jira gadget pattern), enforced by the widget registry at the service
/// boundary; the FK split is deliberate:
///   * `savedFilterId` — `SetNull`: deleting a filter STALES the widget
///     (the designed "filter missing" card), never deletes it — the
///     verified Cloud gadget behaviour. The 6.2.1 delete-dependents
///     enumeration counts these rows before the delete.
///   * `projectId` — `Cascade`: a deleted project takes its widgets (no
///     meaningful stale state — the workspace no longer contains the data).
/// `position` is the shipped base-62 fractional index
/// (`lib/workItems/positioning.ts`) within `column`, so drag-reorder is a
/// one-field write (the board precedent). `config` holds the per-type
/// settings the registry's schema validates (page size / statistic type /
/// period + days-back + cumulative). No `workspaceId` by design (the
/// saved_filter_star pattern — denormalized tenancy on a child row could
/// lie); RLS joins through the parent dashboard.
model DashboardWidget {
  id            String              @id @default(cuid())
  dashboardId   String              @map("dashboard_id")
  type          DashboardWidgetType
  column        Int
  position      String
  config        Json
  savedFilterId String?             @map("saved_filter_id")
  projectId     String?             @map("project_id")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  dashboard   Dashboard    @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  savedFilter SavedFilter? @relation(fields: [savedFilterId], references: [id], onDelete: SetNull)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // The getDashboard read: widgets in render order.
  @@index([dashboardId, column, position])
  // The 6.2.1 delete-dependents count + the SetNull fan-out.
  @@index([savedFilterId])
  // The project-delete cascade fan-out.
  @@index([projectId])
  @@map("dashboard_widget")
}

/// Personal access token (Story 7.8 · Subtask 7.8.1) — the per-user bearer
/// credential AI agents present to the MCP server (`Authorization: Bearer
/// motir_pat_…`). The Jira / GitHub API-token shape: generated once, shown
/// once, stored ONLY as a sha-256 hash, expiring, revocable.
///
/// The plaintext secret is NEVER persisted — only `tokenHash` (the lookup
/// key) and `tokenPrefix` (the display-only first chars, so the list can show
/// `motir_pat_AbC1…` without holding anything sensitive). Revoking DELETES the
/// row (MOTIR-3546): the list holds live credentials only, and `revokedAt`
/// survives as an unused transition guard (see the field).
/// RLS: a token row is visible/mutable to its owning user
/// (`app.user_id`) for the settings surface, OR under the trusted system
/// context (`app.system_admin`) — the MCP bearer gate resolves tokens BEFORE
/// any user context exists (the pre-auth lookup), so it reads under the
/// system context (the job-ledger precedent).
model ApiToken {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  /// The workspace this token is BOUND to (Story 7.8 · bug 7.21). A PAT is
  /// workspace-scoped (the verified Linear mirror: keys are created in, listed
  /// per, and act within ONE workspace), captured from the creator's ACTIVE
  /// workspace at mint time. The MCP bearer gate (`verifyMcpToken`) resolves the
  /// request workspace from THIS column — NOT the owner's default workspace — so
  /// a token minted in workspace A always acts on A (the bug 7.21 fix). The
  /// Settings list is filtered to this column, so a token shows only in the
  /// workspace it belongs to. Cascade: a deleted workspace takes its tokens.
  workspaceId   String    @map("workspace_id")
  /// User-facing name, e.g. "claude-code".
  label         String
  /// sha-256 hex of the full secret — the lookup key. Unique so `verify` is a
  /// single equality probe on a unique index (constant work per call).
  tokenHash     String    @unique @map("token_hash")
  /// First 12 chars of the secret (display-only), so the list can show
  /// `motir_pat_AbC1…`. Never enough to reconstruct the secret.
  tokenPrefix   String    @map("token_prefix")
  /// Null = never expires. The boundary is checked in `verify`.
  expiresAt     DateTime? @map("expires_at")
  /// Throttled in `verify` (skip the write if touched < 5 min ago) so a
  /// chatty agent session does not write-amplify.
  lastUsedAt    DateTime? @map("last_used_at")
  /// ⚠️ RETAINED, UNUSED, AND SCHEDULED FOR REMOVAL (MOTIR-3546).
  ///
  /// This was the soft-revoke stamp: revoking set it and left the row "for the
  /// audit trail". Nothing ever read that trail, so a revoked credential sat in
  /// the owner's token list for ever with no way to remove it. **Revoking now
  /// DELETES the row**, the `delete_revoked_api_tokens` migration cleared every
  /// row that carried a value here, and no code path writes it any more.
  ///
  /// It survives this change for one reason: `fly.toml` runs migrations BEFORE
  /// the new image takes traffic, so during a rolling release the OLD image is
  /// still stamping this column. Dropping it here would break that image's
  /// reads mid-deploy, and removing only the guard would let a token revoked in
  /// that window come back valid. `verify` therefore still rejects a non-null
  /// value. Both the column and that guard go together, in a follow-up, once
  /// the new image is everywhere.
  revokedAt     DateTime? @map("revoked_at")
  /// The token's GRANT — the access boundary that NARROWS the owner's project
  /// role. Stores `PermissionKey`s from `lib/permissions/catalog.ts`
  /// (MOTIR-2572); a dispatch seam admits an operation only when the grant
  /// holds the permission that operation asserts.
  ///
  /// ⚠️ THE NAME IS HISTORICAL AND THE COLUMN IS MIXED-VOCABULARY. Rows written
  /// before MOTIR-2572 hold one of the six retired `TokenScope` strings, and
  /// NOTHING REWRITES THEM — no migration ever touches a live credential's row.
  /// So NEVER read this column directly: `expandStoredGrant`
  /// (`lib/tokens/grant.ts`) is the one reader, and it maps a legacy string
  /// forward, passes a permission key through, and drops anything else. The
  /// name stays because renaming it is a migration with RLS blast radius for a
  /// name no reader sees (`docs/decisions/token-permissions.md` §5).
  ///
  /// A token minted without an explicit choice gets `DEFAULT_TOKEN_GRANT`,
  /// applied by `apiTokensService.create`.
  scopes        String[]  @default([])
  /// The PROJECT this token is bound to, or NULL (MOTIR-2605 Amendment 1).
  ///
  /// ⚠️ NULL IS A MEANING, NOT AN OPTION. It is the DEVICE-CREDENTIAL SHAPE —
  /// what `motir login` mints — and a permanent legal state. Do NOT make this
  /// column `NOT NULL`: there is no project a device credential should be
  /// pinned to, so the backfill has no correct value, and `list_projects` +
  /// `motir link` depend on that credential spanning the projects its holder's
  /// roles reach.
  ///
  /// The rule the column encodes: **the binding is REQUIRED where the GRANT IS
  /// CHOSEN, and absent where it is fixed.** A chosen grant (the create-token
  /// modal) needs a project, because "may this token edit work items?" has no
  /// answer until one is named — permissions resolve per project. A fixed grant
  /// (`CLI_TOKEN_GRANT`, which the approval screen shows and cannot edit) asks
  /// nothing, so `grant ∩ role` resolves per project at dispatch instead.
  ///
  /// When set, dispatch refuses an operation resolving to a DIFFERENT project as
  /// a NOT-FOUND, never a 403 — so a narrowed credential cannot be used to
  /// enumerate the workspace. Cascade: a deleted project takes its tokens.
  projectId     String?   @map("project_id")
  /// The DISPATCH RUN this token is bound to, or NULL (MOTIR-688,
  /// `docs/decisions/hosted-agent-run.md` §3). A token carrying it is a RUN
  /// TOKEN: minted by `runCredentialService` for one hosted run, acting as the
  /// dispatcher, and accepted ONLY by that run's own ingest and its card's
  /// dispatch prompt — every other door refuses it (`authenticateApiToken`,
  /// `verifyMcpToken`). NULL is every ordinary PAT and device credential.
  /// Cascade: a deleted run takes its token, which is dead by then anyway.
  dispatchRunId String?   @map("dispatch_run_id")
  /// The OAuth CLIENT this row is a CONNECTION for, or NULL (Story MOTIR-6973 ·
  /// Subtask MOTIR-6983). Non-null makes the row an OAUTH CONNECTION: what a
  /// person approved on the consent screen for one app — this workspace, this
  /// project or none, this grant. NULL is every PAT, device credential and run
  /// token.
  ///
  /// ⚠️ A CONNECTION IS A TOKEN ROW, NOT A PARALLEL TABLE, deliberately. The
  /// token already carries the whole reach model — the bound workspace, the
  /// one-arm project binding, the grant (`scopes`), `lastUsedAt` — and every gate
  /// downstream reads that shape. A second table would be a second reach model,
  /// and two reach models drift: the first time one gained a check the other
  /// lacked, a connected app could reach something a PAT with the same grant
  /// could not. So an OAuth access token resolves (through its `reference_id`) to
  /// THIS row, and the MCP gate hands the tools the same `AuthInfo` a PAT yields.
  ///
  /// A connection has no bearer secret of its own: the client holds OAuth access
  /// and refresh tokens (`oauth_access_token` / `oauth_refresh_token`), which
  /// point here. `tokenHash` is the hash of random bytes nobody ever held, so no
  /// PAT can resolve to a connection, and `apiTokensService.verify` refuses one
  /// regardless. At most one connection per (person, client, workspace, project)
  /// — a hand-written unique index in the migration, because Prisma cannot
  /// express its predicate. Cascade: a deleted client takes its connections, and
  /// DELETING a connection takes its access tokens, refresh tokens and consent
  /// rows with it — which is what revoking one is.
  oauthClientId String?   @map("oauth_client_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dispatchRun DispatchRun? @relation(fields: [dispatchRunId], references: [id], onDelete: Cascade)
  oauthClient OauthClient? @relation(fields: [oauthClientId], references: [clientId], onDelete: Cascade)

  oauthAccessTokens  OauthAccessToken[]
  oauthRefreshTokens OauthRefreshToken[]
  oauthConsents      OauthConsent[]

  // The settings-surface read: a user's tokens in a workspace, newest first.
  @@index([userId])
  @@index([workspaceId])
  @@index([projectId])
  /// The run credential's revoke (`runCredentialService.revokeRunCredential`).
  @@index([dispatchRunId])
  /// A client's connections — the cascade from `oauth_client`.
  @@index([oauthClientId])
  @@map("api_token")
}

/// The lifecycle state of an AI-planning proposal bundle (Story 7.21).
/// `generating` — the producer (7.4 generation / 7.11 re-planning) has opened
/// the plan and is still appending proposals. `planned` — the generation
/// frontier is complete; the plan is reviewable and decidable. `approved` /
/// `declined` — terminal; the user has decided. Approve MATERIALIZES the items
/// into the work-item tree; decline drops them with the tree untouched.
///
/// `stale` — the plan reached a reviewer and can no longer be approved, because
/// a `modify`/`remove` target reached a terminal status AFTER the plan closed
/// (MOTIR-3574, `docs/decisions/agent-authored-plans.md` AMENDMENT 9). It is
/// NOT terminal and NOT decided: the plan is live and awaiting action, and its
/// exits are the drift reversing (back to `planned`) or a reviewer declining
/// it. It exists so `planned` can mean APPROVABLE — the invariant a plan
/// carrying post-close drift used to break silently, by staying `planned` and
/// failing at the button. Reachable only from `planned`; a `generating` plan is
/// in front of nobody and has nothing to be stale about.
enum PlanStatus {
  generating
  planned
  stale
  approved
  declined

  @@map("plan_status")
}

/// WHY a `declined` plan ended (MOTIR-3189) — the record behind a status that
/// covers three different histories. See `Plan.decisionReason`, which is where
/// the reasoning for a private column rather than a `PlanStatus` member lives.
enum PlanDecisionReason {
  /// A person reviewed a `planned` plan and rejected it — `declinePlan` from
  /// `planned`, the only ending that existed before this enum.
  reviewed
  /// A plan ended without proposals ever being written. Two producers:
  /// `declinePlan` from `generating` (a person ended one that never finished),
  /// and `markPlanned` over an EMPTY proposal set (MOTIR-4124) — a close with
  /// nothing in it is a decision, not a review request. `plannedAt` stays NULL
  /// in both: the frontier never became something a person was asked to read.
  discarded
  /// `abandonedPlanService.reconcileAbandoned` terminated a plan whose producer
  /// was provably gone. `decidedById` is NULL — nobody decided it.
  abandoned

  @@map("plan_decision_reason")
}

/// The operation a `PlanItem` proposes against the work-item tree (Story 7.21).
/// `add` — create a new node (its fields live in `proposedFields`; no WorkItem
/// exists until approve). `modify` — patch an existing node (the sparse changed
/// fields live in `patch`; the target keeps its committed values until approve).
/// `remove` — archive an existing node.
enum PlanItemOp {
  add
  modify
  remove

  @@map("plan_item_op")
}

/// WHY a `Plan` was started (MOTIR-916). `sourceJobId` already records WHICH job
/// produced a plan; this records what decided to start it. `user` — a person
/// clicked generate / augment / expand / re-plan (the default, so every existing
/// row and every request-path submit reads as user-initiated). `cadence` — the
/// auto-plan cadence watcher fired it because the project's ready set drained
/// below `Project.aiAutoPlanThreshold`, with no human in the loop. The review
/// surface reads it to LABEL an auto-proposed expansion; it does not change how
/// the plan is reviewed or approved.
enum PlanOrigin {
  user
  cadence

  @@map("plan_origin")
}

/// WHICH DOOR opened a `PlanChangeSession` (AMENDMENT 17 §4). Distinct from
/// `PlanOrigin` (why a PLAN was started) and never folded into it.
/// `conversation` — a first turn in the planning surface or a plan-session door;
/// `mcp` — `create_plan`; `generation` — Generate / onboarding; `expand` — an
/// expand job with no conversation; `cadence` — the auto-plan watcher;
/// `legacy` — BACKFILL ONLY, for a pre-existing plan whose producing
/// conversation cannot be identified (core stores no job kind, so the honest
/// value is "unknown", never a plausible guess).
enum PlanSessionOrigin {
  conversation
  mcp
  generation
  expand
  cadence
  legacy
  /// The Guide me through door on ONE manual card (MOTIR-7464 · ADR
  /// `conversation-turn-intent.md` AMENDMENT 2, A2.2): `targetKeys = [<KEY>]`, every
  /// turn is `guide`, it submits no plan and takes no `PlanTargetLock`. The resume
  /// reads that filter on `conversation` never pick it up.
  guide

  @@map("plan_session_origin")
}

/// WHY a planning session ENDED (story MOTIR-7630 · MOTIR-7636;
/// `agent-authored-plans.md` AMENDMENT 23 §1). Written with
/// `PlanChangeSession.endedAt`, never without it. The first three are MOTIR's
/// ending and read **Closed** on the Plans page; `declined` and `approved` are a
/// person's decision on the session's plan and read as those. Deliberately NOT
/// a `PlanStatus` member: the end is a SESSION fact, and `PlanStatus` is public
/// vocabulary (v1, MCP, i18n parity).
enum PlanSessionEndReason {
  /// Its attempt's job failed or was canceled.
  failed
  /// The idle sweep closed it after its lease ran out.
  idle
  /// The person restarted from inside the planning overlay.
  restarted
  /// A person declined its plan.
  declined
  /// Its plan was approved.
  approved

  @@map("plan_session_end_reason")
}

/// WHY a hosted planning attempt failed, as motir-ai's CLOSED vocabulary
/// (`walkStop.reasonCode`, motir-ai `docs/contract.md` §5; Story MOTIR-7905).
/// A CODE, never motir-ai's English: core translates each member (en / zh) at
/// render time. `stalled` is the one member motir-ai never sends: it is core's
/// abandoned-plan sweep finding the plan silent (MOTIR-9065). The failure path
/// maps any code it does not recognise, and a
/// missing `walkStop`, to `internal` before it writes, so the column is total.
enum PlanSessionFailureReason {
  rate_limited
  out_of_credits
  model_unavailable
  token_expired
  prompt_too_large
  job_failed
  stalled
  internal

  @@map("plan_session_failure_reason")
}

/// Which kind of session the failed walk had open (Story MOTIR-7905). Null on the
/// session when the attempt failed before the walk reached a level.
enum PlanSessionWalkPhase {
  lay
  author

  @@map("plan_session_walk_phase")
}

/// WHY an open session is waiting on its owner (Story MOTIR-7905):
///   * `question` — a hosted phase returned to the conversation with a WHAT question;
///   * `reply`    — the planner replied, no job is running, and the person left.
enum PlanSessionAwaitingCause {
  question
  reply

  @@map("plan_session_awaiting_cause")
}

/// An AI-planning proposal bundle (Story 7.21 — the Plan substrate). A `Plan`
/// gathers proposed `PlanItem` operations the user reviews and approves/declines
/// as ONE unit. Nothing it proposes is real until approve: an `add` lives only
/// as a PlanItem (no WorkItem yet), and `modify`/`remove` leave their targets
/// untouched. The lifecycle timestamps + decider ARE the history surface (when
/// planned / when decided / by whom). Workspace-scoped tenant data (RLS).
model Plan {
  id                   String                  @id @default(cuid())
  workspaceId          String                  @map("workspace_id")
  projectId            String                  @map("project_id")
  status               PlanStatus              @default(generating)
  /// A short label for the plan — typically the idea/prompt the generation came from.
  title                String?
  /// Longer human summary of what the plan proposes (Markdown), when distinct from the title.
  summary              String?                 @db.Text
  /// AI-suggested product/project name (MOTIR-1554/1551) — set on the FINAL
  /// plan-proposals append, and ONLY by the onboarding generation. Consumed at
  /// approve to rename a still-provisional draft project. Null otherwise.
  productName          String?                 @map("product_name")
  /// The motir-ai generation job that produced this plan, for provenance.
  sourceJobId          String?                 @map("source_job_id")
  /// WHY this plan was started (MOTIR-916) — `user` (someone clicked) or
  /// `cadence` (the auto-plan watcher fired it when the ready set drained).
  /// Set at submit; never changes afterwards.
  origin               PlanOrigin              @default(user)
  /// WHO ASKED for this plan (MOTIR-2986) — the person whose request produced
  /// it, as opposed to `decidedById`'s who APPROVED it and `authorSource`'s
  /// which AGENT wrote it. A plan has up to three parties and they are commonly
  /// three different ones: a teammate asks, an agent writes, a lead approves.
  ///
  /// NULL is a MEANING, and it is the `cadence` case. `autoPlanCadenceService`
  /// runs the watcher under the PROJECT OWNER's credential so the job has one —
  /// nobody clicked anything — so recording that owner here would attribute to a
  /// person a request they never made. The requester is written ⟺ a person
  /// actually asked (`origin = 'user'`); a cadence plan is identified by its
  /// `origin`, not by a fabricated requester.
  createdById          String?                 @map("created_by_id")
  /// WHO authored this plan (MOTIR-2986), as opposed to `origin`'s WHY,
  /// `createdById`'s WHO ASKED and `sourceJobId`'s WHICH JOB — the
  /// `source · harness · model` triple
  /// `docs/decisions/work-item-provenance.md` Decision 2 fixes for a work item,
  /// mirrored onto the plan by `docs/decisions/agent-authored-plans.md` Q3. The
  /// enum is REUSED rather than duplicated so a plan's author and its
  /// materialized items' authors are drawn from ONE closed vocabulary and cannot
  /// disagree; a second enum would be a second display switch to keep total.
  ///
  /// SERVER-SET at the write seam — `mcp` from the `create_plan` MCP tool, the
  /// same discipline `create_work_item` applies so an agent cannot claim
  /// `native`/`manual`. NEVER a caller field.
  authorSource         WorkItemPlanningSource? @map("author_source")
  /// The authoring agent's harness, SELF-REPORTED at `create_plan`
  /// (`plannedWithHarness`) — free text by Decision 2, stored as-supplied
  /// (trimmed, empty → null). Null on every plan Motir's own generator produced:
  /// the generator path is deliberately not retrofitted here (MOTIR-2996).
  authorHarness        String?                 @map("author_harness")
  /// The authoring agent's model, SELF-REPORTED at `create_plan`
  /// (`plannedWithModel`) — free text, same rules as `authorHarness`.
  authorModel          String?                 @map("author_model")
  createdAt            DateTime                @default(now()) @map("created_at")
  /// Set when generation completes (→ `planned`).
  plannedAt            DateTime?               @map("planned_at")
  /// Set on approve/decline, with the deciding actor.
  decidedAt            DateTime?               @map("decided_at")
  decidedById          String?                 @map("decided_by_id")
  /// WHY this plan ended, for the three histories `declined` now covers
  /// (MOTIR-3189). `reviewed` — a person read a finished plan and said no.
  /// `discarded` — a person ended a plan that never finished generating.
  /// `abandoned` — the sweep terminated one whose producer was provably gone.
  ///
  /// All three are DERIVABLE from the null pattern across `plannedAt` /
  /// `decidedById`, and none was RECORDED: `planReviewService` pushed one
  /// `declined` event and the rail rendered all three identically, so a reader
  /// could see that a plan ended and not why.
  ///
  /// A PRIVATE column rather than a fourth `PlanStatus` member, which is the
  /// trade AMENDMENT 2 weighed and this one completes. `PlanStatus` is a public
  /// vocabulary reaching v1's `planStatusSchema`, the MCP tool descriptions,
  /// `PlanStatusDto`, four display switches and the zh-parity gate; this column
  /// reaches the review surface and the sweep's log line. AMENDMENT 2's own
  /// fallback — "the honesty lives in the ACTOR: `decidedById` is NULL" — is the
  /// half-measure it replaces, and that null still means what it meant.
  ///
  /// NULL is not a fourth reason: every row written before this column existed
  /// reads null, so a consumer treats it as "not recorded" and falls back to the
  /// status. Never set on `approved` — an approval has one history.
  decisionReason       PlanDecisionReason?     @map("decision_reason")
  /// The planning SESSION this plan belongs to (AMENDMENT 17 §5) — set at
  /// creation on every author path and NEVER re-pointed; a revision keeps it
  /// (only `sourceJobId` moves). Closes AMENDMENT 16 D5's `lastJobId` lookup.
  /// NULLABLE AT THE DATABASE only so a build predating this column can still
  /// write a plan during a rollout; "every plan has a session" is enforced by
  /// the author paths (MOTIR-6022) and the MOTIR-6020 backfill.
  sessionId            String?                 @map("session_id")
  /// WHEN anything last happened to this plan while it was being written
  /// (Story MOTIR-7820 · MOTIR-7822): stamped by every planner step signal and
  /// by every content write (create, append, deepen, edit, correction,
  /// withdrawal, brief correction), in the same transaction as the write. A
  /// DECISION (`planned` / `approved` / `declined`) is not activity and does not
  /// stamp it. What tells a stalled plan from a busy one — `createdAt` and the
  /// decision timestamps cannot, because a plan records nothing between them.
  lastActivityAt       DateTime                @default(now()) @map("last_activity_at")
  /// The SHARPENED requirement (Task MOTIR-1101 · MOTIR-8183) — the answers a
  /// person settled in a Sharpen session on this plan, plus the planner's marked
  /// assumptions for the questions they skipped or left to it, written by the
  /// write-back door (`planSharpeningService`) as a FULL replace each call. The
  /// shape is `SharpenedRequirementDto` (`lib/dto/plans.ts`): the six
  /// `SubmittedRequirement` parts, `plannerAssumptions` and `settledAt`. NULL
  /// means nobody sharpened this plan — every plan written before the column.
  sharpenedRequirement Json?                   @map("sharpened_requirement")

  workspace         Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project           Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  session           PlanChangeSession?     @relation(fields: [sessionId], references: [id], onDelete: NoAction)
  decidedBy         User?                  @relation("PlanDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  createdBy         User?                  @relation("PlanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items             PlanItem[]
  revisions         PlanRevision[]
  /// The step each RUNNING planner session is on (Story MOTIR-7820 ·
  /// MOTIR-7822) — one row per session, replaced on its next report and
  /// deleted when it ends. Read only while the plan is `generating`.
  steps             PlanStep[]
  /// The planner's NARRATION (Story MOTIR-8060 · MOTIR-8062) — every plain-language
  /// sentence a planner session wrote about its work, append-only and kept after
  /// the step ends and after the plan is decided.
  narration         PlanNarration[]
  /// Each planner session's STEP WORDS (MOTIR-8062) — kind + target title as
  /// last reported, kept after the session's `end` deletes its `PlanStep`.
  narrationSessions PlanNarrationSession[]
  /// The targets this plan has PARKED at `planning` while it is open
  /// (MOTIR-5645). Cascade-deleted with the plan, so a deleted plan holds
  /// nothing — the restore is the release path's job, not the FK's.
  targetLocks       PlanTargetLock[]
  /// Sharpen sessions about this plan (Task MOTIR-1101 · MOTIR-8182). Cascade.
  sharpenSessions   SharpenSession[]

  @@index([workspaceId])
  @@index([projectId, createdAt])
  /// A session's plans — the Plans row's latest-plan state and every
  /// plan→session read that replaced the `lastJobId` lookup (AMENDMENT 17 §5).
  @@index([sessionId])
  /// The pending-proposal GATE's read (MOTIR-916): "does this project have an
  /// UNDECIDED plan (`generating` / `planned`)?" runs per project on every
  /// cadence tick, so it gets its own composite index rather than riding the
  /// (projectId, createdAt) one and filtering status in the heap.
  ///
  /// EXTENDED with `createdAt` by MOTIR-3235, rather than adding a fifth index.
  /// The tabbed Plans list reads ONE status at a time and still orders by
  /// `createdAt desc` — which `(project_id, status)` alone cannot serve: it
  /// narrows and then sorts the narrowed set in the heap, on the read that runs
  /// on every tab switch and every scroll-to-load page. `(projectId, status)`
  /// survives as a LEFTMOST PREFIX of this one, so `findUndecidedByProject`
  /// keeps exactly the index it had; nothing about the gate's read changes.
  @@index([projectId, status, createdAt])
  /// The ABANDONED-PLAN sweep's discovery read (MOTIR-3064): "which `generating`
  /// plans, in ANY project, are older than the grace?" — cross-workspace, so
  /// neither index above helps it (both lead with `project_id`). Status first,
  /// then age, which is the order the predicate narrows in: `generating` is a
  /// small tail of the table, and the sweep then takes the oldest N of it.
  @@index([status, createdAt])
  @@map("plan")
}

/// One proposed OPERATION inside a `Plan` (Story 7.21) — a PROPOSAL, never a row
/// in the work-item tree. Op-typed (`add`/`modify`/`remove`). Identity is
/// sacred: only `add` mints a new WorkItem id, and only at materialize; a
/// `modify` NEVER mints a new id. The OLD side of any diff is read live from the
/// target — this row stores only the NEW values. Workspace-scoped tenant data (RLS).
model PlanItem {
  id             String     @id @default(cuid())
  workspaceId    String     @map("workspace_id")
  planId         String     @map("plan_id")
  op             PlanItemOp
  /// NULL for `add` until it materializes (then the created id); the EXISTING
  /// target for `modify` / `remove`.
  workItemId     String?    @map("work_item_id")
  /// `add` ONLY — the new node's proposed fields (title, kind, descriptionMd,
  /// type, priority, executor, storyPoints, estimateMinutes, difficulty,
  /// explanationMd, explanationSource, planningProvenance, targetRepo,
  /// targetRepoRole, todos).
  /// The add's values live HERE (no WorkItem exists yet). `PlanItemProposedFields`
  /// in `lib/dto/plans.ts` is the authoritative shape — this list is a reader's
  /// summary of it, so keep the two in step when the shape grows.
  /// `todos` is the card's ORDERED STEPS (MOTIR-3810 · `agent-authored-plans.md`
  /// AMENDMENT 13): `add` only, array order is list order, and approve writes one
  /// `work_item_todo` row per element. No column and no table — a proposal's steps
  /// live in this JSON exactly as its description does.
  proposedFields Json?      @map("proposed_fields")
  /// `modify` ONLY — the sparse changed fields ({ title?, descriptionMd?,
  /// priority?, type?, storyPoints?, estimateMinutes?, difficulty?, targetRepo?,
  /// blockedByAdd?, blockedByRemove? }); see `PlanItemPatch` in
  /// `lib/dto/plans.ts` for the authoritative shape.
  patch          Json?
  /// `add` (and edge changes): a parent ref that may point at a real workItemId
  /// OR another PlanItem in the SAME plan (an intra-plan temp-ref, `planItem:<id>`),
  /// resolved to a real id at materialize.
  parentRef      String?    @map("parent_ref")
  /// `add` / edge changes: blocked-by refs, each a real workItemId or an
  /// intra-plan temp-ref, resolved at materialize.
  blockedByRefs  String[]   @map("blocked_by_refs")
  /// `add` only: the OLDER work items the created card SUPERSEDES (Story
  /// MOTIR-6577 · MOTIR-6630), each a real workItemId or an intra-plan temp-ref,
  /// resolved at materialize and written as one `supersedes` link each (from =
  /// the created card, to = the ref). Structural like `blockedByRefs`, so a
  /// column and never a `proposedFields` key.
  supersedesRefs String[]   @default([]) @map("supersedes_refs")
  /// `modify`/`remove`: the target's revision the change was computed against
  /// (the optimistic-concurrency anchor for the conflict check, 7.21.3).
  baseRevision   String?    @map("base_revision")
  /// `remove` only: WHY the card is being removed (AMENDMENT 18 §3, MOTIR-6052).
  /// Trimmed, 1–2000 characters; null on every other op and on a legacy remove.
  /// Written into the `archived` revision's diff at approve.
  reason         String?
  createdAt      DateTime   @default(now()) @map("created_at")

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// SetNull (not Cascade): archiving a target work item leaves the PlanItem as
  /// history. `add` rows have a null target until materialize.
  workItem  WorkItem?      @relation("PlanItemWorkItem", fields: [workItemId], references: [id], onDelete: SetNull)
  revisions PlanRevision[]

  /// A `modify`/`remove` target is unique per plan (one op per target per plan).
  /// Postgres treats NULLs as distinct, so multiple `add` rows (null target) in
  /// one plan are allowed — only real targets are constrained.
  @@unique([planId, workItemId])
  @@index([planId])
  @@index([workspaceId])
  /// THE REVERSE INDEX (MOTIR-3579). `work-item/transitioned` fires on EVERY
  /// status change in the tenant, and the drift listener's first question is
  /// *which plans propose to change THIS work item?* — a lookup by
  /// `workItemId`. The `@@unique` above cannot serve it: its leftmost column is
  /// `planId`, so a query naming only the work item cannot use it and falls to a
  /// sequential scan of every proposal in the workspace, on every board drag.
  /// (MOTIR-3560 asserted `PlanItem.workItemId` "is already the reverse index";
  /// it is not, and `agent-authored-plans.md` AMENDMENT 9 D5 records the
  /// correction.) `workspaceId` rides second because every read is tenant-scoped
  /// — the RLS policy and the explicit filter both name it — so the composite
  /// answers the whole predicate rather than half of it.
  @@index([workItemId, workspaceId])
  /// THE FORWARD-PARENT INDEX (MOTIR-4365). The item page's pending-plan read
  /// asks a SECOND question the one above cannot answer — *which plans propose
  /// to add CHILDREN under THIS card?* — and it cannot answer it for a reason
  /// deeper than its column list: an `add` has NO `workItemId` at all. The row
  /// it would name does not exist until the plan is approved, so an `add` names
  /// its parent in `parentRef` and nothing else. Without this index that arm
  /// falls to a sequential scan of every proposal in the workspace, on a read
  /// that runs inside the item page's request on every item page. `workspaceId`
  /// rides second for exactly the reason it does above — every read is
  /// tenant-scoped, so the composite answers the whole predicate.
  @@index([parentRef, workspaceId])
  @@map("plan_item")
}

/// One CONTENT mutation of a `Plan`, append-only (Story MOTIR-3532 · MOTIR-3535).
///
/// The plan's own timeline is DERIVED — `planReviewService` computes at most four
/// events from `createdAt` / `plannedAt` / `decidedAt` / `decisionReason`, all of
/// them status transitions, and its only actor is the decider. So a proposal
/// deepened five times is byte-indistinguishable from one written once, and the
/// party who WROTE the plan never appears on it at all. This table is what makes
/// the second kind of event sayable.
///
/// ⚠️ MIRRORS `WorkItemRevision` (`changedById` / `changedAt` / `changeKind` /
/// `diff Json`) rather than inventing a second vocabulary for the same idea, and
/// it inherits that model's tenancy decision too: there is deliberately **no
/// `workspace_id` column**. Denormalizing tenancy onto a revision row would let
/// it lie about which workspace it belongs to; the RLS policy (see the
/// `add_plan_revisions` migration) JOINS to the parent `plan` instead, exactly as
/// `work_item_revision`'s joins to `work_item`.
///
/// ⚠️ THE ROW IS WRITTEN INSIDE THE MUTATION'S OWN TRANSACTION, and that is the
/// whole guarantee. A revision written after the commit can be lost while the
/// mutation stands; one written in its own transaction can commit while the
/// mutation rolls back. Both produce a trail that LIES, in opposite directions.
/// The repository's required `tx` is the compile-time half of that contract.
/// This is NOT an instance of the side-effects-outside-the-transaction rule —
/// that rule is about external I/O (email, webhooks, blob ops) whose failure must
/// not roll back the write. This is a database write ABOUT a database write, in
/// the same database, and its atomicity with the mutation is the point.
model PlanRevision {
  id           String                  @id @default(cuid())
  planId       String                  @map("plan_id")
  /// The proposal this change was ABOUT, when it was about one (a deepen / an
  /// edit). Null for a plan-level act — the open, an append, the close, a
  /// decision. SetNull rather than Cascade so a vanished proposal leaves the
  /// change on record.
  planItemId   String?                 @map("plan_item_id")
  /// The acting USER, or null when no person acted.
  ///
  /// NULL IS A MEANING, and it is the same one `Plan.createdById` documents for
  /// itself: `autoPlanCadenceService` runs the watcher under the PROJECT OWNER's
  /// credential so the job has one, and recording that owner here would attribute
  /// to a person an act they never performed. So the generation-time writes on a
  /// `cadence` plan record null; the review edit and both decisions always record
  /// their actor, because those are only ever reached by a person.
  changedById  String?                 @map("changed_by_id")
  changedAt    DateTime                @default(now()) @map("changed_at")
  /// `created` | `appended` | `edited` | `planned` | `approved` | `declined` |
  /// `reason_classified`.
  /// String, not an enum — the same call `WorkItemRevision.changeKind` makes and
  /// for the same reason: a new verb is then a code change rather than a
  /// migration, and the value set is read by this product's own surfaces only.
  ///
  /// ⚠️ `reason_classified` is INTERNAL (Story MOTIR-5543 · MOTIR-6083). It is
  /// Motir's own planner-quality data, not the tenant's, so every tenant-facing
  /// read excludes it — at the QUERY, through the one shared
  /// `TENANT_VISIBLE_PLAN_REVISION_WHERE` fragment in `planRevisionRepository`.
  changeKind   String                  @map("change_kind")
  /// WHICH AGENT acted, when one did — the `source · harness · model` triple
  /// `docs/decisions/work-item-provenance.md` Decision 2 fixes, recorded PER ACT
  /// rather than read off the plan. The plan's `authorSource` says who wrote the
  /// plan; it cannot say who performed THIS change, and the two differ the moment
  /// a person edits or decides an agent-written plan. Null ⟺ no agent acted.
  actorSource  WorkItemPlanningSource? @map("actor_source")
  actorHarness String?                 @map("actor_harness")
  actorModel   String?                 @map("actor_model")
  /// WHAT changed, per `changeKind` — a COUNT-shaped payload (how many proposals
  /// an append carried, which fields an edit supplied), never the proposal bodies
  /// themselves. `design/ai-planning/design-notes.md` Part X §5 decides what the
  /// timeline shows of it.
  diff         Json
  /// The EVIDENCE behind a `reason_classified` row, as free text — populated ONLY
  /// by that kind, and null on every other (Story MOTIR-5543 · MOTIR-6083).
  ///
  /// ⚠️ INTERNAL: never serialised to a tenant. It rides the same row the
  /// classification does, and the one read that returns it
  /// (`planRevisionRepository.listReasonClassifications`) has no route, no MCP
  /// tool and no DTO on any tenant surface — `PlanHistoryEventDto` is unchanged.
  ///
  /// ⚠️ WHY IT CANNOT LIVE IN `diff`. That payload is COUNT-shaped by contract
  /// (directly above) — how many proposals an append carried, which fields an
  /// edit supplied — and the timeline renders it on that promise. Evidence is
  /// prose: the turn that raised the thing, or the rule search that came back
  /// empty. Putting it in `diff` would either break the count contract for every
  /// existing reader or smuggle a body into a payload documented as never
  /// carrying one. Bounded at 4 000 characters by the service.
  noteMd       String?                 @map("note_md")

  plan      Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  planItem  PlanItem? @relation(fields: [planItemId], references: [id], onDelete: SetNull)
  changedBy User?     @relation("PlanRevisionAuthor", fields: [changedById], references: [id], onDelete: SetNull)

  /// The timeline's read: one plan's trail, in time order.
  @@index([planId, changedAt])
  @@index([planItemId])
  @@index([changedById])
  @@map("plan_revision")
}

/// The KIND of step a running planner session is on (Story MOTIR-7820 ·
/// MOTIR-7822). `settle` never names a target; `lay` and `author` may name one
/// or, in their UNTARGETED forms, none (laying the project's top level, and
/// authoring an item not yet on the plan).
enum PlanStepKind {
  settle
  lay
  author

  @@map("plan_step_kind")
}

/// The step ONE running planner session is on (Story MOTIR-7820 · MOTIR-7822).
/// A SET per plan, not one "latest step": after a lay, both planners author a
/// level's children at once, so one slot would show one and drop the rest, and
/// parallel reports writing one slot would overwrite each other. One row per
/// `(planId, sessionKey)` makes "replace my step" and "clear my step"
/// independent upserts and deletes.
///
/// No `workspace_id`, deliberately — the `PlanRevision` tenancy: the RLS policy
/// joins to the parent `plan`.
model PlanStep {
  id         String       @id @default(cuid())
  planId     String       @map("plan_id")
  /// The planner's own opaque id for one running session (≤ 128 chars).
  sessionKey String       @map("session_key")
  kind       PlanStepKind
  /// `planItem:<id>` or a work-item id, exactly as the planner sent it. NULL for
  /// `settle` always, and for the two untargeted forms of `lay` / `author` —
  /// "no ref exists yet", never "unknown".
  targetRef  String?      @map("target_ref")
  /// The SERVER's clock at the report, never a caller field.
  startedAt  DateTime     @map("started_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, sessionKey])
  @@index([planId])
  @@map("plan_step")
}

/// One plain-language sentence a planner session wrote about its own work (Story
/// MOTIR-8060 · MOTIR-8062): the planner's NARRATION, drawn as its messages in
/// the plan's chat panel. APPEND-ONLY KEPT HISTORY: a row is never updated and
/// never deleted, except by the plan's own cascade. No FK to `plan_step`, so a
/// sentence outlives its session's step (`end` deletes the step, not this).
model PlanNarration {
  id         String   @id @default(cuid())
  planId     String   @map("plan_id")
  /// The writing session's opaque key, the same value `plan_step` carries.
  sessionKey String   @map("session_key")
  /// Per-plan order, gapless from 1, taken under the plan row lock.
  seq        Int
  /// The sentence, cleaned to one line and capped (`cleanNarrationSentence`).
  body       String
  createdAt  DateTime @default(now()) @map("created_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, seq])
  @@index([planId, sessionKey])
  @@map("plan_narration")
}

/// One planner session's STEP WORDS on a plan (MOTIR-8062): the step kind, its
/// target ref and the target's TITLE as it read when the step was reported — the
/// head of that session's group in the chat panel. Upserted on every accepted
/// non-`end` step report (a re-report REPLACES kind/ref/title and keeps
/// `firstReportedAt`); never touched by `end`, never deleted except by the plan's
/// cascade. No FK to `plan_step`, so it survives the step's end.
model PlanNarrationSession {
  id              String       @id @default(cuid())
  planId          String       @map("plan_id")
  sessionKey      String       @map("session_key")
  stepKind        PlanStepKind @map("step_kind")
  /// `planItem:<id>` or a work-item id, as reported. NULL on `settle` and on an
  /// untargeted `lay` / `author`.
  targetRef       String?      @map("target_ref")
  /// The target's title at report time, cleaned like a sentence. NULL when there
  /// is no target or it could not be resolved.
  targetTitle     String?      @map("target_title")
  firstReportedAt DateTime     @default(now()) @map("first_reported_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, sessionKey])
  @@map("plan_narration_session")
}

/// A Motir member's GitHub OAuth user-identity binding (Story 7.10 ·
/// MOTIR-1498) — "Grant 1" of the verified GitHub-App model. This grant is
/// IDENTITY ONLY: it proves which GitHub user the member is and grants NO repo
/// access (that's the separate installation grant, GithubInstallation /
/// MOTIR-891). An identity with no installation is a valid state the UI shows.
///
/// One identity per Motir user (`userId @unique`) and one Motir user per GitHub
/// account (`githubUserId @unique`) — a GitHub account can't be bound to two
/// members. The user access token is stored ENCRYPTED at rest (AES-256-GCM via
/// lib/github/tokenCrypto.ts), never plaintext, and never leaves the service
/// layer (the DTO omits it). RLS keys on `app.user_id` (the api_token
/// precedent): the OAuth callback persists under `withUserContext`, so a member
/// only ever reads/writes their own identity.
model GithubIdentity {
  id                   String   @id @default(cuid())
  userId               String   @unique @map("user_id")
  githubUserId         String   @unique @map("github_user_id")
  githubLogin          String   @map("github_login")
  avatarUrl            String?  @map("avatar_url")
  /// The GitHub user access token, encrypted at rest (never plaintext). Only
  /// lib/github/tokenCrypto.ts + githubIdentityService ever read/write it.
  accessTokenEncrypted String   @map("access_token_encrypted")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("github_identity")
}

/// A per-user OAuth identity for an EXTERNAL import source (Story 7.16 ·
/// MOTIR-1653) — the "Model A" substrate that replaces the paste-a-token path.
/// It mirrors GithubIdentity: the OAuth connect flows (7.16.11–13) and the
/// import routes (MOTIR-941) read/write through it so the live connectors
/// (Jira / Linear / Plane) authenticate with a STORED, ENCRYPTED token, never a
/// credential pasted into the wizard.
///
/// One identity per (`userId`, `source`, `workspaceId`) — a member can connect
/// each vendor once per workspace. Both tokens are stored ENCRYPTED at rest
/// (AES-256-GCM via lib/crypto/tokenCrypto.ts), never plaintext, and never leave
/// the service layer (no DTO exposes them; the fetch-and-decrypt read is
/// server-to-server, for the connectors). `metadata` carries the vendor's
/// per-connection context (the Jira cloud id / site URL, the Plane base URL +
/// workspace slug). RLS keys on `app.user_id` (the GithubIdentity precedent):
/// the connect callback + the connector read persist/read under
/// `withUserContext`, so a member only ever touches their own identity.
model ImportSourceIdentity {
  id                    String       @id @default(cuid())
  source                ImportSource
  userId                String       @map("user_id")
  workspaceId           String       @map("workspace_id")
  /// The vendor access token, encrypted at rest (never plaintext). Only
  /// lib/crypto/tokenCrypto.ts + importSourceIdentityService ever read/write it.
  accessTokenEncrypted  String       @map("access_token_encrypted")
  /// The vendor refresh token (OAuth flows that issue one — e.g. Jira 3LO),
  /// encrypted at rest; null for sources that return no refresh token.
  refreshTokenEncrypted String?      @map("refresh_token_encrypted")
  /// When the access token expires (null when the vendor issues a
  /// non-expiring token); the refresh flow reads it to decide when to refresh.
  expiresAt             DateTime?    @map("expires_at")
  /// Per-connection vendor context (Json): the Jira cloud id / site URL, the
  /// Plane base URL + workspace slug — whatever the connector needs to address
  /// the right instance. Carries NO secret (the tokens are the encrypted cols).
  metadata              Json?
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, source, workspaceId])
  @@index([userId])
  @@index([workspaceId])
  @@map("import_source_identity")
}

/// A GitHub App installation on a workspace (Story 7.10 · MOTIR-891) — "Grant 2"
/// of the verified GitHub-App model: the owner installs the Motir App on their
/// GitHub org/user and selects repos, granting repo access. DISTINCT from the
/// per-user identity grant (GithubIdentity) — an installation with no bound
/// identity, or an identity with no installation, are both valid states the UI
/// shows. Created by the `installation` webhook (MOTIR-892, system context).
/// Workspace-scoped tenant data: RLS gates on `app.workspace_id`, with the
/// system-admin escape the webhook writer uses.
///
/// `provider` is the PROVIDER DISCRIMINATOR — every downstream read goes through
/// the GitProvider seam (`lib/git`), so GitLab/Bitbucket is purely additive
/// (7.23 implements the same seam under `provider: 'gitlab'`). This is the SHARED
/// connection entity every provider plugs into (the card's "no new parallel
/// model"): a GitLab connection is a row here with `provider: 'gitlab'`.
///
/// TOKEN STORAGE differs by the provider's auth model. GitHub (Grant 2) NEVER
/// stores a token here — its installation token is minted on demand from the App
/// private key (`lib/github/appAuth.ts`) and cached in-memory only, so the three
/// `*_encrypted` / `token_expires_at` columns stay NULL for GitHub rows. GitLab
/// (7.23 · MOTIR-1474) has no App-installation model: its OAuth grant issues an
/// access + refresh token per connection that MUST be persisted (encrypted) and
/// refreshed, so a GitLab row populates them. The columns are nullable + provider-
/// neutral in name precisely so the shared entity serves both models.
model GithubInstallation {
  id                    String    @id @default(cuid())
  /// Provider discriminator — "github" (default) or "gitlab"; the seam keys on it.
  provider              String    @default("github")
  /// The host's own installation/connection id (as a string — never do math on
  /// it): GitHub's numeric installation id, or the GitLab connection id minted at
  /// connect. UNIQUE (one row per connection); the webhook + token paths key on
  /// it. DISTINCT from `id`, the internal cuid PK.
  installationId        String    @unique @map("installation_id")
  /// The workspace whose OWN grant this is — NULL for Motir's shared
  /// provisioning installation, which is owned by no tenant (MOTIR-1931, the
  /// 2026-07-31 amendment to `docs/decisions/project-repository-set.md`). Every
  /// tenant's Motir-created repos sit behind that ONE installation, so it cannot
  /// name a workspace; the repo row carries the tenancy instead. NULL is also the
  /// guard that makes `deleteExcept` unreachable on the shared path:
  /// `persistInstallation` requires a `workspaceId: string`, so the reconcile
  /// cannot even be formed for a shared installation.
  workspaceId           String?   @map("workspace_id")
  /// The ORGANISATION this connection belongs to (Story MOTIR-4669 · MOTIR-4649)
  /// — the tier a repository is actually connected at. A repository is connected
  /// ONCE, to the organisation, and which projects use it is visibility
  /// configuration (MOTIR-2029's rule for the code graph, applied to the thing
  /// the graph is built FROM); the workspace column above is the tier this
  /// replaces as the OWNER, and it is kept because a connection is still STARTED
  /// from somewhere.
  ///
  /// ⚠️ NULLABLE, and for the SAME reason `workspaceId` is: Motir's shared
  /// provisioning installation is owned by no tenant, so it can name neither a
  /// workspace nor an organisation. A NULL here is that row, not a backfill gap —
  /// the backfill's own assertion is scoped to rows that HAVE a workspace.
  organizationId        String?   @map("organization_id")
  accountLogin          String    @map("account_login")
  accountType           String    @map("account_type")
  /// The connection's access token, encrypted at rest — NULL for GitHub (minted
  /// on demand). Populated for GitLab (OAuth issues a stored token). Only
  /// `lib/gitlab/tokenCrypto.ts` + `gitlabConnectionService` read/write it.
  accessTokenEncrypted  String?   @map("access_token_encrypted")
  /// The connection's refresh token, encrypted at rest — NULL unless the provider
  /// issues one (GitLab does; GitHub does not). GitLab rotates it on each refresh.
  refreshTokenEncrypted String?   @map("refresh_token_encrypted")
  /// When the stored access token expires — the refresh path reads it to decide
  /// when to refresh. NULL for GitHub (no stored token).
  tokenExpiresAt        DateTime? @map("token_expires_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  workspace    Workspace?                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Modelled on BOTH sides with the same action the SQL uses (the FK-`@relation`
  /// rule). Cascade, exactly as the workspace relation above: a deleted
  /// organisation takes its connections with it.
  organization Organization?               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repos        GithubRepo[]
  /// The organisations this installation is linked to (MOTIR-8218). One row per
  /// organisation; the installation itself stays ONE fact about GitHub.
  orgLinks     GithubInstallationOrgLink[]

  @@index([workspaceId])
  @@index([organizationId])
  @@map("github_installation")
}

/// THE LINK BETWEEN ONE GITHUB ACCOUNT AND ONE ORGANISATION (Story MOTIR-8216 ·
/// MOTIR-8218).
///
/// A GitHub App installation is one account, and since this story one account
/// can serve several Motir organisations, each with its own disjoint subset of
/// the account's repositories. The installation row stays the single GitHub-side
/// fact, keyed on GitHub's unique `installation_id`; WHICH organisations use it
/// is this table. Its `workspace_id` / `organization_id` columns are left in
/// place for the deploy window (the old build still writes them) — contracting
/// them is not this story's.
///
/// ⚠️ Motir's SHARED PROVISIONING INSTALLATION (MOTIR-1931) gets NO row here:
/// it is owned by no tenant, so there is nothing to link, and the backfill only
/// copies rows that carry an organisation. That is what keeps it invisible to
/// every tenant read of "my accounts".
///
/// RLS: an org read arm (`github_installation_org_link_org_read`, the
/// `github_installation_org_read` shape), a read for the workspace the link was
/// connected from, and writes under the system context only.
model GithubInstallationOrgLink {
  id             String   @id @default(cuid())
  /// FK → GithubInstallation.id (the internal cuid, NOT GitHub's numeric id).
  installationId String   @map("installation_id")
  organizationId String   @map("organization_id")
  /// The tier the link was connected FROM, as `github_repo` records it.
  workspaceId    String   @map("workspace_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  installation GithubInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// One link per (installation, organisation): a re-run install refreshes it in place.
  @@unique([installationId, organizationId])
  @@index([organizationId])
  @@index([workspaceId])
  @@map("github_installation_org_link")
}

/// A repository selected on a GitHub App installation (Story 7.10 · MOTIR-891).
/// The installation grant's repo access is scoped to these rows. FK to the
/// internal installation modelled on BOTH sides (the FK-`@relation` rule). Read
/// through the GitProvider seam as a NormalizedRepo (owner/name/defaultBranch).
model GithubRepo {
  id             String  @id @default(cuid())
  /// Provider discriminator — always "github" for these rows.
  provider       String  @default("github")
  /// FK → GithubInstallation.id (the internal cuid, NOT GitHub's numeric
  /// installation id). The parent installation this repo was selected on.
  installationId String  @map("installation_id")
  /// WHOSE this repo is (MOTIR-1931). Tenancy is a property of the REPOSITORY,
  /// not of the installation: Motir's provisioning org holds every tenant's
  /// created repos behind ONE installation, so workspace A's repo and workspace
  /// B's repo differ by repository, never by installation. This column is the
  /// ONLY tenancy read — the installation still SELECTS which mirror rows a
  /// delivery may touch, the repo row ATTRIBUTES them. Mirrors `ProjectRepo`,
  /// which already gates on its own `workspace_id` rather than a join through.
  workspaceId    String  @map("workspace_id")
  /// WHOSE this repository is, at the tier that actually owns it (Story
  /// MOTIR-4669 · MOTIR-4649). A repository is connected ONCE, to the
  /// ORGANISATION, and which projects use it is visibility configuration —
  /// MOTIR-2029's rule for the code graph, applied to the thing the graph is
  /// built FROM. Two workspaces of one organisation connecting the same
  /// repository were two connections and two graphs built from identical bytes;
  /// this column is what stops that being expressible.
  ///
  /// NOT NULL since MOTIR-4700. It was added NULLABLE by MOTIR-4649 for a
  /// DEPLOY WINDOW — a migration runs before the new pods serve, and a NOT NULL
  /// in that same migration would have failed every insert the OLD build
  /// attempted on the two unattended write paths. That window closed when the
  /// pre-MOTIR-4649 build went out of service, and the constraint is what makes
  /// the guarantee the writers already enforce a property of the DATABASE:
  /// `UpsertGithubRepoInput.organizationId` is required and
  /// `resolveOrganizationId` throws rather than returning null, so no caller
  /// could manufacture a null — but only the constraint says so to anything that
  /// is not a caller.
  ///
  /// ⚠️ `GithubInstallation.organizationId` stays NULLABLE, and that asymmetry is
  /// the model rather than an oversight: Motir's SHARED PROVISIONING INSTALLATION
  /// (MOTIR-1931) serves N tenants and is owned by none, so it can name neither a
  /// workspace nor an organisation — its `workspaceId` is null for the same
  /// reason. The repository rows it holds carry both tiers, which is what lets
  /// THIS column be tightened while that one cannot.
  ///
  /// ⚠️ AND THE ROW-LEVEL SECURITY NOW READS THIS COLUMN — MOTIR-4677 landed
  /// with MOTIR-4649, so the sentence that used to stand here ("the shipped
  /// policies still key on `workspaceId`; rewriting them is MOTIR-4677's card")
  /// describes a world that no longer exists. TWO permissive policies stand on
  /// this table and Postgres ORs them: `github_repo_workspace_or_system`
  /// (`FOR ALL`, on `workspace_id` — the writes and the workspace-scoped read)
  /// and `github_repo_org_read` (`FOR SELECT`, on `organization_id`).
  ///
  /// Which is a second reason the NOT NULL matters rather than only tidying: a
  /// row with a null organisation is invisible to the org read arm by
  /// construction — `NULL = <anything>` is NULL, never true — so it would be
  /// readable through the workspace arm alone and silently absent from every
  /// organisation-tier read. The constraint removes that shape.
  ///
  /// `workspaceId` above is KEPT and still non-null: it is the tier a repository
  /// is connected FROM, and it is what the `FOR ALL` policy authorises writes on.
  organizationId String  @map("organization_id")
  /// GitHub's numeric repository id (as a string) — stable across renames.
  repoId         String  @map("repo_id")
  owner          String
  name           String
  defaultBranch  String  @map("default_branch")
  /// Whether the repository is ARCHIVED on the host (MOTIR-1959). An archived
  /// repo is READ-ONLY: it rejects a push and a pull request from an admin, so a
  /// card resolving to one dispatches an agent that cannot open a PR at all.
  /// Membership in the project's set and a collaborator's `push` permission are
  /// both silent about this — they answer "which row?" and "may this PERSON
  /// write?", never "does this REPOSITORY still accept writes?".
  ///
  /// Recorded, never derived: the value is stamped from the host's own
  /// `archived` / `archived_at` field at every point the mirror is written
  /// (installation reconcile, provisioning, GitLab connect) and flipped by the
  /// `repository` `archived` / `unarchived` delivery, so it stays true for a repo
  /// archived AFTER it joined the set — which is the failure MOTIR-1956 recorded.
  ///
  /// `@default(false)` rather than nullable: every pre-existing row was accepted
  /// as live, and `false` says exactly that — "not known to be archived" — with no
  /// backfill pass and no third state for consumers to interpret.
  archived       Boolean @default(false)

  /// THE DEFAULT BRANCH'S CURRENT HEAD, as the push webhook last saw it (Story
  /// MOTIR-4669 · MOTIR-4724).
  ///
  /// Half of "is the code graph behind the code". `handlePush` already PARSES
  /// this — `NormalizedPushEvent.headSha` — and discarded it, so persisting it is
  /// a field write on a delivery Motir already handles rather than a new call to
  /// anyone. That is what makes staleness a comparison of two local columns
  /// instead of a GitHub API call per repository on every page render.
  ///
  /// NULL until the first push after this migration. A null means "not known
  /// yet", never "up to date": the derivation reads it as UNKNOWN and reports the
  /// repository as `indexed` rather than inventing a `stale` from missing data.
  defaultBranchHeadSha String? @map("default_branch_head_sha")

  /// THE HEAD THE CODE GRAPH WAS BUILT FROM — the other half.
  ///
  /// ⚠️ IT IS THE HEAD OBSERVED WHEN THE INDEX RUN STARTED, not when it finished,
  /// and the direction of that imprecision is deliberate. The index job reads the
  /// default branch's CURRENT head at run time (`githubWebhookService.handlePush`
  /// says so in its own words), so a push landing DURING a run leaves this value
  /// behind the new head — and the repository then reads `stale`. The opposite
  /// choice (stamp at finish) would read `indexed` for a graph that had already
  /// missed a commit. Over-reporting staleness costs a re-index; under-reporting
  /// it tells somebody their graph matches their code while they decide whether
  /// to trust a plan built from it.
  ///
  /// motir-core does NOT receive the indexed commit from motir-ai — the boundary
  /// reports no sha — so this is the closest thing motir-core can know, and it is
  /// exact except across that one window.
  indexedHeadSha String?   @map("indexed_head_sha")
  /// When that index succeeded. Renders "indexed <when>"; never used for staleness,
  /// which is a SHA comparison — a timestamp cannot tell a quiet repo from a stale one.
  indexedAt      DateTime? @map("indexed_at")

  /// The `job_run.id` of an index run IN FLIGHT for this repository, or null.
  ///
  /// ⚠️ THIS EXISTS BECAUSE THE LEDGER CANNOT ANSWER IT.
  /// `jobRunRepository.findRunningCodeGraphIndexForWorkspace` states the reason on
  /// itself: a `running` row has no `output.repoRef`, because the job writes
  /// `output` only on success — so the ledger knows that A run is in flight and
  /// never WHICH repository it is for.
  ///
  /// ⚠️ IT IS A POINTER, NOT A STATE, and that is what makes a crashed run
  /// self-healing. The derivation reports `indexing` only when the run it names is
  /// still `running`; a run that died leaves this column set and the row reads
  /// whatever its shas say, because an abandoned run is not an index in progress.
  indexingRunId String? @map("indexing_run_id")

  /// WHY INDEXING IS PAUSED FOR THIS REPOSITORY, or null (MOTIR-4593 · Story
  /// MOTIR-4335). Set when a dispatch was refused by a HARD STOP of the
  /// organisation's internal index allowance — `paused_index_no_credit`,
  /// `paused_index_allowance_exhausted`, and whatever `paused_index_<stop>` a
  /// later hard stop names. Cleared by the next dispatch the allowance lets boot.
  ///
  /// ⚠️ INTERNAL. Motir does not charge for code indexing, and this reason is the
  /// internal cause: a surface may say a refresh is `paused`, never why
  /// (`lib/codeGraph/refreshReason.ts`). It is the input the catch-up sweep
  /// (MOTIR-5290) selects on — a repository with no recorded pause is never
  /// re-asked.
  ///
  /// ⚠️ A POINTER-FREE STATE, UNLIKE `indexingRunId`: nothing else can say a
  /// dispatch was refused, because a refused dispatch writes no ledger row that
  /// names the repository.
  indexPausedReason String?   @map("index_paused_reason")
  /// When the pause above was recorded.
  indexPausedAt     DateTime? @map("index_paused_at")

  /// THE LAST INDEX WAS REFUSED FOR SIZE (MOTIR-7129 · Story MOTIR-7092): the
  /// graph's UNCOMPRESSED size and the supported maximum motir-ai refused it
  /// against at the upload grant, in bytes, and when that was recorded. Written by
  /// `githubRepoRepository.markIndexRefusedForSize` when a run settles refused for
  /// size (MOTIR-7130); cleared by `clearIndexRefusal` when a later run actually
  /// indexes. A run that fails for any other reason leaves them as they are —
  /// nothing has shown the graph got smaller.
  ///
  /// ⚠️ CUSTOMER-FACING — the opposite of `indexPausedReason` above. These are
  /// written so they CAN be shown: the `/code` Repositories row tells the person
  /// the size and the limit (MOTIR-7132). They are NUMBERS, not a sentence, so the
  /// row renders its own copy in each locale and no motir-ai wording ever reaches a
  /// customer.
  ///
  /// BigInt: the plausibility envelope admits a claim up to 4 GiB, past `int4`.
  indexRefusedSizeBytes BigInt?   @map("index_refused_size_bytes")
  /// The supported maximum the size above was refused against.
  indexRefusedCapBytes  BigInt?   @map("index_refused_cap_bytes")
  /// When the refusal above was recorded.
  indexRefusedAt        DateTime? @map("index_refused_at")

  /// THE DRIFT COUNT — how many commits the default branch is ahead of the graph
  /// (MOTIR-4644), and the exact PAIR it was computed for.
  ///
  /// ⚠️ THE TWO SHA COLUMNS ARE NOT REDUNDANT WITH THE ONES ABOVE, and they are
  /// what makes this cache safe. A count is a fact about ONE pair
  /// `(indexedHeadSha, defaultBranchHeadSha)`. Either of those can move at any
  /// moment — a push, an index run — and the stored number is then a fact about
  /// a pair that no longer exists. Storing the count ALONE would leave no way to
  /// tell a current answer from a stale one, so the read compares the pair and
  /// returns `null` when it has moved rather than a number that was true
  /// yesterday.
  ///
  /// ⚠️ AND `null` IS NEVER `0`. Zero means the graph MATCHES the head; null
  /// means nobody has counted, or the count is not defined for this pair (a
  /// force-push has no common ancestor), or the host could not answer. The
  /// surfaces draw them differently and must keep being able to.
  ///
  /// Written only by the recompute job — never on a render path, which is
  /// MOTIR-1766's constraint carried forward: no provider round-trip while
  /// somebody is waiting for a page.
  commitsBehind        Int?    @map("commits_behind")
  /// The `indexedHeadSha` the stored count was computed against.
  commitsBehindBaseSha String? @map("commits_behind_base_sha")
  /// The `defaultBranchHeadSha` the stored count was computed against.
  commitsBehindHeadSha String? @map("commits_behind_head_sha")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  installation                GithubInstallation           @relation(fields: [installationId], references: [id], onDelete: Cascade)
  /// The owning tenant (MOTIR-1931) — modelled on BOTH sides, like every other FK
  /// in this schema (the CLAUDE.md migration rule). Cascade: a deleted workspace
  /// takes its mirrored repos with it, exactly as it did when they hung off the
  /// installation.
  workspace                   Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// The owning ORGANISATION (MOTIR-4649, made required by MOTIR-4700) —
  /// modelled on BOTH sides, like every other FK in this schema (the CLAUDE.md
  /// migration rule). Cascade, for the same reason the workspace relation has it:
  /// a deleted organisation takes its mirrored repos with it.
  organization                Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pullRequests                GithubPullRequest[]
  mergeQueueAttempts          GithubMergeQueueAttempt[]
  /// Metered CI runs on this repo (Story MOTIR-1775 · MOTIR-1896). SetNull, like
  /// `ProjectRepo.githubRepoId`: disconnecting the repo must not delete the
  /// record that Motir paid for its compute. The row keeps `repoOwner`/`repoName`
  /// — the identity GitHub actually bills against — so the audit survives the
  /// mirror row entirely.
  ciWorkflowRunUsages         CiWorkflowRunUsage[]
  /// Runner-fleet provisioning intents for this repo (MOTIR-1920). SetNull for
  /// the same reason the metered rows are: the intent keeps `repoOwner`/`repoName`
  /// so it survives the mirror row entirely.
  ciRunnerProvisioningIntents CiRunnerProvisioningIntent[]
  /// The project-repo-set rows this connected repo REALIZES — a LIST, and the
  /// plural is the model this story reverses into (MOTIR-4669 · MOTIR-4648).
  ///
  /// ⚠️ It was `ProjectRepo?`, singular, and the reason it could be was
  /// `ProjectRepo.githubRepoId @unique`: a repo created for project A could never
  /// be recorded as project B's (MOTIR-1780). That constraint is DROPPED. A
  /// repository belongs to the ORGANISATION and which projects use it is
  /// visibility configuration (MOTIR-2029), so **a repository in two projects is
  /// the ordinary case**, and what survives is the narrower guarantee: at most one
  /// row per `(project, repository)` — `ProjectRepo`'s
  /// `@@unique([projectId, githubRepoId])`.
  ///
  /// Back-relation of a SetNull FK, unchanged: disconnecting this repo leaves each
  /// set row with a null realized repo, not a deleted plan.
  projectRepos                ProjectRepo[]
  workItemDeliveries          WorkItemDelivery[]
  testInstructionsRepos       TestInstructionsRepo[]
  /// Preview deployments this repository's host reported (MOTIR-5329). Cascade.
  repoDeployments             RepoDeployment[]

  @@unique([installationId, repoId])
  @@index([installationId])
  @@index([workspaceId])
  /// The host identity of the repository (MOTIR-8218) — what the one-org-per-repo
  /// guard (`trg_github_repo_one_organization`) and webhook routing look up by.
  /// NOT unique, deliberately: one organisation legitimately holds the same
  /// repository twice after a takeover (the provisioning row keeps its coordinates
  /// while the tenant's own installation re-selects it). What may never happen is
  /// two ORGANISATIONS holding it, and that is the trigger's to refuse.
  @@index([provider, repoId])
  /// Serves the org-tier reads this column exists for, and — once MOTIR-4677
  /// rewrites them — the RLS predicate itself, exactly as `@@index([workspaceId])`
  /// serves `github_repo_workspace_or_system` today.
  ///
  /// ⚠️ A hand-written PARTIAL index on this table must not reuse `(organization_id)`
  /// as its whole column list, for the reason `project_repository` records at
  /// length (MOTIR-1960): Prisma's differ pairs a database index to a datamodel
  /// index BY COLUMN LIST, and the pairing turns an inexpressible `WHERE` clause
  /// into a permanent spurious RENAME.
  @@index([organizationId])
  @@map("github_repo")
}

/// A pull request linked to a work item (Story 7.10 · MOTIR-891) — the
/// PR→work-item link the status sync (MOTIR-892) + CI loop (MOTIR-894) drive.
/// `workItemId` is NULLABLE: a PR can exist before it resolves to a work item
/// (the head ref carries the MOTIR-<n> hint the consumer resolves). FK to the
/// repo AND the work item modelled on both sides (the FK-`@relation` rule). Read
/// through the GitProvider seam as a NormalizedChangeRequest.
model GithubPullRequest {
  id                    String              @id @default(cuid())
  /// Provider discriminator — always "github" for these rows.
  provider              String              @default("github")
  /// FK → GithubRepo.id (internal cuid).
  repoId                String              @map("repo_id")
  number                Int
  /// Normalized change-request state: "open" | "closed" (merged is the boolean).
  state                 String
  merged                Boolean             @default(false)
  headRef               String              @map("head_ref")
  /// The branch the change request targets, as of the last delivery (Story
  /// MOTIR-2725 · MOTIR-2729). The completion decision has always compared this
  /// against the repository's mirrored `defaultBranch` — a merge onto anything
  /// else never reached the trunk (MOTIR-1873) — but it read it off the LIVE
  /// payload (`NormalizedChangeRequest.baseRef`) and dropped it here, which is
  /// all a PER-DELIVERY gate ever needs. The repository-SET gate is the first
  /// consumer that asks about merges which already happened, in OTHER
  /// repositories, whose only record is this row.
  ///
  /// NULLABLE and deliberately NOT backfilled: a row ingested before this column
  /// existed genuinely does not know its base, and a consumer must read null as
  /// UNKNOWN in BOTH directions — it does not prove the merge reached the trunk
  /// (which would complete a card on a stranded merge), and it does not prove it
  /// did not (which would hold every already-complete card in the product). Same
  /// rule `merged_at` above states for the same reason. Every live path supplies
  /// it: it is REQUIRED on `NormalizedChangeRequest` for both providers and on
  /// the historical backfill, so only pre-existing rows are ever null.
  baseRef               String?             @map("base_ref")
  /// The PR's title as of the last webhook delivery (MOTIR-1579 — the
  /// Development surface renders it). Nullable: rows ingested before title
  /// capture display their `head_ref` instead.
  title                 String?
  /// Whether the change request is a DRAFT — explicitly not offered for review —
  /// as of the last delivery (MOTIR-5002). `NormalizedChangeRequest.draft` is
  /// where it is read from the payload; this is where it survives the delivery.
  ///
  /// ⚠️ ITS READERS ARE `resyncLinkedPullRequest` AND `mergeCandidateHead` (a draft
  /// is no merge candidate — MOTIR-5699), and that narrowness is the design. Every
  /// OTHER reader of this row must go on seeing a draft as an
  /// ordinary OPEN pull request — the `deferred_open_pr` count that holds a
  /// multi-repository parent open while one repository's chain is stopped, the
  /// delivery-set gate, the Development surface — so nothing here keys on it and
  /// nothing should. The link door needs it because a link carries no payload:
  /// it synthesizes a change request from this row, and before this column it had
  /// to pin `draft: false` and assert `implemented` about a pull request whose
  /// author had said the opposite.
  ///
  /// ⚠️ NULLABLE, NOT BACKFILLED, and read as UNKNOWN — the same rule `base_ref`
  /// and `merged_at` above state, for the same reason. A row mirrored before this
  /// column existed genuinely does not know, and the two guesses are not
  /// symmetric: `false` re-asserts the very defect on the population most likely
  /// to be a draft (an in-flight parent run, whose pull request is a draft until
  /// its last child lands), while `true` would strand a ready pull request's card.
  /// So the resync DECLINES on null rather than choosing one, and the next
  /// delivery fills it in.
  ///
  /// ⚠️ AND `undefined` IS NOT `null` AT THE WRITE. `UpsertGithubPullRequestInput`
  /// takes it as a REQUIRED key whose value may be undefined — "I do not assert
  /// draft-ness" — which leaves an existing value alone on update and the column
  /// null on insert. That is what lets the link door create a placeholder row
  /// without claiming to know, and the backfill (merged rows only, where the flag
  /// decides nothing) say the same.
  draft                 Boolean?
  /// The host's answer to *can this pull request merge into its base right now?* —
  /// GitHub's raw `mergeable_state` (`clean`, `dirty`, `blocked`, `unstable`,
  /// `behind`, `unknown`, …), as of the last time Motir ASKED (MOTIR-5913, for bug
  /// MOTIR-5907; design/github § 30). Stored as TEXT, not an enum: the value set is
  /// the host's and open, and every reader compares against `'dirty'` alone.
  ///
  /// ⚠️ IT IS ONLY MEANINGFUL AT `mergeableStateHeadSha`. A conflict usually arrives
  /// with NO event on the pull request — another merge moves the BASE — so the
  /// reading is refreshed by asking, not by a payload: the base-branch push
  /// re-evaluation, the press-time read and the reconcile tick write it, and a
  /// `synchronize` CLEARS it (a new head's mergeability is uncomputed). A reading
  /// taken at an older head is not a conflict at the current one.
  ///
  /// ⚠️ NULL IS "NOT KNOWN", NEVER "CONFLICTED" — the MOTIR-5699 rule for `draft`.
  /// GitHub itself answers `mergeable: null` until it has computed, and inventing a
  /// conflict for that would hold healthy work.
  mergeableState        String?             @map("mergeable_state")
  /// The head commit `mergeableState` was read at. See above.
  mergeableStateHeadSha String?             @map("mergeable_state_head_sha")
  /// The pull request's HEAD COMMIT, as the host last reported it (MOTIR-7005) —
  /// written by every `pull_request` delivery (`synchronize` included) and by every
  /// host read (the reconcile tick, the base-branch re-read, the press-time read).
  ///
  /// ⚠️ THE CHECK ROWS ARE NOT THE HEAD. A push that produces no CI — which GitHub
  /// guarantees for a pull request conflicting with its base — leaves the newest
  /// check rows at the OLD commit, and before this column that commit was read as
  /// current: a gate was raised over it and the card promoted on its green. Every
  /// head reader goes through `lib/github/pullRequestHead.ts`, and a member whose
  /// check rows are not at this head is not green.
  ///
  /// ⚠️ NULLABLE, NOT BACKFILLED, and read as UNKNOWN — then the readers fall back
  /// to the check rows' head, which is what they did before the column existed.
  headSha               String?             @map("head_sha")
  /// Whether this pull request's association with a work item was DECLARED by a
  /// person or an agent (MOTIR-1596, design/github Panel 5) rather than inferred.
  ///
  /// ⚠️ RETIRED, AND STILL DECLARED — this is PHASE 1 of a three-phase column
  /// removal (MOTIR-4894; `docs/decisions/delivery-reader-migration.md` §6a), and
  /// the declaration is the whole point of the phase, not an oversight.
  ///
  /// It qualified `work_item_id`: a manual link was the STICKY override of the
  /// MOTIR-892 branch/title resolver, so the webhook never overwrote one. That
  /// resolver was retired by MOTIR-3674 and the scalar dropped by MOTIR-3757, so
  /// there was nothing left to be sticky AGAINST — yet the flag kept being
  /// written, and the Development section kept rendering it as a "linked
  /// manually" suffix on rows a coding agent had linked over `link_pull_request`.
  /// MOTIR-4894 removed every reader and writer in application code: the DTO
  /// field, the mapper line, `markLinkedManually`, the sync's preserve arm, the
  /// historical sweep's write and comparison, and the suffix itself.
  ///
  /// ⚠️ DO NOT DELETE THIS FIELD AND THE COLUMN IN ONE CHANGE. A Prisma read with
  /// no explicit `select` emits every scalar the model DECLARES, so this line is
  /// itself a reader — the last one, and the one no grep for the name can find.
  /// `fly.toml`'s `release_command` migrates before any new machine takes
  /// traffic, so a `DROP COLUMN` shipped alongside this line's deletion lands
  /// under the PREVIOUS image and every read of this model 500s for the length of
  /// the rollout (that is exactly what took `get_work_item` down tenant-wide on
  /// 2026-08-28). Phase 2 `@ignore`s the field and RELEASES; phase 3 drops the
  /// column with the `-- @client-stopped-selecting:` marker
  /// `tests/contract-phase-guard.test.ts` requires.
  linkedManually        Boolean             @default(false) @map("linked_manually")
  /// WHEN the merge landed, stamped from the delivery's `pull_request.merged_at`
  /// (MOTIR-2922). Null on every row that has not merged — and on merged rows
  /// ingested before this column existed, which is why a consumer must treat
  /// null as "unknown", never as "merged at the epoch". `updatedAt` cannot serve
  /// this purpose: a later `check_suite`-driven upsert moves it, so it answers
  /// "when did we last hear about this PR", not "when did the work land".
  mergedAt              DateTime?           @map("merged_at")
  /// The repo-relative paths the MERGE touched, captured best-effort after the
  /// status sync commits (MOTIR-2922). Empty when the PR has not merged, when
  /// the capture failed, and on rows that predate the column — all three are the
  /// same "no evidence" state on purpose, because a consumer that could tell
  /// them apart would still have nothing to do with the difference.
  changedPaths          String[]            @default([]) @map("changed_paths")
  /// Whether `changedPaths` is a PREFIX of the merge's real file list rather
  /// than the whole of it — set when the list exceeded `MAX_CAPTURED_PR_PATHS`
  /// or the page walk hit its cap. A consumer may read absence of a path as
  /// evidence ONLY while this is false (the no-silent-caps rule).
  changedPathsTruncated Boolean             @default(false) @map("changed_paths_truncated")
  /// THE MERGE RECORD (MOTIR-5520) — written ONLY when Motir itself merged or
  /// enqueued this pull request, never by the webhook. `null` on both means *not
  /// merged by Motir*, which is every row that predates this column and every merge a
  /// person made on the host.
  ///
  /// ⚠️ IT LIVES HERE AND NOT ON `approval_gate.outcome_ref`, WHICH ALREADY MEANS
  /// SOMETHING. That column is the status KEY the deciding transaction applied, and
  /// the item page paints it as a status (`OptimisticStatusProvider.tsx`); a merge SHA
  /// written there would render as one. An automatic merge has no gate row at all,
  /// so the pull request is the one place both paths can record what happened.
  mergeAuthority        MergeAuthority?     @map("merge_authority")
  /// What the merge PRODUCED — the merge commit SHA, or `queue:<entryId>` when the
  /// pull request was enqueued. The queue entry is what lets a later ejection be
  /// matched to the entry Motir created (MOTIR-5461).
  mergeOutcomeRef       String?             @map("merge_outcome_ref")
  /// THE DECISION DOCUMENT AT THE HEAD (Story MOTIR-4907 · MOTIR-5674;
  /// `docs/decisions/approval-gates.md` §8's FIFTH AMENDMENT, clause 7). Which
  /// `docs/decisions/*.md` file this pull request adds or modifies, read off the
  /// host's file list when a head is OBSERVED — so a gate transaction can ask the
  /// decision question without calling the host. Written only for a pull request
  /// delivering a `decision` + `coding_agent` card. `null` = never captured.
  ///
  /// ⚠️ NOT A COPY OF THE DOCUMENT. Motir stores no decision text anywhere; this is
  /// the file's IDENTITY (path + git blob sha), a fact about the host. And it is
  /// NOT `changedPaths`, which stays the MERGE's file list (MOTIR-2922): these are
  /// a HEAD-time fact, and one column meaning two moments would make both wrong.
  decisionDocOutcome    DecisionDocOutcome? @map("decision_doc_outcome")
  /// The document's repo-relative path, set only for outcome `one`.
  decisionDocPath       String?             @map("decision_doc_path")
  /// The document's git BLOB sha at that head, set only for outcome `one`. The
  /// decision gate's version keys on this, not on the head, so a push that leaves
  /// the document untouched does not re-ask an accepted decision (clause 4).
  decisionDocBlobSha    String?             @map("decision_doc_blob_sha")
  /// The head commit the capture was read at, for every outcome; null when the
  /// host named none.
  decisionDocHeadSha    String?             @map("decision_doc_head_sha")
  /// EVERY decision document the head writes — the one path for `one`, each of them
  /// for `several` (MOTIR-5678), so the port can name what a reviewer must reduce to
  /// one. Empty for `none`, `unreadable` and a row never captured.
  decisionDocPaths      String[]            @default([]) @map("decision_doc_paths")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  repo               GithubRepo                      @relation(fields: [repoId], references: [id], onDelete: Cascade)
  checkRuns          GithubCheckRun[]
  deliveries         WorkItemDelivery[]
  // One per (head commit, delivered card) — THE feedback comment for that pair
  // (MOTIR-3770).
  ciFeedbackComments GithubCiFeedbackComment[]
  // Every time the merge queue removed it without merging it (MOTIR-5632).
  queueExits         GithubPullRequestQueueExit[]
  mergeRefusals      GithubPullRequestMergeRefusal[]
  queueAttempts      GithubMergeQueueAttempt[]
  reviews            GithubPullRequestReview[]

  @@unique([repoId, number])
  @@index([repoId])
  @@map("github_pull_request")
}

/// One REMOVAL of a pull request from a merge queue that did not merge it (Story
/// MOTIR-5461 · MOTIR-5632), specified by `docs/decisions/approval-gates.md` §4
/// THIRD AMENDMENT, decisions 3 and 9. Rows ACCUMULATE: one head can be ejected
/// several times, each by a different merge group, and the latest row is the pull
/// request's current exit.
///
/// It is where the queue's verdict lives, and deliberately NOT in `github_check_run`:
/// that table is the pull request's OWN CI state at its head, and a queue failure
/// written there would turn a green pull request red.
model GithubPullRequestQueueExit {
  id                     String               @id @default(cuid())
  /// FK → GithubPullRequest.id (internal cuid).
  pullRequestId          String               @map("pull_request_id")
  /// The delivery's `X-GitHub-Delivery` GUID — the idempotency key (decision 9). A
  /// hand REDELIVERY repeats it (measured, MOTIR-5627), so a replayed exit writes
  /// nothing; a genuine second exit is a new event with a new GUID.
  deliveryId             String               @unique @map("delivery_id")
  /// The host's reason, VERBATIM (`CI_FAILURE`, `MANUAL`, …, or a string nobody has
  /// mapped yet).
  rawReason              String               @map("raw_reason")
  disposition            QueueExitDisposition
  /// The pull request's head when it left the queue — what *Queue again* and the
  /// promotion hold compare the current head against.
  headSha                String               @map("head_sha")
  exitedAt               DateTime             @map("exited_at")
  /// Stamped by *Queue again* (MOTIR-5634) when the pull request was put back.
  /// Null while the exit still stands.
  requeuedAt             DateTime?            @map("requeued_at")
  /// The merge-queue check that failed, copied from the pull request's latest
  /// queue attempt (MOTIR-5633; decision 8) — or filled later, when that check
  /// completes after the exit. Null when no check is known: a conflict has no merge
  /// group, and an installation without the `merge_group` event records no attempt.
  failingCheckName       String?              @map("failing_check_name")
  failingCheckUrl        String?              @map("failing_check_url")
  /// That check's RAW GitHub conclusion (`failure`, `cancelled`, `timed_out`, …),
  /// VERBATIM — the difference `mapConclusion` folds away (§4 SIXTH AMENDMENT,
  /// MOTIR-6846). `cancelled` / `timed_out` make a `CI_FAILURE` / `CI_TIMEOUT` exit
  /// NEUTRAL. Null while no check is named, and on every exit recorded before it.
  failingCheckConclusion String?              @map("failing_check_conclusion")
  createdAt              DateTime             @default(now()) @map("created_at")

  pullRequest GithubPullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@index([pullRequestId, exitedAt])
  @@map("github_pull_request_queue_exit")
}

/// ONE MERGE THE HOST REFUSED, recorded on the pull request (Story MOTIR-5799 ·
/// MOTIR-5833; ADR `docs/decisions/approval-gates.md` §4 FOURTH AMENDMENT, point 5).
///
/// ⚠️ THE SIBLING OF `github_pull_request_queue_exit`, FOR THE OTHER WAY A MERGE FAILS
/// TO LAND. The queue's removal arrives as a webhook and has always been recorded; a
/// refusal at the PRESS existed only in that request's response, so a reload showed a
/// card reading **Approved** with nothing anywhere saying the merge had been refused or
/// why. One approval authorizes ONE attempt (point 1), so the attempt that was spent has
/// to be a FACT the page can read back.
///
/// ⚠️ ROWS ACCUMULATE, exactly as exits do: a person may press again after changing the
/// setting, and be refused again. The pull request's CURRENT refusal is its latest row —
/// hence the (pull_request_id, refused_at) index.
///
/// ⚠️ `subject_changed` IS NEVER RECORDED. That refusal means the head moved under the
/// press, so nothing was attempted and no approval was spent (MOTIR-5232's path).
///
/// ⚠️ TENANCY IS THE PARENT'S, COPIED EXACTLY — no workspace column, and an RLS policy
/// that joins `github_pull_request → github_repo` explicitly, with the `system_admin`
/// arm for the paths that resolve their tier before a workspace is bound.
model GithubPullRequestMergeRefusal {
  id             String    @id @default(cuid())
  /// FK → GithubPullRequest.id (internal cuid).
  pullRequestId  String    @map("pull_request_id")
  /// The host's refusal, VERBATIM — one of `lib/git/types.ts`'s `MergeRefusalCode`
  /// (`checks_not_green`, `conflict`, `branch_protected`, `app_permission_missing`,
  /// `already_merged`), or a backfill-only code the convergence writes (MOTIR-5809).
  code           String
  /// The head the press was made against — what makes the refusal STOP STANDING when a
  /// push moves it, the same rule an exit follows.
  headSha        String    @map("head_sha")
  /// The gate whose approval this press spent. Null for a press carried by a design
  /// approval (MOTIR-5664) and for a row the convergence writes.
  approvalGateId String?   @map("approval_gate_id")
  /// `app_permission_missing` only — the permission the host said it needed.
  permission     String?
  /// The host's OWN message for the refusal, verbatim (Bug MOTIR-6735) — for a
  /// `branch_protected` refusal the only record of WHICH setting refused it. Null when
  /// the host gave none, and on every row recorded before the column existed.
  reason         String?
  refusedAt      DateTime  @map("refused_at")
  /// Stamped when a later press at the same head SUCCEEDED, or the pull request merged.
  /// Null while the refusal still stands. A PUSH needs no stamp: the head moves and the
  /// row no longer names it.
  supersededAt   DateTime? @map("superseded_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  pullRequest GithubPullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@index([pullRequestId, refusedAt])
  @@map("github_pull_request_merge_refusal")
}

/// ONE GITHUB REVIEW, mirrored (Story MOTIR-4910 · MOTIR-5594; ADR
/// `docs/decisions/approval-gates.md` §8 FOURTH AMENDMENT, decisions 2, 4 and 7).
/// A `pull_request_review` delivery writes one row here; the evaluator reads them
/// to decide the card's one approve-to-merge gate, and the Development block reads
/// them to draw what each pull request's review says while the gate waits.
///
/// ⚠️ ROWS ARE RECORDED WHETHER OR NOT A GATE EXISTS (decision 8). A review given
/// while CI was still running has nowhere to be applied yet; storing it anyway is
/// what lets the gate, once raised, be decided from reviews that predate it
/// instead of asking the reviewer a second time.
///
/// ⚠️ TENANCY IS THE PARENT'S, COPIED EXACTLY. Like `github_pull_request_queue_exit`
/// and `github_ci_feedback_comment`, this row has NO workspace column of its own:
/// it hangs off a pull request, and RLS does not traverse foreign keys, so its
/// policy joins `github_pull_request → github_repo` explicitly. The `system_admin`
/// arm admits the webhook path, which resolves its connection tier before any
/// workspace is bound.
model GithubPullRequestReview {
  id String @id @default(cuid())

  /// GITHUB'S OWN `review.id` — the IDEMPOTENCY KEY, unique. A redelivered
  /// `submitted` event upserts this same row rather than writing a second one.
  githubReviewId String @unique @map("github_review_id")

  githubPullRequestId String @map("github_pull_request_id")

  /// `review.user.id` — the stable identity the actor resolution joins on
  /// (`GithubIdentity.githubUserId`), never the login, which a person can change.
  reviewerGithubUserId String @map("reviewer_github_user_id")
  /// `review.user.login` — what a surface SHOWS, and the whole label when Motir
  /// cannot map the reviewer to a member (decision 3).
  reviewerLogin        String @map("reviewer_login")
  /// `review.user.type` — `User` or `Bot`. Stored as given rather than as an
  /// enum: it is GitHub's vocabulary and it grows.
  reviewerType         String @map("reviewer_type")

  state GithubReviewState

  /// `review.commit_id` — the head the review was given AT. A review counts only
  /// where this equals the member's head in the gate's `subjectVersion`.
  commitSha String @map("commit_sha")

  /// The reviewer's permission when the review arrived, captured rather than
  /// re-read later (decision 2).
  reviewerPermission GithubRepositoryPermission @map("reviewer_permission")

  submittedAt DateTime @map("submitted_at")
  /// `review.html_url`. Nullable — a payload need not carry one.
  htmlUrl     String?  @map("html_url")

  /// `review.body` — what the reviewer WROTE, as given (Story MOTIR-6067 ·
  /// MOTIR-6074; ADR `approval-gates.md` §10b). A `changes_requested` review that
  /// decides a gate hands this over as the gate's reason, so a refusal made on
  /// GitHub says why exactly as one pressed in Motir does. NULL when the review
  /// carried no text — a surface then says *no reason given on GitHub*.
  body String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pullRequest GithubPullRequest @relation(fields: [githubPullRequestId], references: [id], onDelete: Cascade)

  /// The evaluator's read: every review for one pull request at one head.
  ///
  /// ⚠️ EXPLICITLY NAMED, and it must stay under 63 characters. The derived name
  /// (`github_pull_request_review_github_pull_request_id_commit_sha_idx`) is 64,
  /// and Postgres and Prisma truncate it DIFFERENTLY — Postgres cuts the tail
  /// (`…_commit_sha_id`), Prisma keeps its `_idx` suffix (`…_commit_sh_idx`) — so
  /// the two never agree and `migrate diff` reports a permanent spurious RENAME,
  /// which the build job fails on. Caught by that check on this card.
  @@index([githubPullRequestId, commitSha], map: "github_pr_review_pr_id_commit_sha_idx")
  @@map("github_pull_request_review")
}

/// One merge-queue ATTEMPT of a pull request (Story MOTIR-5461 · MOTIR-5633;
/// `docs/decisions/approval-gates.md` §4 THIRD AMENDMENT, decision 8). Written at the
/// `merge_group` `checks_requested` delivery, before any of the group's checks can
/// complete, for each pull request its `head_ref` names. A failed check run at the
/// group's `head_sha` writes its name and link here (the first failure to complete
/// wins). Like the exit row, deliberately NOT `github_check_run`: the group's checks
/// say nothing about the pull request's own head.
model GithubMergeQueueAttempt {
  id                     String    @id @default(cuid())
  /// FK → GithubPullRequest.id (internal cuid).
  pullRequestId          String    @map("pull_request_id")
  /// FK → GithubRepo.id — the lookup a check run makes, by repository and sha.
  repoId                 String    @map("repo_id")
  /// The merge group's commit — every check the queue runs is reported against it.
  headSha                String    @map("head_sha")
  /// `refs/heads/gh-readonly-queue/<base>/pr-<n>-<base sha>`, verbatim.
  headRef                String    @map("head_ref")
  failingCheckName       String?   @map("failing_check_name")
  failingCheckUrl        String?   @map("failing_check_url")
  /// The failing check's RAW GitHub conclusion, verbatim (§4 SIXTH AMENDMENT,
  /// MOTIR-6846). Written beside the name, by the same first-failure-wins write.
  failingCheckConclusion String?   @map("failing_check_conclusion")
  failedAt               DateTime? @map("failed_at")
  createdAt              DateTime  @default(now()) @map("created_at")

  pullRequest GithubPullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  repo        GithubRepo        @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([pullRequestId, headSha])
  @@index([repoId, headSha])
  @@map("github_merge_queue_attempt")
}

/// One DELIVERY of a work item by a pull request — the ONE association between the
/// two, many-to-many in both directions (Story MOTIR-3655 · MOTIR-3657), specified
/// by `docs/decisions/work-item-delivery-links.md`.
///
/// N cards linking to the SAME pull-request row is N rows, and that is how one pull
/// request delivers N cards; one card linking to two pull-request rows is two rows,
/// and that is how a card spans repositories. Nothing else is needed to express
/// either direction.
///
/// Every row is written by `link_pull_request` — a per-card DECLARATION by the agent
/// that did that card's work, never an inference from what a diff touched. That is
/// the property MOTIR-3527 wanted and the reason this supersedes it rather than
/// contradicting it.
///
/// `repo_id` is a REAL column and not a join away: the completion gate compares each
/// member's merge against THAT repository's own default branch, and resolving it per
/// member through `github_pull_request → github_repo` is an N+1 on the delivery path.
/// `workspace_id` is carried on the ROW because RLS does not traverse foreign keys —
/// note `GithubPullRequest` has none of its own and reads tenancy through its repo.
model WorkItemDelivery {
  id                  String   @id @default(cuid())
  workspaceId         String   @map("workspace_id")
  workItemId          String   @map("work_item_id")
  githubPullRequestId String   @map("github_pull_request_id")
  repoId              String   @map("repo_id")
  createdAt           DateTime @default(now()) @map("created_at")

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workItem    WorkItem          @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  pullRequest GithubPullRequest @relation(fields: [githubPullRequestId], references: [id], onDelete: Cascade)
  repo        GithubRepo        @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([workItemId, githubPullRequestId])
  @@index([workspaceId])
  @@index([githubPullRequestId])
  @@index([repoId])
  @@map("work_item_delivery")
}

/// One terminal CI check result for a linked PR (Story 7.10 · Subtask 7.10.6 /
/// MOTIR-894) — the verification half of the closed loop: a `check_suite` /
/// `check_run` webhook delivery, resolved to its PR and persisted so the CI
/// feedback is IDEMPOTENT. The unique `(pull_request_id, commit_sha, check_name)`
/// is the card's idempotency key: a redelivery or a re-run of the SAME check at
/// the SAME head commit converges on this one row rather than recording a second
/// one. `conclusion` is the normalized `CiConclusion`
/// (`success` | `failure` | `pending` | `neutral`) the `GitProvider` seam emits.
/// The feedback COMMENT's identity is `GithubCiFeedbackComment`'s, not this
/// table's. This table carried a scalar mirror of it until MOTIR-3803 dropped
/// the column, completing the three-phase retirement MOTIR-3770 began.
/// Provider-neutral: a GitLab pipeline (7.23)
/// normalizes into the same shape. The work item's own `ciState` signal is
/// derived from these rows and denormalized onto `WorkItem.ciState`.
model GithubCheckRun {
  id             String   @id @default(cuid())
  /// FK → GithubPullRequest.id (internal cuid) — the PR this check ran against.
  pullRequestId  String   @map("pull_request_id")
  /// The head commit SHA the check ran on (the payload's `head_sha`). Part of the
  /// idempotency key: a re-run against a NEW commit is a distinct row.
  commitSha      String   @map("commit_sha")
  /// The check's name / context (a `check_run.name`, a `check_suite` app slug, or
  /// a legacy commit-status `context`) — distinguishes concurrent checks on one
  /// commit so each keeps its own feedback.
  checkName      String   @map("check_name")
  /// The CI RUN this check belongs to — GitHub's `check_suite.id` (one suite per
  /// workflow run), GitLab's pipeline id. Part of the idempotency key since
  /// MOTIR-3209: `cancel-in-progress` makes TWO runs at one commit ordinary, and
  /// a key that could not tell them apart merged them by NAME — so a matrix job
  /// cancelled before expansion (`Vitest (${{ matrix.shard }}/…)`) recorded a
  /// failure no later run could ever overwrite.
  ///
  /// ⚠️ NOT NULL with an EMPTY-STRING sentinel for "no run identity", not a
  /// nullable column: Postgres treats NULLs in a unique index as distinct, and
  /// Prisma's compound-unique input cannot carry one, so a nullable member would
  /// insert a fresh row per delivery instead of converging. Every row written
  /// before this column existed carries `''`, as does every provider that
  /// reports no run identity (a legacy commit-`status` event) — one degraded
  /// group that supersedes nothing and is superseded by nothing, i.e. exactly
  /// the behaviour those rows had before.
  checkSuiteId   String   @default("") @map("check_suite_id")
  /// TRUE for a suite's OWN roll-up row — a GitHub `check_suite` event, recorded
  /// under the App slug — rather than a check (MOTIR-6274). Every GitHub Actions
  /// workflow is the same App, so that name is shared by suites of DIFFERENT
  /// workflows at one commit and says nothing about which workflow a suite is:
  /// `liveCheckRows` leaves these rows out of its shared-name test. A GitLab
  /// pipeline row is NOT one — its `pipeline` name is the supersession key there.
  suiteAggregate Boolean  @default(false) @map("suite_aggregate")
  /// Normalized `CiConclusion`: "success" | "failure" | "pending" | "neutral".
  conclusion     String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  pullRequest GithubPullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@unique([pullRequestId, commitSha, checkName, checkSuiteId])
  @@index([pullRequestId])
  @@map("github_check_run")
}

/// ONE DEPLOYMENT a repository's own host reported — the PREVIEW URL behind the
/// HOW TO TEST block's "in the preview" path (Story MOTIR-4906 · MOTIR-5329).
///
/// Motir only LISTENS: it creates no deployment and posts no status. The row is
/// the host's latest status for one deployment, keyed on the host's own id, and
/// stored against the COMMIT it deployed (and the ref it was made from, for the
/// read that knows a pull request's branch but not yet its head sha).
///
/// Out-of-order delivery is guarded IN THE WRITE: the upsert overwrites only when
/// the incoming status is not older than the stored one, so a late `in_progress`
/// never replaces a `success` that already arrived.
model RepoDeployment {
  id                   String   @id @default(cuid())
  /// The repository's tenancy, copied onto the row so the policy is a pure gate
  /// (the `test_instructions` / `work_item_delivery` precedent).
  workspaceId          String   @map("workspace_id")
  repoId               String   @map("repo_id")
  provider             String
  providerDeploymentId String   @map("provider_deployment_id")
  commitSha            String   @map("commit_sha")
  ref                  String
  environment          String
  /// One of `DEPLOYMENT_STATES` (`lib/git/types.ts`); text so a provider's new
  /// state can be stored and rendered as `unknown` rather than refused.
  state                String
  /// Only an `http:` / `https:` URL is kept; anything else is stored NULL,
  /// because the port renders this as a link.
  environmentUrl       String?  @map("environment_url")
  occurredAt           DateTime @map("occurred_at")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repo      GithubRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, provider, providerDeploymentId])
  @@index([repoId, commitSha])
  @@index([repoId, ref])
  @@index([workspaceId])
  @@map("repo_deployment")
}

/// THE CI feedback comment for one `(change request, head commit, work item)`
/// (MOTIR-3770), specified by `docs/decisions/ci-feedback-comment-per-card.md`.
///
/// The comment's KEY is unchanged from MOTIR-2946 — one comment per change
/// request per head commit, carrying the AGGREGATE over that commit's whole check
/// set — and this table adds the third coordinate that key always implied and
/// nothing could store: WHICH CARD it was posted on. A pull request delivering N
/// cards is N rows, one comment each, and that is the whole shape.
///
/// It replaced `github_check_run.feedback_comment_id` as the source of truth, and
/// MOTIR-3803 has since dropped that column. It was a nullable scalar on a table
/// whose grain is one row PER CHECK, so it
/// held one id replicated across every check row at the commit — which is one id
/// however many cards the delivery reached, and a second delivered card therefore
/// showed no CI verdict at all while its `ciState` said otherwise (MOTIR-3721
/// AC 6, the half that shipped unmet).
///
/// ⚠️ `onDelete: Cascade` ON THE COMMENT IS LOAD-BEARING, and it is what an array
/// column could not have offered. The id this table hands the edit path must be
/// LIVE: a person deleting a feedback comment takes its row with it, so the next
/// terminal conclusion at that commit finds nothing recorded and posts a fresh
/// comment. A dangling id would instead throw inside the delivery's transaction,
/// and a webhook the host then retries for ever is a far worse failure than a
/// duplicated comment.
///
/// Tenancy is the `github_check_run` policy one table over — the `system_admin`
/// arm, else a join through `github_pull_request → github_repo` — because this
/// row hangs off the same pull request and carries no tenant discriminator of its
/// own. (`work_item_delivery` carries `workspace_id` instead because it is read
/// BEFORE a tenant is bound; this table is only ever read inside the CI-feedback
/// path, which has already resolved and bound one.)
model GithubCiFeedbackComment {
  id            String   @id @default(cuid())
  /// FK → GithubPullRequest.id — the change request the verdict is about.
  pullRequestId String   @map("pull_request_id")
  /// The head commit the check set ran on. A new commit is a new comment, which
  /// is the identity MOTIR-2946 settled.
  commitSha     String   @map("commit_sha")
  /// The delivered card the comment was posted ON — the coordinate the scalar
  /// could not carry.
  workItemId    String   @map("work_item_id")
  /// The `Comment` itself. Cascade, so a deleted comment leaves no dangling id.
  commentId     String   @map("comment_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  pullRequest GithubPullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  workItem    WorkItem          @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  comment     Comment           @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([pullRequestId, commitSha, workItemId])
  @@index([workItemId])
  @@index([commentId])
  @@map("github_ci_feedback_comment")
}

/// The SOURCE a set of issues is imported FROM (Story 7.16 · MOTIR-939). Live
/// connectors — `jira` / `linear` / `github` (paginated REST) + `plane` (added
/// as a planned connector, MOTIR-1639) — and `csv`, the credential-free
/// uploaded-file fallback. The decision (MOTIR-938) records the connector layer
/// as an INTERFACE (`IssueSourceConnector`), so a new source is a new connector
/// plus one enum value here — never a wizard rewrite.
enum ImportSource {
  jira
  linear
  github
  plane
  csv

  @@map("import_source")
}

/// The lifecycle of one import RUN (Story 7.16 · MOTIR-938 decision). Every
/// import is PREVIEWED before it writes (the dry-run is the run minus the
/// writes): `draft` (created, no mapping confirmed) → `previewed` (the dry-run
/// plan computed) → `running` → a terminal `succeeded` / `partially_failed` (some
/// issues failed, the rest committed) / `failed`.
enum ImportStatus {
  draft
  previewed
  running
  succeeded
  partially_failed
  failed

  @@map("import_status")
}

/// One issue-import RUN (Story 7.16 · MOTIR-939) — the persistence record the
/// importer rides. It captures WHERE from (`source` + `sourceRef`, e.g. the
/// connected Jira project / GitHub repo / uploaded CSV ref), the confirmed
/// field-`mapping` (typed JSON, decided in MOTIR-938), the run `status`, and the
/// per-outcome `*Count` tallies. This card (MOTIR-939) is the SCHEMA + the
/// single-op repository; the mapping/persist ENGINE that owns the transaction +
/// the create-vs-update decision is MOTIR-941 (7.16.5).
///
/// Workspace-scoped tenant data, so it lands WITH its RLS policy in the same
/// migration (migration-by-concern — no unguarded window). Every FK is modelled
/// as a Prisma `@relation` on BOTH sides with an explicit `onDelete` (the
/// FK-`@relation`/migrate-dev-no-drift rule): workspace/project CASCADE (tenant +
/// project teardown), `createdBy` SET NULL (a deleted initiator never destroys
/// import history — the `plan.decidedBy` precedent).
model Import {
  id           String       @id @default(cuid())
  workspaceId  String       @map("workspace_id")
  projectId    String       @map("project_id")
  source       ImportSource
  /// The connected project / repo / file ref the issues come from (Jira project
  /// key, GitHub `owner/repo`, an uploaded-file handle). Nullable — a `draft`
  /// import may not have picked its source ref yet.
  sourceRef    String?      @map("source_ref")
  /// The confirmed field-mapping config as typed JSON (MOTIR-938's mapping table:
  /// type/status/priority/users/labels/…). Nullable — a `draft` has none yet; the
  /// engine (MOTIR-941) reads it, this card only stores it.
  mapping      Json?
  status       ImportStatus @default(draft)
  createdCount Int          @default(0) @map("created_count")
  updatedCount Int          @default(0) @map("updated_count")
  skippedCount Int          @default(0) @map("skipped_count")
  failedCount  Int          @default(0) @map("failed_count")
  createdById  String?      @map("created_by_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy      User?           @relation("ImportCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  importedIssues ImportedIssue[]

  @@index([workspaceId])
  @@index([projectId, createdAt])
  @@map("import")
}

/// The idempotency MAP (Story 7.16 · MOTIR-939) — one row per imported source
/// issue, mapping its stable `(project, source, externalId)` identity to the
/// Motir `workItem` it became. This is what makes a re-run idempotent: the
/// importer (MOTIR-941) resolves each source issue through this map and UPSERTS
/// the mapped work item instead of creating a duplicate. `sourceHash` lets the
/// engine detect a source-side change since the last run (re-sync vs skip).
///
/// The `@@unique([projectId, source, externalId])` is the idempotency guarantee
/// AT THE DB — a second import of the same external id cannot insert a second
/// mapping row, not merely "the app checks first" (MOTIR-938's Atlassian
/// external-id-skip precedent). The identity is STABLE ACROSS runs, so it is keyed
/// on the source identity, NOT `importId` (which changes each run — `importId` is
/// provenance only, SET NULL so deleting an old run never wipes the map and breaks
/// idempotency). `workItem` is CASCADE: delete the work item and its mapping row
/// goes too, so a re-import re-creates it. Workspace-scoped → RLS in the same
/// migration; every FK a both-sides `@relation` (the FK-`@relation` rule).
model ImportedIssue {
  id          String       @id @default(cuid())
  workspaceId String       @map("workspace_id")
  projectId   String       @map("project_id")
  /// The run that most recently wrote this mapping (provenance). Nullable +
  /// SET NULL: the map SURVIVES an import-run delete so re-runs stay idempotent.
  importId    String?      @map("import_id")
  source      ImportSource
  /// The source's stable id for the issue (Jira `PROJ-123`, Linear identifier,
  /// GitHub `owner/repo#42`, a CSV id column).
  externalId  String       @map("external_id")
  workItemId  String       @map("work_item_id")
  /// Hash of the source issue's mapped fields at last import — lets a re-run
  /// detect a source-side change (re-sync) vs an unchanged issue (skip). Nullable.
  sourceHash  String?      @map("source_hash")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  import    Import?   @relation(fields: [importId], references: [id], onDelete: SetNull)
  workItem  WorkItem  @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@unique([projectId, source, externalId])
  @@index([workspaceId])
  @@index([importId])
  @@index([workItemId])
  @@map("imported_issue")
}

/// Migrate-existing-codebase onboarding — the "Workflow B" state machine (Story
/// 7.15 · MOTIR-1499). One durable, RESUMABLE record per project drives a user
/// through connecting a repo, indexing it into the code graph, auditing +
/// approving its coding conventions, running discovery, generating a code-aware
/// plan, and reviewing it. This card is the SCAFFOLDING: the persisted model +
/// repository + the per-step transition service (verify → advance → kick), whose
/// exit-check + kick bodies are stubbed seams the wiring slice (MOTIR-931) fills.
///
/// RESUMABLE by shape: `step` is the saved position, re-read on load — there is
/// no restart-from-`connect` path. The per-step OUTPUTS the transitions gate on
/// are persisted columns (`connectedRepoRef`, `codeGraphReady`,
/// `conventionApprovedAt`, `discoveryJobId`, `generateJobId`), so a resumed run
/// picks up exactly where it stopped.
///
/// Project-scoped tenant data, so the RLS policy (a pure active-workspace gate —
/// the `import` / `plan` precedent) lands in the SAME migration. `discoveryJobId`
/// / `generateJobId` are OPAQUE motir-ai job tokens (no `@relation`, the
/// `plan.sourceJobId` precedent); `connectedRepoRef` is an opaque connected-repo
/// ref. Both FKs are both-sides `@relation`s with the SAME actions the SQL uses
/// (workspace/project CASCADE) so `migrate dev` reports no drift (the
/// FK-`@relation` rule).
model MigrateOnboarding {
  id                   String                  @id @default(cuid())
  workspaceId          String                  @map("workspace_id")
  projectId            String                  @map("project_id")
  /// The onboarding flavour. Always `migrate` here — a single-value discriminator
  /// carried explicitly (per the card's `kind: 'migrate'` field) so a future
  /// shared onboarding model could add a `fresh` sibling without a data migration.
  kind                 MigrateOnboardingKind   @default(migrate)
  /// The saved position in the six-step sequence — the RESUMABILITY anchor.
  step                 MigrateOnboardingStep   @default(connect)
  /// The run-level lifecycle: `active` until the `review → done` transition marks
  /// it `completed`; `failed` is the terminal error state a kicked action sets.
  status               MigrateOnboardingStatus @default(active)
  /// The connected source-repo ref (opaque — a GitHub `owner/repo`, etc.). The
  /// `connect` step's output + its exit condition. Null until a repo is connected.
  connectedRepoRef     String?                 @map("connected_repo_ref")
  /// True once the `index` step has indexed the repo into the code graph — the
  /// `index` step's output + the `audit_convention` step's precondition.
  codeGraphReady       Boolean                 @default(false) @map("code_graph_ready")
  /// When the coding-convention audit was approved — the `audit_convention` step's
  /// output + the `discovery` step's precondition. Null until approved.
  conventionApprovedAt DateTime?               @map("convention_approved_at")
  /// The opaque motir-ai discovery job token (no `@relation` — the
  /// `plan.sourceJobId` precedent). The `discovery` step's output.
  discoveryJobId       String?                 @map("discovery_job_id")
  /// The opaque motir-ai code-aware-generation job token. The `generate` step's output.
  generateJobId        String?                 @map("generate_job_id")
  /// True when the user explicitly skipped the OPTIONAL import step — the
  /// `import` step's skip exit. Mutually exclusive with `importCompleted`.
  importSkipped        Boolean                 @default(false) @map("import_skipped")
  /// True once an import completed on this project (a `succeeded` or
  /// `partially_failed` import RUN exists). The `import` step's completion exit.
  importCompleted      Boolean                 @default(false) @map("import_completed")
  /// When the TERMINAL RECONCILIATION completed this run from the durable
  /// `project.onboardingRanAt` marker instead of the wizard walking the final
  /// `review → done` hop (MOTIR-2092). Null on a run that walked there itself —
  /// which is what makes the two distinguishable after the fact.
  reconciledAt         DateTime?               @map("reconciled_at")
  /// The step the run was parked at when the reconciliation completed it. `step`
  /// is overwritten with `done` by that write, so without this the only record
  /// of how far the journey actually got is destroyed in place.
  reconciledFromStep   MigrateOnboardingStep?  @map("reconciled_from_step")
  /// WHICH STEPS THIS RUN ACTUALLY RUNS — the PLANNER's answer (MOTIR-4759),
  /// carried here by the routing verdict that sent the user to this wizard
  /// (MOTIR-4767 decides it, MOTIR-4769 moves it).
  ///
  /// EMPTY means "no verdict reached this run" and every step runs, which is
  /// exactly the behaviour every run had before this field existed — so there is
  /// nothing to backfill and a run created by any other door is untouched.
  ///
  /// A step ABSENT from a non-empty set was answered by the project's own
  /// substrate rather than by the user, and that is also the RECORD of how it
  /// was satisfied: the provenance line reads this, and so does the rail that
  /// collapses the steps it did not run.
  keptSteps            MigrateOnboardingStep[] @map("kept_steps")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // One migrate-onboarding run per project (the resumable single run); the
  // unique also makes the Project ↔ MigrateOnboarding relation a clean one-to-one.
  @@unique([projectId])
  @@index([workspaceId])
  @@map("migrate_onboarding")
}

enum MigrateOnboardingKind {
  migrate

  @@map("migrate_onboarding_kind")
}

/// The explicit migrate-onboarding sequence: six working steps
/// (connect → index → audit_convention → discovery → generate → review) plus the
/// terminal `done`. Snake_case member (`audit_convention`) mirrors the schema's
/// `partially_failed` / `coding_agent` convention.
enum MigrateOnboardingStep {
  connect
  index
  import
  audit_convention
  discovery
  generate
  review
  done

  @@map("migrate_onboarding_step")
}

enum MigrateOnboardingStatus {
  active
  completed
  failed

  @@map("migrate_onboarding_status")
}

/// The project's plan-change CONVERSATION (Story 7.30 · MOTIR-1728) — the
/// persisted thread that turns "change my plan" from a one-shot prompt into a
/// refinement dialogue. A session ACCUMULATES the user's turns; submitting
/// hands the accumulated intent to the already-shipped plan-edit job contract
/// (`aiPlanEditsService.submitAugment` → `POST /api/ai/augment` + the job /
/// stream / approve routes). It adds NO engine capability: motir-ai still sees
/// one `augment` job with one prompt.
///
/// Why persisted rather than client state: a conversation that evaporates on
/// reload is not a conversation. Re-opening the planning workspace RESUMES this
/// thread (the resumability anchor, the `MigrateOnboarding` precedent), and the
/// accumulated turns — not just the latest one — are what the job receives.
///
/// MANY sessions per project and per anchor set, over time (story MOTIR-6011 —
/// `docs/decisions/agent-authored-plans.md` AMENDMENT 17 §1–§2, which
/// supersedes the original "ONE thread per project"). A session is a record
/// from its FIRST TURN, is addressed by its `id` on every door, and `scopeKey`
/// DESCRIBES what it is anchored to rather than identifying it. Which session a
/// re-opened surface resumes is a service decision (§3: your own, active within
/// the resume window), not a uniqueness guarantee. Every `Plan` belongs to
/// exactly one session through `Plan.sessionId` (§5). Workspace-scoped tenant
/// data (RLS in the same migration).
model PlanChangeSession {
  id                  String                    @id @default(cuid())
  workspaceId         String                    @map("workspace_id")
  projectId           String                    @map("project_id")
  /// Who opened the thread. SetNull — a departed author leaves the conversation
  /// intact and unattributed (the `Notification` actor semantics).
  createdById         String?                   @map("created_by_id")
  /// The number of turns on the thread — the READ-DERIVED value an append
  /// allocates the next `seq` from. Appends lock this row (`SELECT … FOR UPDATE`)
  /// and re-read it inside the transaction, so two concurrent appends serialize
  /// into two ordered turns instead of colliding on `seq` (the
  /// lock-before-read-derived-update rule); the `(session_id, seq)` unique is the
  /// DB-level backstop, translated to a typed error.
  turnCount           Int                       @default(0) @map("turn_count")
  /// The CANONICAL anchor-set discriminator (7.12.3 · MOTIR-909) — what makes a
  /// thread "the conversation about THESE work items" rather than "the project's
  /// conversation". Derived, never client-supplied: `targetKeys` deduped, sorted,
  /// joined by `,` (see `lib/planChange/scope.ts`). The empty string is the
  /// PROJECT-WIDE thread — the shipped 7.30 conversation, unchanged — so the
  /// `(project_id, scope_key)` unique still admits exactly one of those per
  /// project while allowing one contextual thread per distinct anchor set.
  scopeKey            String                    @default("") @map("scope_key")
  /// The anchor SET this thread is scoped to, as work-item IDENTIFIERS ("MOTIR-812"),
  /// in the same canonical order `scopeKey` is built from. Empty on the project-wide
  /// thread. Stored (not re-derived from `scopeKey`) because it is what a RESUMED
  /// thread re-submits as the motir-ai `context.targetKeys` anchor set, and what the
  /// panel labels the conversation with. Identifiers, not FKs — the same opaque-token
  /// posture `last_job_id` takes; a deleted anchor must not cascade the conversation.
  targetKeys          String[]                  @default([]) @map("target_keys")
  /// The most recent plan-edit job this thread submitted (an OPAQUE motir-ai job
  /// token — a plain scalar, NOT an FK; the `plan.sourceJobId` precedent). What
  /// a resumed rail re-attaches its stream / diff review to.
  lastJobId           String?                   @map("last_job_id")
  /// When that submission happened. Null until the thread has been submitted at
  /// least once (a thread can accumulate turns without ever submitting).
  lastSubmittedAt     DateTime?                 @map("last_submitted_at")
  /// When the session was last USED — every turn (user, assistant, system) and
  /// every submit moves it (AMENDMENT 17 §3). The resume window and the Plans
  /// page's newest-activity order both read it. Not `updatedAt`, which any
  /// bookkeeping write (a lock, a label) would also move.
  lastActivityAt      DateTime                  @default(now()) @map("last_activity_at")
  /// WHICH DOOR opened the session (AMENDMENT 17 §4) — NOT `Plan.origin`, which
  /// answers what decided to start a plan. `legacy` is written only by the
  /// MOTIR-6020 backfill, for a pre-existing plan whose conversation cannot be
  /// identified.
  origin              PlanSessionOrigin         @default(conversation)
  /// The REFUSED approval gate that SEEDED this session (story MOTIR-6068 ·
  /// MOTIR-6207; `agent-authored-plans.md` AMENDMENT 17 §9). Written ONLY at the
  /// session's creation by a seeded first turn
  /// (`planChangeSessionsService.startSeededWithFirstTurn`) and never changed
  /// afterwards; NULL on every unseeded session. A seeded start resumes only a
  /// session of the SAME seed. SetNull — a gate row that goes leaves the
  /// conversation intact and unseeded.
  seedGateId          String?                   @map("seed_gate_id")
  /// The GUIDE REPLY TURN whose re-plan offer SEEDED this session (Story MOTIR-8684 ·
  /// MOTIR-8691; decision MOTIR-8685): the `assistant` turn of a guide conversation
  /// that holds the offer. Written ONLY at creation, by the guide-seeded first turn
  /// (`planChangeSessionsService.startGuideSeededWithFirstTurn`), and never changed;
  /// NULL on every other session, and on a session the guide's request was sent
  /// into because the person already held the target. EXCLUSIVE with `seedGateId`
  /// (the `plan_change_session_one_seed` CHECK). SetNull — a turn that goes leaves
  /// the conversation intact and unseeded.
  seedGuideTurnId     String?                   @map("seed_guide_turn_id")
  /// When the session ENDED (AMENDMENT 23 §1). **A session is OPEN ⟺ this is
  /// NULL.** An ended session is never resumed and accepts no turn. Written only
  /// by the one end operation, together with `endReason` and `endedById`.
  endedAt             DateTime?                 @map("ended_at")
  /// Why it ended — see `PlanSessionEndReason`. Null exactly when `endedAt` is.
  endReason           PlanSessionEndReason?     @map("end_reason")
  /// The person who ended it (a decider, or the person who restarted); NULL when
  /// Motir ended it (a failure, the idle sweep). SetNull — a departed member
  /// leaves the end recorded and unattributed.
  endedById           String?                   @map("ended_by_id")
  /// The ENDED session this one's conversation was copied from (AMENDMENT 23
  /// §6) — written once, at creation, by the copy start; NULL otherwise. SetNull:
  /// the copy outlives its source.
  copiedFromSessionId String?                   @map("copied_from_session_id")
  // ── THE SESSION'S WAITING STATE (Story MOTIR-7905 · MOTIR-7908) ───────────────
  // An OPEN session can be waiting on its person in one of two ways, and never both
  // (the `plan_change_session_one_wait` CHECK). Both are cleared by the one end write
  // (`endSessionWithin`), which the same CHECK requires: an ENDED session waits on
  // nothing. The definitions every reader shares live in
  // `lib/planChange/sessionWaitingState.ts` — read them there, not here.
  //
  // ── FAILED, waiting to resume ─────────────────────────────────────────────────
  /// When core observed the session's latest hosted attempt FAIL partway through a
  /// walk. Written by the failure path (`markFailed`), cleared by the resume when the
  /// new attempt binds (`clearFailure`) or by the end. **failed-waiting ⟺ ended_at IS
  /// NULL AND failed_at IS NOT NULL.**
  failedAt            DateTime?                 @map("failed_at")
  /// The motir-ai job that failed (an OPAQUE token, like `lastJobId`). The resume
  /// submits it as `resume.fromJobId`: the failed attempt's settled PART 1 lives on
  /// that job's row in motir-ai.
  failedJobId         String?                   @map("failed_job_id")
  /// WHY, as motir-ai's closed code — never its English.
  failureReason       PlanSessionFailureReason? @map("failure_reason")
  /// motir-ai's `walkStop.detail` (at most 300 characters). For support and logs
  /// ONLY — never rendered to the person and never on the DTO.
  failureDetail       String?                   @map("failure_detail")
  /// The kind of session the walk had open; null when the attempt failed before it
  /// reached a level.
  failureStopPhase    PlanSessionWalkPhase?     @map("failure_stop_phase")
  /// An opaque reference to the level's parent, or to the card being authored (a
  /// `planItem:<id>` or a work-item key), stored exactly as motir-ai reports it.
  /// Core never resolves it to a row: the resume reads the PLAN's own state.
  failureStopRef      String?                   @map("failure_stop_ref")
  /// That level's or card's title at the moment of failure, so a row can name it
  /// without a second read.
  failureStopTitle    String?                   @map("failure_stop_title")
  /// Whether the failed attempt can be RESUMED (MOTIR-9121): motir-ai's own verdict on
  /// the failed job (`resumable` on `GET /v1/jobs/:id`) — `false` when the job failed
  /// before its conversation settled, so a resume has nothing to continue from. A
  /// `false` record offers no Resume, has released the attempt's targets, and lets the
  /// next turn plan again. Null when unknown (a motir-ai that does not say, or a failure
  /// recorded before this column), which reads as resumable, as it always did.
  failureResumable    Boolean?                  @map("failure_resumable")
  // ── AWAITING ITS PERSON ───────────────────────────────────────────────────────
  /// When the conversation began waiting on its owner's next turn. Written by the
  /// planning-session gate (`markAwaitingPerson`), cleared by the person's next turn
  /// or by the end. **awaiting-person ⟺ ended_at IS NULL AND awaiting_person_since
  /// IS NOT NULL.**
  awaitingPersonSince DateTime?                 @map("awaiting_person_since")
  /// `question` or `reply` — see `PlanSessionAwaitingCause`.
  awaitingPersonCause PlanSessionAwaitingCause? @map("awaiting_person_cause")
  /// How many bugs a GUIDE conversation has filed through its `file_bug` action
  /// (Story MOTIR-7797 · MOTIR-7800; decision MOTIR-7798 Q3). Read and bumped
  /// under this row's lock in the transaction that files the bug, so two
  /// concurrent filings cannot both pass `GUIDE_BUGS_PER_CONVERSATION`. Always 0
  /// on a session that is not a guide.
  guideBugsFiled      Int                       @default(0) @map("guide_bugs_filed")
  // ── AUTOMATIC RESUME ──────────────────────────────────────────────────────────
  /// How many times Motir has resumed this conversation by itself after its
  /// planning machine was lost (Story MOTIR-8301 · MOTIR-8305). Bumped by
  /// `recordAutoResume` in ONE statement that also enforces the bound
  /// (`AUTO_RESUMES_PER_SESSION`), so two concurrent callers cannot both pass it.
  /// A CHECK keeps it non-negative.
  autoResumeCount     Int                       @default(0) @map("auto_resume_count")
  /// When Motir last resumed this conversation by itself. Null until the first.
  lastAutoResumedAt   DateTime?                 @map("last_auto_resumed_at")
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")

  workspace       Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project         Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy       User?                    @relation("PlanChangeSessionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  seedGate        ApprovalGate?            @relation("PlanChangeSessionSeedGate", fields: [seedGateId], references: [id], onDelete: SetNull)
  seedGuideTurn   PlanChangeTurn?          @relation("PlanChangeSessionSeedGuideTurn", fields: [seedGuideTurnId], references: [id], onDelete: SetNull)
  endedBy         User?                    @relation("PlanChangeSessionEndedBy", fields: [endedById], references: [id], onDelete: SetNull)
  copiedFrom      PlanChangeSession?       @relation("PlanChangeSessionCopiedFrom", fields: [copiedFromSessionId], references: [id], onDelete: SetNull)
  copies          PlanChangeSession[]      @relation("PlanChangeSessionCopiedFrom")
  turns           PlanChangeTurn[]
  /// Grill me sessions about this conversation (Story MOTIR-9221 · MOTIR-9314). Cascade.
  sharpenSessions SharpenSession[]
  /// The BOUNDARY MAILBOX for this thread's runs (MOTIR-4067) — one ordered
  /// sequence per job, carrying BOTH the turns typed mid-run and the stop.
  /// Cascade: a deleted thread takes its mailbox with it.
  mailbox         PlanChangeMailboxEntry[]
  /// The planner's mid-run PAUSES on this thread's runs (MOTIR-8007). Cascade.
  runPauses       PlanChangeRunPause[]
  /// The work items this conversation currently HOLDS (Story MOTIR-2786 ·
  /// MOTIR-2787). Cascade — a deleted thread releases everything it held.
  targetLocks     PlanTargetLock[]
  /// The plans this conversation produced (AMENDMENT 17 §5) — many plans to one
  /// session: a refine or a revision writes a successor plan on the SAME
  /// session, never a new one.
  plans           Plan[]

  /// The composite-FK TARGET (MOTIR-1735). `id` is already unique on its own, so
  /// this adds no integrity constraint of its own — it exists solely to make
  /// `(id, workspace_id)` a referenceable key, so `plan_change_turn` can point its
  /// FK at the PAIR and prove a turn's tenancy against its parent's. See the
  /// `session` relation on `PlanChangeTurn`.
  @@unique([id, workspaceId])
  /// The RESUME read (AMENDMENT 17 §3): "this member's most recent session in
  /// this scope". Replaces the `@@unique([projectId, scopeKey])` MOTIR-909 set —
  /// a scope now holds many sessions, so uniqueness is gone and this index
  /// serves the one read the unique used to answer.
  @@index([projectId, scopeKey, createdById, lastActivityAt])
  /// The Plans page's session list (AMENDMENT 17 §8), newest activity first.
  @@index([projectId, lastActivityAt])
  /// The SEEDED-session read (AMENDMENT 17 §9): "this member's most recent
  /// session seeded by this gate" — `findSeededForUser`.
  @@index([seedGateId, createdById, lastActivityAt])
  /// The GUIDE-SEEDED-session read (MOTIR-8691): "this member's most recent
  /// session seeded by this guide offer" — `findSeededByGuideTurnForUser`.
  @@index([seedGuideTurnId, createdById, lastActivityAt])
  /// The TO RESUME read (Story MOTIR-7905): "this member's failed-waiting sessions",
  /// newest failure first.
  @@index([workspaceId, createdById, failedAt])
  @@index([workspaceId])
  @@map("plan_change_session")
}

/// One turn on a plan-change conversation (Story 7.30 · MOTIR-1728), ordered by
/// `seq` within its session (0-based, gapless — allocated under the session's row
/// lock). Two roles:
///   * `user`   — what the person typed. These, IN ORDER, are the accumulated
///                intent a submission sends to the plan-edit job.
///   * `system` — a thread MARKER Motir wrote (today: "these turns were
///                submitted", carrying the resulting `job_id`), so a resumed
///                thread renders what already went out instead of looking like
///                nothing happened. System turns are NOT part of the intent.
/// Workspace-scoped tenant data (RLS in the same migration).
model PlanChangeTurn {
  id                    String                 @id @default(cuid())
  workspaceId           String                 @map("workspace_id")
  sessionId             String                 @map("session_id")
  /// 0-based position in the thread. Unique per session — the DB backstop for the
  /// locked allocation; a violation means a lost append race and surfaces as a
  /// typed domain error, never a raw P2002.
  seq                   Int
  role                  PlanChangeTurnRole
  body                  String                 @db.Text
  /// The producing motir-ai job token — set on a `system` submission marker (the
  /// job that submission produced) AND on an `assistant` turn (the job whose
  /// result carried the utterance, MOTIR-2226; it is also the idempotency key
  /// that keeps a re-read job from appending the same turn twice). Also set on a
  /// `user` turn submitted through the ASK door (MOTIR-1819) — that turn IS its
  /// own submission, so the turn is the natural key for the job it produced, and
  /// the settle is then a single keyed, replayable lookup rather than "the most
  /// recent user turn". Null on a `user` turn of the shipped plan-change path,
  /// whose submission is a separate gesture writing a `system` marker.
  jobId                 String?                @map("job_id")
  /// The ONE Gate-2 question an `assistant` turn asked (MOTIR-2222's
  /// `PlanningTurn.question`), or null when the turn only reported its findings.
  /// It is what makes the awaiting-your-answer state DERIVABLE from the persisted
  /// thread rather than held in client state — so re-opening the workspace hours
  /// later comes back to the same pending question. Null on every other role.
  question              String?                @db.Text
  /// A `user` turn sent as the REPLY to the pending question (through the answer
  /// bar), as opposed to one that changed the subject and SUPERSEDED it. The two
  /// dispositions render different markers (design state C vs E), and neither may
  /// rest on reading the words — so which affordance sent it is recorded here.
  isAnswer              Boolean                @default(false) @map("is_answer")
  /// What this turn ASKED FOR — `ask` (answer my question, change nothing) or
  /// `plan_change` (propose a plan delta), MOTIR-1816 /
  /// `docs/decisions/conversation-turn-intent.md`. Set on `user` turns only
  /// (null on `system` / `assistant`, the `authorId` precedent).
  ///
  /// ⚠️ SERVER-RESOLVED, never client-supplied (ADR §1). The client posts the
  /// text and nothing else; the intent is decided by motir-ai as the first step
  /// of the `ask_project` job and written here. It records the EFFECTIVE
  /// disposition — what actually ran for this turn — not a stored guess, which
  /// is why a re-run under the other intent MOVES it rather than adding a second
  /// row (the `isAnswer` posture: the thread records what Motir DID).
  intent                PlanChangeTurnIntent?  @map("intent")
  /// Whether this turn was RE-RUN under the other intent after Motir read it
  /// wrong (ADR §3). `intent` alone cannot say so — it holds what finally ran —
  /// and the transcript is a record, so the correction has to survive as a fact
  /// rather than as the absence of the first reading. Also the one number that
  /// says whether ADR §4's default ever needs revisiting.
  intentCorrected       Boolean                @default(false) @map("intent_corrected")
  /// When a `debug` turn's ONE write was CLAIMED (MOTIR-7049,
  /// `docs/decisions/conversation-turn-intent.md` AMENDMENT 1 · A1.4). Set on a
  /// `user` turn only, by a compare-and-set under the session's row lock BEFORE
  /// the card is written, so of two settles of the same `debug_bug` job exactly
  /// one writes. Null on every other turn, and on a debug turn nothing has been
  /// landed for. Released (back to null) only when the write was refused inside
  /// its own transaction, so nothing committed; a claim that outlives a crash
  /// stays set — the landing fails CLOSED rather than filing a second bug.
  debugLandingClaimedAt DateTime?              @map("debug_landing_claimed_at")
  /// The work item a `user` turn was ANCHORED on (MOTIR-7064; ADR AMENDMENT 1 ·
  /// A1.2) — the report widget's triage bug on its seeded debug turn — as the
  /// IDENTIFIER the ask door resolved it to ("MOTIR-812"), never the raw string
  /// the client posted. The rail draws it as the turn's target chip, so a
  /// reloaded thread keeps the chip as well as the words. Null on every other
  /// role and on an unanchored turn (the orb, an ordinary question). An
  /// IDENTIFIER, not an FK, for the reason `citations` gives: the record of what
  /// the turn was about must not cascade away with the card.
  anchorKey             String?                @map("anchor_key")
  /// What a `debug` turn LANDED (MOTIR-7064; ADR AMENDMENT 1 · A1.4), on the
  /// `assistant` turn that carries its diagnosis — `{ outcome, workItemKey,
  /// title, createdInTriage }`, the settle's `DebugLandingDto` as it was when
  /// the reply was appended (the title is that moment's; the rail prefers the
  /// thread's live reference). Written in the SAME append as the reply, so a
  /// reply never exists without it. It is what renders the turn's outcome line
  /// after a reload. Null on every other turn — every non-debug reply, and every
  /// `user` / `system` turn.
  debugLanding          Json?                  @map("debug_landing")
  /// The CLAIM on a `guide` turn's landing (Story MOTIR-7459 · MOTIR-7470; ADR
  /// `conversation-turn-intent.md` AMENDMENT 2, A2.4) — set on the `user` turn,
  /// by a compare-and-set under the session's row lock, BEFORE the turn's
  /// actions are written to the card. The debug claim's shape: a replayed or
  /// concurrent settle of the same job finds it taken and lands nothing.
  guideLandingClaimedAt DateTime?              @map("guide_landing_claimed_at")
  /// What a `guide` turn's job returned and what landed (MOTIR-7470), on the
  /// `assistant` turn carrying its message — `{ actions, outcomes, temporary }`:
  /// the validated actions, each one's outcome (`landed`, `recorded` on the
  /// conversation only, or `skipped` with its reason), and whether the walk was
  /// on a temporary (unsaved) list. Written in the SAME append as the reply. The
  /// rail and canvas read it, and the temporary list is re-derived from it, so
  /// an unsaved walk lives on the conversation and nowhere else (A2.2). Null on
  /// every other turn.
  guideTurn             Json?                  @map("guide_turn")
  /// The fixed confirm CORE wrote on this `assistant` turn (MOTIR-7649; ADR
  /// AMENDMENT 3, A3.2) — written with no model call by the ask settle for a
  /// `new_session` turn and by the Plan something new control, so the words and
  /// the button leave the SAME turn. It is PENDING while it is the thread's latest
  /// turn and the session is open; an unanswered confirm closes nothing. Null on
  /// every other turn and role.
  confirm               PlanChangeTurnConfirm? @map("confirm")
  /// The work items an `assistant` ANSWER rests on, as work-item IDENTIFIERS
  /// ("MOTIR-812"), in the order the answer cites them. Empty on every other
  /// role and on an answer the graphs could not support.
  ///
  /// IDENTIFIERS, NOT FKs — deliberately, and the same call `PlanChangeSession.
  /// targetKeys` makes for the same reason: a deleted work item must not cascade
  /// away the answer that once cited it, and a citation is a record of what was
  /// read, not a live relationship. Validated against the project's own items at
  /// WRITE time (`workItemRepository.findByIdentifiers`), so a cross-project or
  /// unresolvable key is dropped rather than persisted as a chip that renders
  /// broken. Queryable without a join (`citations @> ARRAY['MOTIR-812']`).
  citations             String[]               @default([])
  /// The files a `guide` `user` turn carried (Story MOTIR-7471 · MOTIR-7484;
  /// `docs/decisions/guide-turn-files.md` A3.2) — `attachment` ids, in the order
  /// the person added them, each an attachment on the GUIDED card at the moment
  /// the turn was sent. Empty on every other turn and role.
  ///
  /// IDS, NOT FKs — the `citations` call, for the same reason: the attachment can
  /// be deleted from the card later, and the turn must survive it unchanged; the
  /// rail then draws that id as a removed chip. Validated at WRITE time (the card,
  /// the workspace, the caller's view) by `aiGuideService`, never trusted as sent.
  attachmentIds         String[]               @default([]) @map("attachment_ids")
  /// The planning job that was RUNNING when this `user` turn was typed (Story
  /// MOTIR-7990 · MOTIR-7996; `conversation-turn-intent.md` AMENDMENT 4). It marks
  /// the turn as a MID-RUN turn, which is what tells the ask settle never to open
  /// a new planning run for it: it was answered by an `ask_project` job carrying
  /// the run's snapshot, and only a change verdict reaches the running job's
  /// mailbox. Null on every other turn, and on every turn written before the
  /// column existed — a null reads exactly as it always did (no back-fill).
  runJobId              String?                @map("run_job_id")
  /// How the CODE-GRAPH OUTAGE touched this `assistant` turn (Story MOTIR-8136 ·
  /// MOTIR-8141; `design/code-context/design-notes.md` §17) — `declined` for a
  /// plan-writing turn that wrote NO plan because the code could not be read,
  /// `answered` for a question that was answered without it. Written in the SAME
  /// append as the turn, from the job result's own outage signal, so the notice
  /// survives a reload and stays in the history after the graph returns. Null on
  /// every other turn, role and row written before the column existed (no
  /// back-fill): a null reads exactly as the turn always did.
  codeUnreadable        PlanChangeTurnOutage?  @map("code_unreadable")
  /// The target repositories whose code cannot be SEARCHED, as `[{ repoRef, state }]`
  /// (MOTIR-9167): written on the `assistant` turn of a conversation that stopped for
  /// that reason before any planning job opened, so the banner survives a reload.
  /// Null on every other turn and on rows written before the column existed.
  codeUnsearchable      Json?                  @map("code_unsearchable")
  /// The exact text an `assistant` ANSWER offered to FORWARD to the running
  /// planner (MOTIR-7996) — the offered `user` turn's own body, in the person's
  /// words. Set only by a mid-run ask settle whose result carried `offerForward`;
  /// the NEXT mid-run turn reads it as `pendingOffer`, and a confirmation forwards
  /// THIS text, never the confirming turn's. Null on every other turn.
  forwardOffer          String?                @map("forward_offer") @db.Text
  /// The ONE offer an `assistant` answer ended with (MOTIR-9219 · MOTIR-9288; ADR
  /// conversation-turn-intent AMENDMENT 5 clause 1): `{ kind, requestMd, targetKey }`
  /// plus the disposition core writes after the fact (`declinedAt` / `declinedById`,
  /// `confirmedAt` / `confirmedById` / `confirmedSessionId`), the shape the guide's
  /// `replanOffer` keeps. Undecided / superseded are DERIVED from the thread, never
  /// stored. NOT `forwardOffer`, which is the mid-run forward offer. Null on every
  /// other turn, including every turn written before the column.
  answerOffer           Json?                  @map("answer_offer")
  /// The CLAIM on a targeted "plan this" turn's one start (MOTIR-9219 · MOTIR-9291),
  /// set on the `user` turn by a compare-and-set under the session's row lock before
  /// the plan is submitted, and cleared again when that submit throws. The guide and
  /// debug claims' shape: a replayed settle of the same ask job finds it taken and
  /// starts nothing.
  planStartClaimedAt    DateTime?              @map("plan_start_claimed_at")
  /// The mailbox entry a mid-run `user` turn was FORWARDED as (MOTIR-7996), written
  /// in the same locked write that records the turn `plan_change`. An id, not an
  /// FK, for the reason `citations` gives: the mailbox is the pipe, this is the
  /// thread's record of what went down it. Null on a turn that was not forwarded.
  forwardedEntryId      String?                @map("forwarded_entry_id")
  /// The REVISION job a mid-run `user` turn became (Story MOTIR-7990 · MOTIR-7997):
  /// the change was forwarded after the walk finished but before the plan was
  /// decided, so it was submitted as a REVISE_PLAN revision of the run's own plan
  /// instead of being dropped. An opaque job id (no FK, the `jobId` precedent). The
  /// rail draws "applied as a revision of the plan" from it. Null on every turn that
  /// was not revised late.
  revisedLateJobId      String?                @map("revised_late_job_id")
  /// The author of a `user` turn (null for `system` / `assistant` turns, and
  /// cleared if the author is deleted — SetNull, the session's `createdBy`
  /// semantics).
  authorId              String?                @map("author_id")
  createdAt             DateTime               @default(now()) @map("created_at")

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// COMPOSITE FK (MOTIR-1735) — the turn points at `(session_id, workspace_id)`,
  /// not at `session_id` alone, so a turn can only ever attach to a session IN ITS
  /// OWN WORKSPACE. This is the structural half of the tenancy guarantee: RLS
  /// checks the row's own `workspace_id` but does NOT traverse foreign keys, so a
  /// single-column FK let a tenant plant a turn under a FOREIGN session — passing
  /// `WITH CHECK` while claiming a `(session_id, seq)` slot the victim could never
  /// use, wedging their thread (a cross-tenant DoS). Referencing the pair makes
  /// that row nonexistent rather than merely invisible, and unlike a policy it
  /// also holds for BYPASSRLS/superuser connections.
  session            PlanChangeSession   @relation(fields: [sessionId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  /// The planning sessions seeded by the re-plan offer this turn holds (MOTIR-8691).
  seededPlanSessions PlanChangeSession[] @relation("PlanChangeSessionSeedGuideTurn")
  author             User?               @relation("PlanChangeTurnAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([sessionId, seq])
  @@index([sessionId, seq])
  @@index([workspaceId])
  @@map("plan_change_turn")
}

/// Is a Sharpen session about a PLAN or ONE committed WORK ITEM (Task MOTIR-1101 · MOTIR-8182).
enum SharpenScopeKind {
  plan
  /// A plan-change CONVERSATION with no plan yet (Story MOTIR-9221 · MOTIR-9314).
  conversation

  @@map("sharpen_scope_kind")
}

/// A Sharpen session is OPEN (waiting on the person or on a turn) or ENDED.
enum SharpenSessionStatus {
  open
  ended

  @@map("sharpen_session_status")
}

/// WHY a Sharpen session ended — nothing was undetermined, the planner ran out of
/// questions, or the person stopped it.
enum SharpenEndReason {
  nothing_to_ask
  finished
  stopped

  @@map("sharpen_end_reason")
}

/// Who wrote a Sharpen turn — the PERSON (an action) or the PLANNER (a job result).
enum SharpenTurnRole {
  person
  planner

  @@map("sharpen_turn_role")
}

/// What the person did on a Sharpen turn.
enum SharpenAction {
  start
  answer
  own_words
  skip
  you_decide
  stop

  @@map("sharpen_action")
}

/// A SHARPEN session (Task MOTIR-1101 · Subtask MOTIR-8182) — one person's
/// grilling conversation about WHAT a plan or one committed work item is, one
/// question at a time. A dedicated table rather than a `plan_change_session`
/// origin: that model is scoped by work-item keys, has no plan scope, and its
/// `origin` / turn `intent` enums are read by the planning, guide and
/// conversation doors.
///
/// Exactly ONE of `planId` / `workItemId` is set, and it matches `scopeKind`
/// (a CHECK in the migration). ONE OPEN session per person per target is held
/// by two partial unique indexes (`… WHERE status = 'open'`), so two concurrent
/// "Sharpen" clicks can never open two. The JSON columns hold motir-ai's
/// `SharpenTurnResult` pieces and are OPAQUE here: the door's service and DTO
/// (MOTIR-8181) type them. Workspace-scoped by RLS.
model SharpenSession {
  id                  String               @id @default(cuid())
  workspaceId         String               @map("workspace_id")
  projectId           String               @map("project_id")
  /// The person who opened it — the session is theirs alone, so it goes with them.
  createdById         String               @map("created_by_id")
  scopeKind           SharpenScopeKind     @map("scope_kind")
  planId              String?              @map("plan_id")
  /// The plan-change CONVERSATION a `conversation`-scope session grills (Story
  /// MOTIR-9221 · MOTIR-9314) — its settled answers are stored here, with it.
  planChangeSessionId String?              @map("plan_change_session_id")
  /// RETIRED (MOTIR-9314): the work-item target is gone, so nothing writes or
  /// reads this. SCHEMA-ONLY phase of the column's removal
  /// (docs/decisions/delivery-reader-migration.md §6a/§6b): `@ignore`d so the
  /// client stops selecting it while the column stays; the CONTRACT phase drops
  /// the column, this field, its relation and its index together, after release.
  workItemId          String?              @map("work_item_id") @ignore
  status              SharpenSessionStatus @default(open)
  endReason           SharpenEndReason?    @map("end_reason")
  /// The question waiting on the person, or null.
  pendingQuestion     Json?                @map("pending_question")
  /// The answers the person settled so far — the cumulative set.
  settled             Json                 @default("[]")
  /// The planner-marked assumptions for skipped / "you decide" questions.
  assumptions         Json                 @default("[]")
  /// The write-back outcome motir-ai reported when the session ended, or null.
  writeBack           Json?                @map("write_back")
  lastActivityAt      DateTime             @default(now()) @map("last_activity_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy         User               @relation("SharpenSessionCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  plan              Plan?              @relation(fields: [planId], references: [id], onDelete: Cascade)
  planChangeSession PlanChangeSession? @relation(fields: [planChangeSessionId], references: [id], onDelete: Cascade)
  workItem          WorkItem?          @relation(fields: [workItemId], references: [id], onDelete: Cascade) @ignore
  turns             SharpenTurn[]

  @@index([workspaceId])
  @@index([projectId])
  @@index([planId])
  @@index([planChangeSessionId])
  @@index([workItemId])
  @@map("sharpen_session")
}

/// One TURN of a Sharpen session (Task MOTIR-1101 · Subtask MOTIR-8182) — a
/// person's action, or the planner's result as motir-ai returned it. `seq` is
/// gapless per session (`UNIQUE (session_id, seq)`, allocated under the
/// session's row lock), and a job settles into at most one planner turn (a
/// partial unique on `(session_id, job_id) WHERE role = 'planner'`). Carries its
/// own `workspace_id` so its own RLS policy gates it — RLS does not traverse FKs.
model SharpenTurn {
  id          String          @id @default(cuid())
  workspaceId String          @map("workspace_id")
  sessionId   String          @map("session_id")
  seq         Int
  role        SharpenTurnRole
  /// The person's action; null on a planner turn.
  action      SharpenAction?
  body        String          @db.Text
  /// The reading the person picked (`answer` only).
  readingId   String?         @map("reading_id")
  /// The motir-ai job this turn submitted (person) or settled from (planner) —
  /// an OPAQUE job token, not an FK (the `plan.source_job_id` precedent).
  jobId       String?         @map("job_id")
  /// The planner's result as returned, or null.
  record      Json?
  authorId    String?         @map("author_id")
  createdAt   DateTime        @default(now()) @map("created_at")

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session   SharpenSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  author    User?          @relation("SharpenTurnAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([sessionId, seq])
  @@index([workspaceId])
  @@map("sharpen_turn")
}

/// THE BOUNDARY MAILBOX (Story MOTIR-4054 · MOTIR-4067) — what the user typed
/// while a planning job was in flight, and the stop that ends it.
///
/// ⚠️ ONE PIPE CARRIES BOTH, and that is the whole reason this is one table
/// rather than a `stop` column beside a turns table. The consumer half already
/// merged in `motir-ai` (MOTIR-4060) checks ONE mailbox at ONE phase boundary;
/// two pipes for one check is how a stop overtakes a turn typed before it, or a
/// turn is consumed after the run was told to end. Here they share a single
/// `seq` sequence per job, so the order they were made in is a property of the
/// row rather than of whichever query ran first.
///
/// ⚠️ NOT A SIGNAL — STORAGE THE JOB CHECKS. Nothing here interrupts anything: a
/// turn that arrives during an `author` sits until that author finishes, because
/// a card written half under one set of instructions and half under another is
/// incoherent in a way nothing downstream can detect (`motir-ai`
/// `src/llm/mailbox.ts`).
model PlanChangeMailboxEntry {
  id              String                        @id @default(cuid())
  workspaceId     String                        @map("workspace_id")
  sessionId       String                        @map("session_id")
  /// The motir-ai job this entry is addressed to — an OPAQUE job token, a plain
  /// scalar and NOT an FK (the `plan_change_session.last_job_id` precedent). The
  /// mailbox is per-RUN: a thread that submits again starts an empty one, and an
  /// entry can never be read by a job it was not typed at.
  jobId           String                        @map("job_id")
  /// 0-based position in THIS job's mailbox. Allocated under the session row's
  /// `SELECT … FOR UPDATE` lock with a re-read inside the transaction (the
  /// lock-before-read-derived-update rule), and `(session_id, job_id, seq)` is
  /// the DB backstop that turns a lost race into a typed error.
  ///
  /// ⚠️ IT IS THE ORDERING, AND `created_at` IS NOT. Two entries written inside
  /// the same millisecond is reachable and is exactly the case a timestamp sort
  /// gets wrong; `motir-ai`'s `readDelivery` sorts by `receivedAt` and breaks
  /// ties on ARRAY ORDER, so the producer's claim about order travels in the
  /// array — which this column is what builds.
  seq             Int
  kind            PlanChangeMailboxKind
  /// What the user typed, verbatim. Required on a `turn`, null on a `stop`.
  body            String?                       @db.Text
  /// What the run should DO with this turn — `fold` (carry on) or `restart`
  /// (withdraw what was appended and re-plan). Null on a `stop`. An absent or
  /// unrecognised value reads as `fold` on the consumer side, which is the
  /// branch that loses least when the two repos disagree about a word.
  disposition     PlanChangeMailboxDisposition? @map("disposition")
  /// Where a `restart` RE-ANCHORS the walk — a work-item identifier. Null means
  /// the target the run is already on.
  restartTarget   String?                       @map("restart_target")
  /// The caller's OWN stable key for this delivery. `(session_id, job_id,
  /// idempotency_key)` is UNIQUE, so a retried submit resolves to the row it
  /// already wrote instead of delivering the same sentence twice.
  ///
  /// ⚠️ This follows the repo's EXISTING idempotency shape rather than inventing
  /// one — a caller-supplied token on a unique column, as `CiOverageDebitInput`'s
  /// `externalRef` is. (MOTIR-4067's card names `planningTurnId` as the pattern;
  /// `lib/ai/types.ts` says in as many words that `externalRef` is deliberately
  /// NOT one, because `planningTurnId` is AI-TURN-shaped. The shape the card
  /// meant is the general one, and this is it.)
  idempotencyKey  String                        @map("idempotency_key")
  /// When a boundary check READ this entry. Null while it is still waiting; the
  /// read door sets it and never returns a set row again, which is what makes
  /// "a turn read at one boundary is not read at the next" a stored fact rather
  /// than an in-process set that a job retry loses.
  ///
  /// ⚠️ A `stop` IS STILL DERIVED FROM EXISTENCE, not from this column. Once a
  /// run has been ended it stays ended, so consuming the stop entry must not
  /// un-stop the answer.
  consumedAt      DateTime?                     @map("consumed_at")
  /// Who typed it (null on a `stop` raised by the system, and cleared when the
  /// author is deleted — the turn's `authorId` semantics).
  authorId        String?                       @map("author_id")
  /// The run pause this `fold` turn DECLINES (MOTIR-8007): the person said no to
  /// the planner's START OVER offer, so this turn tells the walk to apply the change
  /// to the work items already written. An id, not an FK (the pause is a different
  /// table with its own lifecycle; the mailbox is the pipe). Null on every other turn.
  declinesPauseId String?                       @map("declines_pause_id")
  /// The run pause this `fold` turn ANSWERS (MOTIR-8007): the person's reply to the
  /// planner's mid-run question, verbatim. Null on every other turn.
  answersPauseId  String?                       @map("answers_pause_id")
  createdAt       DateTime                      @default(now()) @map("created_at")

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// COMPOSITE FK, for the reason MOTIR-1735 gives on `PlanChangeTurn.session`:
  /// RLS checks the row's own `workspace_id` and does NOT traverse foreign keys,
  /// so a single-column FK would let a tenant plant an entry under a FOREIGN
  /// session — passing `WITH CHECK` while claiming a `(session_id, job_id, seq)`
  /// slot the victim can never use. Referencing the PAIR makes that row
  /// nonexistent rather than merely invisible, and unlike a policy it holds for
  /// BYPASSRLS / superuser connections too.
  session   PlanChangeSession @relation(fields: [sessionId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  author    User?             @relation("PlanChangeMailboxEntryAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([sessionId, jobId, seq])
  @@unique([sessionId, jobId, idempotencyKey])
  @@index([sessionId, jobId, seq])
  @@index([workspaceId])
  @@map("plan_change_mailbox_entry")
}

/// The planner's mid-run PAUSE (Story MOTIR-7990 · MOTIR-8007; `conversation-turn-
/// intent.md` AMENDMENT 4). While its job keeps RUNNING, the planner can stop the
/// walk on one thing and wait for the person:
///
///   * `replan`  — a forwarded change is a RE-PLAN: the planner OFFERS a one-click
///     START OVER. Yes writes the shipped `restart` mailbox turn; No writes a `fold`
///     turn (`declines_pause_id`) telling the walk to apply the change to the work
///     items already written.
///   * `unclear` — a forwarded change is UNCLEAR about WHAT: the planner asks. The
///     person's reply is a `fold` turn (`answers_pause_id`), ruled again as a change.
///
/// ⚠️ NOT THE END-OF-JOB QUESTION. `PlanChangeTurn.question` is written when a job
/// has ENDED and its answer submits a NEW planning run; a mid-run question must do the
/// opposite (reach THIS run), so it lives here and never as an `assistant` turn with
/// `question` set.
///
/// At most ONE is open (unanswered) per job. The answer is CLAIMED under the session
/// row lock before the motir-ai round-trip, and delivered on the idempotency key
/// `run-pause:<id>:<choice>`, so two tabs race on the claim and never on the mailbox.
model PlanChangeRunPause {
  id                  String    @id @default(cuid())
  workspaceId         String    @map("workspace_id")
  sessionId           String    @map("session_id")
  /// The planning job whose walk is paused — an OPAQUE job token, not an FK.
  jobId               String    @map("job_id")
  /// `replan` | `unclear` | `code_unsearchable` — CHECK-constrained in the migration (text, like
  /// `PlanRevision.changeKind`: a new kind is then a code change).
  kind                String
  /// The target repositories whose code cannot be SEARCHED and why, as
  /// `[{ repoRef, state }]` (MOTIR-9167) — set exactly when `kind = 'code_unsearchable'`.
  /// Shown to the person, who resumes the walk once the code can be searched.
  unsearchableRepos   Json?     @map("unsearchable_repos")
  /// The mailbox entry ids of the change turns this pause is about, in the order
  /// the planner named them. Bodies are read back from core's own rows.
  changeTurnIds       String[]  @default([]) @map("change_turn_ids")
  /// The planner's one-line reason — set exactly when `kind = 'replan'` (≤ 500).
  /// SHOWN to the person and NEVER sent back to the planner.
  reason              String?   @db.Text
  /// The planner's question — set exactly when `kind = 'unclear'` (≤ 600). Same.
  question            String?   @db.Text
  idempotencyKey      String    @map("idempotency_key")
  createdAt           DateTime  @default(now()) @map("created_at")
  /// `start_over` | `apply` (replan), `replied` (unclear) or `resumed` (code_unsearchable); null while open.
  answer              String?
  answeredAt          DateTime? @map("answered_at")
  answeredById        String?   @map("answered_by_id")
  /// The person's typed reply, verbatim — set only on `replied`. Kept on the pause
  /// so a replay can be compared against it and a refused delivery still records it.
  replyText           String?   @map("reply_text") @db.Text
  /// The mailbox entry written for the answer (the restart, decline or reply turn).
  mailboxEntryId      String?   @map("mailbox_entry_id")
  /// Set when the answer was recorded but could not be delivered because the run
  /// had ended (`PLAN_CHANGE_JOB_NOT_RUNNING`).
  deliveryRefusedCode String?   @map("delivery_refused_code")

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// COMPOSITE FK, for the reason `PlanChangeMailboxEntry.session` gives.
  session    PlanChangeSession @relation(fields: [sessionId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  answeredBy User?             @relation("PlanChangeRunPauseAnswerer", fields: [answeredById], references: [id], onDelete: SetNull)

  @@unique([sessionId, jobId, idempotencyKey])
  @@index([sessionId, jobId, createdAt])
  @@index([workspaceId])
  @@map("plan_change_run_pauses")
}

/// A mailbox entry is a TURN the user typed or the STOP that ends the run. One
/// enum because they share one ordered pipe (see the model header).
enum PlanChangeMailboxKind {
  turn
  stop

  @@map("plan_change_mailbox_kind")
}

/// What the run should do with a folded turn — the two branches `motir-ai`'s
/// boundary check takes on input (`MailboxDisposition` in `src/llm/mailbox.ts`).
/// There is deliberately no `stop` member: a stop is a KIND, not a disposition,
/// because it is not something done WITH a turn.
enum PlanChangeMailboxDisposition {
  /// Carry on — the turn joins what every later session of this run reads.
  fold
  /// START OVER — withdraw what this pass appended and re-plan, keeping the plan.
  restart

  @@map("plan_change_mailbox_disposition")
}

enum PlanChangeTurnRole {
  user
  system
  /// The PLANNER's own turn (MOTIR-2226) — the findings report it owes on every
  /// planning turn, plus the one clarifying question when the request was not
  /// determinate (MOTIR-2222 produces both). A real persisted turn, not client
  /// chrome: the thread is the record of who said what, and a question the user
  /// has not answered has to survive a reload to be answerable at all.
  assistant

  @@map("plan_change_turn_role")
}

/// What a `user` turn on the project conversation ASKED FOR (MOTIR-1816 ·
/// `docs/decisions/conversation-turn-intent.md`). ONE thread carries both, and a
/// thread may alternate freely turn by turn — the previous turn's intent places
/// no constraint on the next, which is why this sits on the TURN and never on
/// the session. There is deliberately no "unknown" value: every turn that ran,
/// ran as one of these, and a turn that never ran carries null.
enum PlanChangeTurnIntent {
  /// Propose a plan delta — the shipped path, unchanged.
  plan_change
  /// Answer a question about the project from its plan tree and code graph,
  /// with citations. Writes nothing.
  ask
  /// Diagnose a REPORT OF BROKEN BEHAVIOUR (MOTIR-7047 · the ADR's AMENDMENT 1,
  /// A1.6): `ask_project` redirected the turn and a `debug_bug` job ran for it.
  /// It writes at most ONE card (A1.4) — landed by MOTIR-7049, not here.
  debug
  /// A turn of a GUIDE conversation (MOTIR-7464 · the ADR's AMENDMENT 2, A2.1):
  /// chosen by the Guide me through door, never by a classifier, and run as ONE
  /// `guide_work_item` job anchored on the card (`anchorKey`). Every user turn of
  /// a `guide`-origin session carries it; `intentCorrected` stays false.
  guide
  /// A request to PLAN SOMETHING NEW (MOTIR-7649 · the ADR's AMENDMENT 3, A3.1):
  /// `ask_project` redirected the turn and NO job ran for it. Core wrote the fixed
  /// confirm (`PlanChangeTurn.confirm`) instead; nothing closes until the person
  /// presses Confirm.
  new_session

  @@map("plan_change_turn_intent")
}

/// Which fixed confirm an `assistant` turn CORE wrote is (MOTIR-7649 · the ADR's
/// AMENDMENT 3, A3.2). One value today: the Plan something new confirm, whose two
/// answers are controls (Confirm · Keep planning), never typed text — which is
/// why it is NOT a `question`: a pending question routes a typed reply into the
/// plan-change submit, and a reply to this must never start a plan run.
enum PlanChangeTurnConfirm {
  new_session

  @@map("plan_change_turn_confirm")
}

/// How a code-graph outage touched an `assistant` turn (Story MOTIR-8136 ·
/// MOTIR-8141) — the stored face the rail draws from, `design-notes.md` §17.
enum PlanChangeTurnOutage {
  /// A plan-writing job met the outage and wrote no plan.
  declined
  /// A question job was answered without the code.
  answered

  @@map("plan_change_turn_outage")
}

/// ONE work item held EXCLUSIVELY by ONE planning session (Story MOTIR-2786 ·
/// MOTIR-2787) — the lease behind the `planning` status lock.
///
/// WHY A ROW AND NOT JUST THE STATUS. `planning` is a workflow status a person
/// can also set by hand, and MOTIR-2425 shipped it for a DIFFERENT purpose: an
/// agent that cannot implement a card parks it there until a human acts, and
/// `defaultWorkflow.ts` is emphatic that nothing may auto-return such a card to
/// `todo`. A recovery sweep that released "everything sitting in `planning`"
/// would undo exactly that. So the LEASE is the authority and the status is its
/// visible face: release and recovery touch only items that have a row here, and
/// an item parked at `planning` with no row is never disturbed.
///
/// `work_item_id` is UNIQUE — that is the exclusion, enforced by the database
/// rather than by a check-then-act in the service. Acquire still locks the work
/// item row first (`SELECT … FOR UPDATE`, a row that always exists, so the lock
/// is real rather than a lock over an empty set), and the unique index is the
/// backstop whose P2002 is translated to `PlanTargetLockedError`.
///
/// The lease (`expires_at`) is what makes a crashed planner recoverable WITHOUT a
/// database edit — the failure mode the story calls worse than the race it
/// prevents, and the one nothing else can reach: a plan whose job dies stays
/// `generating` forever, so no product event ever fires to release it.
///
/// Workspace-scoped tenant data, so `workspace_id` is non-null and the RLS policy
/// ships in the SAME migration (PRODECT_FINDINGS #20 — no unguarded window). It
/// additionally carries a `FOR SELECT` arm for `app.system_admin`, because the
/// expiry sweep is cross-tenant BY DESIGN; the per-row RELEASE then re-binds to
/// that row's own workspace, so no write ever runs untenanted.
model PlanTargetLock {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  projectId   String   @map("project_id")
  /// The held item. UNIQUE — one holder per item, whatever scope named it. This
  /// is the hole `scope_key` cannot close: `[MOTIR-9]` and `[MOTIR-9, MOTIR-4]`
  /// are two different threads addressing one common item, and only a constraint
  /// on the ITEM can tell them apart.
  workItemId  String   @unique @map("work_item_id")
  /// The holding plan-change conversation. Cascade — a deleted thread cannot keep
  /// holding anything.
  ///
  /// ⚠️ NULLABLE SINCE MOTIR-5645. A lock is now held by a SESSION or by a PLAN,
  /// never by neither and never by both: `plan_target_lock_one_holder` is a
  /// `num_nonnulls(session_id, plan_id) = 1` CHECK. The two coexist on one table
  /// because they answer the same question — WHO is rewriting this card right
  /// now — and putting them in two tables would give the `work_item_id` UNIQUE,
  /// which is the whole exclusion, nothing to be unique across.
  sessionId   String?  @map("session_id")
  /// The holding PLAN (MOTIR-5645, `docs/decisions/agent-authored-plans.md`
  /// AMENDMENT 16 D5). Set when the park came from `plansService.addProposals` —
  /// the one choke point every authoring door passes through — rather than from a
  /// planning conversation's open. Cascade, for the same reason `session_id` is:
  /// a deleted plan cannot keep holding anything.
  planId      String?  @map("plan_id")
  /// WHO holds it, so a refusal can name a person rather than a session id.
  /// SetNull: a departed holder leaves a lease the sweep still expires.
  heldById    String?  @map("held_by_id")
  /// The status the item held BEFORE the lock, restored on release. Stored rather
  /// than assumed: the workflow allows `in_progress ↔ planning`, so a release that
  /// hardcoded `todo` would silently discard real progress.
  priorStatus String   @map("prior_status")
  /// Whether acquire actually MOVED the status. False when the move was not a
  /// legal edge for that item or when the item was already at `planning`. The
  /// exclusion holds either way — it is this row, not the status — and release
  /// then restores nothing.
  ///
  /// ⚠️ The parenthetical here used to read "only `todo` and `in_progress` reach
  /// `planning`". MOTIR-5643 declares an edge from every NON-terminal status, so
  /// a legal-edge failure is now the custom-workflow case rather than the
  /// ordinary one.
  statusHeld  Boolean  @default(false) @map("status_held")
  acquiredAt  DateTime @default(now()) @map("acquired_at")
  /// The LEASE. Extended on each turn of the holding session; past it, the sweep
  /// (and a competing acquire) may take the item back.
  expiresAt   DateTime @map("expires_at")

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItem  WorkItem           @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  session   PlanChangeSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  plan      Plan?              @relation(fields: [planId], references: [id], onDelete: Cascade)
  heldBy    User?              @relation("PlanTargetLockHeldBy", fields: [heldById], references: [id], onDelete: SetNull)

  /// The release read — every lock one session holds, in one query.
  @@index([sessionId])
  /// The same read for a PLAN-held lock (MOTIR-5645): approve, decline and the
  /// abandoned-plan sweep all list a plan's locks.
  @@index([planId])
  /// The sweep's read: expired first, bounded.
  @@index([expiresAt])
  @@index([workspaceId])
  @@map("plan_target_lock")
}

/// One INTENDED repository in a project's REPOSITORY SET (Story MOTIR-1775 ·
/// MOTIR-1780), specified by `docs/decisions/project-repository-set.md`.
///
/// This table is BOTH a PLAN and a RECORD, deliberately in one place: a row is
/// created `proposed` (role + name + seed source, nothing on GitHub yet) and
/// later carries `github_repo_id`, the realized `GithubRepo` mirror row. One
/// table rather than an intents table plus a links table, because two registries
/// drift — the same argument `docs/decisions/target-repo-attribution.md` §1 used
/// to refuse a second repo registry.
///
/// It is ALSO the project↔repo isolation boundary (MOTIR-4955). `GithubRepo`
/// records organisation connectivity; a project may read, audit or dispatch into
/// that asset only when this table links it. `github_repo.workspace_id` remains
/// the connection/RLS key and is not project membership.
///
/// CARDINALITY comes from the architecture, never from a constant: a project that
/// separates a web app from an API is TWO rows, add a shared package and it is
/// three, a monorepo is one. The single-repo project is one row in this same
/// table (ADR §6), not a second code path.
///
/// Naming note: the Prisma model is `ProjectRepo` (table `project_repository`) so
/// its data-access leaf can be `projectRepoRepository`, unambiguous next to the
/// long-shipped `projectRepository` — which is the repository for the `project`
/// table, a different entity.
///
/// Workspace-scoped tenant data, so `workspace_id` is non-null and the RLS policy
/// ships in the SAME migration (PRODECT_FINDINGS #20 — no unguarded window). Both
/// tenant FKs and the nullable realized-repo FK are modelled as Prisma
/// `@relation`s on BOTH sides with the same actions the SQL uses (the
/// FK-`@relation` rule), so `migrate dev` reports no drift.
model ProjectRepo {
  id                    String                    @id @default(cuid())
  workspaceId           String                    @map("workspace_id")
  projectId             String                    @map("project_id")
  /// WHAT this repository is (ADR §1.1) — a fixed six-value enum, because the role
  /// drives real behaviour: it selects what the repo is seeded from (§2) and it is
  /// the key a work item's repo pin resolves through (§5). An open string could do
  /// neither without a lookup table that would be this enum, less safely.
  /// A role MAY repeat (§1.2) — two services are two `api` rows.
  role                  ProjectRepoRole
  /// The free-form label the enum deliberately does not carry (ADR §1.1) — `api` +
  /// "billing" versus `api` + "search". Distinguishes repeated roles for a human;
  /// never a resolution key (an ambiguous role resolves to null, §5.3, rather than
  /// being disambiguated by a label nobody validated).
  label                 String?
  /// The INTENDED repo name, editable per row until the row is established (ADR
  /// §1.4/§1.5). Unique per project (see `@@unique`). Once realized this is still
  /// the authored intent — the authoritative checkout name is the realized repo's
  /// own `name`, which is what the read layer prefers (a rename on the host must
  /// not silently re-point a dispatch).
  name                  String
  /// WHAT the repo is seeded from (ADR §2), recorded as a STRING, not a boolean or
  /// a two-value enum: when the multi-stack starter registry lands (MOTIR-709 /
  /// 9.3.5) a row's seed source becomes a registry key and §2's table becomes its
  /// default map — no migration, no second code path. Values today come from
  /// `lib/projectRepos/vocabulary.ts`.
  seedSource            String                    @map("seed_source")
  /// The per-row ESTABLISH state (ADR §4.1). Rows are INDEPENDENT: one may fail or
  /// be skipped while the others succeed, and nothing is rolled back (a created
  /// repository is a real artifact in the user's own account — §4.2). `failed` is
  /// RESUMABLE, not terminal.
  state                 ProjectRepoState          @default(proposed)
  /// Why a `failed` row failed, so partial establishment is RECORDED rather than
  /// inferred (revoked token, not an org admin, name collision, template policy,
  /// rate limit). Null in every other state; cleared on a retry.
  failureReason         String?                   @map("failure_reason")
  /// WHY Motir proposed this row — the ADR §0.1 rung the derivation climbed to
  /// (MOTIR-1892), so the establish step can show what was inferred on a LATER
  /// page load and a wrong proposal is arguable rather than mysterious. Without
  /// it the reasoning existed only in the proposal run's own return value, and
  /// the proposer runs ONCE (it refuses to touch a set that already has rows).
  ///
  /// NULLABLE, and null is the honest answer in two cases that need no backfill:
  /// a row the USER added (there is no Motir inference to explain) and every row
  /// written before this column existed. It also SURVIVES a user's edit — the
  /// signal records what Motir inferred at proposal time, and a rename does not
  /// rewrite that history.
  ///
  /// A STRING, not an enum, for the same reason `seedSource` is one: §0.1 is a
  /// LADDER that gains rungs, each new rung already needs a derivation branch and
  /// UI copy, so an enum would add a migration to a change that is a code change
  /// anyway — and a second place to drift. The signal drives NO behaviour (unlike
  /// `role`, which selects the seed source and resolves repo pins); it is
  /// explanatory metadata. The closed union `ProjectRepoProposalSignalDto` +
  /// `PROJECT_REPO_PROPOSAL_SIGNALS` + the set service's validation are what keep
  /// the column from holding a rung the ADR does not name.
  ///
  /// Only the machine-readable SIGNAL is stored, never the derivation's English
  /// `reason`: that gloss is a log/PR fallback and is not a localized string, so
  /// persisting it would put untranslated prose on a rendered surface.
  proposalSignal        String?                   @map("proposal_signal")
  /// ── The CI-Actions INTENT (MOTIR-1907) ──────────────────────────────────
  ///
  /// The DESIRED Actions state for this row: `true` means "Motir wants GitHub
  /// Actions DISABLED on this repository", because its org is
  /// `ci_credits_exhausted`. Stored as INTENT rather than applied-state because
  /// the fan-out is N GitHub calls with NO transaction over them: half can fail,
  /// and a durable intent is what lets the next sweep finish the job instead of
  /// losing it (§6.5).
  ciActionsDisabled     Boolean                   @default(false) @map("ci_actions_disabled")
  /// When the intent above last CHANGED. Paired with `ciActionsAppliedAt` this
  /// is the whole convergence predicate — a row needs (re-)asserting exactly
  /// when `ciActionsAppliedAt IS NULL OR ciActionsAppliedAt < ciActionsIntentAt`.
  ///
  /// Two timestamps rather than a `pending` boolean on purpose: a boolean has to
  /// be cleared by the same code that sets it, so a crash between the GitHub call
  /// and the clear leaves it lying. Comparing two stamps is derivable state — it
  /// cannot desynchronise, and a re-run recomputes the same answer.
  ciActionsIntentAt     DateTime?                 @map("ci_actions_intent_at")
  /// When the intent was last SUCCESSFULLY asserted on the host. NULL means it
  /// never has been (a fresh row, or every attempt so far failed).
  ciActionsAppliedAt    DateTime?                 @map("ci_actions_applied_at")
  /// ── The TAKE-IT-OVER saga (MOTIR-711) ───────────────────────────────────
  ///
  /// Where this row sits in the handoff that moves a Motir-owned repository to
  /// the user's own GitHub. NULL is the overwhelmingly common state and means
  /// "no takeover has ever been requested" — it is NOT a state of the machine,
  /// which is why the column is nullable rather than defaulted: a default would
  /// claim every repository is mid-handoff.
  ///
  /// Modelled as durable STATES rather than inferred from the mirror, because
  /// two of them are waits on a HUMAN doing something on GitHub — accepting a
  /// transfer, installing the App — and a wait nobody recorded is a wedged repo
  /// (ADR `ci-minutes-allowance.md` §5.4/§G). Every state is re-promptable.
  takeoverState         ProjectRepoTakeoverState? @map("takeover_state")
  /// The GitHub login the repository is being handed to — a personal account or
  /// one of the user's orgs. Recorded at REQUEST time so the saga can be resumed
  /// (and the transfer re-issued) without asking again, and so the webhook can
  /// verify the transfer that landed is the one Motir asked for.
  takeoverTargetOwner   String?                   @map("takeover_target_owner")
  /// When the takeover was requested. The saga's start, and what an operator
  /// reads to spot a transfer nobody has accepted for a fortnight.
  takeoverRequestedAt   DateTime?                 @map("takeover_requested_at")
  /// When the `repository` `transferred` webhook confirmed the repo actually
  /// moved. NULL while the transfer is still pending the new owner's accept.
  takeoverTransferredAt DateTime?                 @map("takeover_transferred_at")
  /// When the handoff COMPLETED — i.e. a `GithubInstallation` under the new
  /// owner was observed, so dispatch and the code-graph feed still work. The
  /// transfer alone never sets this: a repo the App can no longer reach is a
  /// broken loop, not a finished handoff.
  takeoverCompletedAt   DateTime?                 @map("takeover_completed_at")
  /// Why a `failed` takeover failed, so a stalled handoff is RECORDED rather
  /// than inferred. Cleared on every retry, exactly like `failureReason`.
  takeoverFailureReason String?                   @map("takeover_failure_reason")
  /// ── COLLABORATOR ACCESS — the TEAM's way IN to their own code ──────────────
  ///
  /// Every repository Motir creates lives in Motir's own org and is PRIVATE (ADR
  /// §3 amendment), so nobody on the team can clone it until Motir invites their
  /// GitHub account as a collaborator. That record is `ProjectRepoCollaborator`
  /// — ONE ROW PER (repository × user), not columns on this row.
  ///
  /// ⚠️ It STARTED as four singular columns here (MOTIR-1900), which could hold
  /// exactly one person: the approving user. MOTIR-1910 replaced them with the
  /// join table, because a project's code is reachable by a TEAM and "how many
  /// can there be?" is answered by the membership, not by one. The four columns
  /// were migrated into it, not dropped — see the migration's backfill.
  collaborators         ProjectRepoCollaborator[]
  /// The realized `GithubRepo` mirror row — NULL until the repo exists, set when
  /// creation or connect-existing completes (`attachRealizedRepo`). This is the
  /// seam that makes one table serve as both plan and record.
  ///
  /// ⚠️ THIS COLUMN WAS `@unique`, AND THE MODEL THAT MADE IT SO IS REVERSED
  /// (MOTIR-4669 · MOTIR-4648). The comment here used to read: *"a realized repo
  /// is claimed by AT MOST ONE project row, so a repo created for project A can
  /// never be recorded as project B's."* A repository belongs to the
  /// ORGANISATION, and which projects use it is visibility configuration
  /// (MOTIR-2029, applied to the thing the code graph is built FROM) — so **a
  /// repository in two projects is the ordinary case**, and the old sentence is
  /// not merely relaxed, it is false.
  ///
  /// What SURVIVES is the narrower guarantee, and it is still enforced in the
  /// DATABASE rather than in application code: `@@unique([projectId,
  /// githubRepoId])` below — one repository appears at most once in ONE project's
  /// set. That is what the 409 on a double-connect now means, and Postgres still
  /// allows many NULLs in it, which is exactly right: every `proposed` row is
  /// unrealized.
  ///
  /// SetNull (not Cascade): disconnecting a repo must leave the row with a null
  /// realized repo and its state still reading honestly. A disconnected repo is
  /// not a lost plan — the role + name + seed source survive so the row can be
  /// re-established.
  githubRepoId          String?                   @map("github_repo_id")
  /// ORDER within the set, and it is MEANINGFUL: the first row is the project's
  /// PRIMARY repo (ADR §1.3) — what a single-repo project's one row is, and the
  /// deterministic tie-break anywhere the set needs one. Order carries NO dispatch
  /// meaning; an item is never routed by position. A fractional index (the same
  /// `String @db.Text` + `lib/workItems/positioning` scheme as `work_item` /
  /// `board_column`), so a row is reordered with one write.
  position              String                    @db.Text
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")

  workspace  Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  githubRepo GithubRepo?    @relation(fields: [githubRepoId], references: [id], onDelete: SetNull)
  /// The WORK ITEMS pinned to this repository row (Story MOTIR-2732 · MOTIR-3039).
  /// Cascade on delete: removing a row from the project's set removes the cards'
  /// references to it, because the project no longer has that repository. `Restrict`
  /// would make the set uneditable the moment any card pinned a row, which ADR
  /// `project-repository-set.md` §4.4 forbids. A pin's survival across a repository
  /// being DISCONNECTED is a different edge and is preserved by `githubRepoId`'s
  /// `SetNull` above. Modelled both sides per the FK-`@relation` rule.
  workItems  WorkItemRepo[]

  /// The first uniqueness guarantee: at most one row per `(project, name)`, so two
  /// rows can never race for one repo name. Enforced in the DATABASE — the service
  /// additionally rejects a CASE-VARIANT collision (git-host names are
  /// case-insensitive), for which this exact-match index is the backstop.
  @@unique([projectId, name])
  /// The uniqueness that REPLACES `githubRepoId @unique` (MOTIR-4648): one
  /// repository appears at most once in ONE project's set. It keeps a real
  /// database-level guard rather than moving the check into application code — the
  /// same 409 the product already returns, asked at the grain the product now has.
  /// Many NULLs are allowed, as before: an unrealized row claims nothing.
  @@unique([projectId, githubRepoId])
  /// Serves every read of this table, not just an explicit `where workspaceId`:
  /// RLS policy `project_repository_active_workspace` predicates all of them on
  /// `workspace_id = current_setting('app.workspace_id')`.
  ///
  /// ⚠️ A hand-written PARTIAL index on this table must NOT use `(workspace_id)`
  /// as its whole column list (MOTIR-1960). Prisma's differ pairs a database
  /// index to a datamodel index BY COLUMN LIST, and ignores one it cannot
  /// express — a `WHERE` clause is inexpressible — only while no `@@index`
  /// claims those columns. When one does, the two get paired, the sole remaining
  /// difference is the name, and `migrate diff` reports a permanent spurious
  /// RENAME that the next `migrate dev` writes into a migration, destroying one
  /// of the two indexes. Give the partial index a column list of its own, chosen
  /// from what its query actually filters on — as
  /// `project_repository_ci_actions_pending_idx` (`workspace_id, state`) and
  /// `project_repository_takeover_in_flight_idx` (`workspace_id,
  /// takeover_state`) both do.
  @@index([workspaceId])
  @@index([projectId])
  @@map("project_repository")
}

/// WHERE a work item's work ships — ONE ROW PER REPOSITORY the item is pinned to,
/// pointing at the project's own `project_repository` row (Story MOTIR-2732 ·
/// MOTIR-3039, ADR `docs/decisions/work-item-repository-set.md` "Amendment
/// 2026-08-18" §A2).
///
/// This REPLACES `work_item.targetRepos` — an ordered array of repository NAMES —
/// as the authored state, and the amendment's §A1 answers §1.1's costed rejection
/// of a join table on its own terms rather than around it. The short version: the
/// foreign key §1.1 declined was to `github_repo`, whose row a disconnect removes;
/// this one is to `project_repository`, whose row a disconnect LEAVES
/// (`github_repo_id` is SET NULL), so the property that rejection protected — a pin
/// survives its repository being briefly disconnected — is preserved BY the
/// reference. And the shape here is neither of the (B)/(C) §1.1 rejected: the join
/// table is the only WRITABLE representation, and every repository NAME the product
/// publishes is a read projection of it, so nothing published is dropped and there
/// is no second writable copy to keep in step by convention.
///
/// ORDERED by `position`, ascending, and **position 0 is the PRIMARY** — the
/// repository `resolveDispatchRepo` routes to (ADR §2). A plain `Int` and not the
/// fractional-index `String` this schema uses on `work_item.position` /
/// `project_repository.position`: a fractional index buys a cheap insert-between on
/// a list a user re-orders one element at a time, and a repository set is REPLACED
/// wholesale by one service write with no incremental re-order. The ordinal is
/// therefore sufficient AND assertable — `@@unique([workItemId, position])` makes a
/// gap or a collision a database error rather than a rendering question.
///
/// Workspace-scoped tenant data, so `workspace_id` is carried on the ROW (RLS does
/// not traverse foreign keys) and the policy ships in the same migration.
///
/// A reference to a row in ANOTHER PROJECT is rejected at the WRITE layer with a
/// typed error, not by a constraint: `project_repository.project_id` and
/// `work_item.project_id` are two columns nothing relates, so no foreign key can
/// see the mismatch. That is the same write-layer check
/// `docs/decisions/target-repo-attribution.md` §2 already applies to an authored
/// NAME, moved from a string comparison onto an id.
model WorkItemRepo {
  id            String   @id @default(cuid())
  workspaceId   String   @map("workspace_id")
  workItemId    String   @map("work_item_id")
  projectRepoId String   @map("project_repo_id")
  /// The element's index in the ordered set; 0 is the PRIMARY. Contiguous from 0
  /// by the write path, and unique per item so a gap cannot be written silently.
  position      Int
  createdAt     DateTime @default(now()) @map("created_at")

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workItem    WorkItem    @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  projectRepo ProjectRepo @relation(fields: [projectRepoId], references: [id], onDelete: Cascade)

  /// One reference per repository per item — duplicates COLLAPSE at the write
  /// layer (first occurrence wins, exactly as the name path's `matchAuthoredTargetRepos`
  /// already does), and this index is that rule's backstop rather than the rule.
  @@unique([workItemId, projectRepoId])
  /// Ordering is a fact about the row, not a rendering decision — see `position`.
  @@unique([workItemId, position])
  @@index([workspaceId])
  @@index([projectRepoId])
  @@map("work_item_repository")
}

/// What a collaborator may DO with the repository (Story MOTIR-1775 · MOTIR-1910,
/// specified by `docs/decisions/project-repository-set.md` §3 Q2).
///
/// PER INVITEE, not one value for the product — which is the whole point of the
/// enum existing. MOTIR-1900 pinned `admin` as a module constant and justified it
/// by the TAKEOVER path: the repository is the approving user's "in every sense
/// but the account it sits under… including the settings needed to take it over
/// later (MOTIR-711)". That reasoning is OWNER-shaped — only the owner walks the
/// transfer — so a teammate gets `push`: clone, branch, push, and nothing that
/// could transfer, rename or delete the project's repositories.
///
/// Deliberately NOT the full GitHub role vocabulary (`pull`/`triage`/`maintain`
/// exist too). Motir grants what its own decision named and nothing speculative;
/// a level earns a value here when a card decides it needs one.
enum ProjectRepoCollaboratorPermission {
  /// Clone, branch, push. The default for every teammate.
  push
  /// Everything `push` allows plus repository settings — reserved to the
  /// approving user, and what the MOTIR-1900 backfill stamps on their row so no
  /// access already granted is silently downgraded by the migration.
  admin

  @@map("project_repo_collaborator_permission")
}

/// ONE person's access to ONE repository Motir made (Story MOTIR-1775 ·
/// MOTIR-1910) — the record of the collaborator invitation, per `(repository,
/// user)`.
///
/// ⚠️ WHY A TABLE AND NOT COLUMNS. MOTIR-1900 recorded this as four nullable
/// columns on `project_repository`, which is exactly one collaborator per
/// repository — the approving user. Every other member of the workspace was
/// therefore locked out of their own project's code, with nowhere in the schema
/// to record letting them in. The count was never a property of the repository;
/// it is a property of the TEAM, so the shape is a join table whose degenerate
/// case is one row.
///
/// ⚠️ ROWS ARE INDEPENDENT, exactly like the repository rows they hang off (ADR
/// §4.2). One member's GitHub refusal leaves every other member's row untouched
/// and rolls nothing back: a real invitation was sent to the others, and undoing
/// it to make a report look tidy would be a lie about the world. So there is no
/// transaction spanning the host calls — each row is committed as it resolves.
///
/// STATE IS DERIVED, never stored (`lib/projectRepos/access.ts`), for the same
/// reason the `ci_actions_*` intent columns are: a stored state must be CLEARED
/// by whatever set it, so a crash between the GitHub call and the write leaves it
/// lying. Two nullable stamps recompute the same answer on every read:
///
///   accepted     ⟺ accepted_at IS NOT NULL
///   invited      ⟺ invited_at IS NOT NULL (and not accepted)
///   not_invited  ⟺ neither  (a row exists, e.g. an earlier failed attempt)
///
/// A member with NO ROW is `not_invited` too — the honest answer, and why the
/// read left-joins members rather than requiring a row to exist first.
model ProjectRepoCollaborator {
  id String @id @default(cuid())

  /// The tenant, carried on the row itself because RLS does not traverse foreign
  /// keys — the policy predicates on THIS column, never on a join through
  /// `project_repository`. Same reasoning as that table's own `workspace_id`.
  workspaceId   String @map("workspace_id")
  projectRepoId String @map("project_repository_id")

  /// WHO — a real Motir user, never a typed GitHub handle. This FK is the
  /// safety property: an invitation can only ever be aimed at someone the
  /// workspace already contains, so a typo cannot invite a stranger to a private
  /// repository (MOTIR-1900's own warning, made structural).
  userId String @map("user_id")

  /// The GitHub login invited, SNAPSHOT at invite time from that user's own
  /// `GithubIdentity` (which is `@unique` on `userId` and holds their OAuth
  /// token — Motir cannot OAuth on anyone's behalf, so this is only ever their
  /// own connected account).
  ///
  /// Recorded rather than re-derived on read for the reason MOTIR-1900 gave: if
  /// the member later disconnects or reconnects a DIFFERENT GitHub account, the
  /// invitation that is live on GitHub is still the OLD login's — and the row
  /// must say which account actually holds access, not which one the user
  /// happens to have connected today.
  githubLogin String @map("github_login")

  /// What was granted (ADR §3 Q2). Defaults to `push`; the approving user's
  /// backfilled row carries `admin`.
  permission ProjectRepoCollaboratorPermission @default(push)

  /// When the invitation was last SENT. Re-sending re-stamps it; accepting does
  /// NOT clear it, so the row keeps both events. NULL means no invitation has
  /// gone out yet — a row can exist un-invited when an earlier attempt failed.
  invitedAt DateTime? @map("invited_at")

  /// When this account was first OBSERVED to hold access — either GitHub
  /// answered the invite `204` ("already a collaborator", no invitation to
  /// accept) or a later refresh read found them one. NULL means "not observed
  /// accepted", NEVER "declined": GitHub owns acceptance and tells Motir nothing
  /// when it happens, so Motir shows what it can see rather than pretending to
  /// know more. Monotonic — a repeat refresh never rewrites the first sighting.
  acceptedAt DateTime? @map("accepted_at")

  /// GitHub's `html_url` for the PENDING invitation — the target of **Open the
  /// invitation**. Stored because the invitation is a GitHub object that cannot
  /// be reconstructed from `owner/name`. Cleared on acceptance, so the link never
  /// points at an invitation that no longer exists.
  invitationUrl String? @map("invitation_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectRepo ProjectRepo @relation(fields: [projectRepoId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One record per person per repository. This is what makes the invite
  /// IDEMPOTENT at the database level: a retry after a crash between the GitHub
  /// call and the write upserts the same row rather than recording a second
  /// invitation for the same account.
  @@unique([projectRepoId, userId])
  @@index([workspaceId])
  @@index([projectRepoId])
  @@index([userId])
  @@map("project_repository_collaborator")
}

/// ONE completed GitHub Actions workflow run whose compute MOTIR PAID FOR (Story
/// MOTIR-1775 · MOTIR-1896) — the per-run AUDIT row of the CI-minutes meter
/// (`docs/decisions/ci-minutes-allowance.md`).
///
/// Motir hosts every repository it creates for a new project in its own GitHub
/// org (ADR §Context, after the MOTIR-1893 amendment), and private-repo Actions
/// minutes bill to the REPOSITORY OWNER — so from the first `motir run` onward
/// Motir pays for those users' CI. This table is the measurement: what ran, how
/// long, on which runner, at which price ratio, and which tenant it belongs to.
///
/// This table MEASURES and STORES. It debits no credits, reads no balance and
/// refuses no dispatch — that is MOTIR-1901's job, and the seam between them is
/// ONE read (`ciMinutesMeterService.getOrgPeriodConsumption`).
///
/// ⚠️ IDEMPOTENCY is the `@@unique([runId, runAttempt])` index (ADR §5.8). A
/// webhook delivery can repeat — GitHub retries, and a redelivery is routine —
/// and a run counted twice would bill a user for compute that ran once. The
/// ATTEMPT is part of the key, not incidental: a re-run is a new attempt that
/// GitHub bills AGAIN, so it must meter again. The unique index is the real
/// guard (a pre-read races); the service catches its P2002 and reports
/// `duplicate` without touching the period rollup.
///
/// ⚠️ EVERY QUANTITY IS RE-DERIVABLE, so a repricing needs no backfill (§3.3):
/// the raw wall clock, the billable (per-job `ceil`) minutes, the runner
/// breakdown and the MULTIPLIER APPLIED are all stored. A future rate change
/// adds an effective-dated entry and never rewrites what was already counted.
///
/// Workspace-scoped tenant data: `workspace_id` is non-null and the RLS policy
/// ships in the SAME migration (PRODECT_FINDINGS #20 — no unguarded window),
/// with the `app.system_admin` escape the webhook path needs (it has no active
/// workspace), mirroring `github_repo`.
model CiWorkflowRunUsage {
  id             String  @id @default(cuid())
  /// Provider discriminator — always "github" today. ADR §5.6: Motir creates no
  /// GitLab repositories, so there is no GitLab compute it pays for. The column
  /// exists so that stays a recorded fact rather than an assumption baked into
  /// the table's shape.
  provider       String  @default("github")
  workspaceId    String  @map("workspace_id")
  /// The org the POOL and the credit ledger are keyed by (§4.1), DENORMALIZED so
  /// the allowance sibling's "used this period" question is one indexed read.
  organizationId String  @map("organization_id")
  /// The attributed project — NULLABLE and SetNull. A Motir-org repo whose
  /// project was deleted is still real spend (§5.4: "metered as a cost, charged
  /// to nobody, and LOGGED"), and silence there would hide it.
  projectId      String? @map("project_id")
  /// The connected-repo mirror row this run belongs to — nullable + SetNull, so
  /// disconnecting a repo never deletes the record that Motir paid for it.
  githubRepoId   String? @map("github_repo_id")

  /// GitHub's own workflow-run id (as a string — never do math on it).
  runId        String  @map("run_id")
  /// The run ATTEMPT. A re-run bills again, so it is part of the idempotency key.
  runAttempt   Int     @map("run_attempt")
  /// The repository owner AS THE RUN REPORTED IT (§5.5) — never copied from the
  /// mirror, which can hold a pre-transfer owner. This is the identity GitHub
  /// bills against, and it is what the §5.1 gate matched on, so the row records
  /// WHY it was metered.
  repoOwner    String  @map("repo_owner")
  repoName     String  @map("repo_name")
  workflowName String? @map("workflow_name")

  /// The calendar-month period this run counts in — midnight UTC on the 1st
  /// (§4.5). A PURE function of `runCompletedAt`, so the meter keys a row
  /// without reading any billing state, and the bucket never moves.
  periodStart    DateTime @map("period_start")
  /// When the run completed — the period key AND the effective-date the runner
  /// rates were resolved at (§3.3).
  runCompletedAt DateTime @map("run_completed_at")

  /// Σ ceil(per-JOB wall-clock minutes) — what GitHub bills, before
  /// normalization. Per-job rounding up is not optional (§5.8): jobs run in
  /// parallel, so the run's own wall clock would badly undercount a 4-job suite.
  billableMinutes         Int     @map("billable_minutes")
  /// Σ raw job durations in seconds, UN-rounded — the audit trail that makes a
  /// later re-pricing a recomputation rather than a backfill (§3.3).
  rawWallClockSeconds     Decimal @map("raw_wall_clock_seconds") @db.Decimal(12, 2)
  /// The METERED quantity: Σ (billable minutes × the runner's price ratio). The
  /// pool is denominated in these (§3.1). Decimal, never Float — these are
  /// summed into a period total that a credit charge is derived from, and
  /// binary-float drift has no place there.
  linearEquivalentMinutes Decimal @map("linear_equivalent_minutes") @db.Decimal(12, 2)
  jobCount                Int     @map("job_count")
  /// Per-runner-family breakdown: family, the multiplier APPLIED, billable
  /// minutes, raw seconds, job count, and whether the family was unpriced (the
  /// §3.4 ×1.00 fallback). JSON rather than a child table — it is an explanatory
  /// audit payload nothing filters or joins on.
  runnerBreakdown         Json    @map("runner_breakdown")

  createdAt DateTime @default(now()) @map("created_at")

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  githubRepo   GithubRepo?  @relation(fields: [githubRepoId], references: [id], onDelete: SetNull)

  /// The idempotency guarantee (§5.8) — a run reported twice counts once, and a
  /// RE-RUN (a new attempt) counts again.
  @@unique([runId, runAttempt])
  @@index([workspaceId])
  @@index([organizationId, periodStart])
  @@index([projectId])
  @@map("ci_workflow_run_usage")
}

/// The PER-PERIOD consumption rollup (Story MOTIR-1775 · MOTIR-1896) — the row
/// the allowance sibling (MOTIR-1901) reads to answer "how many
/// Linux-equivalent minutes has org X used this period?".
///
/// WHY a rollup at all: the ADR's acceptance is that the question is "a single
/// indexed read rather than a scan-and-sum over all history". Summing
/// `ci_workflow_run_usage` would grow without bound — one row per PR run,
/// forever — while this table holds at most one row per (workspace, month).
/// The per-run rows stay for audit; this is the hot read.
///
/// KEYED BY WORKSPACE, summed by ORG. The pool is org-level (§4.1) but an org
/// can hold several workspaces, and this table follows the workspace-scoped
/// tenancy contract like every other tenant table. The org read is therefore a
/// SUM over that org's rows for one period — bounded by the org's workspace
/// count (small) and served entirely by `@@index([organizationId, periodStart])`,
/// so it is still one indexed query, never a history scan.
///
/// The rollup is incremented IN THE SAME TRANSACTION as the run row that feeds
/// it, so the two can never disagree: a duplicate delivery fails the run row's
/// unique index and the increment rolls back with it.
model CiPeriodUsage {
  id             String @id @default(cuid())
  workspaceId    String @map("workspace_id")
  organizationId String @map("organization_id")

  /// Midnight UTC on the 1st of the calendar month (§4.5).
  periodStart DateTime @map("period_start")

  /// The pool-denominated total — what the allowance is measured against.
  linearEquivalentMinutes Decimal @default(0) @map("linear_equivalent_minutes") @db.Decimal(14, 2)
  /// The un-normalized billable total, kept alongside so a repricing can be
  /// checked against the raw (§3.3) and so the monthly reconciliation has a
  /// like-for-like figure to compare with GitHub's own report (§5.8).
  billableMinutes         Int     @default(0) @map("billable_minutes")
  rawWallClockSeconds     Decimal @default(0) @map("raw_wall_clock_seconds") @db.Decimal(14, 2)
  runCount                Int     @default(0) @map("run_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// One rollup row per workspace per period — the upsert target.
  @@unique([workspaceId, periodStart])
  /// The org's "used this period" read (§Consequences, MOTIR-1901's one input).
  @@index([organizationId, periodStart])
  @@map("ci_period_usage")
}

/// What an org's CI consumption has been CHARGED in a period (Story MOTIR-1775 ·
/// MOTIR-1901) — the ENTITLEMENT half's only durable state, and the row every
/// charge locks `FOR UPDATE` before deciding anything.
///
/// ORG-scoped, not workspace-scoped (deliberately unlike `CiPeriodUsage`): the
/// pool is org-level (§4.1) and the credit ledger is one balance per org, so a
/// charge that spans an org's workspaces has no single workspace to belong to.
/// Its RLS policy therefore gates on `app.organization_id` (plus the
/// `app.system_admin` escape the webhook-driven charger needs), not on
/// `app.workspace_id`.
///
/// The three counters are NOT redundant, and conflating them re-introduces the
/// exact bugs §4.6 forbids — see `computeIncrementalCharge` for the full
/// reasoning:
///   * `accountedMinutes` — the WATERMARK: consumption already weighed against
///     the pool. Charging is incremental against this, which is what stops a
///     mid-period seat REMOVAL (a smaller pool) from back-billing minutes that
///     were free when they ran.
///   * `chargedMinutes` — of those, how many fell beyond the pool. Fractional, so
///     the sub-credit remainder carries instead of being rounded away each event.
///   * `chargedCredits` / `debitedCredits` — whole credits BOOKED locally vs.
///     CONFIRMED by motir-ai's ledger. They differ exactly while a cross-boundary
///     debit is outstanding (§8.6 makes it a post-commit side effect that may
///     fail), and the gap is what lets the next metering event retry it.
model CiPeriodCharge {
  id             String @id @default(cuid())
  organizationId String @map("organization_id")

  /// Midnight UTC on the 1st of the calendar month (§4.5) — the same key the
  /// meter's period rows use, computed by the same `periodStartFor`.
  periodStart DateTime @map("period_start")

  /// Consumption already weighed against the pool (the watermark).
  accountedMinutes Decimal @default(0) @map("accounted_minutes") @db.Decimal(14, 2)
  /// Of the accounted minutes, those beyond the pool (fractional carry included).
  chargedMinutes   Decimal @default(0) @map("charged_minutes") @db.Decimal(14, 2)
  /// Whole credits booked locally for this period's overage.
  chargedCredits   Int     @default(0) @map("charged_credits")
  /// Whole credits motir-ai's ledger has CONFIRMED. Never exceeds `chargedCredits`.
  debitedCredits   Int     @default(0) @map("debited_credits")

  /// The idempotency key of a debit that was attempted but not confirmed, and the
  /// credits it carried. At most one is outstanding at a time: the next charge
  /// event RETRIES this exact ref first (motir-ai is idempotent on it and reports
  /// `idempotent: true` when it had in fact landed), which is the only way to
  /// resolve a timed-out debit without risking a double charge. A new debit is
  /// never issued while one is pending — the outstanding delta is simply carried
  /// by `chargedCredits - debitedCredits` until the pending one clears.
  pendingDebitRef     String?   @map("pending_debit_ref")
  pendingDebitCredits Int       @default(0) @map("pending_debit_credits")
  /// When the pending slot was first occupied (MOTIR-7316): set with the first
  /// `pendingDebitRef`, kept while one stays outstanding, cleared with it. The
  /// fleet monitor dates an unconfirmed debit from this — `updatedAt` moves on
  /// every metered tick, pending or not, so it cannot.
  pendingDebitSince   DateTime? @map("pending_debit_since")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// One charge row per org per period — the lock target and the upsert key.
  @@unique([organizationId, periodStart])
  @@map("ci_period_charge")
}

/// A QUEUED CI job that needs a Motir-fleet runner (Story MOTIR-1916 ·
/// MOTIR-1920) — the fleet's ENTRY POINT, and the durable record that a machine
/// was asked for.
///
/// WHY A ROW AND NOT A DIRECT CALL. The `workflow_job` `queued` webhook must be
/// acked fast (a slow handler makes GitHub retry) while booting a runner is a
/// slow, failure-prone side effect against a cloud provider. Persisting the
/// INTENT first splits the two: the delivery is durable the moment this row
/// commits, and MOTIR-1921's provisioner can crash, retry or be redeployed
/// between receipt and boot without losing the job. A fire-and-forget call would
/// lose exactly the jobs that arrive during a deploy.
///
/// ⚠️ EVERY ROW HERE IS A LABEL-SCOPED JOB. `ci-minutes-allowance.md` §O: the
/// handler emits an intent ONLY for a job whose requested labels name the Motir
/// runner. GitHub-hosted jobs — including all 31 of `motir-core`'s own — reach
/// the same webhook and are dropped before this table is touched, which is what
/// keeps Motir's own release path off infrastructure Motir is still building
/// (§J). `requestedLabels` is stored so that decision is auditable after the
/// fact rather than inferred.
///
/// The attribution columns mirror `CiWorkflowRunUsage` deliberately: the same
/// repo → project → workspace → org chain resolves both, so the compute Motir
/// provisions and the minutes it later charges for can be joined on the same
/// keys. `projectId` / `githubRepoId` are nullable + SetNull for the same reason
/// the metered rows are — a deleted project or a disconnected repo must not
/// erase the record that a runner was booted and paid for.
model CiRunnerProvisioningIntent {
  id       String @id @default(cuid())
  /// Provider discriminator — always "github" today (§5.6: Motir creates no
  /// GitLab repositories, so there is no GitLab job the fleet would serve).
  provider String @default("github")

  workspaceId    String  @map("workspace_id")
  /// The org whose pool and cap this job's runner counts against, DENORMALIZED
  /// exactly as the metering tables denormalize it — MOTIR-1922's in-flight cap
  /// and credit-exhaustion refusal both key on the org, and neither should have
  /// to join through the workspace to ask.
  organizationId String  @map("organization_id")
  projectId      String? @map("project_id")
  githubRepoId   String? @map("github_repo_id")

  /// The App installation the delivery arrived on — carried because MOTIR-1921
  /// mints the runner-registration token with it, and re-deriving it at boot
  /// time from the repo would read a mirror that may since have changed.
  installationId String @map("installation_id")

  /// GitHub's own ids (strings — never do math on them). The three together are
  /// the idempotency key: GitHub redelivers webhooks, a re-run is a new
  /// `runAttempt` that legitimately needs fresh runners, and ONE run attempt
  /// queues MANY jobs, each needing its own ephemeral runner. Keying on
  /// `(runId, runAttempt)` alone — the meter's key, which is right for a
  /// per-RUN measurement — would collapse a 31-job matrix into one intent and
  /// starve 30 jobs.
  runId        String  @map("run_id")
  runAttempt   Int     @map("run_attempt")
  jobId        String  @map("job_id")
  jobName      String? @map("job_name")
  workflowName String? @map("workflow_name")

  /// The repository AS THE DELIVERY REPORTED IT (§5.5) — never copied from the
  /// mirror, which can hold a pre-transfer owner.
  repoOwner String @map("repo_owner")
  repoName  String @map("repo_name")

  /// The labels the job's `runs-on` REQUESTED — the evidence for why this row
  /// exists at all. Stored rather than recomputed because the §O gate is the
  /// one decision on this path whose failure is silent and expensive in both
  /// directions (provisioning for a job that is not ours; not provisioning for
  /// one that is).
  requestedLabels String[] @map("requested_labels")

  /// When GitHub queued the job — NOT when Motir received the delivery. The age
  /// of an unclaimed intent is the stuck-queue signal, and a redelivery hours
  /// later must not make an old job look fresh.
  queuedAt DateTime @map("queued_at")

  /// The provisioning lifecycle. MOTIR-1920 only ever writes `pending`; the
  /// transitions out of it are MOTIR-1921's (boot / teardown) and MOTIR-1922's
  /// (the in-flight cap and the `ci_credits_exhausted` refusal). Kept a String
  /// rather than an enum so that card can extend the vocabulary without a
  /// migration on a table it does not own — the values live in
  /// `lib/ciFleet/config.ts`'s consumer, and this column has exactly one writer
  /// today.
  ///
  /// MOTIR-1921 extends the vocabulary exactly as that comment anticipated:
  /// `provisioning` (claimed, JIT minted, machine booting), `running` (the
  /// container is up), `completed` and `failed` (terminal, with
  /// `teardownReason` saying which path got there). The set lives in
  /// `lib/repositories/ciRunnerProvisioningIntentRepository.ts`.
  status String @default("pending")

  /// ── The PROVISIONED CONTAINER (MOTIR-1921) ────────────────────────────────
  /// The port's `ContainerHandle`, flattened. PERSISTED, and that is the whole
  /// reason the reaper can work: the case it exists for is this process dying
  /// between provision and teardown, so the handle has to survive somewhere that
  /// is not this process. Provider-agnostic by construction — a Fly Machine id
  /// and an EC2 instance id are both just `container_id` (ADR §4's rule 1).
  containerProvider       String?               @map("container_provider")
  containerId             String?               @map("container_id")
  containerRegion         String?               @map("container_region")
  /// The FLEET ACCOUNT the container was booted in (MOTIR-8964), so poll, settle,
  /// stop and reap reach the same provider account after a restart. NULL = the
  /// process-wide fleet — every row written before accounts existed, and every
  /// job of a kind whose switch is Fly. Written at the CLAIM, under the admission
  /// lock (MOTIR-8968), so the per-account count is exact. RESTRICT: an account
  /// with a container recorded against it cannot vanish from under it.
  fleetShardId            String?               @map("fleet_shard_id")
  /// Why the job left the account admission first chose for it (MOTIR-8968).
  /// NULL when it booted on its first choice, or on Fly. The headroom reading
  /// (MOTIR-8969) counts moves from it.
  fleetShardMoveReason    FleetShardMoveReason? @map("fleet_shard_move_reason")
  /// The intent's FIRST `shard_capacity` deferral (MOTIR-8968), at admission or
  /// at boot; never cleared. The headroom reading counts sustained deferral from it.
  shardCapacityDeferredAt DateTime?             @map("shard_capacity_deferred_at")

  /// GitHub's numeric runner id, from the JIT-config mint. Stored because
  /// `generate-jitconfig` REGISTERS the runner before any container exists
  /// (§7.4, verified 2026-08-01), so every failure path between mint and job
  /// must be able to de-register it — and after a crash, this column is the only
  /// thing that knows its name. The encoded JIT config itself is a CREDENTIAL and
  /// is never persisted.
  githubRunnerId Int?    @map("github_runner_id")
  runnerName     String? @map("runner_name")

  /// When the container was created, and when it was observed running. The
  /// second is what carries the usage row's `startedAt` on the happy path: with
  /// `auto_destroy: true` the machine deletes itself, taking its event log with
  /// it, so an observation Motir made while it was alive is the only surviving
  /// record of when it started.
  bootedAt  DateTime? @map("booted_at")
  startedAt DateTime? @map("started_at")

  /// Boot latency in milliseconds — the ADR §6 budget made MEASURABLE rather
  /// than aspirational. Measured from the job's own `queued_at` (GitHub's
  /// instant, not our receipt) to the container being observed running, which is
  /// the orchestrator-observable proxy for §6's webhook→`started_at` span.
  /// MOTIR-1928 measures the real p50/p95 against the budget on live
  /// infrastructure; this is what makes that a query rather than a stopwatch.
  bootLatencyMs Int? @map("boot_latency_ms")

  /// How the container ended — the port's `TeardownReason`. Kept next to the
  /// status because "failed" alone cannot distinguish a provider refusal from a
  /// runner that never registered from a job that ran over its timeout, and
  /// those are three different operational stories.
  teardownReason String?   @map("teardown_reason")
  settledAt      DateTime? @map("settled_at")
  /// A short, non-secret failure detail. Never a provider body.
  failureDetail  String?   @map("failure_detail")

  /// How many boots of this intent failed TRANSIENTLY and put it back in the
  /// pending pool (MOTIR-8941). A fleet runner is interchangeable, so a boot that
  /// is lost for good leaves one queued GitHub job with no runner; a transient
  /// failure is re-queued instead, up to a bound after which it settles
  /// `provision_failed`.
  bootAttempts Int @default(0) @map("boot_attempts")

  /// Which RECONCILE of the job this intent is (MOTIR-8976). 0 is the intent the
  /// `workflow_job.queued` delivery recorded. A fleet runner is not tied to a job
  /// (GitHub hands a new runner to the OLDEST queued job carrying the label), so a
  /// lost runner leaves some job queued while every intent settles `job_completed`;
  /// the reconcile sweep mints generation N+1 for a job GitHub still holds queued.
  reconcileGeneration Int @default(0) @map("reconcile_generation")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fleetShard   FleetShard?  @relation(fields: [fleetShardId], references: [id], onDelete: Restrict)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  githubRepo   GithubRepo?  @relation(fields: [githubRepoId], references: [id], onDelete: SetNull)

  liveAccruals CiLiveAccrual[]

  /// The idempotency guarantee: a redelivered webhook produces no second intent,
  /// while a RE-RUN (a new attempt) and every sibling JOB of the same run each
  /// get their own.
  @@unique([runId, runAttempt, jobId, reconcileGeneration])
  @@index([workspaceId])
  /// MOTIR-1921's work queue: the oldest unclaimed intents, and MOTIR-1922's
  /// per-org in-flight count, are both served by this.
  @@index([status, queuedAt])
  @@index([organizationId, status])
  @@index([projectId, status])
  /// The REAPER's read (MOTIR-1921): intents still holding a container, oldest
  /// boot first. Distinct from `[status, queuedAt]` because the reaper ages a
  /// container from when it BOOTED, not from when GitHub queued the job — an
  /// intent that waited an hour at the admission gate and then booted a second
  /// ago must not be swept as an hour-old orphan.
  @@index([status, bootedAt])
  @@index([fleetShardId])
  @@map("ci_runner_provisioning_intent")
}

/// CI IS DEBITED WHILE IT RUNS (Story MOTIR-6906 · MOTIR-6910 ·
/// `docs/decisions/fleet-per-org-pool.md` §3). One row per live CI container per
/// debit period: the WHOLE minutes that container accrued since its previous row,
/// added to the org's `ci_period_usage` in the same transaction so the existing
/// allowance-then-credits charge sees them before the run ends.
///
/// The row is the idempotency record: `(provisioning_intent_id, tick_start)` makes
/// a replayed or retried tick a no-op, and the per-intent SUM is the checkpoint the
/// next tick subtracts from, so a late tick never counts a minute twice. When the
/// run completes, the `workflow_run` meter subtracts this run's sum from GitHub's
/// figure and adds only the difference (`ciMinutesMeterService.meterWorkflowRun`).
model CiLiveAccrual {
  id                   String @id @default(cuid())
  provisioningIntentId String @map("provisioning_intent_id")
  organizationId       String @map("organization_id")
  workspaceId          String @map("workspace_id")

  /// The GitHub run this container served — the completion meter's key.
  runId      String @map("run_id")
  runAttempt Int    @map("run_attempt")

  /// The start of the 5-minute debit period this row was written in.
  tickStart   DateTime @map("tick_start")
  /// The calendar month (`ci_period_usage.period_start`) the minutes landed in.
  periodStart DateTime @map("period_start")

  /// Whole minutes, in seconds (always a multiple of 60).
  accruedSeconds Int @map("accrued_seconds")

  createdAt DateTime @default(now()) @map("created_at")

  provisioningIntent CiRunnerProvisioningIntent @relation(fields: [provisioningIntentId], references: [id], onDelete: Cascade)
  organization       Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace          Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([provisioningIntentId, tickStart])
  /// The completion meter's read: what this run was already charged live.
  @@index([runId, runAttempt])
  @@index([organizationId])
  @@index([workspaceId])
  @@map("ci_live_accrual")
}

/// THE KILL RECORD (Story MOTIR-6906 · MOTIR-6925, `fleet-per-org-pool.md` §5) —
/// one row per machine the attribution reconciler destroyed or stopped, for the
/// platform admin's list (MOTIR-6905) and the audit of what the reconciler did.
///
/// ⚠️ WRITTEN BEFORE THE DESTROY. The decision commits first and the provider
/// call follows (`docs/jobs.md`'s commit-then-effect rule), so a destroy that
/// throws leaves a row with no `completedAt` and its `failureDetail` — never a
/// machine killed with no record of why. The next pass decides again and writes
/// a new row; a machine that keeps failing to die shows up as several.
model FleetMachineKill {
  id          String @id @default(cuid())
  /// The provider app and machine, as the provider listed them.
  app         String
  machineId   String @map("machine_id")
  machineName String @default("") @map("machine_name")

  /// `no_record` · `record_ended` · `org_stopped` — the alert's own words.
  reason String
  /// `destroyed`, or `stopped` for an agent instance's persistent machine whose
  /// record says it should be resting.
  action String

  /// What matched it, when anything did: the workload and its record's id.
  /// Null for `no_record`.
  workload       String?
  recordRef      String? @map("record_ref")
  /// The organisation of the matched record — null for `no_record`, and after
  /// the organisation is deleted (the row outlives it: it is an audit).
  organizationId String? @map("organization_id")

  machineCreatedAt DateTime? @map("machine_created_at")
  ageSeconds       Int       @map("age_seconds")

  decidedAt     DateTime  @default(now()) @map("decided_at")
  completedAt   DateTime? @map("completed_at")
  failureDetail String?   @map("failure_detail")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, decidedAt])
  @@index([decidedAt])
  @@map("fleet_machine_kill")
}

/// The CONTAINER-SECONDS RECORD (Story MOTIR-1916 · MOTIR-1924) — what ONE fleet
/// runner cost MOTIR, per runner, never aggregated at write time.
///
/// ⚠️ THIS IS THE SECOND METER, AND IT MEASURES A DIFFERENT QUANTITY FROM THE
/// FIRST. `ci-minutes-allowance.md` §P: before the fleet, "what the customer is
/// charged" and "what Motir pays" were one number seen from two sides, because
/// GitHub billed Motir for the minute it charged the user for. On Motir's own
/// runners they are independent — `CiWorkflowRunUsage` measures Actions job
/// wall-clock in Linux-equivalent MINUTES (the customer's side); this measures
/// CONTAINER-SECONDS on the cloud account (Motir's own COGS). Neither can be
/// derived from the other, which is why both exist.
///
/// ⚠️ IT IS NOT BILLING. Nothing here debits a credit ledger, reads a balance or
/// reaches a user-facing surface — `CiPeriodCharge` is the only table a charge
/// touches, and this one is deliberately not joined to it. Its consumers are
/// margin reporting and the fleet's own reconciliation (§Q.2), both internal.
///
/// The FIELDS are fixed by `ci-runner-fleet.md` §5 and mirror the port's
/// `ContainerUsage` one-for-one; the SCHEMA is this card's deliverable. Keeping
/// them in lockstep is what stops the meter, the reconciliation and the margin
/// readout each inventing their own shape.
///
/// Attribution mirrors `CiWorkflowRunUsage` — repo → project → workspace → org,
/// denormalized — so the two meters can be compared per tenant without a join
/// through anything that might have been deleted since.
model CiContainerUsage {
  id String @id @default(cuid())

  /// WHICH ORCHESTRATOR ran it (`fly` / `fake` / a future one) — the port's
  /// `OrchestratorProvider`, NOT a git provider. It is half the idempotency key
  /// because a handle id is only unique within its own provider's namespace.
  containerProvider String @map("container_provider")
  /// The port's opaque `ContainerHandle.id` — a Fly Machine id today. THE
  /// per-runner identity, and with the provider the row's uniqueness.
  handleId          String @map("handle_id")
  containerRegion   String @map("container_region")

  workspaceId    String  @map("workspace_id")
  /// The org margin is read per (§P: "attributed to the org so the two numbers
  /// are comparable per tenant"), DENORMALIZED exactly as the minute meter
  /// denormalizes it.
  organizationId String  @map("organization_id")
  /// Nullable + SetNull like every other attribution column here: a deleted
  /// project must not erase the record that Motir paid for this container.
  projectId      String? @map("project_id")

  /// WHICH workload this container ran. The fleet org is shared — CI runners,
  /// code-graph index containers (MOTIR-1981) and, later, Epic 9's hosted agents
  /// all bill the same uncapped Fly account — so a row that cannot say which
  /// workload it was makes "what did indexing cost us?" unanswerable and merges
  /// three margins into one number. Defaulted to `ci` so this migration is a
  /// no-op for the rows this meter writes today.
  workload String @default("ci")

  /// `owner/name` AS THE INTENT RECORDED IT (§5.5's posture) — the port carries
  /// one string, so the row stores one. The fleet reconciliation splits it.
  ///
  /// ⚠️ NULLABLE SINCE MOTIR-3255, AND THE NULL IS A STATEMENT: *this handle
  /// served an ORG, not a repo.* A warm sync worker (`code-graph-index-fleet.md`
  /// §16) lives across many repos of one org, so no single value here could be
  /// true — and a row naming the last repo it happened to serve would be worse
  /// than a null, because it would read as a fact. Which repos it served, and for
  /// how long, is in `ci_container_usage_slice`; this row keeps the handle's
  /// LIFETIME, which is what the org-and-workload rollup reads.
  ///
  /// Every one-container-one-repo workload still writes it, and the writer
  /// requires it for those — the column is permissive, the writer is not.
  repoFullName  String? @map("repo_full_name")
  /// GitHub's job id (a STRING — never do math on it), matching
  /// `CiRunnerProvisioningIntent.jobId`. One job, one container.
  ///
  /// NULLABLE because only a CI container has one: an index or agent container
  /// is dispatched directly on the orchestrator port and never touches Actions,
  /// so there is no job id to record. Required in practice for `workload = 'ci'`.
  workflowJobId String? @map("workflow_job_id")

  /// The machine class ACTUALLY provisioned — reported by the adapter rather
  /// than assumed from the spec, because a provider may fall back to a different
  /// class and the rate that applies is the one that ran.
  cpuKind  String @map("cpu_kind")
  cpus     Int
  memoryMb Int    @map("memory_mb")

  /// The physical quantity, provider-attested where available. `startedAt` is
  /// NULL iff the container never started (a `provision_failed` row), and that
  /// is the case `billableSeconds` 0 records.
  containerCreatedAt DateTime  @map("container_created_at")
  containerStartedAt DateTime? @map("container_started_at")
  /// NULLABLE so a row can exist for a container that is still RUNNING. A CI
  /// runner lives minutes and is costed at teardown, which is why this was NOT
  /// NULL; an Epic 9 agent container spans a whole `motir run <story>` — HOURS —
  /// and under teardown-only costing would produce no row for its entire life,
  /// accruing spend invisibly against an account Fly provides no cap for.
  ///
  /// ⚠️ NULL IS THEREFORE "STILL ACCRUING", AND IT IS THE ROW'S SETTLED FLAG
  /// (MOTIR-1995 implements the accrual the column was relaxed for). A row with a
  /// null `container_stopped_at` carries a PARTIAL figure that a later checkpoint
  /// may raise; a settle writes this instant together with `terminal_state` +
  /// `teardown_reason` and reconciles `billable_seconds` to the true total. The
  /// writer enforces the pairing — a settled row never has a null here, and a
  /// second settle of the same handle changes nothing.
  containerStoppedAt DateTime? @map("container_stopped_at")
  /// ceil(stopped − started) once settled, and ceil(now − started) at a
  /// checkpoint; 0 when it never started. Fly bills a Machine on its RUNNING
  /// seconds, so this IS the provider's own basis — which is what makes the fleet
  /// reconciliation an audit rather than two estimates.
  ///
  /// ⚠️ ABSOLUTE-TO-DATE, NEVER A DELTA (MOTIR-1995). Every accrual write states
  /// the container's TOTAL seconds so far and the writer derives the rollup's
  /// increment by subtracting what this column already held. That is what makes a
  /// replayed checkpoint — the normal case, since supervision runs as durable
  /// Inngest steps that re-execute on replay — cost exactly nothing.
  billableSeconds    Int       @map("billable_seconds")

  /// The calendar-month bucket — the same `periodStartFor` the minute meter keys
  /// on (§4.5), so the two meters' periods always line up.
  ///
  /// ⚠️ PINNED AT THE ROW'S FIRST WRITE AND NEVER MOVED. For a settle-only
  /// container that is `periodStartFor(containerStoppedAt)`, unchanged. For a
  /// checkpointed one it is the period of the FIRST accrual, and a container that
  /// runs across a month boundary keeps it: the rollup it has already been added
  /// to is the one the settle must reconcile against, and re-bucketing the row
  /// would leave the old period's rollup permanently overstated.
  periodStart DateTime @map("period_start")

  /// The commercial mapping, resolved from the DATED rate table AT TEARDOWN.
  /// DECIMAL, never Float: `usdPerSecond` is ~3×10⁻⁵ and the second counts run
  /// to five digits, so binary-float error is invisible per row and systematic
  /// across a month — the shape of error a reconciliation is worst at catching.
  usdPerSecond      Decimal   @map("usd_per_second") @db.Decimal(20, 12)
  costUsd           Decimal   @map("cost_usd") @db.Decimal(20, 12)
  /// WHICH rate row was applied. NULL means no row covered this container: it
  /// was recorded at a zero rate and LOGGED (the §3.4 posture one domain over),
  /// and the null is what distinguishes "cost unknown" from a genuine zero.
  rateEffectiveFrom DateTime? @map("rate_effective_from")

  /// The provider's own terminal state string, and the port's `TeardownReason`.
  /// "How did this container end" is unanswerable from timestamps alone, and it
  /// is the question the fleet's operational story is made of.
  ///
  /// NULLABLE for the same reason as `containerStoppedAt`: a container that has
  /// not ended yet has no terminal state, and forbidding that row is what would
  /// hide a long-running container's spend until it stopped. A settled row still
  /// carries both — enforced by the writer, not by the column.
  terminalState  String? @map("terminal_state")
  teardownReason String? @map("teardown_reason")

  /// THE DISPATCH RUN THIS CONTAINER SERVED (MOTIR-6448) — set only for a
  /// hosted-agent container, whose one id everywhere is `DispatchRun.id`
  /// (`docs/decisions/hosted-agent-run.md` §1). NULL for a CI runner and an index
  /// container, which serve no run. A POINTER FROM THE METER TO THE RUN, never a
  /// cost column on `dispatch_run` (MOTIR-1801): the run's machine time is READ
  /// from here. `SET NULL` for the reason `project_id` gives — a deleted run must
  /// not erase the record that Motir paid for this container.
  dispatchRunId String? @map("dispatch_run_id")

  createdAt               DateTime  @default(now()) @map("created_at")
  /// When motir-ai's platform usage rollup accepted this container's report
  /// (Story MOTIR-727 · MOTIR-7294) — NULL until then. The backfill sends only
  /// settled rows still NULL here, so a second run sends nothing new.
  platformMeterReportedAt DateTime? @map("platform_meter_reported_at")

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  dispatchRun  DispatchRun? @relation(fields: [dispatchRunId], references: [id], onDelete: SetNull)

  /// THE IDEMPOTENCY GUARANTEE, and it is per RUNNER because a runner is what a
  /// container is. Both callers of the sink — the `finally` that guarantees
  /// teardown and the reaper — can reach the SAME handle, and `teardown` is
  /// required to be idempotent, so the second arrival must cost nothing. §5's
  /// invariant is exactly this index: "for every provisioned handle, exactly one
  /// usage row".
  @@unique([containerProvider, handleId])
  @@index([workspaceId])
  /// The org's "what did the fleet cost this period" read.
  @@index([organizationId, periodStart])
  /// The fleet reconciliation's read (§Q.2): every container in a period, split
  /// by repo.
  @@index([periodStart])
  @@index([projectId])
  /// A run's machine-time read (MOTIR-6448).
  @@index([dispatchRunId])
  @@map("ci_container_usage")
}

/// WHAT ONE HANDLE'S SECONDS WERE SPENT ON, when the handle served more than one
/// repo (Story MOTIR-3249 · Subtask MOTIR-3255).
///
/// ⚠️ WHY THIS EXISTS. `ci_container_usage` is one row per CONTAINER carrying one
/// `project_id` and one `repo_full_name`, and that was exact while every container
/// served exactly one repo. The warm sync worker (`code-graph-index-fleet.md` §16)
/// breaks the assumption: one machine, one ORG, many repos over its life. A row
/// that cannot say which project's syncs it performed makes *"what did indexing
/// cost us for project X"* unanswerable — the precise failure MOTIR-1995 was filed
/// over, reached this time through an attribution hole rather than a missing route.
///
/// ⚠️ IT DOES NOT REPLACE THE HANDLE ROW, AND THE TWO ARE NOT TWO INTERPRETATIONS
/// OF ONE RECORD. The handle row stays the ONE record of what the machine cost —
/// its lifetime seconds, its rate, its period — and it alone feeds the org ×
/// workload rollup. A slice is a finer READ of that same lifetime, never a second
/// source for the total. What keeps them honest is arithmetic, and it is asserted:
/// **Σ slices = the handle's `billable_seconds`, idle included.**
///
/// ⚠️ IDLE IS A SLICE, AND ITS OWNER IS THE ORG. A worker that waits costs money on
/// nobody's behalf in particular, and *"idle is a real cost and it belongs to
/// somebody"* is settled here by giving it a row of its own with a null project and
/// a null repo. It is DERIVED by the writer (lifetime − Σ reported work), never
/// reported by the container — so the reconciliation holds by construction rather
/// than by trusting a caller to do subtraction.
model CiContainerUsageSlice {
  id String @id @default(cuid())

  /// The handle this slice belongs to — the same `(provider, handle)` pair that
  /// identifies the parent row. Denormalized rather than a foreign key onto the
  /// parent's `id` for the reason the parent denormalizes attribution: the writer
  /// holds these two values before it holds the parent's cuid, and a slice must be
  /// idempotently upsertable in the same transaction that materializes the parent.
  containerProvider String @map("container_provider")
  handleId          String @map("handle_id")

  /// The unit of work this slice covers — one SYNC, named by the id the dispatch
  /// already carries (`runId`). It is the idempotency key: supervision runs as
  /// durable steps that re-execute on replay, so every write is an upsert on
  /// `(provider, handle, slice_ref)` and a replay costs nothing.
  ///
  /// The DERIVED idle slice uses the reserved ref `__idle__` — a slice the writer
  /// owns needs a key the writer owns, and no run id can collide with it.
  sliceRef String @map("slice_ref")

  /// `work` or `idle`. An explicit kind rather than "a work slice whose repo is
  /// null": the two are different claims, and a reader forced to infer one from a
  /// null would be inventing the second interpretation this model exists to avoid.
  kind String

  /// WHO the slice is attributed to. Both are NULL on an `idle` slice — the org
  /// owns it, and the org is on the row already. `project_id` is nullable + SetNull
  /// for the reason the parent's is: a deleted project must not erase the record
  /// that Motir paid for this compute.
  workspaceId    String  @map("workspace_id")
  organizationId String  @map("organization_id")
  projectId      String? @map("project_id")
  repoFullName   String? @map("repo_full_name")

  /// ABSOLUTE-TO-DATE, NEVER A DELTA — the same discipline as the parent's
  /// `billable_seconds` and for the same reason: a replayed checkpoint states the
  /// slice's total so far and the writer overwrites, so replaying is free and
  /// double-counting is not expressible.
  seconds Int

  /// The commercial mapping, copied from the parent at write time so a slice reads
  /// without a join and cannot drift if the rate table is later re-dated. DECIMAL
  /// for the reason the parent gives.
  usdPerSecond Decimal @map("usd_per_second") @db.Decimal(20, 12)
  costUsd      Decimal @map("cost_usd") @db.Decimal(20, 12)

  /// The parent's period, copied — pinned at the parent's first write and never
  /// moved, so a slice can never land in a bucket its own handle is not in.
  periodStart DateTime @map("period_start")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// One slice per unit of work per handle — the key the upsert is idempotent on.
  ///
  /// ⚠️ THE NAME IS PINNED, and it has to be: the derived name for three columns
  /// on a table with this prefix is 67 characters, over Postgres's 63-byte
  /// identifier limit, so the database and Prisma each truncate it — to DIFFERENT
  /// strings. `migrate diff` then reports a permanent rename, and the drift never
  /// resolves however many times the migration is re-applied. An explicit short
  /// map is the only form both sides agree on.
  @@unique([containerProvider, handleId, sliceRef], map: "ci_container_usage_slice_handle_ref_key")
  /// The reconciliation read: every slice of one handle.
  @@index([containerProvider, handleId])
  /// The attribution reads: what one org, or one project, cost in a period.
  @@index([organizationId, periodStart])
  @@index([projectId, periodStart])
  @@map("ci_container_usage_slice")
}

/// The PER-PERIOD fleet-COST rollup (Story MOTIR-1916 · MOTIR-1924 ·
/// MOTIR-1995) — the row that makes "what did this org's fleet cost Motir in
/// July?" one indexed read rather than a scan-and-sum over every container ever
/// booted.
///
/// The exact shape of `CiPeriodUsage` one meter over, and deliberately so:
/// keyed by workspace (the tenancy contract), summed by org (where the margin
/// question is asked), incremented in the SAME transaction as the container row
/// that feeds it — so the two can never disagree.
///
/// ⚠️ MARGIN IS DERIVED FROM STORED VALUES, NOT FROM LOGS. `CiPeriodUsage` holds
/// the org's metered Linux-equivalent minutes for the same period and the same
/// key; this holds what those minutes cost. That pairing is the whole point:
/// §L's margin claim and §M's ×1.00 estimate become measurements the moment
/// both rows exist, and re-pricing the allowance (§1) with evidence needs
/// nothing else.
model CiContainerPeriodCost {
  id             String @id @default(cuid())
  workspaceId    String @map("workspace_id")
  organizationId String @map("organization_id")

  /// Midnight UTC on the 1st of the calendar month (§4.5).
  periodStart DateTime @map("period_start")

  /// WHICH workload these seconds are, and PART OF THE KEY (MOTIR-1995).
  ///
  /// ⚠️ THE PER-ROW `workload` ON `CiContainerUsage` IS NOT ENOUGH, and that was
  /// the gap. This rollup exists so the cost question is ONE indexed read; with a
  /// single row per (workspace, period) that read returns CI + index + agent
  /// summed together, and the only way back to "what did indexing cost us?" is
  /// the scan over per-container rows the rollup exists to avoid. So the three
  /// workloads get three rows and are separable at the same cost as the total —
  /// which is `code-graph-index-fleet.md`'s own reason for the discriminator, one
  /// table further along than MOTIR-1924 could see.
  ///
  /// `ci` / `index` / `agent` (`CiContainerWorkload`), defaulted to `ci` so the
  /// migration is a no-op for every row MOTIR-1924's meter has already written.
  workload String @default("ci")

  /// Σ billable container-seconds — the PHYSICAL total, kept alongside the money
  /// so a re-pricing can be recomputed from it without a backfill (§3.3's rule,
  /// applied to Motir's own cost).
  ///
  /// ⚠️ INCREMENTED BY SIGNED DELTAS, NOT ONLY BY WHOLE CONTAINERS (MOTIR-1995).
  /// A checkpointed container contributes the DIFFERENCE between what it has
  /// accrued so far and what this rollup already holds for it, so replaying a
  /// checkpoint adds nothing and a settle that lands BELOW the last checkpoint
  /// (the container stopped between two observations) corrects downward. The
  /// physical total therefore always equals Σ of the per-container rows.
  containerSeconds Int     @default(0) @map("container_seconds")
  /// Σ cost in USD. Decimal at the row's own precision, never a float.
  costUsd          Decimal @default(0) @map("cost_usd") @db.Decimal(24, 12)
  /// How many DISTINCT containers have contributed. Incremented only when a
  /// container's usage row is first created, never per checkpoint — otherwise a
  /// long-running container would count itself once per observation.
  containerCount   Int     @default(0) @map("container_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// One rollup row per workspace per period PER WORKLOAD — the upsert target.
  @@unique([workspaceId, periodStart, workload])
  /// The org's cost-for-this-period read, mirroring `CiPeriodUsage`'s. The
  /// workload is deliberately NOT in the index: both reads this serves — one
  /// workload's line and the full per-workload breakdown — hit at most three rows
  /// per workspace in the period, so the extra column would buy nothing.
  @@index([organizationId, periodStart])
  @@map("ci_container_period_cost")
}

/// The PROVISIONING GATE's serialization anchor (Story MOTIR-1916 · MOTIR-1922)
/// — a table whose rows carry no data and exist only to be LOCKED.
///
/// ⚠️ WHY A ROW AND NOT JUST A COUNT. Both admission caps are read-derived
/// writes: *count what is in flight → decide → claim a slot*. `SELECT … FOR
/// UPDATE` over the counted rows cannot make that safe, because the rows two
/// racing admissions are about to claim are DIFFERENT rows — locking what you
/// counted never prevents a concurrent insert or update from changing the count
/// underneath you (there is no phantom protection at READ COMMITTED). So the
/// admissions have to contend on ONE shared row, and there is no natural row for
/// "the fleet" the way `organization` is the natural one for the §4 entitlement
/// caps (`entitlementsService`, which locks exactly that). This table supplies
/// it. `notes.html` #35 is the rule; this is the anchor that makes it applicable.
///
/// One row per SCOPE, created on demand:
///   * `fleet`               — the global ceiling. Every admission takes it, so
///                             it serializes the whole gate.
///   * `project:<projectId>` — the per-project allowance.
///
/// Deliberately NOT workspace-scoped and NOT a tenant table: it holds no tenant
/// data, and the fleet scope is by definition cross-tenant. Its RLS policy is
/// `system_admin` only, which is also the context the whole fleet path runs in.
model CiFleetAdmissionLock {
  /// `fleet`, or `project:<projectId>`. The primary key IS the scope, so the
  /// `INSERT … ON CONFLICT DO NOTHING` that materializes a scope on first use is
  /// naturally idempotent.
  scope String @id

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ci_fleet_admission_lock")
}

/// ONE ROW PER FLEET CONTAINER, for the workloads that do not own a table of
/// their own (Story MOTIR-1916 · MOTIR-1997). The registration surface behind
/// the CROSS-WORKLOAD ceiling.
///
/// ⚠️ WHY THIS EXISTS. `ci_fleet_admission_lock`'s `fleet` scope bounds *CI*,
/// because the number counted under it came from `ci_runner_provisioning_intent`
/// and nothing else. MOTIR-1981 puts CODE-GRAPH INDEX containers in the same Fly
/// org and Epic 9 adds HOSTED AGENT containers; neither writes a runner intent,
/// so neither was visible to the only number bounding Motir's fleet invoice —
/// and `docs/decisions/ci-runner-fleet.md` §9 records that Fly offers **neither a
/// spending cap nor a billing alert**, so there is no provider-side backstop
/// beneath it. Two independent per-workload caps do not compose into a bound:
/// real peak concurrency is `runners + index + agents`, and no per-workload
/// number expresses it.
///
/// ⚠️ WHY A SECOND TABLE RATHER THAN A COUNTER. A maintained integer is only as
/// exact as its least reliable decrement — one missed release poisons the
/// ceiling permanently, and an approximate ceiling on an account with no
/// provider cap is not a ceiling. Rows are re-derivable, countable under the
/// existing `fleet` lock in the same transaction as the claim they guard, and
/// idempotent to take (`(workload, ref)` is unique).
///
/// ⚠️ WHY CI DOES **NOT** WRITE HERE. `ci_runner_provisioning_intent.status`
/// already IS the CI in-flight window (`provisioning` + `running`), maintained by
/// every claim, release and settle path that exists. Mirroring it into a second
/// table would add a dual write on the hottest path in the fleet and a leak class
/// where none exists today. So the ceiling is a UNION over a registry of
/// per-workload counters (`lib/ciFleet/workloads.ts`) — CI counts its own table;
/// a workload with no table of its own counts rows here. A workload that later
/// grows its own table swaps its registry entry and the ceiling stays correct.
///
/// Deliberately NOT workspace-scoped and NOT a tenant table (the same argument
/// `ci_fleet_admission_lock` makes): it bounds Motir's OWN infrastructure spend,
/// is cross-tenant by definition, and its RLS policy is `system_admin` only —
/// which is also the only context the fleet path ever runs in. `organization_id`
/// / `workspace_id` are carried for ATTRIBUTION in an operator's breakdown, never
/// as a tenancy boundary; both are nullable because a workload may hold a
/// container before it knows whose it is.
model FleetInFlightSlot {
  id String @id @default(cuid())

  /// A `FleetWorkloadKind` (`lib/ciFleet/workloads.ts`). TEXT rather than an
  /// enum for the reason the intent's `status` is text: a new workload must be a
  /// one-line registry edit, not a migration, and the exhaustive `Record` in the
  /// registry is what makes forgetting one a COMPILE error.
  workload String

  /// The workload's OWN identifier for the thing holding the container — an
  /// index-run id, an agent-run id. Unique with `workload`, which is what makes
  /// taking a slot idempotent under a redelivery or a retry: the second `INSERT
  /// … ON CONFLICT DO NOTHING` occupies no extra capacity.
  ref String

  /// The organisation whose POOL this slot counts against
  /// (`docs/decisions/fleet-per-org-pool.md` §2, MOTIR-6907) — REQUIRED since the
  /// pool became per organisation: a slot with no org would be counted by no
  /// org's pool, which is a container nothing bounds. The workspace is
  /// attribution only. Not FKs: a slot must survive the deletion of whatever it
  /// pointed at, because a leaked slot that outlives its owner is exactly the
  /// row `expires_at` exists to age out — a cascade would silently free
  /// capacity a live container is still spending.
  organizationId String  @map("organization_id")
  workspaceId    String? @map("workspace_id")

  /// The container this slot stands for, once the workload knows it. Nullable
  /// because the slot is taken BEFORE the boot — that ordering is the whole
  /// point, exactly as `claimPending` precedes provisioning on the CI path.
  containerProvider String? @map("container_provider")
  containerId       String? @map("container_id")

  /// WHICH RUN holds this slot — the workload's own identifier for the dispatch
  /// that took it (MOTIR-2160). The `ref` says WHAT is being worked on and must
  /// stay deterministic so a redelivery is idempotent; this says WHO is working
  /// on it, which is the question the ref deliberately cannot answer.
  ///
  /// Without it a second run for the same `ref` is indistinguishable from the
  /// first run's own replay, so it was admitted past every cap — and whichever
  /// run settled first released a slot the other's live container was still
  /// spending against. With it, admission can defer a DIFFERENT run while still
  /// admitting the SAME one's retry, and a release can be refused unless it owns
  /// the row (`fleetInFlightSlotRepository.releaseOwned`).
  ///
  /// Nullable, and NOT part of any uniqueness: the key stays `(workload, ref)` —
  /// one slot per unit of work, whoever holds it. A workload that does not
  /// identify its runs simply leaves it NULL and keeps the pre-MOTIR-2160
  /// behaviour.
  ownerRef String? @map("owner_ref")

  claimedAt DateTime @default(now()) @map("claimed_at")

  /// ⚠️ A SAFETY NET, NOT THE RELEASE MECHANISM. Release is an explicit delete
  /// when the container ends; this bounds the damage of a release that never
  /// runs (a crashed dispatcher, a workload with a missed teardown path). The
  /// count ignores rows at or past it, so a leak costs capacity for at most the
  /// container's own hard-kill budget plus a margin, instead of forever. Set it
  /// from the workload's `timeoutSeconds`: a value shorter than the container's
  /// real life would UNDER-count and let the ceiling be exceeded.
  expiresAt DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Idempotent take: one slot per (workload, ref), forever.
  @@unique([workload, ref])
  /// The ceiling's read — count live rows for one workload. Ordered
  /// `[workload, expiresAt]` because that is the predicate's shape.
  @@index([workload, expiresAt])
  /// The per-organisation pool count (MOTIR-6907), read under the fleet lock.
  @@index([organizationId, expiresAt])
  @@map("fleet_in_flight_slot")
}

/// The provider an account of a fleet pool runs on (MOTIR-8961). `fly` only: the
/// AWS story adds `aws` in its own migration, with its own columns and CHECKs.
enum FleetShardProvider {
  fly

  @@map("fleet_shard_provider")
}

/// What an account is to its fleet kind. `primary` = an account of that kind's
/// SHARED pool. The pool-growth story adds `spare`.
enum FleetShardRole {
  primary

  @@map("fleet_shard_role")
}

/// Why admission skips an account for a while (MOTIR-8968).
enum FleetShardPauseReason {
  capacity_refused
  provider_unavailable

  @@map("fleet_shard_pause_reason")
}

/// Why a CI job left the account admission first chose for it (MOTIR-8968).
enum FleetShardMoveReason {
  capacity_refused
  provider_unavailable

  @@map("fleet_shard_move_reason")
}

/// `provisioning` while add-shard is still setting the account up; `active` is
/// admissible; `disabled` is kept but takes no new job.
enum FleetShardState {
  provisioning
  active
  disabled

  @@map("fleet_shard_state")
}

/// ONE ACCOUNT OF ONE FLEET KIND'S POOL (Story MOTIR-8953 · MOTIR-8961) — the
/// noun the pool layer is written against: one fleet kind, one provider
/// location, one Motir-owned GitHub org with the App installation serving it,
/// the REFERENCE to its provider credential, and the account's real limits with
/// where each was read.
///
/// ⚠️ NOT A TENANT TABLE. An account of a shared pool is platform infrastructure
/// many tenants share, so there is no `workspace_id` / `organization_id`, and the
/// RLS policy is `app.system_admin` only, like `fleet_in_flight_slot`.
///
/// ⚠️ CREDENTIALS ARE REFERENCED, NEVER STORED. `credentialRef` names the
/// environment variable (or prefix) the secret lives in — where every fleet
/// credential already lives (`FLY_FLEET_API_TOKEN`). The repo has no
/// encryption-at-rest scheme for provider secrets, and a secret in a row is a
/// secret in every database dump.
///
/// ⚠️ LIMITS, NOT CEILINGS. The limit columns record what the provider or GitHub
/// ALLOWS, and `limitsSource` says where each number came from (`provider_read` ·
/// `documented` · `raised`, keyed by limit name). Admission ceilings are DERIVED
/// from them and never stored here — one number per fact.
///
/// The database holds the invariants itself (migration `fleet_shard`): the fleet
/// kind is one of the four `FLEET_WORKLOADS` names; a `fly` row names its
/// org/app/region and machine limit; every limit present is > 0; one Fly
/// location is one account.
///
/// Nothing reads it in production yet: boot, stop, reap and admission still read
/// the process-wide fleet config.
model FleetShard {
  id   String @id @default(cuid())
  /// A lowercase slug, e.g. `ci-runner-iad-1`.
  name String @unique

  /// The pool it belongs to — a `FLEET_WORKLOADS` name (`lib/ciFleet/workloads.ts`),
  /// held to the four by a CHECK.
  fleetKind String             @map("fleet_kind")
  provider  FleetShardProvider
  role      FleetShardRole     @default(primary)
  state     FleetShardState    @default(provisioning)

  /// The Motir-owned GitHub org, the provisioning App's installation on it (a
  /// string, as `GithubOrgTarget.installationId` is), and which App that is.
  githubOrg            String @map("github_org")
  githubInstallationId String @map("github_installation_id")
  githubAppRole        String @default("provisioning") @map("github_app_role")

  /// The Fly location. Required for a `fly` row (CHECK).
  flyOrg    String? @map("fly_org")
  flyApp    String? @map("fly_app")
  flyRegion String? @map("fly_region")

  /// The environment variable (or prefix) holding the provider credential.
  credentialRef String @map("credential_ref")

  /// The account's REAL limits — each > 0 when present (CHECK).
  vcpuQuota                  Int?      @map("vcpu_quota")
  machineLimit               Int?      @map("machine_limit")
  githubRegistrationsPer5Min Int?      @map("github_registrations_per_5_min")
  githubApiPerHour           Int?      @map("github_api_per_hour")
  /// Where each limit was read: `{ "<limit>": "provider_read" | "documented" | "raised" }`.
  limitsSource               Json      @default("{}") @map("limits_source")
  limitsVerifiedAt           DateTime? @map("limits_verified_at")

  /// The platform admin's admission ceiling for this account (MOTIR-8968 reads it,
  /// MOTIR-8972 writes it). NULL = derived from the limits
  /// (`shardAdmissionCeiling`); > 0 when set (CHECK).
  admissionCeilingOverride Int?                   @map("admission_ceiling_override")
  /// Skipped by admission until then, after the account refused a provision for
  /// capacity or was unreachable (MOTIR-8968). Expires by itself.
  admissionPausedUntil     DateTime?              @map("admission_paused_until")
  admissionPausedReason    FleetShardPauseReason? @map("admission_paused_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// The CI intents whose containers were booted in this account (MOTIR-8964).
  ciRunnerIntents CiRunnerProvisioningIntent[]

  /// One Fly location is one account.
  @@unique([provider, flyOrg, flyApp])
  /// Admission and the headroom reading list one kind's accounts by role and state.
  @@index([fleetKind, role, state])
  @@map("fleet_shard")
}

/// The repo-role vocabulary (`docs/decisions/project-repository-set.md` §1.1).
/// Six values, fixed — do NOT add one without amending the ADR, and keep it in
/// lockstep with motir-ai's proposal-schema role enum (MOTIR-1885).
enum ProjectRepoRole {
  /// A browser-facing application — the default platform starter's shape.
  web
  /// A backend service exposing an API: a separated backend, or one of several.
  api
  /// A native / cross-platform mobile app.
  mobile
  /// A library or package consumed by the other repos.
  shared
  /// Infrastructure-as-code, deployment, CI-only content.
  infra
  /// The honest escape hatch — a CLI, a desktop app, a docs site.
  other

  @@map("project_repo_role")
}

/// The per-row establish lifecycle (ADR §4.1):
///
///   proposed ──create──▶ creating ──▶ created
///      │                    │
///      │                    └──error──▶ failed ──retry──▶ creating
///      │                                   │
///      ├──connect-existing──▶ connected ◀──┘
///      │                                   │
///      └──skip──▶ skipped ◀────────────────┘
///
/// `created`, `connected` and `skipped` are SETTLED; `failed` is resumable. The
/// legal-edge table lives in `lib/projectRepos/transitions.ts`.
enum ProjectRepoState {
  /// Derived or hand-added, nothing created yet, fully editable.
  proposed
  /// Creation is in flight on the host.
  creating
  /// Motir created the repository.
  created
  /// An existing repository was connected instead (this is how a MONOREPO
  /// collapses the set to one row).
  connected
  /// Deliberately left without a repository — NOT an error (ADR §4.3).
  skipped
  /// Creation failed; `failureReason` says why. Retryable, connectable, skippable.
  failed

  @@map("project_repo_state")
}

/// The TAKE-IT-OVER saga's per-row lifecycle (MOTIR-711):
///
///   requested ──transfer accepted──▶ transfer_pending ──▶ awaiting_reinstall ──▶ done
///       │                                   │                      │
///       └───────────────── failed ◀─────────┴──────────────────────┘
///
/// `failed` is RESUMABLE, never terminal — every state is re-promptable, because
/// the two middle states are waits on a human acting on GitHub.
enum ProjectRepoTakeoverState {
  /// Requested and claimed. Actions are being re-enabled and the transfer issued.
  requested
  /// The transfer was accepted by GitHub and is awaiting the new owner's ACCEPT
  /// (a personal-account target must accept; an org target usually lands at once).
  transfer_pending
  /// The repository has moved. Motir's provisioning App no longer reaches it, so
  /// the user must install the App on the new owner and select it.
  awaiting_reinstall
  /// A `GithubInstallation` exists under the new owner — the loop survived.
  done
  /// A step failed; `takeoverFailureReason` says why. Retryable.
  failed

  @@map("project_repo_takeover_state")
}

/// WHO owns a project's repository set (ADR §3) — read on `Project`, not on a set
/// row, because §3.5 forbids a half-and-half set.
enum ProjectRepoOwnership {
  /// Created in the user's own account/org — theirs from the first commit.
  user
  /// Created under Motir's org, recorded as CLAIMABLE (MOTIR-711 transfers the
  /// whole set together).
  motir

  @@map("project_repo_ownership")
}

/// THE CODE-GRAPH OFFBOARDING QUEUE (MOTIR-2166 ·
/// `docs/decisions/code-graph-index-fleet.md` §14). One pending removal of a
/// tenant's derived code graph: motir-core's four lifecycle triggers enqueue,
/// `system.code-graph-offboard-sweep` drains, and motir-ai's
/// `POST /v1/code-graph/offboard` performs the three deletions.
///
/// **Why a table rather than the `deleteQuietly` precedent (§14.5).**
/// `projectsService.archiveProject` already fires a post-commit, best-effort
/// external cleanup at a runner group, and that is the right SHAPE — outside the
/// transaction, never failing the user's action. It is the wrong MECHANISM twice:
/// a retention WINDOW cannot be implemented by a call that happens now (deferral
/// needs stored state), and a dropped `deleteQuietly` leaves a stale access list
/// somebody tidies later, while a dropped call here leaves customer-derived data
/// retained forever underneath a promise that it was not.
///
/// ⚠️ **THE ABSENCE OF A FOREIGN KEY IS THE FEATURE — do not "fix" it.** This row
/// must OUTLIVE the workspace and project it names, because the workspace-delete
/// arm is precisely the case where everything else about that tenant is gone. An
/// FK to `workspace` or `project` would cascade the row away at the exact moment
/// it becomes the only record that anything needs removing — reproducing, one
/// repo over, the defect §14.1 is about: the `AiProject` FK cascade destroys the
/// `CodeRepo` rows that are the only inventory of which snapshots exist, turning
/// retained data into UNREFERENCED retained data. `FleetInFlightSlot` carries the
/// same reasoning for the same reason ("a slot must survive the deletion of
/// whatever it pointed at"). This is the rare place where a reviewer's correct
/// instinct — every id column should be a relation — is the bug.
model CodeGraphOffboarding {
  id String @id @default(cuid())

  /// The tenant coordinates motir-ai resolves its `AiProject` by — the same pair
  /// every other core→ai call carries. Deliberately NOT relations (see above):
  /// they are a NAME for something that may already be deleted, not a pointer to
  /// something that must still exist.
  coreWorkspaceId String @map("core_workspace_id")
  coreProjectId   String @map("core_project_id")

  /// WHICH repo's graph — `owner/name`, or {@link OFFBOARD_ALL_REPOS} (`*`) for
  /// every repo of the project (the project-archive and workspace-delete arms of
  /// §14.3, which motir-ai serves by OMITTING `repoRef`).
  ///
  /// A SENTINEL rather than NULL, and that is load-bearing rather than lazy:
  /// Postgres treats NULLs as distinct in a unique index, so a nullable column
  /// would let two project-wide rows for the same project both insert, and Prisma
  /// cannot express a null component in the compound-unique `where` an upsert
  /// needs. The sentinel is what makes "enqueue is an upsert" — §14's own design
  /// — actually hold. `*` can never collide with a real value: a `repoRef` is
  /// always `owner/name`, and no host permits `*` in either segment.
  repoRef String @map("repo_ref")

  /// WHEN the removal becomes due. `now + CODE_GRAPH_RETENTION_WINDOW` for the
  /// three windowed triggers; `now` for a workspace delete, which has no window
  /// because a hard delete leaves no surface to undo into (§14.3 — "a grace
  /// period the user cannot reach is not a grace period").
  dueAt DateTime @map("due_at")

  /// Which trigger enqueued this — a `CodeGraphOffboardReason`
  /// (`lib/codeGraph/offboarding.ts`). TEXT rather than an enum for the reason
  /// `FleetInFlightSlot.workload` is text: a new trigger should be a registry
  /// edit, not a migration.
  reason String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Enqueue is an UPSERT on this key, so a repo disconnected, reconnected and
  /// disconnected again holds ONE row with the latest `dueAt` rather than a
  /// stack of them.
  @@unique([coreWorkspaceId, coreProjectId, repoRef])
  /// The sweep's only read: rows whose `dueAt` has passed, oldest first.
  @@index([dueAt])
  @@map("code_graph_offboarding")
}

/// One recorded agreement: this user accepted this legal document at this
/// version, at this moment (Story 8.4 · Subtask MOTIR-1135).
///
/// ⚠️ APPEND-ONLY. A row is never updated and never deleted while the account
/// lives, because the table IS the evidence: the question a regulator or a
/// disputing customer asks is *what did they agree to, and when*, and a
/// current-value column answers only the first half of the most recent one.
/// Recording the version in the KEY rather than in a mutable column is what
/// makes that true — and it makes the write idempotent, so a retried signup
/// hook or a double-submitted interstitial writes nothing the second time
/// instead of stamping a fresh timestamp over a real one.
///
/// ⚠️ IT IS NOT ONE ROW PER ACCEPTANCE ACT — it is one row per DOCUMENT.
/// `motir.co/legal/terms` §15 makes the Terms, the Acceptable Use Policy and
/// the Privacy Policy a single agreement, and the interstitial offers a single
/// button for all of them (`design/auth/design-notes.md`, *One agreement, one
/// control*). One act therefore writes up to three rows sharing an
/// `acceptedAt`. Per-document rows are what let the re-consent check compare
/// each document's own semver against its own accepted version, which is the
/// whole mechanism — a single scalar could not represent a reader who is
/// current on the Terms and behind on the Privacy Policy.
///
/// There is deliberately no `workspaceId`: an agreement is between moooon B.V.
/// and a PERSON, made at sign-up before any workspace is resolved, and it does
/// not change when they join another org. Its RLS gate therefore keys on
/// `app.user_id`, the `api_token` precedent, not on `app.workspace_id`.
model LegalAcceptance {
  id String @id @default(cuid())

  userId String @map("user_id")

  /// The document's slug — its key in the CONFIGURED manifest
  /// (`MOTIR_LEGAL_DOCUMENTS`), which is also the last segment of the `url` that
  /// manifest entry publishes. A plain string rather than an enum:
  /// `lib/legal/documents.ts` treats THE MANIFEST as the registry (nothing
  /// enumerates slugs, so a document ships by being configured), and an enum
  /// here would re-introduce exactly the hardcoded list that module's docstring
  /// records as a shipped defect. A slug the manifest no longer publishes is a
  /// historical row, which is correct: the agreement happened. (It was a
  /// filename under `content/legal/` until MOTIR-4007 made the source
  /// configuration; the column's contents and this reasoning are unchanged.)
  documentSlug String @map("document_slug")

  /// The version string as it stood in that document's front matter when the
  /// person agreed — `1.0.0`. Stored verbatim rather than parsed, because it is
  /// EVIDENCE: the semver split is a reading we do of it (`lib/legal/consent.ts`),
  /// and a reading is not the thing that was shown.
  version String

  acceptedAt DateTime @default(now()) @map("accepted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The idempotency key. Re-recording an acceptance the person already made is
  /// a no-op rather than a second row (`skipDuplicates` on the write), so the
  /// signup hook's retry and a double-clicked interstitial are both safe.
  @@unique([userId, documentSlug, version])
  /// The gate's read: every acceptance this user holds for the re-consent set,
  /// on every signed-in page load. `userId` alone is the prefix the query
  /// filters on; the slug narrows it in the same index.
  @@index([userId, documentSlug])
  @@map("legal_acceptance")
}

/// What state an {@link AccountDeletionRequest} is in — a Postgres ENUM, not a
/// string, and that is a decision rather than a default (Story 8.4 ·
/// MOTIR-3698).
///
/// The `Data › Data & privacy` pane renders ONE state per value and the erasure
/// sweep branches on them, so every consumer will hold a `Record<Status, …>`
/// that TypeScript certifies as total. Over a free `String` column that
/// certificate certifies nothing: the database can hold a value the map has
/// never heard of, and an unknown status resolving to a plausible default is
/// indistinguishable from the real thing on a surface that tells someone when
/// their account will be erased. The enum is what makes the compiler's totality
/// claim true of the DATA and not merely of the type.
///
/// THREE values, and there is no `pending` / `failed` arm. Scheduling is a
/// single committed transaction, so a request is `scheduled` the moment it
/// exists; a sweep that cannot finish leaves the row `scheduled` and retries,
/// because a deletion that has not happened is still due (MOTIR-3702 owns the
/// sweep and its retry semantics).
enum AccountDeletionStatus {
  /// The account is closed and the erasure is due at `erasureDueAt`. The ONE
  /// state the partial unique index treats as open — a user may hold at most
  /// one row here.
  scheduled
  /// The person signed back in (or used the banner) before the window ran out.
  /// Terminal: cancelling does not reopen, a new request is a new row.
  cancelled
  /// The erasure sweep ran and finished. Terminal.
  completed

  @@map("account_deletion_status")
}

/// What state a {@link DataExportRequest} is in — a Postgres ENUM for the same
/// reason as {@link AccountDeletionStatus} (Story 8.4 · MOTIR-3698). The pane
/// draws one panel per value: a spinner, a Download button, a failure with a
/// contact route, and an expired archive that must be requested again.
enum DataExportStatus {
  /// The background build is running (or queued). No file exists yet.
  preparing
  /// The archive is built and downloadable until `expiresAt`.
  ready
  /// The build failed; `failureReason` says why and the pane routes the reader
  /// to `privacy@motir.co` (design DECISION 2's Art. 12(3) path).
  failed
  /// The seven-day retention ran out and the blob was deleted. The row survives
  /// so the pane can say what happened instead of showing nothing.
  expired

  @@map("data_export_status")
}

/// One request to close and erase an account — GDPR Art. 17 (Story 8.4 ·
/// MOTIR-3698; design of record `design/settings/design-notes.md` →
/// `Data & privacy` → DECISION 4).
///
/// DELETION SCHEDULES, IT DOES NOT FIRE. The account closes immediately and the
/// erasure runs `ACCOUNT_ERASURE_WINDOW_DAYS` later; signing in before then
/// cancels it. This row is that schedule: it exists so the window is a fact in
/// the database rather than a promise in copy, and so the app-wide cancel banner
/// has something to read.
///
/// ⚠️ `erasureDueAt` IS COMPUTED, NEVER TYPED. `lib/account/dataSubjectRequests.ts`
/// derives it from `ACCOUNT_ERASURE_WINDOW_DAYS`, which is the number
/// `motir.co/legal/privacy` §6 publishes as a promise to users. A literal `30`
/// in a service or a migration is how a published legal promise and shipped
/// behaviour quietly diverge — and here the divergence would be about when
/// somebody's account is erased.
///
/// AT MOST ONE OPEN REQUEST PER USER, enforced by the PARTIAL UNIQUE INDEX
/// `account_deletion_request_open_per_user_key` (`(user_id) WHERE status =
/// 'scheduled'`) and NOT by application code. Scheduling is a check-then-write,
/// and a `SELECT … FOR UPDATE` over a predicate matching ZERO rows locks
/// nothing: two concurrent requests both read "no open request" and both insert.
/// The index is therefore the real guard on the FIRST write and the lock is the
/// guard on every subsequent one; the service (MOTIR-3700) translates the
/// resulting `P2002` into its typed domain error rather than letting a raw
/// driver code escape as a 500.
///
/// The index is deliberately the table's ONLY index on `(user_id)` alone: Prisma
/// pairs a database index to a datamodel index BY COLUMN LIST and cannot express
/// a `WHERE` clause, so an `@@index([userId])` beside it would drift for ever as
/// a spurious rename (`CLAUDE.md`, the partial-index rule). The history read
/// uses `(userId, requestedAt)`, which earns its second column from its own
/// `ORDER BY`.
///
/// TENANCY — identity-scoped, so the RLS policy keys on `app.user_id` (the
/// `api_token` / `legal_acceptance` precedent), with a `system_admin` arm for the
/// erasure sweep, which runs with no user bound. See the migration for the full
/// reasoning.
model AccountDeletionRequest {
  id     String @id @default(cuid())
  userId String @map("user_id")

  /// When the person asked. The window is measured from HERE, not from `now()`
  /// at read time, so a request's due date never moves.
  requestedAt  DateTime              @default(now()) @map("requested_at")
  /// When the erasure becomes due — `requestedAt + ACCOUNT_ERASURE_WINDOW_DAYS`.
  /// Persisted rather than derived at read time because it is the promise the
  /// banner and the pane both display, and a stored deadline survives a change
  /// to the constant for requests already in flight.
  erasureDueAt DateTime              @map("erasure_due_at")
  status       AccountDeletionStatus @default(scheduled)
  /// When the person cancelled, if they did. Null for every other state.
  cancelledAt  DateTime?             @map("cancelled_at")
  /// When the erasure sweep finished, if it has. Null for every other state.
  completedAt  DateTime?             @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The pane's history read — this person's requests, newest first. NOT
  /// `([userId])`: see the model's doc comment on the partial-index rule.
  @@index([userId, requestedAt])
  /// The erasure sweep's read — every request whose window has run out. Both
  /// columns are in its `WHERE`, so the second earns its place.
  @@index([status, erasureDueAt])
  @@map("account_deletion_request")
}

/// ⚠️ RETIRED — SCHEMA-ONLY PHASE (Story MOTIR-9385 · MOTIR-9386). Motir has no
/// Enterprise plan, and the feature that wrote and read this table is deleted.
/// The model is `@@ignore`d so the generated client no longer names the table,
/// while the table and its five enum types stay in place: `fly.toml`'s
/// `release_command` migrates BEFORE the new image takes traffic, so dropping
/// them in the same release would pull the table from under the still-serving
/// image (`docs/decisions/delivery-reader-migration.md` §6a,
/// `tests/contract-phase-guard.test.ts`). A CONTRACT migration in a LATER
/// release drops the table and the enums and deletes these declarations.
///
/// A request for the ENTERPRISE plan, sent from the Enterprise card's Contact
/// sales control on Billing & plans (Story MOTIR-7602 · Subtask MOTIR-7605).
/// Platform staff work it in the operator console's Enterprise requests page
/// through `new → contacted → offer_sent → won | lost`.
///
/// AT MOST ONE OPEN REQUEST PER ORG — the PARTIAL UNIQUE INDEX
/// `enterprise_request_open_per_org_key` (`(organization_id) WHERE status IN
/// ('new','contacted','offer_sent')`), not a check-then-insert: two tabs racing
/// both read "nothing open", so only the index can refuse the second insert. It
/// is the table's only index on `(organization_id)` alone — the history read is
/// `(organizationId, createdAt)` (`CLAUDE.md`, the partial-index rule).
///
/// It never stores a PRICE: the offer is private and lives outside the product.
/// Every answer the org gives is optional except the note.
///
/// TENANCY — org-scoped (`app.organization_id`), with an `app.platform_staff`
/// arm for the console and an `app.system_admin` arm for the email job. See the
/// migration.
model EnterpriseRequest {
  id             String  @id @default(cuid())
  organizationId String  @map("organization_id")
  /// Who pressed Send. SetNull: the org's record outlives the sender's account.
  requestedById  String? @map("requested_by_id")

  status EnterpriseRequestStatus @default(new)

  /// Roughly how many cards a day the org wants to run.
  cardsPerDay      Int?                 @map("cards_per_day")
  /// How many agents in parallel.
  parallelAgents   Int?                 @map("parallel_agents")
  agentPath        EnterpriseAgentPath? @map("agent_path")
  autonomy         EnterpriseAutonomy?
  startWhen        EnterpriseStartWhen? @map("start_when")
  teamSize         EnterpriseTeamSize?  @map("team_size")
  /// How to reach them. The service defaults it to the sender's email.
  contact          String
  /// The free-text note — the one required answer.
  note             String
  /// The PM-core tier the org was on when it asked (`pmTierForOrg`), snapshotted.
  tierKeyAtRequest String?              @map("tier_key_at_request")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  /// When staff moved it to `won` or `lost`. Null while it is open.
  closedAt  DateTime? @map("closed_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User?        @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  /// The console list — newest first within a state filter.
  @@index([status, createdAt])
  /// The org's history read. NOT `([organizationId])` — see the doc comment.
  @@index([organizationId, createdAt])
  @@index([requestedById])
  @@map("enterprise_request")
  @@ignore
}

/// Where an {@link EnterpriseRequest} stands. `new`, `contacted` and
/// `offer_sent` are OPEN (the partial index); `won` and `lost` are terminal.
enum EnterpriseRequestStatus {
  new
  contacted
  offer_sent
  won
  lost

  @@map("enterprise_request_status")
}

/// Which agents the org would run.
enum EnterpriseAgentPath {
  /// Motir's hosted agents, on Motir's models.
  hosted
  /// Their own agents (Claude Code, Codex, …) on their own credential.
  own
  both

  @@map("enterprise_agent_path")
}

/// Whether the org wants the project run on its own, or only a volume of runs.
enum EnterpriseAutonomy {
  autonomous_lead
  volume_only
  unsure

  @@map("enterprise_autonomy")
}

/// When the org would start.
enum EnterpriseStartWhen {
  now
  within_month
  within_quarter
  exploring

  @@map("enterprise_start_when")
}

/// The org's team size, as a range.
enum EnterpriseTeamSize {
  size_1_10
  size_11_50
  size_51_200
  size_201_plus

  @@map("enterprise_team_size")
}

/// A request to DELETE AN ORGANIZATION (Story MOTIR-6306 · Subtask MOTIR-6391) —
/// the org-tier sibling of {@link AccountDeletionRequest}, mirrored one for one.
/// `docs/decisions/organization-deletion.md` (MOTIR-6389) is the contract: the
/// Owner schedules (§1), the org closes read-only for 30 days (§2, §3), the Owner
/// may cancel (§4), then a resumable sweep erases it to a tombstone (§6, §7).
///
/// ⚠️ `erasureDueAt` IS COMPUTED, NEVER TYPED — `lib/organizations/deletion.ts`
/// derives it from `ORGANIZATION_DELETION_WINDOW_DAYS`, the number DPA §10
/// promises. Persisted at scheduling so the date a member was emailed never moves.
///
/// AT MOST ONE OPEN REQUEST PER ORG — the PARTIAL UNIQUE INDEX
/// `organization_deletion_request_open_per_org_key` (`(organization_id) WHERE
/// status IN ('scheduled','erasing')`), not application code: a `FOR UPDATE`
/// over zero rows locks nothing, so the index is the guard on the FIRST write.
/// It is the table's only index on `(organization_id)` alone — the history read
/// is `(organizationId, requestedAt)` (`CLAUDE.md`, the partial-index rule).
///
/// TENANCY — org-scoped: the RLS policy keys on `app.organization_id` (the
/// `ci_period_charge` shape), with a `system_admin` arm for the sweep. See the
/// migration.
model OrganizationDeletionRequest {
  id             String @id @default(cuid())
  organizationId String @map("organization_id")

  /// Who scheduled it. SetNull: the org's record outlives the actor's account.
  requestedByUserId String?  @map("requested_by_user_id")
  /// When the Owner asked. The window is measured from HERE.
  requestedAt       DateTime @default(now()) @map("requested_at")
  /// `requestedAt + ORGANIZATION_DELETION_WINDOW_DAYS` — the promise the dialog,
  /// the banner and every email state. Stored, never recomputed.
  erasureDueAt      DateTime @map("erasure_due_at")

  status OrganizationDeletionStatus @default(scheduled)

  /// When, and by whom, it was cancelled. Null for every other state.
  cancelledAt       DateTime? @map("cancelled_at")
  cancelledByUserId String?   @map("cancelled_by_user_id")

  /// When the sweep claimed it (`scheduled → erasing`), finished it
  /// (`→ erased`), and when the seven-year purge removed the tombstone.
  erasingStartedAt DateTime? @map("erasing_started_at")
  erasedAt         DateTime? @map("erased_at")
  purgedAt         DateTime? @map("purged_at")

  /// The LAST erasure step completed, so a resumed sweep skips finished steps.
  /// Null until the first step lands.
  erasureStep OrganizationErasureStep? @map("erasure_step")
  /// The last step failure, kept for the operator and the next attempt.
  lastError   String?                  @map("last_error")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requestedBy  User?                        @relation("OrganizationDeletionRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  cancelledBy  User?                        @relation("OrganizationDeletionCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  /// The emails already sent about this request (MOTIR-6395's dedupe record).
  notices      OrganizationDeletionNotice[]

  /// History, newest first. NOT `([organizationId])` — see the doc comment.
  @@index([organizationId, requestedAt])
  /// The sweep's due read — both columns are in its `WHERE`.
  @@index([status, erasureDueAt])
  @@index([requestedByUserId])
  @@index([cancelledByUserId])
  @@map("organization_deletion_request")
}

/// One change of an organisation's content language (Story MOTIR-7731 ·
/// MOTIR-8092) — the "who / from / to / when" record. Written only by
/// `organizationContentLanguageService.changeContentLanguage` (MOTIR-8094), in
/// the same transaction as the `Organization.contentLanguage` update, and never
/// for a no-op change. The registration default writes no row, so an
/// organisation with no rows has never had its language changed.
model OrganizationContentLanguageChange {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  /// Who changed it. SetNull: the record of the change outlives the account.
  changedByUserId String?  @map("changed_by_user_id")
  /// `lib/i18n/locales.ts` codes, validated in code (`isLocale`).
  fromLanguage    String   @map("from_language")
  toLanguage      String   @map("to_language")
  changedAt       DateTime @default(now()) @map("changed_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  changedBy    User?        @relation("OrganizationContentLanguageChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  /// The history read, newest first.
  @@index([organizationId, changedAt])
  @@index([changedByUserId])
  @@map("organization_content_language_change")
}

/// One flip of a project's auto-translate switch (Story MOTIR-7738 ·
/// MOTIR-8825) — the "who / from / to / when" record, the project-tier twin of
/// {@link OrganizationContentLanguageChange}. Written only by the service that
/// flips `Project.autoTranslateWorkContent`, in the same transaction as that
/// write. No CHECK forbids `fromEnabled = toEnabled`: whether a no-op flip
/// writes a row is the service's call. RLS is the project-scoped pair
/// (`page_version`): workspace-keyed, with a project-narrowing SELECT arm.
model ProjectAutoTranslateChange {
  id              String   @id @default(cuid())
  workspaceId     String   @map("workspace_id")
  projectId       String   @map("project_id")
  /// Who flipped it. SetNull: the record of the change outlives the account.
  changedByUserId String?  @map("changed_by_user_id")
  fromEnabled     Boolean  @map("from_enabled")
  toEnabled       Boolean  @map("to_enabled")
  changedAt       DateTime @default(now()) @map("changed_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changedBy User?     @relation("ProjectAutoTranslateChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  /// The history read, newest first.
  @@index([projectId, changedAt])
  @@map("project_auto_translate_change")
}

/// One email notice sent about an {@link OrganizationDeletionRequest} (Story
/// MOTIR-6306 · MOTIR-6395) — the DEDUPE record that makes each notice
/// exactly-once per (request, kind, daysLeft) whatever the job engine's own
/// idempotency window is: the reminder job runs every day for a month, and the
/// schedule / cancel / erase callers are at-least-once.
///
/// Written AFTER the notice's emails are enqueued (each carrying its own
/// per-recipient idempotency key), so a crash between the two re-sends at worst
/// inside the engine's dedupe window rather than silently skipping a notice.
/// Cascades with its request, so the seven-year purge takes it too.
model OrganizationDeletionNotice {
  id        String                         @id @default(cuid())
  requestId String                         @map("request_id")
  kind      OrganizationDeletionNoticeKind
  /// The reminder's day count (7 or 1); 0 for the one-off notices.
  daysLeft  Int                            @default(0) @map("days_left")
  sentAt    DateTime                       @default(now()) @map("sent_at")

  request OrganizationDeletionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, kind, daysLeft])
  @@map("organization_deletion_notice")
}

/// Which notice an {@link OrganizationDeletionNotice} records (DECISION §8).
enum OrganizationDeletionNoticeKind {
  scheduled
  cancelled
  reminder
  erased

  @@map("organization_deletion_notice_kind")
}

/// Where an {@link OrganizationDeletionRequest} stands (DECISION §2–§7).
enum OrganizationDeletionStatus {
  /// Closing: read-only, due at `erasureDueAt`. OPEN (the partial index).
  scheduled
  /// The Owner took it back before the due date. Terminal.
  cancelled
  /// The sweep has claimed it and is working through `erasureStep`. OPEN — a
  /// second schedule may not start while an erasure is mid-flight.
  erasing
  /// The org is a tombstone. Terminal until the retention purge.
  erased
  /// Seven years on, the tombstone and its billing rows are gone. Terminal.
  purged

  @@map("organization_deletion_status")
}

/// The erasure steps, in the ORDER DECISION §6 fixes — Git FIRST, because
/// `github_repo` / `github_installation` cascade on `workspace_id` and would be
/// gone before a later Git step could walk them.
enum OrganizationErasureStep {
  git
  workspaces
  ai
  tombstone

  @@map("organization_erasure_step")
}

/// One request for a copy of everything this account holds — GDPR Art. 15 +
/// Art. 20 (Story 8.4 · MOTIR-3698; design of record
/// `design/settings/design-notes.md` → `Data & privacy` → DECISIONs 1 and 2).
///
/// THE FILE IS HANDED OVER IN THE PANE, NOT IN THE EMAIL. A private object is
/// served through a presigned URL with a 300-second TTL (`signedDownloadUrl` in
/// `lib/blob/uploader.ts`), and a URL that dies in five minutes cannot be emailed
/// to a human being. So the shape is: request → background build → email
/// notification → the reader RETURNS to the pane → Download mints a fresh link.
/// That return trip is only a real instruction if the archive is still there when
/// they make it, which is what `expiresAt` is: `builtAt +
/// DATA_EXPORT_RETENTION_DAYS`. The sweep that expires a row and deletes its blob
/// rides with the export build (MOTIR-3701); this model carries the column.
///
/// NO UNIQUENESS CONSTRAINT, deliberately — unlike {@link AccountDeletionRequest}.
/// Two archives of the same account are wasteful, not incorrect: nothing is
/// destroyed, no promise is doubled, and the pane simply shows the newest. The
/// throttle that stops somebody queueing fifty of them is a rate limit in the
/// service (MOTIR-3701), which is where a policy decision belongs — a unique
/// index here would instead make a second legitimate request after a failure
/// impossible.
///
/// TENANCY — identity-scoped, same policy shape as
/// {@link AccountDeletionRequest}; the `system_admin` arm is the export BUILD
/// job, which runs with no user bound.
model DataExportRequest {
  id     String @id @default(cuid())
  userId String @map("user_id")

  requestedAt DateTime         @default(now()) @map("requested_at")
  status      DataExportStatus @default(preparing)

  /// Where the built archive lives in blob storage — the pathname
  /// `signedDownloadUrl` mints a link for. Null until the build succeeds, and
  /// null again once the expiry sweep has deleted the object, so a non-null
  /// value means "there is a file to serve".
  blobPathname  String?   @map("blob_pathname")
  /// When the archive finished building. The retention window is measured from
  /// here, not from `requestedAt`: a build that took an hour must still be
  /// downloadable for the full seven days after it exists.
  builtAt       DateTime? @map("built_at")
  /// When the archive stops being downloadable — `builtAt +
  /// DATA_EXPORT_RETENTION_DAYS`. Persisted for the same reason
  /// `erasureDueAt` is: it is displayed, and a stored deadline does not move.
  expiresAt     DateTime? @map("expires_at")
  /// Why a `failed` build failed, in operator terms. Never rendered verbatim to
  /// the reader — the pane shows the copy DECISION 2 fixes and routes to
  /// `privacy@motir.co`; this column is for the person answering that mail.
  failureReason String?   @map("failure_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The pane's read — this person's exports, newest first.
  @@index([userId, requestedAt])
  /// The expiry sweep's read — every ready archive whose retention has run out.
  /// Both columns are in its `WHERE`.
  @@index([status, expiresAt])
  @@map("data_export_request")
}

// ───────────────────────────────────────────────────────────────────────────
// The DISPATCH RUN record (Story MOTIR-1789 · Subtask MOTIR-1791), specified by
// `docs/decisions/dispatch-run-record.md`.
//
// One invocation of a Motir CLI command, over a SET of cards. `motir run
// <story>` claims every member of a scope in one transaction and works them in
// dependency order; `motir batch` freezes what it will take and what it will
// skip before it dispatches anything; `motir auto` discovers its set one card at
// a time. All three are ONE run with one id, one order, one stop reason — so the
// record is a run HEADER plus one LEG per card, and a single-card `motir next`
// is the degenerate case of the same object (ADR Q1).
//
// ⚠️ IT IS NOT A `JobRun`, AND IT IS NOT motir-ai's `AgentRun`. `JobRun` records
// one invocation of a server-side background job on Motir's OWN infrastructure,
// which Motir schedules, executes and can cancel. A `DispatchRun` records one
// invocation of a CLI command on SOMEBODY ELSE'S machine, which Motir never
// executes and only ever hears about — every row here is a report, not an
// observation. motir-ai's `AgentRun` is the METERING aggregate on the other side
// of the open-core boundary (9.1.6), correlated to this row by run id and never
// merged with it: a BYOK-local run has a row here and no metering row at all.
// The naming exists because the first decomposition of this story called these
// models `AgentRun`, documented the collision at length, and shipped it anyway
// (MOTIR-1801 / MOTIR-3890) — by which point `JobRun` had landed and the
// collision was three-way inside one schema file.
//
// ⚠️ THREE COLUMNS THAT MUST NEVER EXIST ON ANY OF THESE MODELS (ADR Q3), each
// because the fact already has exactly one owner:
//
//   1. no pull-request or CI column — that is `WorkItemDelivery` →
//      `GithubPullRequest` → `GithubCheckRun`, with the one verdict
//      `derivePrCiState` derives (MOTIR-3655 / MOTIR-3697). The run's EVENTS
//      record that a pull request was opened; the run's SURFACES read the
//      delivery set;
//   2. no work-item status column and no status write — the CLI owns every
//      transition and the CI-green promotion is server-side (MOTIR-2999);
//   3. no token, usage, credit or cost column — ever, not "not yet". Billing
//      lives in motir-ai, and a BYOK run never touches the gateway.
//
// `tests/dispatchRunSchemaBoundaries.test.ts` asserts all three over the
// GENERATED client's field names, so the boundary cannot be crossed by a
// well-meaning migration.
model DispatchRun {
  id          String @id @default(cuid())
  /// Tenant of record. Carried on the ROW because RLS does not traverse foreign
  /// keys — the same reason `work_item_delivery` carries one.
  workspaceId String @map("workspace_id")
  projectId   String @map("project_id")

  /// Which command opened the run. `run` and `run_scope` are the same word to a
  /// person and genuinely different runs: one claims a card, the other claims a
  /// container and every leaf under it.
  command DispatchCommand
  /// WHO EXECUTED IT. This discriminator is why there is one table and not two:
  /// 9.1.7's hosted orchestrator becomes a second WRITER of the ingest
  /// operations rather than the owner of a second record.
  origin  DispatchRunOrigin @default(local)

  /// The container or sprint-bearing item the run was pointed at, for a scoped
  /// run. `SET NULL` — a run's history outlives a deleted card, and a scope that
  /// has since been archived must not take the run with it.
  scopeWorkItemId String? @map("scope_work_item_id")
  /// What the CLI PRINTED for the scope ("MOTIR-1789", "the active sprint"). A
  /// label rather than a derivation, so the page can render a run whose scope
  /// row is gone.
  scopeLabel      String? @map("scope_label")

  status     DispatchRunStatus   @default(running)
  /// Null while `running`. Written once, by the read-derived terminal update — a
  /// late event must never re-open a closed run.
  stopReason DispatchStopReason? @map("stop_reason")

  /// The agent BINARY the operator ran (`claude`, `codex`), and the model it
  /// self-reported. Deliberately the same vocabulary as
  /// `WorkItem.implementationHarness` / `implementationModel`, so the two never
  /// diverge — that pair is also the shipped precedent for recording HOW work
  /// was done without recording what the agent read (ADR Q4).
  agent String?
  model String?

  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  /// When the run last said it was alive (MOTIR-6528, `run-death-keeps-work.md`
  /// §2). A LOCAL run heartbeats every 60 s while it is open; null for a run
  /// opened by a CLI that never heartbeats and for every HOSTED run, whose
  /// liveness is its supervision. Read through `isRunAlive`
  /// (`lib/runs/runLiveness.ts`) and nowhere else.
  lastHeartbeatAt DateTime? @map("last_heartbeat_at")

  /// WHO REPORTS this run (MOTIR-7450, `agent-reported-runs.md` §1): `cli` for every
  /// run a runner observes — the v1 ingest, a hosted or instance start, a repair or
  /// continue claim — and `agent` for a run the agent opened about ITSELF through
  /// `start_work_item_run`. Set by the door that opened the run, never by a caller.
  /// It also picks the lapse window the reap applies (§5).
  reportedBy DispatchRunReporter @default(cli) @map("reported_by")

  /// The operator who started it. `SET NULL`: deleting a person must not destroy
  /// the record of what their runs did.
  createdById String? @map("created_by_id")

  /// Supplied by the CLI so a retried open is ONE row rather than two runs that
  /// each saw half the work.
  idempotencyKey String? @map("idempotency_key")

  /// The developer's own agent the run executes in (`origin: instance` —
  /// `docs/decisions/agent-instance-run.md` §5, MOTIR-7023). Null for every
  /// `local` and `hosted` run. `SET NULL`, so removing an agent row never takes
  /// run history with it (an agent row is soft-deleted in practice, so its name
  /// stays readable). AT MOST ONE `running` run per agent is enforced by a
  /// hand-written PARTIAL unique index in the migration
  /// (`dispatch_run_agent_instance_running_key`), which the datamodel cannot
  /// express — so NO `@@index` / `@@unique` on this model may claim the column
  /// list `(agent_instance_id)` (CLAUDE.md, the partial-index rule). A CHECK
  /// constraint (`dispatch_run_agent_instance_origin_check`) pins that only an
  /// `instance` run names an agent.
  agentInstanceId String? @map("agent_instance_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scope         WorkItem?      @relation("DispatchRunScope", fields: [scopeWorkItemId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  agentInstance AgentInstance? @relation(fields: [agentInstanceId], references: [id], onDelete: SetNull)

  cards            DispatchRunCard[]
  events           DispatchRunEvent[]
  /// How-to-test records this run wrote (MOTIR-5328). SetNull on the FK.
  testInstructions TestInstructions[]
  /// The fleet meter rows for this run's container (MOTIR-6448). SetNull on the FK.
  containerUsage   CiContainerUsage[]
  /// The run-bound Motir credential a hosted run holds (MOTIR-688). Cascade on the FK.
  runTokens        ApiToken[]
  /// The GitHub installation tokens handed to this hosted run (MOTIR-6449), recorded
  /// so the end path can revoke every one. Cascade on the FK.
  gitCredentials   DispatchRunGitCredential[]
  /// The design refusal that started this run automatically, if one did (MOTIR-700).
  designAutoReruns DesignAutoRerun[]
  /// The approval gates this run stopped at, when it closed `gated` (MOTIR-7703).
  heldGates        DispatchRunHeldGate[]
  resumingItems    WorkItem[]                 @relation("WorkItemResumeRun")
  /// The automatic resumes an approval attempted for this gated run (MOTIR-7710).
  gateResumes      GateResume[]               @relation("GateResumeRun")
  /// The approval whose automatic resume started this run, if one did (MOTIR-7710).
  resumedByGate    GateResume[]               @relation("GateResumeResumedRun")

  @@unique([workspaceId, idempotencyKey])
  /// The run list and the `/runs/[id]` read: newest-first per project.
  @@index([workspaceId, startedAt(sort: Desc)])
  @@index([projectId, startedAt(sort: Desc)])
  /// The scope's own run history.
  @@index([scopeWorkItemId, startedAt(sort: Desc)])
  /// An agent's run history, newest first — My agents' LAST-run read per agent
  /// (MOTIR-7029). Two columns, so it never claims the partial unique index's
  /// `(agent_instance_id)` list (CLAUDE.md, the partial-index rule).
  @@index([agentInstanceId, startedAt(sort: Desc)])
  /// The abandoned-run reap's discovery read (MOTIR-1792): the oldest rows still
  /// `running`. Status-first, because `running` is a tiny minority of the table
  /// — the same shape `job_run`'s reap index has.
  @@index([status, startedAt])
  /// The lapse reap's discovery read (MOTIR-6528): running LOCAL runs whose last
  /// heartbeat is older than the lapse window. Status-first for the same reason
  /// as the index above.
  @@index([status, lastHeartbeatAt])
  @@map("dispatch_run")
}

/// A GATE THAT HELD A RUN (Story MOTIR-7701 · MOTIR-7703;
/// `docs/decisions/dispatch-run-record.md` AMENDMENT 2026-10-07).
///
/// When a run closes `gated`, the close DERIVES — server-side, for every reporter —
/// each approval gate that is `awaiting` on a card in the run's scope and is one of
/// the kinds a parent run's stoppers raise (`design_result`, `decision_approval`,
/// `decision_choice`, `decision_confirmation`, `manual_work`), and writes one row
/// per gate in the close's own transaction. No client names a gate: the runbook,
/// the CLI and a hosted container all get the same record. A `gated` close that
/// finds none writes none. The rows are what To resume and the auto-resume read.
model DispatchRunHeldGate {
  id            String           @id @default(cuid())
  /// Tenant of record — RLS does not traverse foreign keys.
  workspaceId   String           @map("workspace_id")
  dispatchRunId String           @map("dispatch_run_id")
  gateId        String           @map("gate_id")
  /// The card the gate is ON, captured at the close.
  workItemId    String           @map("work_item_id")
  /// The gate's kind, captured at the close — one of the five stopper kinds.
  kind          ApprovalGateKind
  createdAt     DateTime         @default(now()) @map("created_at")

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dispatchRun DispatchRun  @relation(fields: [dispatchRunId], references: [id], onDelete: Cascade)
  gate        ApprovalGate @relation(fields: [gateId], references: [id], onDelete: Cascade)
  workItem    WorkItem     @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  /// One row per gate per run.
  @@unique([dispatchRunId, gateId])
  /// The decide door's read: which gated runs does this gate hold?
  @@index([gateId])
  /// A card's held-run read.
  @@index([workItemId])
  @@index([workspaceId])
  @@map("dispatch_run_held_gate")
}

/// WHAT ONE APPROVAL DID ABOUT RESUMING A HOSTED RUN (Story MOTIR-7701 · MOTIR-7710).
/// A gated run on Motir's hosted agent resumes itself when a gate it stopped at is
/// approved: the `run/gate-resume.requested` job starts a hosted continue as the run's
/// dispatcher, and records here what it did. One row per approved gate, keyed on it —
/// a redelivered event writes nothing more. A run that was not hosted gets no row.
model GateResume {
  id           String                @id @default(cuid())
  /// Tenant of record — RLS does not traverse foreign keys.
  workspaceId  String                @map("workspace_id")
  /// The approved gate this attempt answers. Unique: one approval, one attempt.
  gateId       String                @unique @map("gate_id")
  /// The `gated` run the gate held.
  runId        String                @map("run_id")
  /// The hosted continue it started. `SET NULL`: the record outlives the run.
  resumedRunId String?               @map("resumed_run_id")
  outcome      GateResumeOutcome
  /// Why nothing started. Null exactly when `outcome` is `started`.
  skipReason   GateResumeSkipReason? @map("skip_reason")
  /// What the skipped line names — the dispatcher, the model, the repository, or the
  /// continue claim's refusal — captured when it was written.
  detail       String?
  createdAt    DateTime              @default(now()) @map("created_at")

  workspace  Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  gate       ApprovalGate @relation(fields: [gateId], references: [id], onDelete: Cascade)
  run        DispatchRun  @relation("GateResumeRun", fields: [runId], references: [id], onDelete: Cascade)
  resumedRun DispatchRun? @relation("GateResumeResumedRun", fields: [resumedRunId], references: [id], onDelete: SetNull)

  /// The To resume entry's line: a run's newest attempt.
  @@index([runId, createdAt])
  @@index([resumedRunId])
  @@map("gate_resume")
}

enum GateResumeOutcome {
  /// A hosted continue was started, as the gated run's dispatcher, with its model.
  started
  /// Nothing started; `skipReason` says why, and the run waits on To resume.
  skipped

  @@map("gate_resume_outcome")
}

/// Why an automatic resume did not start. The start-path refusals mean what
/// `DesignAutoRerunSkipReason`'s do.
enum GateResumeSkipReason {
  /// The run's dispatcher account no longer exists.
  dispatcher_gone
  /// The dispatcher can no longer edit the project.
  no_project_access
  ci_credits_exhausted
  out_of_credits
  credits_unavailable
  /// The run's model is not offered any more (or the run recorded none).
  model_not_offered
  models_unavailable
  repository_not_writable
  card_not_ready
  /// A continue already holds the run — another approval's resume, or a person's.
  already_resumed
  /// The continue claim refused it for another reason (`detail` names it).
  not_resumable

  @@map("gate_resume_skip_reason")
}

/// A GitHub INSTALLATION TOKEN handed to a hosted run (Story MOTIR-683 · MOTIR-6449;
/// `docs/decisions/hosted-run-runs-the-cli-as-the-app.md` §5).
///
/// One row per token minted: a run spans one or more App installations, and it
/// asks for fresh tokens through its git-credential route for as long as it runs
/// (GitHub fixes an installation token's life at one hour). The row exists so the
/// end path can REVOKE every token the run was handed — `DELETE /installation/token`
/// authenticates with the token itself, so a token nobody kept cannot be revoked.
///
/// The token is stored ENCRYPTED (`lib/github/tokenCrypto.ts`), never in the clear,
/// and the rows are deleted once revoked. Nothing reads it back except the revoke.
model DispatchRunGitCredential {
  id             String   @id @default(cuid())
  /// Denormalized from the run for RLS, which does not traverse the FK.
  workspaceId    String   @map("workspace_id")
  dispatchRunId  String   @map("dispatch_run_id")
  /// Which App minted it: `motir-studio` (a Motir-created repository) or
  /// `motir-integration` (a connected one). A closed union in
  /// `lib/github/runGitCredential.ts`; a string for the reason `seedSource` is one.
  app            String
  /// GitHub's numeric installation id (as a string — never do math on it).
  installationId String   @map("installation_id")
  /// The `owner/name` of every repository the token was narrowed to.
  repositories   String[]
  tokenEncrypted String   @map("token_encrypted")
  /// GitHub's own expiry for the token. A token past it is dead and is not revoked.
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dispatchRun DispatchRun @relation(fields: [dispatchRunId], references: [id], onDelete: Cascade)

  @@index([dispatchRunId])
  @@index([workspaceId])
  @@map("dispatch_run_git_credential")
}

/// One LEG — one card this run owns. The model the first decomposition did not
/// have, and the reason it could not express a scoped or batch run.
///
/// A SKIPPED card gets a leg (ADR Q1): the skip and its reason is the most
/// useful thing on a run page and the only place it can live. Nothing else in
/// the product records a card a run deliberately did NOT take.
model DispatchRunCard {
  id            String @id @default(cuid())
  /// Denormalized from the run for RLS, which does not traverse the FK.
  workspaceId   String @map("workspace_id")
  dispatchRunId String @map("dispatch_run_id")

  /// `SET NULL` — a run's history outlives a deleted card, and every read and
  /// every renderer must render that leg rather than throw. `dispatchRunCard`'s
  /// own tests pin the null arm.
  workItemId  String? @map("work_item_id")
  /// The card's key AS THE RUN SAW IT ("MOTIR-1791"), so a leg whose work item
  /// is gone still says which card it was. Same reasoning as `scopeLabel`.
  workItemKey String? @map("work_item_key")

  /// THE RUN'S OWN ORDER, stored rather than re-derived. A client must never
  /// recompute dispatch order from the dependency graph: the order is a fact
  /// about what the run DID, and the graph it came from moves underneath it.
  position Int

  disposition DispatchCardDisposition @default(queued)
  /// Non-null EXACTLY when `disposition = skipped` — a CHECK constraint in the
  /// migration, not a convention, because a skip whose reason is null is the one
  /// row on the page that says nothing.
  skipReason  DispatchSkipReason?     @map("skip_reason")

  /// The session branch the leg's work was integrated onto, when it was. It
  /// belongs HERE and not on the run: a card carries the session lineage, and
  /// one run can touch more than one repository's branch.
  sessionBranch String? @map("session_branch")

  startedAt DateTime? @map("started_at")
  endedAt   DateTime? @map("ended_at")
  /// The agent process's exit code, when one ran.
  exitCode  Int?      @map("exit_code")
  /// The agent's SELF-REPORTED model for this leg (MOTIR-7502), taken from the
  /// leg's `agent_exited` event under `normalizeReportedModel`
  /// (`lib/dispatchRuns/reportedModel.ts`). Null when the agent reported none —
  /// NEVER inferred from the agent name, the run's `model` or anything else.
  /// Readers take THE LEG'S model, else the run's (`dispatch-run-record.md`).
  model     String?   @map("model")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dispatchRun DispatchRun @relation(fields: [dispatchRunId], references: [id], onDelete: Cascade)
  workItem    WorkItem?   @relation(fields: [workItemId], references: [id], onDelete: SetNull)

  events         DispatchRunEvent[]
  /// The run-found report made on this leg, when its runner stopped on an
  /// unbuildable target (MOTIR-6282). At most one — the row is unique on the leg.
  runFoundReport RunFoundReport?

  /// One leg per card per run.
  @@unique([dispatchRunId, workItemId])
  /// The run view's read, in the run's own order.
  @@index([dispatchRunId, position])
  /// A card's run history.
  @@index([workItemId, createdAt(sort: Desc)])
  @@index([workspaceId])
  @@map("dispatch_run_card")
}

/// The ordered event log. RUN-scoped when `dispatchRunCardId` is null,
/// CARD-scoped when it is set — one stream the surface reads to render either,
/// rather than two tables that have to be merged in the client.
model DispatchRunEvent {
  id            String @id @default(cuid())
  workspaceId   String @map("workspace_id")
  dispatchRunId String @map("dispatch_run_id")

  /// Null for a RUN-scoped event. `CASCADE`, like the run itself: an event
  /// cannot outlive the leg it describes.
  dispatchRunCardId String? @map("dispatch_run_card_id")

  /// MONOTONIC PER RUN, and the stream's resume cursor. ⚠️ Every read orders by
  /// this and NEVER by `createdAt`: two events written in the same millisecond
  /// have no order at all under a timestamp, and the SSE stream's whole contract
  /// is "give me everything after `seq`".
  seq  Int
  kind DispatchEventKind

  /// Structured detail for the event — the claim outcome, the exit code, the
  /// verdict. Never a log body.
  data Json?
  /// THE OPT-IN LOG BODY (ADR Q4), and the only field on any of these models
  /// that can carry content from the operator's machine. Null unless the run was
  /// started with `--report-log`. Bounded at INGEST (16 KiB) and nulled by the
  /// 30-day retention sweep — both MOTIR-1792's.
  body String?

  /// Who wrote THIS event (MOTIR-7450, `agent-reported-runs.md` §3): `agent` for an
  /// event written through `report_action`, `cli` for every other writer — so a CLI
  /// run can carry the agent's own account of its steps without the two being confused.
  reportedBy DispatchRunReporter @default(cli) @map("reported_by")

  createdAt DateTime @default(now()) @map("created_at")

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dispatchRun DispatchRun      @relation(fields: [dispatchRunId], references: [id], onDelete: Cascade)
  card        DispatchRunCard? @relation(fields: [dispatchRunCardId], references: [id], onDelete: Cascade)

  /// The ordering guarantee AND the append's idempotency key: a redelivered
  /// batch converges on the rows it already wrote.
  @@unique([dispatchRunId, seq])
  /// The tailing read — `WHERE dispatch_run_id = ? AND seq > ? ORDER BY seq`.
  @@index([dispatchRunId, seq])
  /// A card's own slice of the stream.
  @@index([dispatchRunCardId, seq])
  @@index([workspaceId])
  @@map("dispatch_run_event")
}

/// Which CLI command opened the run. `motir run <key>` and `motir run <scope>`
/// share a word and are different runs.
enum DispatchCommand {
  next
  run
  run_scope
  batch
  auto
  /// `motir fix <key>` (MOTIR-5464) — a REPAIR of an `implemented` card's red pull
  /// requests. Opened by the server's repair claim, not by the CLI's own open: the
  /// open `fix` run IS the one-repair-at-a-time lock, and it writes no status.
  fix
  /// `motir continue <key>` (MOTIR-6532) — a TAKEOVER of a work item whose last run
  /// DIED. Opened by the server's continue claim, like `fix`: the open `continue`
  /// run IS the one-continue-at-a-time lock, and it writes no status.
  continue
  /// A hosted REVIEW run (Story MOTIR-1626; `hosted-agent-run.md` §8) — reads a green
  /// card's pull requests against the card and returns ONE verdict to its
  /// `agent_review` gate. It makes no to-do claim, pushes nothing and writes no status.
  review

  @@map("dispatch_command")
}

/// WHERE the run executed. One table, two writers.
enum DispatchRunOrigin {
  /// A BYOK run on the operator's own machine, under their own key.
  local
  /// 9.1.7's container, on Motir's infrastructure.
  hosted
  /// A run inside one of the developer's own agents (MOTIR-7023,
  /// `agent-instance-run.md` §5): started from Motir, on Motir's machine, with
  /// the developer's own coding agent and no gateway key. `agentInstanceId`
  /// names the agent.
  instance

  @@map("dispatch_run_origin")
}

enum DispatchRunStatus {
  running
  succeeded
  failed
  cancelled
  /// What the abandoned-run reap writes. Never reported by a client, because a
  /// process that died cannot report anything — and `running` is the most
  /// reassuring possible way to render a dead run.
  timed_out

  @@map("dispatch_run_status")
}

/// Why the run ended. The union of `autoLoop.ts`'s `StopReason` and
/// `batchPlan.ts`'s `BatchStopReason`, plus `abandoned`, which neither can
/// report. `replanned` stays distinct from `halted` because a re-plan is a
/// CORRECT outcome that exits 0.
enum DispatchStopReason {
  /// The ready set is drained (`motir auto`).
  drained
  /// Every card the run planned to work was attempted. Also the single-card
  /// `next` / `run`, which has no loop.
  completed
  max
  halted
  interrupted
  replanned
  /// A between-iteration gate said stop (`motir batch`).
  gated
  /// Written by the reap, never by a client.
  abandoned

  @@map("dispatch_stop_reason")
}

/// The LEG's state. `integrated` / `implemented` / `failed` / `replanned` are
/// `autoLoop.ts`'s `AutoOutcome` verbatim; `not_reached` is
/// `BatchSummary.notReached` — a card the snapshot took and the run never got
/// to, which is neither a skip (nothing decided to leave it out) nor a failure
/// (nothing ran).
enum DispatchCardDisposition {
  queued
  running
  integrated
  implemented
  failed
  replanned
  skipped
  not_reached

  @@map("dispatch_card_disposition")
}

/// Why a card was left out. The union of `SkipRecord.reason` and
/// `SnapshotSkipReason`.
enum DispatchSkipReason {
  needs_planning
  needs_human
  claim_refused
  blocked_in_scope
  /// Ready ONLY via an integrated-awaiting-review dependency, so it cannot ship
  /// a pull request against `main`.
  integrated_dep
  /// The card's agent ran and REFUSED it. Distinct from the `replanned`
  /// disposition: `batch` records a skip because its snapshot implemented
  /// nothing, `auto` records a card whose agent ran.
  replan_submitted
  checkout_unavailable

  @@map("dispatch_skip_reason")
}

/// The CLOSED event vocabulary, derived from the shipped lifecycle at
/// `origin/main` 435bce9bd and enumerated in the ADR. Every renderer must be
/// TOTAL over it — a `switch` with no `default` arm — so adding a member is a
/// type error at every render site rather than a blank cell in production.
enum DispatchEventKind {
  // ── RUN-scoped (`dispatch_run_card_id` is null) ──────────────────────────
  run_opened
  scope_claimed
  snapshot_frozen
  session_pr
  plan_approved
  run_closed

  // ── CARD-scoped ──────────────────────────────────────────────────────────
  card_claimed
  card_skipped
  checkout_ready
  prompt_issued
  agent_started
  agent_exited
  leg_verdict
  delivery_linked
  /// What THIS RUN observed of CI, which is not the card's CI state — that is
  /// the delivery set's, derived once by `derivePrCiState`.
  ci_verdict
  ci_fix_attempt
  ci_gave_up
  card_settled
  /// The opt-in log body.
  log

  // ── What the run PRODUCED, beyond code (MOTIR-3981) ──────────────────────
  /// A `kind: 'bug'` work item was created while this leg was open.
  /// ⚠️ CARD-scoped, and — with `plan_submitted` — one of only two members the
  /// CLI reporter never emits: the id exists only server-side, so the SERVICE
  /// that performs the write appends it
  /// (`run-findings-protocol.md` Q5, `dispatch-run-record.md` AMENDMENT 1).
  bug_filed
  /// A plan-change job produced a plan while this leg was open — the plan a
  /// person must still decide on, as distinct from the RUN-scoped
  /// `plan_approved` a run decided for itself.
  plan_submitted
  /// The runner stopped because its target was UNBUILDABLE and reported it
  /// through `report_unbuildable_target` (MOTIR-5544 · MOTIR-6282,
  /// `run-found-trigger-dispatched-path.md`). The event records what the report
  /// concluded on EVERY arm that reaches a leg — the verdict, and the planning
  /// bug when one was filed.
  /// ⚠️ SERVER-WRITTEN, like `bug_filed` / `plan_submitted`: the report SERVICE
  /// appends it, and the CLI reporter NEVER emits it — the v1 ingest refuses it,
  /// so a client with a run token cannot forge a report the server never made.
  unbuildable_reported
  /// A REVIEW run's verdict (MOTIR-6821; `hosted-agent-run.md` §8.4,
  /// `approval-gates.md` §12.5) — every verdict the run submitted, the one that
  /// decided the `agent_review` gate AND a late one that decided nothing, naming the
  /// verdict, the version it was about and what became of it. It is also what makes a
  /// run's verdict ONE: a run holding one is refused a second.
  /// ⚠️ SERVER-WRITTEN, like `unbuildable_reported`: the verdict route's service
  /// appends it, and the v1 ingest refuses it, so a run token cannot forge one.
  review_verdict
  /// A run BUILT THROUGH a card whose plan was wrong only about the HOW and recorded
  /// each discrepancy through `record_run_discrepancy` (MOTIR-8655,
  /// `A run builds through a wrong HOW — the discrepancy record`, decision page
  /// MOTIR-8654). CARD-scoped, one per leg; `data` is a POINTER only
  /// (`{ commentId, pointCount, dispatchRunCardId }`) — the text lives in the card comment.
  /// ⚠️ SERVER-WRITTEN, like `unbuildable_reported`: the discrepancy service appends it in
  /// the same transaction as the comment, and the v1 ingest refuses it, so a run token
  /// cannot forge one.
  discrepancy_recorded

  /// One step the agent says it is about to take, in one line of at most 500
  /// characters (`agent-reported-runs.md` §3) — written through `report_action`.
  agent_action

  @@map("dispatch_event_kind")
}

/// Who reports a run, or an event (MOTIR-7450, `agent-reported-runs.md` §1).
enum DispatchRunReporter {
  cli
  agent

  @@map("dispatch_run_reporter")
}

/// How the run-found report on one leg concluded (MOTIR-6282,
/// `run-found-trigger-dispatched-path.md`). One member per arm that REACHES a
/// leg — the no-open-leg arm writes no row, so it has no member here.
enum RunFoundReportOutcome {
  /// The target was never shaped by an approved plan.
  no_plan
  /// The approving plan was not written by Motir's own planner
  /// (`Plan.authorSource != native`) — only a motir-ai plan ever fires a bug.
  not_native
  /// The target was edited after its approving plan approved it.
  changed
  /// A native plan, unchanged since approval — a planning bug was filed.
  filed

  @@map("run_found_report_outcome")
}

/// THE RUN-FOUND REPORT's filing row (MOTIR-5544 · MOTIR-6282) — one per
/// stopped leg, keyed by the `DispatchRunCard` id, inserted and LOCKED before
/// any planning bug is filed, so a retried report files at most one bug. The
/// `job_dlq_standing_filing` pattern (MOTIR-5869), mirrored.
///
/// ⚠️ SYSTEM-ADMIN ONLY under RLS, deliberately against the tenant-table
/// default: the row is MOTIR's record of what it filed into its own project,
/// not the tenant's — it carries a key in Motir's project and nothing a tenant
/// reads. `workspaceId` records the leg's tenant; it is not a policy arm.
model RunFoundReport {
  id                      String                 @id @default(cuid())
  /// The leg the report was made on — the idempotency key.
  dispatchRunCardId       String                 @unique @map("dispatch_run_card_id")
  /// The leg's tenant, recorded. No FK: the row is not the tenant's.
  workspaceId             String                 @map("workspace_id")
  /// Null until the report's service decides; set on every arm it reaches.
  outcome                 RunFoundReportOutcome?
  /// The planning bug filed into Motir's meta project, on `filed`. NO FK — it
  /// lives in another workspace, the reason `job_dlq_standing_filing`'s
  /// identifier is text.
  filedWorkItemId         String?                @map("filed_work_item_id")
  filedWorkItemIdentifier String?                @map("filed_work_item_identifier")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")

  dispatchRunCard DispatchRunCard @relation(fields: [dispatchRunCardId], references: [id], onDelete: Cascade)

  @@map("run_found_report")
}

/// ═══════════════════════════════════════════════════════════════════════════
/// PUBLIC ADDRESSES — Story MOTIR-3878 · Subtask MOTIR-4209
/// `docs/decisions/public-tenant-addresses.md` is the record; this model is its
/// §3 / §4 / §7 / §8 answers expressed as a table.
/// ═══════════════════════════════════════════════════════════════════════════

/// WHAT an address is. The ADR gives an address exactly two shapes (§3, §4), and
/// the alias is the third row-kind the never-released rename needs (§8):
///
///   * `workspace_subdomain`       — `<label>.<base>`, owned by the WORKSPACE.
///                                   Every public project under it answers at
///                                   `<label>.<base>/<identifier>`. Exactly one
///                                   live per workspace; `projectId` is NULL.
///   * `workspace_subdomain_alias` — a label renamed away from. Kept FOR EVER,
///                                   always a redirect, never released (§8).
///                                   Also owned by the workspace.
///   * `custom_domain`             — a hostname the customer owns, serving ONE
///                                   project at its root (§4). `projectId` set.
///
/// The two owning shapes are why `projectId` is nullable and `workspaceId` is
/// not: a subdomain has no project, and every row has a workspace.
enum PublicAddressKind {
  workspace_subdomain
  workspace_subdomain_alias
  custom_domain
}

/// WHERE an address is in its life. This enum IS the state checklist every later
/// card works from — the certificates adapter (MOTIR-4210) maps Fly's `check`
/// response onto it, the lifecycle (MOTIR-4216) drives the transitions, the job
/// (MOTIR-4219) refreshes it from the platform, and the pane (MOTIR-4229) draws
/// one row per value. **Add nothing the ADR did not name, and drop nothing** —
/// `design/projects/public-address.mock.html` panel 5 draws all nine, and a
/// tenth value would ship a state with no drawn meaning and no offered action.
///
/// Two are subdomain states and seven are customer-domain states; nothing
/// enforces that split in the type, so the repository's create methods are what
/// keep a subdomain out of `pending_certificate`.
enum PublicAddressStatus {
  /// A workspace subdomain that resolves and serves. Covered by the wildcard
  /// `*.<base>` certificate (ADR §6), so claiming one issues nothing.
  active
  /// A retired subdomain label. Redirects to the live one, permanently.
  alias
  /// Added; the `_motir-verify` TXT has not been seen. No certificate requested
  /// — the ADR §5 order is strict about this, and it is a security property
  /// rather than a nicety: a certificate must never be requested for a hostname
  /// whose owner has not proven write access to the zone.
  unverified
  /// The TXT lookup is in flight.
  verifying
  /// Ownership proven; the certificate has been requested from Fly.
  pending_certificate
  /// The certificate is live and the domain serves. Fly renews it; we surface it.
  issued
  /// Issuance failed. `failureReason` is ALWAYS set alongside — a `failed` with
  /// no reason is not something a customer can act on.
  failed
  /// The certificate lapsed and renewal did not succeed.
  expired
  /// The certificate was withdrawn.
  revoked
}

/// ONE address, of either shape (ADR §3, §4). A project has many; a workspace
/// has many.
///
/// ── `hostname` is GLOBALLY unique, and that is the whole concurrency story ──
///
/// Not `@@unique([workspaceId, hostname])`: a hostname resolves to exactly one
/// owner on the public internet, so two workspaces claiming one name is not a
/// tenancy question, it is an impossibility. The global unique is therefore both
/// the correctness constraint AND the race arbiter — two concurrent claims of
/// one label produce one winner and one `P2002`, which the repository rethrows
/// as a typed `HostnameTakenError` (the `IdentifierTakenError` precedent in
/// `projectsService.changeKey`). There is no count-then-write to lose.
///
/// It is also what makes §8's never-released rule hold for a RENAME with no
/// extra machinery: a retired label keeps its row, the row keeps the name, and
/// nobody else can take it. Modelled on `ProjectKeyAlias` one level down, where
/// `@@unique([workspaceId, identifier])` reserves a retired project key against
/// the live namespace.
///
/// ⚠️ AMENDED (Bug MOTIR-4366) — THAT MECHANISM COVERS THE RENAME AND NOT THE
/// WORKSPACE DELETE, and the precedent above is exactly what hid the gap.
/// `ProjectKeyAlias`'s uniqueness is workspace-SCOPED, so cascading its slot
/// away with its tenant costs nothing; this `hostname` unique is GLOBAL, and
/// `workspaceId` below is `onDelete: Cascade` — so a workspace delete released
/// the live subdomain and every retained alias to whoever asked next, on the one
/// path that runs unattended (the account-erasure sweep). **The cascade is
/// deliberately KEPT**, and the reservation now outlives it in
/// {@link PublicHostnameReservation}, which holds a DIGEST rather than the
/// hostname so the erasure obligation and §8 can both be satisfied. See that
/// model, and §8's AMENDMENT 1.
///
/// ── `workspaceId` is denormalized, deliberately ──
///
/// Every row carries it, including a `custom_domain` whose project already
/// implies it, so the RLS tenancy gate is a direct
/// `workspace_id = app.workspace_id` comparison with no join — the pattern
/// `project_membership`, `work_item` and `project_key_alias` all use.
model PublicAddress {
  id                String              @id @default(cuid())
  workspaceId       String              @map("workspace_id")
  /// NULL for a subdomain (it names the workspace); set for a customer domain
  /// (it names one project).
  projectId         String?             @map("project_id")
  hostname          String              @unique
  kind              PublicAddressKind
  status            PublicAddressStatus
  /// The `_motir-verify.<host>` TXT value. Custom domains only — a subdomain of
  /// our own base needs no ownership proof.
  verificationToken String?             @map("verification_token")
  /// When the platform was last asked about this address (MOTIR-4219). Also the
  /// job's sweep cursor, which is why it is half of an index.
  lastCheckedAt     DateTime?           @map("last_checked_at")
  issuedAt          DateTime?           @map("issued_at")
  /// Always set when `status` is `failed` — see the enum's note.
  failureReason     String?             @map("failure_reason")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation("ProjectPublicAddresses", fields: [projectId], references: [id], onDelete: Cascade)

  /// The back-relation of `Project.primaryAddress`. Modelled on BOTH sides per
  /// the FK-`@relation` rule in `CLAUDE.md`: a raw-SQL-only FK puts the schema
  /// graph and the migration-built database in permanent drift, and every later
  /// `migrate dev` then re-proposes dropping it.
  primaryOf Project[] @relation("ProjectPrimaryAddress")

  @@index([workspaceId])
  @@index([projectId])
  /// The certificate job's sweep (MOTIR-4219): "every address in state X not
  /// checked since T". Both columns, in that order, because the job filters on
  /// the state and orders on the clock.
  @@index([status, lastCheckedAt])
  @@map("public_address")
}

/// A hostname held OUT of the global namespace after the row that held it is
/// gone — Bug MOTIR-4366, amending ADR §8.
///
/// §8 decides a subdomain is never released, and `PublicAddress` implements that
/// with the `hostname` unique index: a retired label keeps its row, the row keeps
/// the name. That mechanism has exactly one hole, and it is the hole the
/// `ProjectKeyAlias` precedent it was ported from cannot have. `ProjectKeyAlias`
/// is `@@unique([workspaceId, identifier])` — its slot is scoped BY the tenant,
/// so cascading it away with the tenant costs nothing. `PublicAddress.hostname`
/// is `@unique` GLOBALLY, and `workspace_id` is `onDelete: Cascade`, so deleting
/// a workspace hands its live subdomain and every retained alias back to whoever
/// asks next. A pattern lifted across a scope boundary looks identical at the
/// call site and has inverted consequences.
///
/// ── WHY A SECOND TABLE AND NOT A TOMBSTONED `PublicAddress` ────────────────
///
/// The alternative was to keep the address row and null its tenancy. It was
/// rejected on the ERASURE half rather than on the schema half: the retained
/// value would still be the literal hostname, which can itself be the personal
/// datum (`jane-smith.<base>`), and `workspace_id` is the RLS tenancy key — a
/// nullable one would make every policy on the table read a NULL comparison and
/// every `workspaceId: string` in the codebase a lie. This table keeps
/// `PublicAddress` exactly as it is, cascade included, so erasure stays simple
/// and complete, and holds the ONE fact that must outlive it.
///
/// ── NO FOREIGN KEY, DELIBERATELY ───────────────────────────────────────────
///
/// `retiredFromWorkspaceId` is a NAME for something that is already gone by the
/// time anyone reads it, not a pointer to something that must still exist — the
/// same reasoning, and the same shape, as `CodeGraphOffboarding`'s tenant
/// coordinates, whose own comment records that a row surviving the workspace
/// cascade is the point. A relation here would re-introduce the very cascade
/// this table exists to survive.
///
/// It is kept for two things and nothing else: the RLS `WITH CHECK` below has a
/// column to compare against, so a tenant can only reserve names on its own
/// behalf; and an operator answering "why is this name held?" has somewhere to
/// start. It is an opaque, orphaned identifier — the workspace it names no
/// longer exists and nothing joins to it.
model PublicHostnameReservation {
  id String @id @default(cuid())

  /// SHA-256 of the normalised hostname under a versioned domain-separation
  /// prefix — `lib/publicAddresses/hostnameReservation.ts` is the transform, and
  /// the only one. The digest and NOT the hostname, because Article 17 asks for
  /// the personal datum to be gone and §8 asks for the name to be held for ever;
  /// a value that can be TESTED and not READ BACK is what satisfies both, and
  /// testing a candidate is the only thing a claim ever needs to do.
  ///
  /// `@unique` for the same reason `public_address.hostname` is: it makes the
  /// reserve idempotent (a resumed erasure sweep re-runs the write and inserts
  /// nothing) without a count-then-write to lose.
  hostnameHash String @unique @map("hostname_hash")

  /// The workspace that retired it. NOT a relation — see above.
  ///
  /// ⚠️ AMENDED (§8 Amendment 2, MOTIR-4454). This read "the workspace whose
  /// DELETION retired it", which was true when `workspacesService.deleteWorkspace`
  /// was the only writer. A workspace may now RELEASE its own subdomain, which
  /// writes this column while the workspace is very much alive — so the id here
  /// is an orphan only on the delete path, and the count of a LIVING workspace's
  /// rows is what §8's rename cap reads
  /// (`publicHostnameReservationRepository.countForWorkspaceInTx`).
  retiredFromWorkspaceId String @map("retired_from_workspace_id")

  retiredAt DateTime @default(now()) @map("retired_at")

  @@map("public_hostname_reservation")
}

/// A FOLDER — a named, nestable place in a project's tree that carries no
/// workflow (Epic MOTIR-5307 · Story MOTIR-5308 · MOTIR-5312).
///
/// It is its OWN record, not a work item: no key, no status, no dependency
/// edges, no assignee, type, estimate or sprint. Nothing that reads work items
/// reads this table, which is what keeps the board, backlog, ready list and
/// reports unchanged by construction rather than by a list of exclusions.
///
/// A work item is filed into one through `WorkItem.folderId`, never through
/// `parentId`. A folder's own parent is another folder or the project root;
/// a folder never sits under a work item.
///
/// Sibling names are unique case-insensitively, at the root as inside a folder:
/// the hand-written expression index `folder_sibling_name_key`, which Prisma
/// cannot express (see the migration). Tenancy and a cycle backstop are
/// triggers; RLS is the `work_item` policy pair.
model Folder {
  id             String   @id @default(cuid())
  workspaceId    String   @map("workspace_id")
  projectId      String   @map("project_id")
  parentFolderId String?  @map("parent_folder_id")
  name           String   @db.Text
  // Fractional index among siblings (lib/workItems/positioning.ts).
  position       String   @db.Text
  createdById    String   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  workspace               Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project                 Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // NoAction, as `WorkItem.parent` is: a folder with child folders cannot be
  // deleted until the service has moved them up.
  parentFolder            Folder?    @relation("FolderParent", fields: [parentFolderId], references: [id], onDelete: NoAction)
  childFolders            Folder[]   @relation("FolderParent")
  createdBy               User       @relation("FolderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  workItems               WorkItem[] @relation("WorkItemFolder")
  pages                   Page[]     @relation("PageFolder")
  /// The project whose bug destination this folder is, if any (MOTIR-4934) —
  /// at most its own project, by `trg_project_bug_destination_folder_tenancy`.
  bugDestinationOf        Project[]  @relation("ProjectBugDestinationFolder")
  /// The project whose PLANNER-bug destination this folder is, if any
  /// (MOTIR-5820) — at most its own project, by
  /// `trg_project_planner_bug_destination_folder_tenancy`.
  plannerBugDestinationOf Project[]  @relation("ProjectPlannerBugDestinationFolder")

  @@index([projectId, parentFolderId, position])
  @@index([workspaceId])
  @@map("folder")
}

/// An error-monitor GRANT — one provider installation, held by one workspace
/// (Story MOTIR-4926 · MOTIR-5258).
///
/// Modelled on `GithubInstallation` ↔ `GithubRepo`, and for the same reason that
/// pair is split: a provider authorises at the ORGANISATION tier (Sentry's
/// permissions are scoped to the org), so ONE grant covers every project in that
/// org. This row is therefore the only one that holds a secret, and the binding
/// below holds none.
///
/// ⚠️ THE CREDENTIAL LIVES HERE AND NOWHERE ELSE. Storing a copy per bound
/// project would mean N copies of one secret, N things to rotate, and N chances
/// for one of them to be the stale one.
// PAGES — a project's documents (Epic MOTIR-5746 · Story MOTIR-5752 · MOTIR-7273).
//
// `docs/decisions/pages.md` §3–§4. `bodyState` is the CANONICAL body — the
// encoding of a Yjs document (`Y.encodeStateAsUpdate`), the schema's first
// `bytea` — and `bodyJson` / `bodyMarkdown` / `bodyText` are DERIVED from it in
// the same transaction as every save; nothing reads a derived column to produce
// the canonical one. `revision` counts saves, 1 at creation.
//
// The tree: a page sits under a page (`parentPageId`) OR in a folder
// (`folderId`), never both (CHECK `page_parent_xor_folder`); both null is the
// project root. `ancestorPageIds` holds the page ids root-first, excluding the
// page itself, and the CHECK `page_depth_limit` caps it below 10 —
// `PAGE_DEPTH_LIMIT` levels. Tenancy of the parent page and the folder, and the
// no-cycle rule, are SECURITY DEFINER triggers in the migration; RLS is the
// `folder` pair. Prisma does not model CHECK constraints or triggers.
model Page {
  id              String    @id @default(cuid())
  workspaceId     String    @map("workspace_id")
  projectId       String    @map("project_id")
  title           String    @default("") @db.Text
  parentPageId    String?   @map("parent_page_id")
  folderId        String?   @map("folder_id")
  position        String    @db.Text
  ancestorPageIds String[]  @default([]) @map("ancestor_page_ids")
  bodyState       Bytes     @map("body_state")
  bodyJson        Json      @map("body_json")
  bodyMarkdown    String    @default("") @map("body_markdown") @db.Text
  bodyText        String    @default("") @map("body_text") @db.Text
  revision        Int       @default(1)
  createdById     String    @map("created_by_id")
  updatedById     String    @map("updated_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  // ARCHIVE (Story MOTIR-5755 · MOTIR-7417, `docs/decisions/pages.md` §7). Live:
  // `archivedAt` and `archiveRootId` both null; archived: both set (the
  // `page_archive_pairing` CHECK). `archiveRootId` is the page the member
  // archived — every sub-page that left with it carries the same id — and is
  // deliberately NOT a relation (a self-FK's SET NULL would break the pairing;
  // the same choice as `ancestorPageIds`). An archived page keeps its own
  // parent / folder / position: that IS where a restore returns it.
  //
  // ⚠️ Its two indexes are hand-written PARTIAL indexes and deliberately NOT
  // declared here: `page_archived_roots_idx` on `(project_id, archived_at DESC,
  // id DESC) WHERE archive_root_id = id` (the Archived pages keyset) and
  // `page_archive_root_idx` on `(archive_root_id) WHERE archive_root_id IS NOT
  // NULL` (one archive set). Prisma cannot express a `WHERE`; declaring either
  // as a plain `@@index` would make `migrate dev` build a NON-partial index from
  // an empty database. Neither shares a column list with an `@@index` below, so
  // the differ ignores both (the MOTIR-1960 rule).
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(3)
  archiveRootId   String?   @map("archive_root_id")
  archivedById    String?   @map("archived_by_id")

  workspace            Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project              Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentPage           Page?                     @relation("PageParent", fields: [parentPageId], references: [id], onDelete: NoAction)
  childPages           Page[]                    @relation("PageParent")
  // The page's images (MOTIR-7279) — attachments it owns from upload.
  attachments          Attachment[]
  folder               Folder?                   @relation("PageFolder", fields: [folderId], references: [id], onDelete: NoAction)
  createdBy            User                      @relation("PageCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy            User                      @relation("PageUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  // SET NULL: deleting the user forgets who archived the page, never that it is.
  archivedBy           User?                     @relation("PageArchiver", fields: [archivedById], references: [id], onDelete: SetNull)
  // The page's history (Story MOTIR-5754). Cascade: deleting a page takes them.
  versions             PageVersion[]
  // Decision publications of this page (Story MOTIR-5761). Cascade.
  decisionPublications DecisionPagePublication[]
  // The work items this page links (Story MOTIR-7565 · MOTIR-7571). Cascade.
  workItemLinks        PageWorkItemLink[]

  @@index([projectId, parentPageId, position, id])
  @@index([projectId, folderId, position, id])
  @@index([workspaceId])
  @@map("page")
}

// PAGE VERSIONS — a page's history (Story MOTIR-5754 · MOTIR-7382).
//
// `docs/decisions/pages.md` §6. A version is a SNAPSHOT of the page body
// (`bodyState` + `bodyMarkdown`) by one author, coalesced per author over
// `PAGE_VERSION_WINDOW_MS` and capped at `PAGE_VERSION_CAP` by `@motir/pages`.
// `number` is per page and never reused (`max + 1`, even after pruning).
//
// A RESTORE row names its source twice: `restoredFromVersionId` (SET NULL when
// the source is pruned) and `restoredFromNumber`, which outlives the source so
// the row still reads "restored from vN, no longer kept". A CHECK keeps the
// number present whenever the id is. Cotenancy of the page and the restore
// source is a SECURITY DEFINER trigger; RLS is the `page` pair.
model PageVersion {
  id                    String    @id @default(cuid())
  workspaceId           String    @map("workspace_id")
  projectId             String    @map("project_id")
  pageId                String    @map("page_id")
  number                Int
  authorId              String    @map("author_id")
  bodyState             Bytes     @map("body_state")
  bodyMarkdown          String    @map("body_markdown") @db.Text
  startedAt             DateTime  @map("started_at")
  savedAt               DateTime  @map("saved_at")
  restoredFromVersionId String?   @map("restored_from_version_id")
  restoredFromNumber    Int?      @map("restored_from_number")
  // THE MARKS (Story MOTIR-5761 · MOTIR-7428, `docs/decisions/pages.md`
  // AMENDMENT 3). SEALED by a decision publish: no save extends it, the cap never
  // prunes it. FROZEN by the gate that approved it (`frozenByGateId`): also its
  // page cannot be deleted while it holds one. The CHECK
  // `page_version_frozen_requires_sealed` keeps a frozen version sealed.
  sealedAt              DateTime? @map("sealed_at")
  frozenAt              DateTime? @map("frozen_at")
  frozenByGateId        String?   @map("frozen_by_gate_id")

  workspace            Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project              Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  page                 Page                      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  author               User                      @relation("PageVersionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  restoredFrom         PageVersion?              @relation("PageVersionRestore", fields: [restoredFromVersionId], references: [id], onDelete: SetNull)
  restoredInto         PageVersion[]             @relation("PageVersionRestore")
  frozenByGate         ApprovalGate?             @relation("PageVersionFrozenByGate", fields: [frozenByGateId], references: [id], onDelete: SetNull)
  // The decision publications that name this version (MOTIR-7428).
  decisionPublications DecisionPagePublication[]

  @@unique([pageId, number])
  @@index([workspaceId])
  @@map("page_version")
}

// DECISION PAGE PUBLICATIONS (Story MOTIR-5761 · MOTIR-7428).
//
// `docs/decisions/approval-gates.md` §8 NINTH AMENDMENT, clause 1: one row per
// `publish_decision_page` — which version of which page a work item published,
// by whom and when. Append-only; the NEWEST row for a work item is its published
// page. Cotenancy (page, version and work item in the row's project, the version
// of the row's page) is a SECURITY DEFINER trigger; RLS is the `page` pair.
//
// `pageVersion` is NoAction, not Restrict: it refuses deleting a published
// version on its own, but is checked at the end of the statement, so a page,
// project or workspace delete that cascades through both rows still succeeds.
model DecisionPagePublication {
  id            String   @id @default(cuid())
  workspaceId   String   @map("workspace_id")
  projectId     String   @map("project_id")
  workItemId    String   @map("work_item_id")
  pageId        String   @map("page_id")
  pageVersionId String   @map("page_version_id")
  publishedById String   @map("published_by_id")
  publishedAt   DateTime @default(now()) @map("published_at")

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItem    WorkItem    @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  page        Page        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageVersion PageVersion @relation(fields: [pageVersionId], references: [id], onDelete: NoAction)
  publishedBy User        @relation("DecisionPagePublisher", fields: [publishedById], references: [id], onDelete: Restrict)

  @@index([workItemId, publishedAt(sort: Desc)])
  @@index([pageVersionId])
  @@index([workspaceId])
  @@map("decision_page_publication")
}

// PAGE ↔ WORK ITEM LINKS (Epic MOTIR-5747 · Story MOTIR-7565 · MOTIR-7571).
//
// `docs/decisions/pages.md` §8.1. One row per `(page, work item, source)`:
// `mention` and `embed` are DERIVED from the page body on every save (the
// adapter's `replaceDerivedLinks`, in the save's transaction); `manual` is
// written by an explicit action and never touched by a body write. Page and work
// item share the row's project (the `trg_page_work_item_link_cotenancy`
// trigger); RLS is the `page` pair. `createdBy` is who FIRST linked it — a
// re-save that keeps a link keeps its row.
model PageWorkItemLink {
  id          String                 @id @default(cuid())
  workspaceId String                 @map("workspace_id")
  projectId   String                 @map("project_id")
  pageId      String                 @map("page_id")
  workItemId  String                 @map("work_item_id")
  source      PageWorkItemLinkSource
  createdById String?                @map("created_by_id")
  createdAt   DateTime               @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  page      Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  workItem  WorkItem  @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  // SET NULL: deleting the user forgets who linked it, never the link.
  createdBy User?     @relation("PageWorkItemLinkCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([pageId, workItemId, source])
  @@index([workItemId, pageId])
  @@index([workspaceId])
  @@map("page_work_item_link")
}

enum PageWorkItemLinkSource {
  mention
  embed
  manual
  description
  explanation

  @@map("page_work_item_link_source")
}

model MonitorInstallation {
  id String @id @default(cuid())

  /// Provider discriminator — "sentry" today, and the only implementation
  /// (`lib/monitors/registry.ts` resolves it). An unknown value is a typed error
  /// there, never a default member.
  provider String @default("sentry")

  /// The provider's OWN installation id, as a string — never do math on it.
  /// Sentry's `installationId` from the external-install redirect. UNIQUE: one
  /// row per provider installation, and the grant-exchange and refresh paths key
  /// on it. DISTINCT from `id`, the internal cuid PK.
  installationId String @map("installation_id")

  /// The workspace whose OWN grant this is. NOT NULL — unlike
  /// `GithubInstallation.workspaceId`, which is nullable only because Motir's
  /// shared PROVISIONING installation (MOTIR-1931) is owned by no tenant. There
  /// is no shared-installation case for a monitor: every grant is a customer
  /// authorising their own Sentry organisation, so the column that says whose it
  /// is can be required, and the RLS policy reads it directly.
  workspaceId String @map("workspace_id")

  /// The grant's access token, encrypted at rest by `lib/monitors/tokenCrypto.ts`
  /// (the shared AES-256-GCM `v1.<iv>.<tag>.<ct>` form). Only
  /// `monitorConnectionService` and the credential-lifecycle path read or write
  /// it, and no read path outside them returns the plaintext.
  accessTokenEncrypted String @map("access_token_encrypted")

  /// The grant's refresh token, encrypted the same way. Sentry's public
  /// integration issues BOTH — an access token that expires in eight hours and a
  /// refresh token to mint the next one — so both are persisted, exactly as the
  /// GitLab connection does for the same reason.
  refreshTokenEncrypted String @map("refresh_token_encrypted")

  /// When the stored access token expires. The refresh path reads it to decide
  /// when to refresh; eight hours after the exchange, for Sentry.
  tokenExpiresAt DateTime @map("token_expires_at")

  /// The grant's HEALTH — "connected" or "degraded". RECORDED, never derived: a
  /// revoked credential is a fact only a probe can learn, and the whole reason
  /// this epic exists (MOTIR-4918) is that a signal which stopped arriving looked
  /// exactly like a quiet week. The credential-lifecycle card (MOTIR-5261) is the
  /// only writer.
  health String @default("connected")

  /// The PROVIDER'S OWN reason for a `degraded` verdict, surfaced verbatim to a
  /// person on the settings surface. NULL while healthy. It is the provider's
  /// string and not ours: a re-worded reason is a reason nobody can act on.
  healthReason String? @map("health_reason")

  /// When the health above was last established. NULL until the first probe.
  healthCheckedAt DateTime? @map("health_checked_at")

  /// The single-flight LEASE on a token refresh (MOTIR-8184). Set in a short
  /// transaction before the provider call and cleared by the transaction that
  /// stores the rotated pair, so no transaction — and no row lock — is open while
  /// the provider is answering. A caller that finds a live lease waits for it
  /// rather than spending the same rotating refresh token a second time. A lease
  /// left behind by a process that died mid-call simply expires. NULL when no
  /// refresh is in flight.
  refreshLeaseUntil DateTime? @map("refresh_lease_until")

  /// When a refresh last went out and got NO ANSWER — a timeout or a dropped
  /// connection (MOTIR-8184). The provider may still have rotated the refresh
  /// token on its side, so the stored pair is left as it is and this records that
  /// the next refusal is most likely the consequence of that lost answer rather
  /// than the customer revoking the integration. Cleared by a successful refresh.
  refreshUncertainAt DateTime? @map("refresh_uncertain_at")

  /// When the provider PERMANENTLY refused this grant's refresh token — a 4xx
  /// answer such as Sentry's "Given refresh token does not exist" (MOTIR-8170).
  /// NULL while the refresh token is believed good. Set, the grant can never
  /// refresh again until a person re-authorises, so the reconciling poll skips
  /// every binding on it rather than spending a provider call and a warn line on
  /// each five-minute tick. A successful refresh and a re-authorisation both
  /// clear it. A timeout or a 5xx never sets it: those are retried next tick.
  refreshRevokedAt DateTime? @map("refresh_revoked_at")

  /// Per-provider context that carries NO secret — Sentry's organisation slug,
  /// so the room can say which org is connected without a provider call. Json?
  /// because the shape is the provider's; the discriminator above says how to
  /// read it.
  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Modelled on BOTH sides with the same action the migration SQL uses (the
  /// FK-`@relation` rule). Cascade: a deleted workspace takes its grants — and
  /// therefore its stored credentials — with it.
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connections MonitorConnection[]

  /// The provider's installation id is unique WITHIN a provider, not across the
  /// table: two providers may legitimately mint the same id. Scoping the
  /// constraint is what keeps a second provider purely additive.
  @@unique([provider, installationId])
  @@index([workspaceId])
  @@map("monitor_installation")
}

/// A BINDING between one Motir project and one monitored external project
/// (Story MOTIR-4926 · MOTIR-5258).
///
/// ⚠️ THIS TABLE IS THE SET. A team with a web app and a worker has two Sentry
/// projects; a monorepo has one; a service-oriented backend has N. So "how many
/// monitored projects does a Motir project have?" is a ROW COUNT, and the
/// degenerate case of one is a row — never a `sentryProjectId` column on
/// `Project`, which would be a schema migration, a settings-page rewrite and a
/// failure-model change the first time a customer has two services.
model MonitorConnection {
  id String @id @default(cuid())

  /// FK → MonitorInstallation.id (the internal cuid, NOT the provider's own
  /// installation id). The grant this binding was made on, and where its
  /// credential lives.
  installationId String @map("installation_id")

  /// The Motir project whose errors these are.
  projectId String @map("project_id")

  /// WHOSE this binding is — carried on the CHILD rather than joined through the
  /// parent grant, which is the shape `GithubRepo` was migrated TO
  /// (`prisma/migrations/20260731160000_github_repo_workspace_tenancy`). RLS does
  /// not traverse a foreign key, so a policy written as a correlated EXISTS over
  /// the parent is a per-row subquery on every read by every caller — measured at
  /// 3× on one unrelated test file (the org-read-arm lesson). This column is what
  /// lets the policy be a column comparison.
  workspaceId String @map("workspace_id")

  /// The provider's own id for the monitored project, as a string. The dedup key
  /// the unique index below is built on.
  externalProjectId String @map("external_project_id")

  /// The monitored project's human slug, as the provider reports it — what the
  /// settings row shows. Recorded rather than resolved: a room that has to call
  /// the provider to render a list cannot render one while the credential is
  /// degraded, which is the exact state it most needs to show.
  externalProjectSlug String @map("external_project_slug")

  // ── INGESTION STATE (Story MOTIR-4929 · Subtask MOTIR-5576) ─────────────────
  // What the reconciling poll reads and writes on its own binding. Every column
  // is nullable, and each NULL means something specific rather than "unknown".

  /// The lowest provider level that files a bug (`lib/monitors/levels.ts`).
  /// `null` means EVERY level qualifies — the shipped default.
  minimumLevel String? @map("minimum_level")

  /// The newest `lastSeen` the poll has fully reconciled. `null` means "read from
  /// this binding's `createdAt`" — the NEW-issue rule: nothing from before the
  /// binding is back-filled. Lowering `minimumLevel` resets it to `null`.
  lastSeenWatermark DateTime? @map("last_seen_watermark")

  /// The last poll's outcome — what the Monitoring room shows on the row, so a
  /// reconciler that stopped is visible where a person looks.
  lastPolledAt        DateTime? @map("last_polled_at")
  /// `ok` | `failed`; `null` = never polled.
  lastPollStatus      String?   @map("last_poll_status")
  lastPollError       String?   @map("last_poll_error")
  lastPollFiledCount  Int?      @map("last_poll_filed_count")
  /// When a poll last came back `ok`. Distinct from `lastPolledAt`, which moves on
  /// a FAILED poll too — so a failing row can still say when it last worked
  /// (the design delta, MOTIR-5575 §12). `null` = never succeeded.
  lastPollSucceededAt DateTime? @map("last_poll_succeeded_at")

  /// FK → User.id: the person who BOUND this monitored project, whose identity
  /// every bug it files is created as. `null` on rows bound before the column
  /// existed, and on a binder whose account is gone — the reconciler then records
  /// a named failure rather than substituting anyone.
  boundByUserId String? @map("bound_by_user_id")

  // ── SYNC STATE (Story MOTIR-4931 · Subtask MOTIR-5701) ──────────────────────
  // The two per-connection direction switches, and the most recent FAILED
  // resolve-back — what the Monitoring room shows on the row.

  /// Motir → monitor: resolve each linked issue when its bug reaches a
  /// done-category status. Defaults ON — the story's shipped default, so every
  /// connection bound before this column existed resolves on done after deploy.
  resolveOnDone Boolean @default(true) @map("resolve_on_done")
  /// Monitor → Motir: take a provider-side assignment onto the bug. Defaults ON
  /// (Linear's default, the plan's recorded assumption).
  syncAssignee  Boolean @default(true) @map("sync_assignee")

  /// The provider's own reason from the most recent FAILED resolve-back,
  /// verbatim. `null` = nothing has failed since the last success.
  lastSyncError                   String?   @map("last_sync_error")
  /// When that failure happened. `null` exactly when `lastSyncError` is.
  lastSyncErrorAt                 DateTime? @map("last_sync_error_at")
  /// The `KEY-<n>` of the bug whose resolve failed, so the row can link to it.
  /// `null` exactly when `lastSyncError` is.
  lastSyncErrorWorkItemIdentifier String?   @map("last_sync_error_work_item_identifier")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// All modelled on BOTH sides with the actions the migration SQL uses
  /// (the FK-`@relation` rule).
  installation MonitorInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  boundBy      User?               @relation("MonitorConnectionBinder", fields: [boundByUserId], references: [id], onDelete: SetNull)
  issues       MonitorIssue[]

  /// ⚠️ THE UNIQUENESS IS THE DATABASE'S, NOT THE READ'S. Binding a project is a
  /// check-then-write, and two authorisation returns can land at once — so the
  /// constraint is what makes exactly one win, and the repository surfaces the
  /// loser's collision as a typed `MONITOR_CONNECTION_ALREADY_EXISTS` refusal
  /// rather than a raw Prisma error. A count-then-write guard with no constraint
  /// behind it only fails under a warm pool.
  @@unique([projectId, installationId, externalProjectId])
  @@index([workspaceId])
  @@index([installationId])
  @@index([projectId])
  @@index([boundByUserId])
  @@map("monitor_connection")
}

/// ONE PROVIDER ISSUE, AS ONE BINDING HAS INGESTED IT (Story MOTIR-4929 ·
/// Subtask MOTIR-5576) — the link between an error monitor's issue and the `bug`
/// work item the reconciler filed for it, plus the recurrence facts a thin bug
/// and a later panel need.
///
/// ⚠️ THE DEDUP KEY IS THE PROVIDER'S ISSUE ID, NOT ITS FINGERPRINT. The
/// fingerprint is the provider's grouping decision and can change under us; the
/// issue id is stable, and is what the resolve-back call will need anyway.
model MonitorIssue {
  id String @id @default(cuid())

  /// FK → MonitorConnection.id — the binding that ingested it.
  connectionId String @map("connection_id")
  /// FK → Project.id — denormalised from the binding so a project-scoped read
  /// needs no join.
  projectId    String @map("project_id")
  /// WHOSE this row is — carried on the CHILD for the reason
  /// `MonitorConnection.workspaceId` gives: an RLS policy should be a column
  /// comparison, not a correlated EXISTS over the parent.
  workspaceId  String @map("workspace_id")

  /// The provider's own issue id, as a string. THE DEDUP KEY (see above).
  externalIssueId String @map("external_issue_id")

  /// The issue's facts as last reconciled (`NormalizedMonitorIssue`).
  title       String
  culprit     String?
  level       String?
  permalink   String?
  eventCount  Int      @default(0) @map("event_count")
  firstSeenAt DateTime @map("first_seen_at")
  lastSeenAt  DateTime @map("last_seen_at")

  /// The issue's LATEST EVENT's `environment` tag and release version, as last
  /// read (Story MOTIR-4932 · Subtask MOTIR-5729). `null` = the latest event
  /// carried none, or we have never read it. The list the poll reads carries
  /// neither, so each is read per issue, outside the row lock, and a failed read
  /// leaves the stored value alone.
  environment String?
  release     String?

  /// The latest event's EVIDENCE, as last read (Story MOTIR-5975 · Subtask
  /// MOTIR-5979): what the work-item page's Errors section, `get_work_item` and
  /// the dispatch prompt all render, so none of them calls the provider. Written
  /// by a SUCCESSFUL context read only — the reconcile visit and the hand-made
  /// link — and only when the event read is not OLDER than the stored one, so a
  /// late read of an earlier event never overwrites a newer one. A failed read
  /// leaves every one of these standing and moves only `evidenceCheckedAt`.
  ///
  /// `frames` / `tags` `NULL` = never read; `[]` = read, and there were none.
  /// The tags have already been through the user-identifying filter
  /// (`lib/monitors/evidence.ts`), and the request is a method and a PATH — no
  /// query, header, cookie or body ever reaches this row.
  exceptionType     String?   @map("exception_type")
  exceptionMessage  String?   @map("exception_message")
  frames            Json?
  tags              Json?
  requestMethod     String?   @map("request_method")
  requestPath       String?   @map("request_path")
  eventId           String?   @map("event_id")
  eventAt           DateTime? @map("event_at")
  /// When the evidence above was last READ successfully. `NULL` = never read.
  evidenceReadAt    DateTime? @map("evidence_read_at")
  /// When a context read was last ATTEMPTED — a success writes it with
  /// `evidenceReadAt`, a failure writes it alone. Later than `evidenceReadAt` =
  /// the evidence is STALE: the last check failed, and what stands is older.
  evidenceCheckedAt DateTime? @map("evidence_checked_at")

  /// FK → WorkItem.id, `onDelete: SetNull`. A DELETED bug leaves this row with a
  /// null pointer — which is exactly how the reconciler tells "its work item was
  /// deleted" apart from "never filed" (the second has no identifier below).
  workItemId String? @map("work_item_id")

  /// The `KEY-<n>` identifier last filed for this issue, KEPT after the work item
  /// is deleted, so a re-filed bug can name the one it replaces.
  filedWorkItemIdentifier String? @map("filed_work_item_identifier")

  /// The motir-ai `author_bug` job dispatched to PLAN the bug filed for this
  /// issue (Story MOTIR-4930 · Subtask MOTIR-5849). `null` = never offered
  /// enrichment. THE IDEMPOTENCY KEY: the enrichment trigger dispatches only while
  /// it is null and writes it with the job id, so a redelivered
  /// `work-item/created` event reads it and spends no second model call. It is
  /// also what tells an enriched card from one that was never offered enrichment.
  authoringJobId String? @map("authoring_job_id")

  // ── SYNC STATE (Story MOTIR-4931 · Subtask MOTIR-5701) ──────────────────────
  // What Motir did TO the provider for this issue, and what it last took FROM it.

  /// The resolve-back's state (`lib/monitors/syncStates.ts`): `null` = never
  /// attempted · `pending` = claimed, call in flight · `resolved` · `failed` ·
  /// `gone` (the provider no longer has the issue). `resolved` and `gone` are
  /// terminal — never re-claimed.
  resolveState       String?   @map("resolve_state")
  /// When the current or last claim was taken. `null` = never claimed. It is
  /// what lets a stale `pending` (a crashed attempt) be re-claimed.
  resolveAttemptedAt DateTime? @map("resolve_attempted_at")
  /// When Motir's resolve SUCCEEDED. THE LOOP GUARD'S INPUT: an issue last seen
  /// at or before this moment is one Motir itself closed. `null` = Motir has
  /// not resolved it.
  resolvedByMotirAt  DateTime? @map("resolved_by_motir_at")
  /// The provider's reason on `failed`. `null` in every other state.
  resolveError       String?   @map("resolve_error")

  /// The provider-side assignee id Motir last APPLIED, or last deliberately
  /// declined. An assignment is applied only when the provider's current value
  /// differs from this. `null` = none synced (or the issue is unassigned).
  syncedAssigneeExternalId String?   @map("synced_assignee_external_id")
  /// Why the last provider assignment was a no-op — `team_assignee` ·
  /// `no_matching_member` — or `null` when it was applied or there was none.
  assigneeSyncNote         String?   @map("assignee_sync_note")
  /// When the bounded refresh last read this issue's assignee. Orders the
  /// refresh oldest-first; `null` = never checked (sorts first).
  assigneeCheckedAt        DateTime? @map("assignee_checked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// All modelled on BOTH sides with the actions the migration SQL uses (the
  /// FK-`@relation` rule).
  connection MonitorConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workItem   WorkItem?         @relation(fields: [workItemId], references: [id], onDelete: SetNull)

  /// ⚠️ THE UNIQUENESS IS THE DATABASE'S, NOT THE READ'S. Two reconcilers of one
  /// issue can run at once (a slow poll and the next tick); the constraint plus
  /// the claim-or-lock in `monitorIssueRepository` is what makes a second row —
  /// and so a second bug — impossible.
  @@unique([connectionId, externalIssueId])
  /// NOT unique: many issues may point at one work item (MOTIR-4932's manual
  /// link), and one issue at most one.
  @@index([workItemId])
  @@index([workspaceId])
  @@index([projectId])
  /// The assignee refresh's oldest-first scan over one connection's links.
  @@index([connectionId, assigneeCheckedAt])
  @@map("monitor_issue")
}

// ── USER AGENT INSTANCES (Story MOTIR-6860 · MOTIR-6870) ─────────────────────
// `docs/decisions/agent-instances.md` §4: a long-lived, per-developer machine
// booted from a sandbox image, with a persistent home volume, that hibernates
// and wakes, and is charged per RUNNING INTERVAL. One row per instance and one
// per running stretch. Workspace-scoped tenant data under RLS (the migration).

/// §4's lifecycle. Every transition is a guarded compare-and-set on this column
/// (`agentInstanceRepository.transition`); the legal pairs are
/// `lib/agentInstances/stateMachine.ts`.
enum AgentInstanceState {
  starting
  running
  hibernating
  hibernated
  waking
  failed
  deleting
  /// Moving to a newer image on the same machine and volume, or rolling back
  /// from one (`agent-image-update.md` Q6, MOTIR-6952). Holds its slot.
  updating

  @@map("agent_instance_state")
}

/// Whether an instance's pinned image carries the in-image terminal server
/// (`docs/decisions/agent-terminal.md` Q8 · MOTIR-6939), probed once per digest
/// on a booted machine. `unknown` until the first probe answers.
enum AgentTerminalServer {
  unknown
  present
  absent

  @@map("agent_terminal_server")
}

/// Which of the agent's two sockets a terminal ticket opens, and a connection
/// carried (`docs/decisions/agent-chat.md` Q4 · MOTIR-7013). The relay redeems a
/// ticket only on its own channel's path (`/v1/terminal` or `/v1/chat`).
enum AgentTerminalChannel {
  terminal
  chat

  @@map("agent_terminal_channel")
}

/// Whether an agent's image carries the run launcher (`agent-instance-run.md`
/// §4, MOTIR-7026) — `unknown` until its digest is probed.
enum AgentRunLauncher {
  unknown
  present
  absent

  @@map("agent_run_launcher")
}

/// The coding agent's sign-in as `motir agent-terminal signin` answers it
/// (`agent-instance-run.md` §4). `unknown` for a profile that cannot answer and
/// for an agent never probed.
enum AgentSignInState {
  unknown
  signed_in
  signed_out

  @@map("agent_sign_in_state")
}

/// Why a running interval ended (§4).
enum AgentInstanceIntervalEndReason {
  hibernated
  idle
  backstop
  credits
  deleted
  lost
  /// Closed by the running charge (AMENDMENT 2): the machine is still up, and the
  /// next interval of the same run opens at this one's end.
  rolled
  /// A platform admin stopped the organisation's containers (Story MOTIR-6905,
  /// MOTIR-7323) — never recorded as `credits`.
  admin_stop

  @@map("agent_instance_interval_end_reason")
}

/// Where a closed interval's charge stands (§5). `pending` until the charge
/// pass reaches it; a transport failure leaves it `pending` for the retry.
enum AgentInstanceChargeOutcome {
  pending
  charged
  not_charged
  refused

  @@map("agent_instance_charge_outcome")
}

model AgentInstance {
  id             String @id @default(cuid())
  /// Tenant of record — carried on the row because RLS does not traverse FKs.
  workspaceId    String @map("workspace_id")
  /// The organisation the machine time is billed to, resolved at create.
  organizationId String @map("organization_id")
  projectId      String @map("project_id")
  /// The ONE developer who may open, wake, hibernate or delete it (§8).
  ownerId        String @map("owner_id")

  /// Unique per (owner, project) among LIVE instances — a partial unique index
  /// in the migration, so a deleted instance's name can be reused.
  name                String
  /// The sandbox profile id (`claude`, `codex`, … — `profiles.json`).
  profileId           String    @map("profile_id")
  /// The moving tag the digest was resolved from, for display.
  imageTag            String    @map("image_tag")
  /// The image DIGEST the instance boots, pinned at create (§1). It changes only
  /// when an update's new image passes its liveness check, so it always names a
  /// digest that has run on this agent (`agent-image-update.md` Q6).
  imageDigest         String    @map("image_digest")
  /// The `x.y.z` of `imageDigest` (Q1, Q6): written at create and by a successful
  /// update; null on an agent created before versions were recorded.
  imageVersion        String?   @map("image_version")
  /// The digest Update pinned (Q6). With `hibernated`, an update waiting for the
  /// next wake; with `updating`, the image being moved to. Cleared when it settles.
  targetImageDigest   String?   @map("target_image_digest")
  /// The version of `targetImageDigest`; set and cleared with it.
  targetImageVersion  String?   @map("target_image_version")
  /// The last update's failure, in words (Q4): set on a rollback (or a failed
  /// one); cleared at the next Update press and when a move succeeds.
  updateFailureReason String?   @map("update_failure_reason")
  /// When the last update failed — and, while `updating`, when its rollback began.
  updateFailedAt      DateTime? @map("update_failed_at")

  /// The persistent handle `provisionPersistent` returns (§1, §7). Null until
  /// the provision call answers; the region is fixed at create.
  flyApp    String? @map("fly_app")
  machineId String? @map("machine_id")
  volumeId  String? @map("volume_id")
  region    String

  state           AgentInstanceState              @default(starting)
  /// Set on `failed`, in words a person can read; cleared on a later wake.
  failureReason   String?                         @map("failure_reason")
  /// Why the stop in flight was begun (MOTIR-7406): written with the
  /// `running → hibernating` move and cleared when the stop settles, so a stop
  /// the SWEEP settles closes the interval with that reason (`credits`,
  /// `backstop`, `idle`, …) rather than a blanket `hibernated`.
  hibernateReason AgentInstanceIntervalEndReason? @map("hibernate_reason")
  stateChangedAt  DateTime                        @default(now()) @map("state_changed_at")
  /// The idle signal (§2): bumped by create, wake, and later stories' relay
  /// and runs. The idle sweep compares it with the 30-minute window.
  lastActivityAt  DateTime                        @default(now()) @map("last_activity_at")
  /// A deleted instance keeps its row so its intervals keep their parent (§4);
  /// every list excludes it.
  deletedAt       DateTime?                       @map("deleted_at")

  /// `agent-instance-storage.md` §4 (MOTIR-6921): when the org's AI plan lapsed,
  /// the instant this instance is deleted — the start of the UTC day 30 days on.
  /// The sweep deletes it through the ordinary delete once it has passed;
  /// re-subscribing clears it. Null = not scheduled.
  scheduledDeletionAt DateTime? @map("scheduled_deletion_at")
  /// When its owner was emailed the date — so the notice goes out once, and a
  /// failed send is retried by the sweep rather than lost.
  deletionNoticedAt   DateTime? @map("deletion_noticed_at")

  /// Does the pinned image serve a terminal (agent-terminal.md Q8)? Probed with
  /// `motir agent-terminal --help` after a boot whose digest was not probed yet.
  terminalServer       AgentTerminalServer @default(unknown) @map("terminal_server")
  /// The image digest `terminalServer` was probed for; null = never probed. A
  /// digest that differs from `imageDigest` is re-probed on the next boot.
  terminalServerDigest String?             @map("terminal_server_digest")

  /// Can the pinned image start a card's run (`agent-instance-run.md` §4,
  /// MOTIR-7026)? Probed with `motir agent-terminal run --help` at a boot whose
  /// digest was not probed yet, beside `terminalServer`. An agent never probed
  /// for its CURRENT digest reads as too old to run a card.
  runLauncher       AgentRunLauncher @default(unknown) @map("run_launcher")
  /// The image digest `runLauncher` was probed for; null = never probed.
  runLauncherDigest String?          @map("run_launcher_digest")
  /// The coding agent's sign-in as the agent's terminal server last answered
  /// `motir agent-terminal signin` (§4): probed at every boot, by a start on a
  /// running agent, and just before a hibernate. The credential lives on the
  /// volume, so a hibernated agent's last answer stands. A probe that could not
  /// answer leaves the previous value.
  signInState       AgentSignInState @default(unknown) @map("sign_in_state")
  /// When `signInState` was last answered; null = never.
  signInCheckedAt   DateTime?        @map("sign_in_checked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace           Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization        Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project             Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner               User                         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  intervals           AgentInstanceInterval[]
  /// agent-terminal.md Q3, Q8 (MOTIR-6940): its terminal tickets and connections.
  terminalTickets     AgentTerminalTicket[]
  terminalConnections AgentTerminalConnection[]
  storageCharges      AgentInstanceStorageCharge[]
  /// `agent-instances.md` AMENDMENT 6 (MOTIR-7397): one per create and per wake.
  bootAttempts        AgentInstanceBootAttempt[]
  /// agent-instance-run.md §5 (MOTIR-7023): the runs executed in this agent.
  dispatchRuns        DispatchRun[]

  /// The owner's list: newest first per project.
  @@index([ownerId, projectId, createdAt(sort: Desc)])
  /// The caps and the sweep: running instances fleet-wide and per organisation.
  @@index([state, organizationId])
  @@index([workspaceId])
  /// The plan-lapse deletion: instances due, and the lapse's schedule per org.
  @@index([scheduledDeletionAt])
  @@map("agent_instance")
}

/// A one-shot TERMINAL TICKET (Story MOTIR-6861 · MOTIR-6940,
/// `docs/decisions/agent-terminal.md` Q3): what the owner's browser presents to
/// the relay in its first frame. 32 random bytes; ONLY their SHA-256 is stored.
/// It lives 60 seconds and is consumed by ONE guarded update
/// (`consumed_at IS NULL AND expires_at > now`), so two relays cannot both
/// redeem it. Expired rows are deleted by `system.agent-instance-sweep`.
model AgentTerminalTicket {
  id          String               @id @default(cuid())
  /// Tenant of record — carried on the row because RLS does not traverse FKs.
  workspaceId String               @map("workspace_id")
  instanceId  String               @map("instance_id")
  /// The owner it was minted for — the only user the relay will connect.
  userId      String               @map("user_id")
  /// Hex SHA-256 of the ticket. The ticket itself is never stored or logged.
  tokenHash   String               @unique @map("token_hash")
  /// The socket it opens (agent-chat.md Q4): presented on the other channel's
  /// path, the relay refuses it 4401.
  channel     AgentTerminalChannel @default(terminal)
  expiresAt   DateTime             @map("expires_at")
  consumedAt  DateTime?            @map("consumed_at")
  createdAt   DateTime             @default(now()) @map("created_at")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instance  AgentInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The sweep's read: every ticket past its life.
  @@index([expiresAt])
  @@index([instanceId])
  @@index([userId])
  @@index([workspaceId])
  @@map("agent_terminal_ticket")
}

/// ONE ROW PER TERMINAL CONNECTION through the relay (MOTIR-6940,
/// `agent-terminal.md` Q8): who, which agent, when it opened and closed, and why
/// it closed. Deliberately NOTHING about what flowed — no bytes, no counts, no
/// frames: the terminal's stream is stored nowhere (Q9 condition 4).
model AgentTerminalConnection {
  id             String               @id @default(cuid())
  workspaceId    String               @map("workspace_id")
  instanceId     String               @map("instance_id")
  userId         String               @map("user_id")
  /// Which socket it carried (agent-chat.md Q4, Q10). The only thing the row
  /// says about a chat — never a frame, a transcript or a title.
  channel        AgentTerminalChannel @default(terminal)
  openedAt       DateTime             @map("opened_at")
  /// Null while the connection is open.
  closedAt       DateTime?            @map("closed_at")
  /// The WebSocket close code the browser's socket ended with.
  closeCode      Int?                 @map("close_code")
  /// The relay's word for why (`AgentTerminalCloseReason`).
  closeReason    String?              @map("close_reason")
  /// The relay process holding this connection (MOTIR-6959): `FLY_MACHINE_ID`, or
  /// hostname+pid off Fly. Its boot closes its own leftovers by it.
  relayMachineId String?              @map("relay_machine_id")
  /// Refreshed by the holding relay about once a minute while the row is open
  /// (MOTIR-6959). An open row not seen for 5 minutes is closed `relay_lost` by
  /// `system.agent-instance-sweep`, with `closedAt = lastSeenAt`.
  lastSeenAt     DateTime             @default(now()) @map("last_seen_at")
  createdAt      DateTime             @default(now()) @map("created_at")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instance  AgentInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// An agent's own connection history, newest first.
  @@index([instanceId, openedAt(sort: Desc)])
  @@index([userId])
  @@index([workspaceId])
  /// The sweep's discovery: open rows (`closed_at IS NULL`) not seen lately.
  @@index([closedAt, lastSeenAt])
  /// A relay's boot: its own machine's open rows.
  @@index([relayMachineId, closedAt])
  @@map("agent_terminal_connection")
}

model AgentInstanceInterval {
  id              String @id @default(cuid())
  workspaceId     String @map("workspace_id")
  organizationId  String @map("organization_id")
  agentInstanceId String @map("agent_instance_id")

  /// The machine RUN this interval belongs to: the id of the interval that opened
  /// it (itself, for the first). A run is split into intervals by the running
  /// charge (AMENDMENT 2); the fleet slot and the 12-hour backstop key on the run.
  runId        String   @map("run_id")
  /// When the run began — the backstop's clock. Equal to `startedAt` on the
  /// run's first interval, and copied onto every rolled one.
  runStartedAt DateTime @map("run_started_at")

  startedAt DateTime                        @map("started_at")
  /// Null while the interval is OPEN. At most one open interval per instance —
  /// a partial unique index in the migration.
  endedAt   DateTime?                       @map("ended_at")
  endReason AgentInstanceIntervalEndReason? @map("end_reason")

  /// ⌈endedAt − startedAt⌉ in seconds, written with the close (§5).
  billableSeconds Int?                        @map("billable_seconds")
  /// ⌈billableSeconds ÷ 60⌉ at the machine-minute rate, written by the charge.
  credits         Int?
  /// The debit's idempotency key: `agent-instance-interval:<id>` (§5).
  chargeReference String                      @unique @map("charge_reference")
  chargeOutcome   AgentInstanceChargeOutcome? @map("charge_outcome")
  chargeDetail    String?                     @map("charge_detail")
  chargeAttempts  Int                         @default(0) @map("charge_attempts")
  chargedAt       DateTime?                   @map("charged_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentInstance AgentInstance @relation(fields: [agentInstanceId], references: [id], onDelete: Cascade)

  /// An instance's own history, and the machine-time-this-period sum.
  @@index([agentInstanceId, startedAt(sort: Desc)])
  /// The charge backstop's discovery read: closed intervals still `pending`.
  @@index([chargeOutcome, endedAt])
  @@index([workspaceId])
  @@map("agent_instance_interval")
}

// ONE UTC DAY OF AN AGENT INSTANCE'S STORAGE, charged (Story MOTIR-6914 ·
// MOTIR-6919; `docs/decisions/agent-instance-storage.md` §2). One row per
// (instance, day) on which the instance existed at any moment — running,
// hibernated or failed — written by the daily storage charge before it asks
// motir-ai, so a charge motir-ai could not take stays `pending` and is asked
// again with the same key. Workspace-scoped tenant data under RLS (the migration).
model AgentInstanceStorageCharge {
  id              String @id @default(cuid())
  workspaceId     String @map("workspace_id")
  organizationId  String @map("organization_id")
  agentInstanceId String @map("agent_instance_id")

  /// The UTC calendar day charged.
  day     DateTime @db.Date
  /// The record's daily rate at the moment the row was written.
  credits Int

  /// The debit's idempotency key: `agent-storage:<instance id>:<YYYY-MM-DD>`.
  /// Unique, so one instance is charged at most once per day.
  chargeReference         String                     @unique @map("charge_reference")
  chargeOutcome           AgentInstanceChargeOutcome @default(pending) @map("charge_outcome")
  chargeDetail            String?                    @map("charge_detail")
  chargeAttempts          Int                        @default(0) @map("charge_attempts")
  chargedAt               DateTime?                  @map("charged_at")
  /// When motir-ai's platform usage rollup accepted this day's storage report
  /// (Story MOTIR-727 · MOTIR-7294) — NULL until then.
  platformMeterReportedAt DateTime?                  @map("platform_meter_reported_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentInstance AgentInstance @relation(fields: [agentInstanceId], references: [id], onDelete: Cascade)

  /// The charge pass's discovery read: rows still `pending`, oldest day first.
  @@index([chargeOutcome, day])
  @@index([workspaceId])
  @@map("agent_instance_storage_charge")
}

/// A per-organization KILL-SWITCH override (Story 10.3 · MOTIR-750) — a durable
/// ops flag a platform superadmin flips without a deploy (disable AI planning
/// for one abusive org, turn off hosted runs for one tenant). NOT an experiment
/// flag: the set of keys is CLOSED, registered in `lib/featureFlags/registry.ts`
/// with a safe platform default each (every one ON today). Evaluation is "this
/// org's row, else the registry default", so ABSENCE IS THE DEFAULT and a fresh
/// org needs no rows.
///
/// Written only from the platform tier (`app.platform_staff`, audited
/// `org.kill_switch_off` / `org.kill_switch_on`); read on the hot path under the
/// system context. No tenant arm: a customer never reads or writes its own
/// switches.
model OrgFeatureFlag {
  id              String       @id @default(cuid())
  organizationId  String       @map("organization_id")
  /// Cascade: a switch means nothing once its organization is gone.
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// A registry key (`ai_planning` · `hosted_runs` · `web_search`). A String,
  /// not an enum, so a later key is a code change and no migration; the SERVICE
  /// refuses an unknown key on write, and an unknown stored key is ignored on read.
  key             String
  enabled         Boolean
  /// The operator's stated reason for the CURRENT state — the same text the
  /// audit row holds; the history is the audit log's, not this row's.
  reason          String?
  /// The operator who last flipped it. SetNull: the switch outlives the account.
  updatedByUserId String?      @map("updated_by_user_id")
  updatedBy       User?        @relation("OrgFeatureFlagUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@unique([organizationId, key])
  @@index([updatedByUserId])
  @@map("org_feature_flag")
}

/// How a staff "View as" session may act (Story 10.3 · MOTIR-749).
enum ImpersonationMode {
  /// Reads as the target; every write is refused server-side
  /// (`ImpersonationReadOnlyError`). The default in the dialog.
  read_only
  /// Acts as the target. Every mutating request is audited
  /// `user.impersonation_action` before it runs.
  full

  @@map("impersonation_mode")
}

/// Why a staff "View as" session ended (MOTIR-749) — `user.impersonation_end`'s
/// `metadata.endedBy`.
enum ImpersonationEndedBy {
  /// The operator pressed Exit session, or started a new session (which ends
  /// the previous one).
  operator
  /// The time-box ran out (`expires_at`), noticed at the gate or by the sweep.
  expiry
  /// The session stopped being valid before its time-box: the operator lost
  /// `superadmin`, signed out (a different sign-in session), or the target
  /// account / organization was suspended.
  revoked

  @@map("impersonation_ended_by")
}

/// A platform staff "View as" session (Story 10.3 · MOTIR-749) — a superadmin
/// seeing, or acting in, a tenant AS one of its users, time-boxed, reason-gated
/// and fully audited (`docs/decisions/platform-staff-auth.md` §7 amendment).
///
/// It is NOT a sign-in as the customer: no Better-Auth session is minted for the
/// target. The operator keeps their own session; a separate httpOnly cookie
/// carries a random token whose SHA-256 is `token_hash`, and `readSession`
/// layers the target identity over the operator's session only while this row
/// is live, bound to `operator_session_id`, and before `expires_at`.
///
/// Written only from the platform tier (`app.platform_staff`, inside the audited
/// transaction that appends `user.impersonation_start` / `_end`); read on the
/// request path under the system context. No tenant arm: a customer never sees
/// that a session was opened as them except through support.
model ImpersonationSession {
  id                String                @id @default(cuid())
  /// SHA-256 (hex) of the cookie's random token — the token itself is never stored.
  tokenHash         String                @unique @map("token_hash")
  /// The superadmin who opened it. Cascade: an operational row, not the record —
  /// the hash-chained audit log keeps who did what for ever.
  operatorUserId    String                @map("operator_user_id")
  operator          User                  @relation("ImpersonationSessionOperator", fields: [operatorUserId], references: [id], onDelete: Cascade)
  /// The operator's platform role when the session started (the audit rows'
  /// `actorRole` for the system-closed end).
  operatorRole      PlatformRole          @map("operator_role")
  /// The operator's own Better-Auth session the staff session is bound to. NOT a
  /// foreign key on purpose: signing out deletes that row, and this one must
  /// outlive it so its end can still be recorded; a mismatch revokes it.
  operatorSessionId String                @map("operator_session_id")
  /// The account viewed as.
  targetUserId      String                @map("target_user_id")
  target            User                  @relation("ImpersonationSessionTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  organizationId    String                @map("organization_id")
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// The workspace the session is pinned to — the target's active workspace for
  /// every request of the session, whatever the operator's own cookie says.
  workspaceId       String                @map("workspace_id")
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mode              ImpersonationMode
  /// The operator's stated reason — required, copied onto every write row of the
  /// session (`user.impersonation_end` / `user.impersonation_action`).
  reason            String
  startedAt         DateTime              @default(now()) @map("started_at")
  /// The time-box. Never more than 60 minutes after `started_at`; the gate
  /// refuses the session from this instant whether or not it has been closed.
  expiresAt         DateTime              @map("expires_at")
  endedAt           DateTime?             @map("ended_at")
  endedBy           ImpersonationEndedBy? @map("ended_by")

  @@index([operatorUserId, endedAt])
  @@index([targetUserId])
  @@index([organizationId])
  @@index([workspaceId])
  @@index([endedAt, expiresAt])
  @@map("impersonation_session")
}

/// Whether a boot attempt was opened by a create or a wake (`agent-instances.md`
/// AMENDMENT 6 §2). A wake writes its `clone` rows `skipped`.
enum AgentInstanceBootKind {
  create
  wake

  @@map("agent_instance_boot_kind")
}

/// How a CLOSED boot attempt ended (AMENDMENT 6 §2) — the stream's `done` frame.
enum AgentInstanceBootOutcome {
  running
  failed
  deleted

  @@map("agent_instance_boot_outcome")
}

/// The five boot steps, in order (AMENDMENT 6 §1). `clone` is one row per
/// project repository.
enum AgentInstanceBootStepKind {
  provision
  machine_start
  clone
  terminal_check
  ready

  @@map("agent_instance_boot_step_kind")
}

/// The five states a boot step is in (AMENDMENT 6 §1).
enum AgentInstanceBootStepState {
  waiting
  in_progress
  done
  failed
  skipped

  @@map("agent_instance_boot_step_state")
}

/// ONE BOOT ATTEMPT of an agent (`docs/decisions/agent-instances.md` AMENDMENT 6
/// §2, §4 · MOTIR-7397): numbered per agent from 1, opened by each create and
/// each wake, so a read shows the current attempt and history is never
/// overwritten. It carries the LEASE that makes one party — the boot driver
/// holding it — the only writer of its steps.
model AgentInstanceBootAttempt {
  id              String                @id @default(cuid())
  workspaceId     String                @map("workspace_id")
  organizationId  String                @map("organization_id")
  agentInstanceId String                @map("agent_instance_id")
  /// 1, 2, 3 … per agent; unique with the agent.
  attempt         Int
  kind            AgentInstanceBootKind

  /// The job run holding the lease, null while nobody has taken it.
  leaseHolder    String?   @map("lease_holder")
  /// A lease past this instant is free to take (AMENDMENT 6 §4).
  leaseExpiresAt DateTime? @map("lease_expires_at")

  startedAt DateTime                  @map("started_at")
  /// Null while the attempt is OPEN.
  endedAt   DateTime?                 @map("ended_at")
  outcome   AgentInstanceBootOutcome?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace     Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization  Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentInstance AgentInstance           @relation(fields: [agentInstanceId], references: [id], onDelete: Cascade)
  steps         AgentInstanceBootStep[]

  @@unique([agentInstanceId, attempt])
  @@index([workspaceId])
  @@map("agent_instance_boot_attempt")
}

/// ONE STEP of a boot attempt (AMENDMENT 6 §1). Written `waiting` (or `skipped`)
/// when the attempt opens; every later write stamps a new `seq`, monotonic per
/// AGENT across its attempts, which is the stream's `since` cursor.
model AgentInstanceBootStep {
  id            String                     @id @default(cuid())
  workspaceId   String                     @map("workspace_id")
  bootAttemptId String                     @map("boot_attempt_id")
  seq           Int
  step          AgentInstanceBootStepKind
  /// `owner/name` on a `clone` row, null elsewhere.
  repository    String?
  /// The row's place in the read-out, 0-based.
  ordinal       Int
  state         AgentInstanceBootStepState
  startedAt     DateTime?                  @map("started_at")
  endedAt       DateTime?                  @map("ended_at")
  /// The failure's words, the exit code, or the terminal probe's answer.
  detail        String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace   Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bootAttempt AgentInstanceBootAttempt @relation(fields: [bootAttemptId], references: [id], onDelete: Cascade)

  @@unique([bootAttemptId, ordinal])
  @@index([bootAttemptId, seq])
  @@index([workspaceId])
  @@map("agent_instance_boot_step")
}

// ─────────────────────────────────────────────────────────────────────────────
// THE IDEA STORE (Story MOTIR-7662 · MOTIR-7670)
//
// Platform-owned content, not tenant data: platform staff curate the ideas
// (the console, the private `motir-ideas` skill over `/api/platform/ideas`),
// and anyone reads the ACTIVE ones over `/api/public/ideas`. No tenant column
// anywhere — RLS reads are unconditional and writes are `app.platform_staff`
// only, the posture `platform_run_model` set (see the migration). Every write
// lands with its hash-chained `PlatformAuditLog` row (`targetKind: idea`).
//
// ⚠️ Not `IdeaDraft` — that is the unrelated pre-auth draft hand-off.
// ─────────────────────────────────────────────────────────────────────────────

/// Who an idea is for. `motir_buys` is an idea Motir itself would buy (the
/// "Motir would buy" band); `direction` is a researched direction with evidence.
enum IdeaKind {
  motir_buys
  direction

  @@map("idea_kind")
}

/// Retiring is the normal end of an idea — it leaves every public read and keeps
/// its reason. Hard delete is a superadmin's correction of a mistake.
enum IdeaStatus {
  active
  retired

  @@map("idea_status")
}

/// The FIXED category list — adding one is a migration, which is what "fixed"
/// means. Labels live in `lib/ideas/categories.ts`, held total by the compiler.
enum IdeaCategory {
  // ── Business functions
  /// Legal
  legal
  /// Finance
  finance
  /// Security & compliance
  security_compliance
  /// Customer support
  customer_support
  /// Localization
  localization
  /// Growth & marketing
  growth_marketing
  /// Sales
  sales
  /// People & HR
  people_hr
  /// Operations
  operations
  /// Engineering
  engineering
  // ── Verticals
  /// E-commerce
  ecommerce
  /// Healthcare
  healthcare
  /// Education
  education
  /// Financial services
  financial_services
  /// Real estate
  real_estate
  /// Logistics
  logistics
  /// Construction
  construction
  /// Agriculture
  agriculture
  /// Pets
  pets
  /// Family care
  family_care
  /// Public sector
  public_sector
  /// Entertainment & media
  entertainment_media
  /// Hospitality & travel
  hospitality_travel
  /// Mobility & automotive
  mobility
  /// Energy & climate
  energy_climate
  /// Manufacturing
  manufacturing
  /// Local services
  local_services
  // ── Consumer
  /// Personal growth
  personal_growth
  /// Personal finance
  personal_finance
  /// Health & wellness
  health_wellness
  /// Social & community
  social_community
  /// Silver economy
  silver_economy
  /// Independent work
  independent_work
  // ── Platform
  /// AI infrastructure
  ai_infrastructure

  @@map("idea_category")
}

/// One idea. A CHECK in the migration holds `retired_reason` and `retired_at`
/// both set exactly when `status = 'retired'`.
model Idea {
  id             String       @id @default(cuid())
  slug           String       @unique
  title          String
  pitch          String
  kind           IdeaKind
  category       IdeaCategory
  /// What the product does — the ordered "does" bullets.
  capabilities   String[]
  /// What nobody serves yet (directions).
  gap            String?
  whyNow         String?      @map("why_now")
  /// Why Motir itself would buy it (`motir_buys` only — enforced in the service).
  whyMotir       String?      @map("why_motir")
  /// Who else needs it (`motir_buys` only — enforced in the service).
  whoElse        String?      @map("who_else")
  status         IdeaStatus   @default(active)
  retiredReason  String?      @map("retired_reason")
  retiredAt      DateTime?    @map("retired_at")
  addedAt        DateTime     @default(now()) @map("added_at")
  lastReviewedAt DateTime?    @map("last_reviewed_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  evidence     IdeaEvidence[]
  tags         IdeaTagAssignment[]
  translations IdeaTranslation[]

  @@index([status, category])
  @@index([status, kind])
  @@map("idea")
}

/// One sourced claim behind an idea, ordered by `position`. A child table, not
/// JSON, so each source is addressable and correctable on its own.
model IdeaEvidence {
  id         String    @id @default(cuid())
  ideaId     String    @map("idea_id")
  position   Int
  claim      String
  sourceName String    @map("source_name")
  url        String
  sourceDate DateTime? @map("source_date") @db.Date

  idea         Idea                      @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  translations IdeaEvidenceTranslation[]

  @@unique([ideaId, position])
  @@map("idea_evidence")
}

/// The curated tag vocabulary. `description` is the stated reason a tag exists.
model IdeaTag {
  id          String   @id @default(cuid())
  slug        String   @unique
  label       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  assignments  IdeaTagAssignment[]
  translations IdeaTagTranslation[]

  @@map("idea_tag")
}

/// An idea ↔ tag join. Deleting an idea drops its assignments; a tag still in
/// use cannot be deleted (Restrict).
model IdeaTagAssignment {
  ideaId String @map("idea_id")
  tagId  String @map("tag_id")

  idea Idea    @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  tag  IdeaTag @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([ideaId, tagId])
  @@index([tagId])
  @@map("idea_tag_assignment")
}

/// The ten locales an idea can be TRANSLATED into (Story MOTIR-7772 · MOTIR-7773)
/// — the eleven UI locales (`lib/i18n/locales.ts`) minus `en`, because English
/// lives on the base rows and is required there. Deliberately not `Locale`: that
/// name is the UI's type, and this one means "the non-English ones".
enum IdeaTranslationLocale {
  zh
  ja
  ko
  de
  fr
  es
  it
  nl
  pl
  pt

  @@map("idea_translation_locale")
}

/// One idea's text in one non-English locale. Every text column is nullable and
/// NULL means "missing in this locale"; `capabilities` counts as present only
/// when its length equals the English list's, so a list that no longer matches
/// its English is stale by construction (a `String[]` cannot be null). Written
/// by a merge-only `INSERT … ON CONFLICT` that never touches the `idea` row, so a
/// translation write does not move `Idea.updatedAt`.
model IdeaTranslation {
  ideaId       String                @map("idea_id")
  locale       IdeaTranslationLocale
  title        String?
  pitch        String?
  capabilities String[]              @default([])
  gap          String?
  whyNow       String?               @map("why_now")
  whyMotir     String?               @map("why_motir")
  whoElse      String?               @map("who_else")
  updatedAt    DateTime              @default(now()) @updatedAt @map("updated_at")

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@id([ideaId, locale])
  @@map("idea_translation")
}

/// One evidence claim in one non-English locale. Only the claim is translated —
/// the source name, URL and date never are. Cascades with its evidence row, so a
/// replaced evidence list can never keep a stale claim translation.
model IdeaEvidenceTranslation {
  evidenceId String                @map("evidence_id")
  locale     IdeaTranslationLocale
  claim      String

  evidence IdeaEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([evidenceId, locale])
  @@map("idea_evidence_translation")
}

/// One vocabulary tag's label in one non-English locale. The tag's `description`
/// is staff-facing and never translated.
model IdeaTagTranslation {
  tagId  String                @map("tag_id")
  locale IdeaTranslationLocale
  label  String

  tag IdeaTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tagId, locale])
  @@map("idea_tag_translation")
}

/// The research-run log the `motir-ideas` skill writes, so its coverage map
/// survives across machines.
model IdeaResearchRun {
  id           String   @id @default(cuid())
  ranAt        DateTime @default(now()) @map("ran_at")
  actorUserId  String   @map("actor_user_id")
  areasCovered String[] @map("areas_covered")
  addedCount   Int      @map("added_count")
  retiredCount Int      @map("retired_count")
  reportMd     String   @map("report_md")

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([ranAt])
  @@index([actorUserId])
  @@map("idea_research_run")
}

/// A project's self-hosted runner group in a CONNECTED org (Story MOTIR-8699 ·
/// MOTIR-8712) — the org-keyed SET whose degenerate case, the provisioning org's
/// group, stays on `Project.runnerGroup*`. One row per `(project, org)`: the group
/// in that org, access-listed to the project's PRIVATE repositories there, managed
/// through the provisioning App's installation on that org.
model ProjectRunnerGroup {
  id              String    @id @default(cuid())
  projectId       String    @map("project_id")
  workspaceId     String    @map("workspace_id")
  /// The org login, stored lower-cased (GitHub logins are case-insensitive).
  org             String
  /// The provisioning App's installation on `org` the group is managed through.
  installationId  String    @map("installation_id")
  runnerGroupId   Int       @map("runner_group_id")
  runnerGroupName String    @map("runner_group_name")
  syncedAt        DateTime? @map("synced_at")
  /// A GitHub-side failure on the last sync for THIS org — the same meaning as
  /// `Project.runnerGroupSyncPending`, scoped to one org.
  syncPending     Boolean   @default(false) @map("sync_pending")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([projectId, org])
  @@index([workspaceId])
  @@map("project_runner_group")
}

/// Which GitHub runner call a ledger row records (MOTIR-8969).
enum GithubRunnerCallKind {
  mint
  delete

  @@map("github_runner_call_kind")
}

/// THE GITHUB RUNNER-CALL LEDGER (Story MOTIR-8953 · MOTIR-8969) — one row per
/// runner mint or delete that reached GitHub, keyed on the RUNNER'S GitHub org
/// (lower-cased), never the machine's account. The headroom pass counts GitHub's
/// per-org limits from it and prunes it to about two hours. Platform bookkeeping
/// with no workspace; RLS admits `app.system_admin` only.
model GithubRunnerCallEvent {
  id           String               @id @default(cuid())
  githubOrg    String               @map("github_org")
  kind         GithubRunnerCallKind
  at           DateTime
  /// The machine's account, for diagnosis only. No FK: the ledger outlives nothing.
  fleetShardId String?              @map("fleet_shard_id")

  @@index([githubOrg, at])
  @@index([at])
  @@map("github_runner_call_event")
}
